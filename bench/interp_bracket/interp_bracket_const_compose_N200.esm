{
 "esm": "1.2.0",
 "metadata": {
  "name": "interp_bracket_const_compose_N200",
  "description": "Interpolation-bracket benchmark (EarthSciAST issue #588), 200 levels and 200 knots, three lookups per level sharing one axis and one query: the bracket_index / interp_linear_bracketed composition over const tables. Generated by bench/interp_bracket/generate.py.",
  "authors": [
   "EarthSciAST interpolation-bracket benchmark"
  ]
 },
