{
 "esm": "1.2.0",
 "metadata": {
  "name": "interp_bracket_runtime_compose_N59",
  "description": "Interpolation-bracket benchmark (EarthSciAST issue #588), 59 levels and 59 knots, three lookups per level sharing one axis and one query: the bracket_index / interp_linear_bracketed composition over computed tables. Generated by bench/interp_bracket/generate.py.",
  "authors": [
   "EarthSciAST interpolation-bracket benchmark"
  ]
 },
 "index_sets": {
  "lev": {
   "kind": "interval",
   "size": 59
  },
  "knot": {
   "kind": "interval",
   "size": 59
  }
 },
 "models": {
  "Column": {
   "expression_templates": {
    "bracket_index": {
     "params": [
      "axis",
      "x",
      "n"
     ],
     "description": "Lower bracketing index of x on the strictly increasing axis (n entries): the number of axis levels at or below x, held to [1, n-1].",
     "body": {
      "op": "min",
      "args": [
       {
        "op": "max",
        "args": [
         {
          "op": "faq",
          "output_idx": [],
          "reduce": "+",
          "args": [
           "axis"
          ],
          "ranges": {
           "k_bracket": [
            1,
            "n"
           ]
          },
          "expr": {
           "op": "ifelse",
           "args": [
            {
             "op": "<=",
             "args": [
              {
               "op": "index",
               "args": [
                "axis",
                "k_bracket"
               ]
              },
              "x"
             ]
            },
            1,
            0
           ]
          }
         },
         1
        ]
       },
       {
        "op": "-",
        "args": [
         "n",
         1
        ]
       }
      ]
     }
    },
    "bracket_weight": {
     "params": [
      "axis",
      "x",
      "i_lo"
     ],
     "description": "Fractional position of x between axis[i_lo] and axis[i_lo+1].",
     "body": {
      "op": "/",
      "args": [
       {
        "op": "-",
        "args": [
         "x",
         {
          "op": "index",
          "args": [
           "axis",
           "i_lo"
          ]
         }
        ]
       },
       {
        "op": "-",
        "args": [
         {
          "op": "index",
          "args": [
           "axis",
           {
            "op": "+",
            "args": [
             "i_lo",
             1
            ]
           }
          ]
         },
         {
          "op": "index",
          "args": [
           "axis",
           "i_lo"
          ]
         }
        ]
       }
      ]
     }
    },
    "lerp": {
     "params": [
      "lo",
      "hi",
      "frac"
     ],
     "description": "Linear blend lo + frac (hi - lo), the order esm-spec 9.2 pins.",
     "body": {
      "op": "+",
      "args": [
       "lo",
       {
        "op": "*",
        "args": [
         "frac",
         {
          "op": "-",
          "args": [
           "hi",
           "lo"
          ]
         }
        ]
       }
      ]
     }
    },
    "interp_linear_bracketed": {
     "params": [
      "table",
      "axis",
      "x",
      "i_lo",
      "n"
     ],
     "description": "interp.linear(table, axis, x) for a run-time table and axis of n entries, given i_lo = bracket_index(axis, x, n).",
     "body": {
      "op": "ifelse",
      "args": [
       {
        "op": "<=",
        "args": [
         "x",
         {
          "op": "index",
          "args": [
           "axis",
           1
          ]
         }
        ]
       },
       {
        "op": "index",
        "args": [
         "table",
         1
        ]
       },
       {
        "op": "ifelse",
        "args": [
         {
          "op": ">=",
          "args": [
           "x",
           {
            "op": "index",
            "args": [
             "axis",
             "n"
            ]
           }
          ]
         },
         {
          "op": "index",
          "args": [
           "table",
           "n"
          ]
         },
         {
          "op": "apply_expression_template",
          "args": [],
          "name": "lerp",
          "bindings": {
           "lo": {
            "op": "index",
            "args": [
             "table",
             "i_lo"
            ]
           },
           "hi": {
            "op": "index",
            "args": [
             "table",
             {
              "op": "+",
              "args": [
               "i_lo",
               1
              ]
             }
            ]
           },
           "frac": {
            "op": "apply_expression_template",
            "args": [],
            "name": "bracket_weight",
            "bindings": {
             "axis": "axis",
             "x": "x",
             "i_lo": "i_lo"
            }
           }
          }
         }
        ]
       }
      ]
     }
    }
   },
