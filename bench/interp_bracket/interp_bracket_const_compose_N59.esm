{
 "esm": "2.0.0",
 "metadata": {
  "name": "interp_bracket_const_compose_N59",
  "description": "Interpolation-bracket benchmark (EarthSciAST issue #588), 59 levels and 59 knots, three lookups per level sharing one axis and one query: the bracket_index / interp_linear_bracketed composition over const tables. Generated by bench/interp_bracket/generate.py.",
  "authors": [
   "EarthSciAST interpolation-bracket benchmark"
  ]
 },
 "index_sets": {
  "lev": {
   "kind": "interval",
   "size": 59
  },
  "knot": {
   "kind": "interval",
   "size": 59
  }
 },
