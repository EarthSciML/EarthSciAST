import Esm.Closed.Interp.Template
import Esm.Expr.Template
import Esm.Lib.Interp

/-!
# The `lib/interp.esm` templates, evaluated, equal the §9.2 primitives

`Esm/Lib/Interp.lean` holds the three expression templates of
`lib/interp.esm` as ASTs (generated by `formal/scripts/gen-lib-templates.py`,
checked current in CI). This file proves that applying each one — §9.6.3
constraint 5 expansion (`Esm.Expr.expand`) then evaluation (`Esm.Expr.eval`) —
gives exactly the value of the matching §9.2 primitive of
`Esm/Closed/Interp.lean`:

* `searchsorted_template_eq`, `linear_template_eq`, `bilinear_template_eq`,
  at every scalar type satisfying `RealNaN` and `ExprLaws` (the exact `Num`
  and the binary64 `Bin64`), for every query, NaN included;
* `linear_template_fma_le_two_ulp`, `bilinear_template_fma_le`: the Q-6
  binary64 bounds restated about the evaluated template at `Bin64`.

The route: the expansion is, by computation, a tree built from the small
shapes below (`countA`, `cellA`, `blendA`, …); each shape evaluates to the
matching piece of the mirror functions of `Esm/Closed/Interp/Template.lean`
(`countLe`, `cellIdx`, the pinned blend); and the mirrors are equal to the
primitives there (`Esm.Closed.Template.linear_eq` …).

The hypotheses are those of the mirror theorems plus what an evaluation of the
AST needs and a primitive does not: the table has the validated shape (an
`index` past the end is an error, not NaN), and an axis has at most `2^53`
knots (so the binary64 count is exact).
-/

namespace Esm.Closed.TemplateAst

open Esm.Expr Esm.Closed.Template Scalar RealNaN

set_option linter.unusedSectionVars false

/-! ## The arithmetic an evaluation needs -/

/-- Integer arithmetic below `2^53` is exact, integer literals read exactly,
and integral values are recognised: what `faq` counts and `index` arguments
need from a scalar type. -/
class ExprLaws (α : Type) [Scalar α] [RealNaN α] [Lits α] : Prop where
  ofDec_int : ∀ m : ℤ, |m| ≤ 2 ^ 53 → (Lits.ofDec m 0 : α) = fin (m : ℝ)
  add_int : ∀ m k : ℤ, |m| ≤ 2 ^ 53 → |k| ≤ 2 ^ 53 → |m + k| ≤ 2 ^ 53 →
    add (fin (m : ℝ) : α) (fin (k : ℝ)) = fin ((m + k : ℤ) : ℝ)
  sub_int : ∀ m k : ℤ, |m| ≤ 2 ^ 53 → |k| ≤ 2 ^ 53 → |m - k| ≤ 2 ^ 53 →
    sub (fin (m : ℝ) : α) (fin (k : ℝ)) = fin ((m - k : ℤ) : ℝ)
  toInt_int : ∀ m : ℤ, Lits.toInt? (fin (m : ℝ) : α) = some m
  isNaN_fin : ∀ r : ℝ, isNaN (fin r : α) = false

theorem toInt_intCast (m : ℤ) :
    (if ((⌊(m : ℝ)⌋ : ℤ) : ℝ) = (m : ℝ) then some ⌊(m : ℝ)⌋ else none) = some m := by
  simp

instance : ExprLaws Num where
  ofDec_int m _ := by
    show Num.fin ((m : ℝ) / 10 ^ 0) = Num.fin (m : ℝ)
    simp
  add_int m k _ _ _ := by
    show Num.fin ((m : ℝ) + k) = Num.fin ((m + k : ℤ) : ℝ)
    push_cast; rfl
  sub_int m k _ _ _ := by
    show Num.fin ((m : ℝ) - k) = Num.fin ((m - k : ℤ) : ℝ)
    push_cast; rfl
  toInt_int m := toInt_intCast m
  isNaN_fin _ := rfl

theorem rn_int {m : ℤ} (h : |m| ≤ 2 ^ 53) : Esm.F64.rn ((m : ℝ)) = m :=
  Esm.F64.rn_of_repr (Esm.F64.repr_intCast h)

instance : ExprLaws Bin64 where
  ofDec_int m h := by
    show Bin64.fin (Esm.F64.rn ((m : ℝ) / 10 ^ 0)) = Bin64.fin (m : ℝ)
    rw [pow_zero, div_one, rn_int h]
  add_int m k _ _ h := by
    show Bin64.fin (Esm.F64.rn ((m : ℝ) + k)) = Bin64.fin ((m + k : ℤ) : ℝ)
    rw [← Int.cast_add, rn_int h]
  sub_int m k _ _ h := by
    show Bin64.fin (Esm.F64.rn ((m : ℝ) - k)) = Bin64.fin ((m - k : ℤ) : ℝ)
    rw [← Int.cast_sub, rn_int h]
  toInt_int m := toInt_intCast m
  isNaN_fin _ := rfl

/-! ## The shapes the expansions are built from -/

def ixA (a : Ast) (is : List Ast) : Ast := .node "index" (a :: is)

/-- `faq` with `output_idx: []`, `reduce: "+"`, `ranges: {k: [1, n]}`. -/
def sumA (k : String) (n body : Ast) (args : List Ast) : Ast :=
  .faq [] "+" (.cons k [.num 1 0, n] .nil) body args

/-- `count_{k ∈ [1,n]}(index(axis,k) <= q)`. -/
def countA (axis q : Ast) (k : String) (n : Ast) : Ast :=
  sumA k n (.node "ifelse" [.node "<=" [ixA axis [.var k], q], .num 1 0, .num 0 0]) [axis]

/-- `min(max(count, 1), n - 1)`. -/
def cellA (axis q : Ast) (k : String) (n : Ast) : Ast :=
  .node "min" [.node "max" [countA axis q k n, .num 1 0], .node "-" [n, .num 1 0]]

def succA (c : Ast) : Ast := .node "+" [c, .num 1 0]

/-- `(q - lo) / (hi - lo)`. -/
def weightA (q lo hi : Ast) : Ast := .node "/" [.node "-" [q, lo], .node "-" [hi, lo]]

/-- `t + w * (u - t)`. -/
def blendA (t u w : Ast) : Ast := .node "+" [t, .node "*" [w, .node "-" [u, t]]]

def searchsortedA (x xs n : Ast) : Ast :=
  .node "+" [.num 1 0, sumA "k_ss" n
    (.node "ifelse" [.node ">=" [ixA xs [.var "k_ss"], x], .num 0 0, .num 1 0]) [xs]]

def linearA (table axis x n : Ast) : Ast :=
  .node "ifelse" [.node "<=" [x, ixA axis [.num 1 0]], ixA table [.num 1 0],
    .node "ifelse" [.node ">=" [x, ixA axis [n]], ixA table [n],
      blendA (ixA table [cellA axis x "k_lin" n]) (ixA table [succA (cellA axis x "k_lin" n)])
        (weightA x (ixA axis [cellA axis x "k_lin" n])
          (ixA axis [succA (cellA axis x "k_lin" n)]))]]

def clampA (x axis n : Ast) : Ast :=
  .node "ifelse" [.node "<=" [x, ixA axis [.num 1 0]], ixA axis [.num 1 0],
    .node "ifelse" [.node ">=" [x, ixA axis [n]], ixA axis [n], x]]

def bilinearA (table ax ay x y nx ny : Ast) : Ast :=
  let i := cellA ax (clampA x ax nx) "k_bx" nx
  let j := cellA ay (clampA y ay ny) "k_by" ny
  let wx := weightA (clampA x ax nx) (ixA ax [i]) (ixA ax [succA i])
  let wy := weightA (clampA y ay ny) (ixA ay [j]) (ixA ay [succA j])
  blendA (blendA (ixA table [i, j]) (ixA table [succA i, j]) wx)
    (blendA (ixA table [i, succA j]) (ixA table [succA i, succA j]) wx) wy

/-! The expansions, by computation. -/

theorem expand_searchsorted (n : ℕ) :
    expand Esm.Lib.Interp.searchsorted [("x", .var "X"), ("xs", .var "A"), ("n", .num n 0)] =
      .ok (searchsortedA (.var "X") (.var "A") (.num n 0)) := rfl

theorem expand_linear (n : ℕ) :
    expand Esm.Lib.Interp.linear
        [("table", .var "T"), ("axis", .var "A"), ("x", .var "X"), ("n", .num n 0)] =
      .ok (linearA (.var "T") (.var "A") (.var "X") (.num n 0)) := rfl

theorem expand_bilinear (nx ny : ℕ) :
    expand Esm.Lib.Interp.bilinear
        [("table", .var "T"), ("axis_x", .var "AX"), ("axis_y", .var "AY"), ("x", .var "X"),
          ("y", .var "Y"), ("nx", .num nx 0), ("ny", .num ny 0)] =
      .ok (bilinearA (.var "T") (.var "AX") (.var "AY") (.var "X") (.var "Y")
        (.num nx 0) (.num ny 0)) := rfl

/-! ## Evaluating the shapes -/

section Eval

variable {α : Type} [Scalar α] [RealNaN α] [Lits α] [Elem α] [ExprLaws α]

theorem op_ifelse : Op.ofString "ifelse" = .ifelse := rfl
theorem op_index : Op.ofString "index" = .strict .index := rfl
theorem op_add : Op.ofString "+" = .strict .add := rfl
theorem op_mul : Op.ofString "*" = .strict .mul := rfl
theorem op_sub : Op.ofString "-" = .strict .sub := rfl
theorem op_div : Op.ofString "/" = .strict .div := rfl
theorem op_le : Op.ofString "<=" = .strict .le := rfl
theorem op_ge : Op.ofString ">=" = .strict .ge := rfl
theorem op_max : Op.ofString "max" = .strict .max := rfl
theorem op_min : Op.ofString "min" = .strict .min := rfl

theorem nat_abs_le {n : ℕ} (h : n ≤ 2 ^ 53) : |(n : ℤ)| ≤ 2 ^ 53 := by
  rw [abs_of_nonneg (by positivity)]; exact_mod_cast h

theorem ofDec_nat {n : ℕ} (h : n ≤ 2 ^ 53) : (Lits.ofDec (n : ℤ) 0 : α) = fin (n : ℝ) := by
  rw [ExprLaws.ofDec_int _ (nat_abs_le h)]; push_cast; rfl

theorem toInt_nat (n : ℕ) : Lits.toInt? (fin (n : ℝ) : α) = some (n : ℤ) := by
  have := ExprLaws.toInt_int (α := α) (n : ℤ)
  push_cast at this; exact this

theorem add_nat {m k : ℕ} (h : m + k ≤ 2 ^ 53) :
    add (fin (m : ℝ) : α) (fin (k : ℝ)) = fin ((m + k : ℕ) : ℝ) := by
  have := ExprLaws.add_int (α := α) m k (nat_abs_le (by omega)) (nat_abs_le (by omega))
    (by have := nat_abs_le (n := m + k) h; push_cast at this; exact this)
  push_cast at this ⊢; exact this

theorem sub_nat {m k : ℕ} (hk : k ≤ m) (h : m ≤ 2 ^ 53) :
    sub (fin (m : ℝ) : α) (fin (k : ℝ)) = fin ((m - k : ℕ) : ℝ) := by
  have := ExprLaws.sub_int (α := α) m k (nat_abs_le h) (nat_abs_le (by omega))
    (by have := nat_abs_le (n := m - k) (by omega); push_cast [Nat.cast_sub hk] at this; exact this)
  push_cast [Nat.cast_sub hk] at this ⊢; exact this

theorem one_eq : (one : α) = fin 1 := by
  have := ofDec_nat (α := α) (n := 1) (by norm_num); simpa [one] using this

theorem zero_eq : (zero : α) = fin 0 := by
  have := ofDec_nat (α := α) (n := 0) (by norm_num); simpa [zero] using this

theorem truthy_ofBool (b : Bool) : truthy (ofBool b : α) = b := by
  cases b <;> simp [truthy, ofBool, one_eq, zero_eq, lt_fin]

theorem fmax_fin (a b : ℝ) : fmax (fin a : α) (fin b) = fin (max a b) := by
  unfold fmax
  rw [ExprLaws.isNaN_fin, ExprLaws.isNaN_fin, lt_fin]
  by_cases h : a < b
  · simp [h, max_eq_right h.le]
  · simp [h, max_eq_left (not_lt.mp h)]

theorem fmin_fin (a b : ℝ) : fmin (fin a : α) (fin b) = fin (min a b) := by
  unfold fmin
  rw [ExprLaws.isNaN_fin, ExprLaws.isNaN_fin, lt_fin]
  by_cases h : b < a
  · simp [h, min_eq_right h.le]
  · simp [h, min_eq_left (not_lt.mp h)]

variable (env : Env α)

theorem ev_lookup {s : String} {v : Val α} (h : env.lookup s = some v) :
    eval (.var s) env = .ok v := by
  simp [eval, h]

theorem ev_nat {n : ℕ} (h : n ≤ 2 ^ 53) : eval (.num (n : ℤ) 0) env = .ok (.num (fin (n : ℝ))) := by
  simp [eval, ofDec_nat h]

theorem ev_one : eval (.num 1 0) env = .ok (.num (fin 1 : α)) := by
  have := ev_nat env (n := 1) (by norm_num); simpa using this

theorem ev_lit1 : eval (.num 1 0) env = .ok (.num (fin ((1 : ℕ) : ℝ) : α)) := by
  have := ev_nat env (n := 1) (by norm_num); simpa using this

theorem ev_zero : eval (.num 0 0) env = .ok (.num (fin 0 : α)) := by
  have := ev_nat env (n := 0) (by norm_num); simpa using this

variable {env}

theorem ev_bin {op : String} {o : StrictOp} (hop : Op.ofString op = .strict o) {a b : Ast}
    {u v : α} (ha : eval a env = .ok (.num u)) (hb : eval b env = .ok (.num v)) :
    eval (.node op [a, b]) env = (applyStrict o [.num u, .num v]).map Val.num := by
  simp only [eval, hop, evalList, ha, hb, bind, Except.bind, pure, Except.pure]
  cases h : applyStrict o [.num u, .num v] <;> rfl

theorem ev_sub {a b : Ast} {u v : α} (ha : eval a env = .ok (.num u))
    (hb : eval b env = .ok (.num v)) : eval (.node "-" [a, b]) env = .ok (.num (sub u v)) := by
  rw [ev_bin op_sub ha hb]; rfl

theorem ev_div {a b : Ast} {u v : α} (ha : eval a env = .ok (.num u))
    (hb : eval b env = .ok (.num v)) : eval (.node "/" [a, b]) env = .ok (.num (div u v)) := by
  rw [ev_bin op_div ha hb]; rfl

theorem ev_add {a b : Ast} {u v : α} (ha : eval a env = .ok (.num u))
    (hb : eval b env = .ok (.num v)) : eval (.node "+" [a, b]) env = .ok (.num (add u v)) := by
  rw [ev_bin op_add ha hb]; rfl

theorem ev_mul {a b : Ast} {u v : α} (ha : eval a env = .ok (.num u))
    (hb : eval b env = .ok (.num v)) : eval (.node "*" [a, b]) env = .ok (.num (mul u v)) := by
  rw [ev_bin op_mul ha hb]; rfl

theorem ev_le {a b : Ast} {u v : α} (ha : eval a env = .ok (.num u))
    (hb : eval b env = .ok (.num v)) :
    eval (.node "<=" [a, b]) env = .ok (.num (ofBool (le u v))) := by
  rw [ev_bin op_le ha hb]; rfl

theorem ev_ge {a b : Ast} {u v : α} (ha : eval a env = .ok (.num u))
    (hb : eval b env = .ok (.num v)) :
    eval (.node ">=" [a, b]) env = .ok (.num (ofBool (le v u))) := by
  rw [ev_bin op_ge ha hb]; rfl

theorem ev_max {a b : Ast} {u v : ℝ} (ha : eval a env = .ok (.num (fin u)))
    (hb : eval b env = .ok (.num (fin v))) :
    eval (.node "max" [a, b]) env = .ok (.num (fin (max u v) : α)) := by
  rw [ev_bin op_max ha hb]
  simp [applyStrict, asNum, bind, Except.bind, pure, Except.pure, Except.map, fmax_fin]

theorem ev_min {a b : Ast} {u v : ℝ} (ha : eval a env = .ok (.num (fin u)))
    (hb : eval b env = .ok (.num (fin v))) :
    eval (.node "min" [a, b]) env = .ok (.num (fin (min u v) : α)) := by
  rw [ev_bin op_min ha hb]
  simp [applyStrict, asNum, bind, Except.bind, pure, Except.pure, Except.map, fmin_fin]

theorem ev_ifelse {c p q : Ast} {b : Bool} (hc : eval c env = .ok (.num (ofBool b : α))) :
    eval (.node "ifelse" [c, p, q]) env = if b then eval p env else eval q env := by
  simp only [eval, op_ifelse, evalIfelse, hc]
  simp [asNum, bind, Except.bind, truthy_ofBool]

theorem ev_index1 {a i : Ast} {xs : List α} {k : ℕ} (ha : eval a env = .ok (.arr1 xs))
    (hi : eval i env = .ok (.num (fin (k : ℝ)))) (h1 : 1 ≤ k) (h2 : k ≤ xs.length) :
    eval (ixA a [i]) env = .ok (.num (Template.ix xs k)) := by
  simp only [ixA, eval, op_index, evalList, ha, hi]
  have hk : ((k : ℤ) - 1).toNat = k - 1 := by omega
  simp [hasInf, applyStrict, asNum, asInt, toInt_nat, indexVal, h1, h2, Template.ix, hk, bind,
    Except.bind, pure, Except.pure]
  rw [List.getElem?_eq_getElem (by omega)]; rfl

theorem ev_index2 {a i j : Ast} {T : List (List α)} {p q : ℕ} (ha : eval a env = .ok (.arr2 T))
    (hi : eval i env = .ok (.num (fin (p : ℝ)))) (hj : eval j env = .ok (.num (fin (q : ℝ))))
    (h1 : 1 ≤ p) (h2 : p ≤ T.length) (h3 : 1 ≤ q) (h4 : q ≤ (T.getD (p - 1) []).length) :
    eval (ixA a [i, j]) env = .ok (.num (Template.ix2 T p q)) := by
  simp only [ixA, eval, op_index, evalList, ha, hi, hj]
  have hp : ((p : ℤ) - 1).toNat = p - 1 := by omega
  have hq : ((q : ℤ) - 1).toNat = q - 1 := by omega
  rw [List.getD_eq_getElem _ _ (show p - 1 < T.length by omega)] at h4
  simp [hasInf, applyStrict, asNum, asInt, toInt_nat, indexVal, h1, h2, h3, h4, Template.ix2, entry, hp,
    hq, bind, Except.bind, pure, Except.pure, List.getElem?_eq_getElem (show p - 1 < T.length by omega),
    List.getElem?_eq_getElem (show q - 1 < T[p - 1].length by omega)]

theorem ev_pred {n : ℕ} (h1 : 1 ≤ n) (h : n ≤ 2 ^ 53) :
    eval (.node "-" [.num (n : ℤ) 0, .num 1 0]) env = .ok (.num (fin ((n - 1 : ℕ) : ℝ) : α)) := by
  rw [ev_sub (ev_nat env h) (ev_lit1 env)]
  rw [sub_nat (α := α) (m := n) (k := 1) h1 h]

theorem ev_succ {c : Ast} {m : ℕ} (hc : eval c env = .ok (.num (fin (m : ℝ)))) (h : m + 1 ≤ 2 ^ 53) :
    eval (succA c) env = .ok (.num (fin ((m + 1 : ℕ) : ℝ) : α)) := by
  unfold succA
  rw [ev_add hc (ev_lit1 env), add_nat h]

theorem ev_weight {q lo hi : Ast} {qv l h : α} (hq : eval q env = .ok (.num qv))
    (hl : eval lo env = .ok (.num l)) (hh : eval hi env = .ok (.num h)) :
    eval (weightA q lo hi) env = .ok (.num (div (sub qv l) (sub h l))) := by
  unfold weightA
  rw [ev_div (ev_sub hq hl) (ev_sub hh hl)]

theorem ev_blend {t u w : Ast} {tv uv wv : α} (ht : eval t env = .ok (.num tv))
    (hu : eval u env = .ok (.num uv)) (hw : eval w env = .ok (.num wv)) :
    eval (blendA t u w) env = .ok (.num (add tv (mul wv (sub uv tv)))) := by
  unfold blendA
  rw [ev_add ht (ev_mul hw (ev_sub hu ht))]

/-- The `+` fold of `faq`, as a count: a step that adds the natural number
`f j ≤ 1` at index `j` folds `1, …, N` to `faqSum N f`. -/
theorem foldlM_count (g : α → ℤ → Except EvalError α) (f : ℕ → ℕ) (n : ℕ) (hn : n ≤ 2 ^ 53)
    (hf : ∀ j, f j ≤ 1)
    (hg : ∀ s j : ℕ, 1 ≤ j → j ≤ n → s + f j ≤ 2 ^ 53 →
      g (fin (s : ℝ)) ((1 : ℤ) + ((j - 1 : ℕ) : ℤ)) = .ok (fin ((s + f j : ℕ) : ℝ))) :
    ∀ N, N ≤ n → ((List.range N).map (fun i : ℕ => (1 : ℤ) + (i : ℤ))).foldlM g zero =
      .ok (fin (faqSum N f : ℝ)) := by
  intro N
  induction N with
  | zero => intro _; simp [faqSum, zero_eq, pure, Except.pure]
  | succ N ih =>
    intro hN
    rw [List.range_succ, List.map_append, List.foldlM_append, ih (by omega)]
    have hle := faqSum_le N f hf
    have hfN := hf (N + 1)
    have := hg (faqSum N f) (N + 1) (by omega) hN (by omega)
    simp only [Nat.add_sub_cancel] at this
    simp only [List.map_cons, List.map_nil, List.foldlM_cons, List.foldlM_nil, bind, Except.bind,
      this, faqSum_succ, pure, Except.pure]

/-- A `faq` `+` over `k ∈ [1, n]` whose body evaluates at each `k` to a natural
number `f k ≤ 1` is the natural-number count `faqSum n f`, exactly. -/
theorem ev_sum {k : String} {n : ℕ} {nE body : Ast} {args : List Ast} {f : ℕ → ℕ}
    (hn : n ≤ 2 ^ 53) (hnE : eval nE env = .ok (.num (fin (n : ℝ)))) (hf : ∀ j, f j ≤ 1)
    (hbody : ∀ j : ℕ, 1 ≤ j → j ≤ n →
      eval body ((k, .num (fin (j : ℝ))) :: env) = .ok (.num (fin (f j : ℝ)))) :
    eval (sumA k nE body args) env = .ok (.num (fin (faqSum n f : ℝ) : α)) := by
  have o1 : (Lits.ofDec 1 0 : α) = fin 1 := by
    have := ofDec_nat (α := α) (n := 1) (by norm_num); simpa using this
  have t1 : Lits.toInt? (fin 1 : α) = some 1 := by
    have := toInt_nat (α := α) 1; simpa using this
  have hi : indices 1 (n : ℤ) = (List.range n).map (fun i : ℕ => (1 : ℤ) + (i : ℤ)) := by
    simp [indices]
  simp only [sumA, eval, o1, hnE]
  simp only [asNum, asInt, t1, toInt_nat, bind, Except.bind, pure, Except.pure, hi]
  rw [foldlM_count _ f n hn hf ?_ n le_rfl]
  intro s j h1 h2 h3
  have hj : (Lits.ofDec ((1 : ℤ) + ((j - 1 : ℕ) : ℤ)) 0 : α) = fin (j : ℝ) := by
    have e : (1 : ℤ) + ((j - 1 : ℕ) : ℤ) = (j : ℤ) := by omega
    rw [e]; exact ofDec_nat (by omega)
  simp only [hj, hbody j h1 h2, faqStep, asNum, bind, Except.bind, pure, Except.pure, add_nat h3]

theorem ev_ix_var {k : String} {v : Val α} : eval (.var k) ((k, v) :: env) = .ok v :=
  ev_lookup _ (by simp)

/-- `count_{k ∈ [1,n]}(index(axis,k) <= q)` is the mirror's `countLe`. -/
theorem ev_count {axis q : Ast} {k : String} {n : ℕ} {A : List α} {qv : α}
    (hn : n ≤ 2 ^ 53) (hA : n ≤ A.length)
    (hax : ∀ v, eval axis ((k, v) :: env) = .ok (.arr1 A))
    (hq : ∀ v, eval q ((k, v) :: env) = .ok (.num qv)) :
    eval (countA axis q k (.num (n : ℤ) 0)) env = .ok (.num (fin (countLe A qv n : ℝ))) := by
  unfold countA countLe
  refine ev_sum hn (ev_nat env hn) (f := fun j => if le (Template.ix A j) qv then 1 else 0)
    (fun j => by split <;> omega) ?_
  intro j h1 h2
  rw [ev_ifelse (ev_le (ev_index1 (hax _) ev_ix_var h1 (by omega)) (hq _))]
  cases le (Template.ix A j) qv
  · simpa using ev_zero (α := α) _
  · simpa using ev_one (α := α) _

/-- `min(max(count, 1), n - 1)` is the mirror's `cellIdx`. -/
theorem ev_cell {axis q : Ast} {k : String} {n : ℕ} {A : List α} {qv : α}
    (h1 : 1 ≤ n) (hn : n ≤ 2 ^ 53) (hA : n ≤ A.length)
    (hax : ∀ v, eval axis ((k, v) :: env) = .ok (.arr1 A))
    (hq : ∀ v, eval q ((k, v) :: env) = .ok (.num qv)) :
    eval (cellA axis q k (.num (n : ℤ) 0)) env = .ok (.num (fin (cellIdx A qv n : ℝ))) := by
  unfold cellA cellIdx
  rw [ev_min (ev_max (ev_count hn hA hax hq) (ev_one env)) (ev_pred h1 hn)]
  push_cast [Nat.cast_min, Nat.cast_max, Nat.cast_sub h1]
  rfl

theorem cellIdx_bounds (A : List α) (q : α) {n : ℕ} (h : 2 ≤ n) :
    1 ≤ cellIdx A q n ∧ cellIdx A q n ≤ n - 1 := by
  unfold cellIdx; omega

end Eval

/-! ## The three templates, evaluated -/

section Templates

variable {α : Type} [Scalar α] [RealNaN α] [Lits α] [Elem α] [ExprLaws α]

/-- The expanded `searchsorted` evaluates to the mirror `Template.searchsorted`. -/
theorem ev_searchsorted (A : List α) (x : α) (h53 : A.length < 2 ^ 53) :
    eval (searchsortedA (.var "X") (.var "A") (.num (A.length : ℤ) 0))
        [("A", .arr1 A), ("X", .num x)] =
      .ok (.num (fin (Template.searchsorted x A A.length : ℝ))) := by
  set env : Env α := [("A", .arr1 A), ("X", .num x)]
  have hs : eval (sumA "k_ss" (.num (A.length : ℤ) 0)
      (.node "ifelse" [.node ">=" [ixA (.var "A") [.var "k_ss"], .var "X"], .num 0 0, .num 1 0])
      [.var "A"]) env =
      .ok (.num (fin (faqSum A.length (fun k => if le x (Template.ix A k) then 0 else 1) : ℝ))) := by
    refine ev_sum h53.le (ev_nat env h53.le) (fun j => by split <;> omega) ?_
    intro j h1 h2
    have eA : eval (.var "A") (("k_ss", Val.num (fin (j : ℝ))) :: env) = .ok (.arr1 A) :=
      ev_lookup _ rfl
    have eX : eval (.var "X") (("k_ss", Val.num (fin (j : ℝ))) :: env) = .ok (.num x) :=
      ev_lookup _ rfl
    rw [ev_ifelse (ev_ge (ev_index1 eA ev_ix_var h1 h2) eX)]
    cases le x (Template.ix A j)
    · simpa using ev_one (α := α) _
    · simpa using ev_zero (α := α) _
  have hle := faqSum_le A.length (fun k => if le x (Template.ix A k) then 0 else 1)
    (fun j => by split <;> omega)
  unfold searchsortedA Template.searchsorted
  rw [ev_add (ev_lit1 env) hs, add_nat (by omega)]

/-- The expanded `linear` evaluates to the mirror `Template.linear`. -/
theorem ev_linear (t A : List α) (x : α) (n : ℕ) (h2 : 2 ≤ n) (h53 : n ≤ 2 ^ 53)
    (ht : t.length = n) (hA : A.length = n) :
    eval (linearA (.var "T") (.var "A") (.var "X") (.num (n : ℤ) 0))
        [("T", .arr1 t), ("A", .arr1 A), ("X", .num x)] =
      .ok (.num (Template.linear t A x n)) := by
  set env : Env α := [("T", .arr1 t), ("A", .arr1 A), ("X", .num x)]
  have eT : eval (.var "T") env = .ok (.arr1 t) := ev_lookup _ rfl
  have eA : eval (.var "A") env = .ok (.arr1 A) := ev_lookup _ rfl
  have eX : eval (.var "X") env = .ok (.num x) := ev_lookup _ rfl
  have hc := ev_cell (env := env) (k := "k_lin") (axis := .var "A") (q := .var "X") (A := A)
    (qv := x) (by omega) h53 (by omega) (fun v => ev_lookup _ rfl)
    (fun v => ev_lookup _ rfl)
  obtain ⟨c1, c2⟩ := cellIdx_bounds A x h2
  have hs := ev_succ hc (by omega)
  have e1 := ev_nat env (n := 1) (by norm_num)
  have en := ev_nat env h53
  unfold linearA Template.linear
  rw [ev_ifelse (ev_le eX (ev_index1 eA (ev_lit1 env) le_rfl (by omega)))]
  by_cases b1 : le x (Template.ix A 1) = true
  · rw [ite_eq_left b1, ite_eq_left b1]
    exact ev_index1 eT (ev_lit1 env) le_rfl (by omega)
  rw [ite_eq_right b1, ite_eq_right b1, ev_ifelse (ev_ge eX (ev_index1 eA en (by omega) (by omega)))]
  by_cases b2 : le (Template.ix A n) x = true
  · rw [ite_eq_left b2, ite_eq_left b2]
    exact ev_index1 eT en (by omega) (by omega)
  rw [ite_eq_right b2, ite_eq_right b2]
  exact ev_blend (ev_index1 eT hc c1 (by omega)) (ev_index1 eT hs (by omega) (by omega))
    (ev_weight eX (ev_index1 eA hc c1 (by omega)) (ev_index1 eA hs (by omega) (by omega)))

/-- `clamp` of the `bilinear` template is the mirror's clamped query. -/
theorem ev_clamp {env : Env α} {x axis : Ast} {xv : α} {A : List α} {n : ℕ}
    (hx : eval x env = .ok (.num xv)) (hax : eval axis env = .ok (.arr1 A))
    (h1 : 1 ≤ n) (hn : n ≤ 2 ^ 53) (hA : n ≤ A.length) :
    eval (clampA x axis (.num (n : ℤ) 0)) env =
      .ok (.num (if le xv (Template.ix A 1) then Template.ix A 1
        else if le (Template.ix A n) xv then Template.ix A n else xv)) := by
  have en := ev_nat env hn
  unfold clampA
  rw [ev_ifelse (ev_le hx (ev_index1 hax (ev_lit1 env) le_rfl (by omega)))]
  by_cases b1 : le xv (Template.ix A 1) = true
  · rw [ite_eq_left b1, ite_eq_left b1]
    exact ev_index1 hax (ev_lit1 env) le_rfl (by omega)
  rw [ite_eq_right b1, ite_eq_right b1, ev_ifelse (ev_ge hx (ev_index1 hax en h1 hA))]
  by_cases b2 : le (Template.ix A n) xv = true
  · rw [ite_eq_left b2, ite_eq_left b2]
    exact ev_index1 hax en h1 hA
  · rw [ite_eq_right b2, ite_eq_right b2]; exact hx

/-- The expanded `bilinear` evaluates to the mirror `Template.bilinear`. -/
theorem ev_bilinear (T : List (List α)) (AX AY : List α) (x y : α) (nx ny : ℕ)
    (hx2 : 2 ≤ nx) (hy2 : 2 ≤ ny) (hx53 : nx ≤ 2 ^ 53) (hy53 : ny ≤ 2 ^ 53)
    (hAX : AX.length = nx) (hAY : AY.length = ny) (hT : T.length = nx)
    (hrows : ∀ row ∈ T, row.length = ny) :
    eval (bilinearA (.var "T") (.var "AX") (.var "AY") (.var "X") (.var "Y")
        (.num (nx : ℤ) 0) (.num (ny : ℤ) 0))
        [("T", .arr2 T), ("AX", .arr1 AX), ("AY", .arr1 AY), ("X", .num x), ("Y", .num y)] =
      .ok (.num (Template.bilinear T AX AY x y nx ny)) := by
  set env : Env α :=
    [("T", .arr2 T), ("AX", .arr1 AX), ("AY", .arr1 AY), ("X", .num x), ("Y", .num y)]
  have eT : eval (.var "T") env = .ok (.arr2 T) := ev_lookup _ rfl
  have eAX : eval (.var "AX") env = .ok (.arr1 AX) := ev_lookup _ rfl
  have eAY : eval (.var "AY") env = .ok (.arr1 AY) := ev_lookup _ rfl
  simp only [Template.bilinear]
  set xq := (if le x (Template.ix AX 1) then Template.ix AX 1
    else if le (Template.ix AX nx) x then Template.ix AX nx else x) with hxq
  set yq := (if le y (Template.ix AY 1) then Template.ix AY 1
    else if le (Template.ix AY ny) y then Template.ix AY ny else y) with hyq
  have cx : ∀ e : Env α, eval (.var "X") e = .ok (.num x) → eval (.var "AX") e = .ok (.arr1 AX) →
      eval (clampA (.var "X") (.var "AX") (.num (nx : ℤ) 0)) e = .ok (.num xq) :=
    fun e h1 h2 => ev_clamp h1 h2 (by omega) hx53 (by omega)
  have cy : ∀ e : Env α, eval (.var "Y") e = .ok (.num y) → eval (.var "AY") e = .ok (.arr1 AY) →
      eval (clampA (.var "Y") (.var "AY") (.num (ny : ℤ) 0)) e = .ok (.num yq) :=
    fun e h1 h2 => ev_clamp h1 h2 (by omega) hy53 (by omega)
  have exq := cx env (ev_lookup _ rfl) eAX
  have eyq := cy env (ev_lookup _ rfl) eAY
  have hi := ev_cell (env := env) (k := "k_bx") (axis := .var "AX")
    (q := clampA (.var "X") (.var "AX") (.num (nx : ℤ) 0)) (A := AX) (qv := xq)
    (by omega) hx53 (by omega) (fun v => ev_lookup _ rfl)
    (fun v => cx _ (ev_lookup _ rfl) (ev_lookup _ rfl))
  have hj := ev_cell (env := env) (k := "k_by") (axis := .var "AY")
    (q := clampA (.var "Y") (.var "AY") (.num (ny : ℤ) 0)) (A := AY) (qv := yq)
    (by omega) hy53 (by omega) (fun v => ev_lookup _ rfl)
    (fun v => cy _ (ev_lookup _ rfl) (ev_lookup _ rfl))
  obtain ⟨i1, i2⟩ := cellIdx_bounds AX xq hx2
  obtain ⟨j1, j2⟩ := cellIdx_bounds AY yq hy2
  have hsi := ev_succ hi (by omega)
  have hsj := ev_succ hj (by omega)
  have rl : ∀ p, 1 ≤ p → p ≤ nx → (T.getD (p - 1) []).length = ny := by
    intro p h1 h2
    apply hrows
    rw [List.getD_eq_getElem _ _ (by omega)]
    exact List.getElem_mem _
  have ix2 : ∀ {pE qE : Ast} {p q : ℕ}, eval pE env = .ok (.num (fin (p : ℝ))) →
      eval qE env = .ok (.num (fin (q : ℝ))) → 1 ≤ p → p ≤ nx → 1 ≤ q → q ≤ ny →
      eval (ixA (.var "T") [pE, qE]) env = .ok (.num (Template.ix2 T p q)) :=
    fun hp hq h1 h2 h3 h4 => ev_index2 eT hp hq h1 (by omega) h3 (by rw [rl _ h1 h2]; exact h4)
  have wx := ev_weight exq (ev_index1 eAX hi i1 (by omega)) (ev_index1 eAX hsi (by omega) (by omega))
  have wy := ev_weight eyq (ev_index1 eAY hj j1 (by omega)) (ev_index1 eAY hsj (by omega) (by omega))
  exact ev_blend
    (ev_blend (ix2 hi hj i1 (by omega) j1 (by omega)) (ix2 hsi hj (by omega) (by omega) j1 (by omega)) wx)
    (ev_blend (ix2 hi hsj i1 (by omega) (by omega) (by omega))
      (ix2 hsi hsj (by omega) (by omega) (by omega) (by omega)) wx) wy

end Templates

/-! ## Applying the templates of `lib/interp.esm` -/

section Apply

variable {α : Type} [Scalar α] [RealNaN α] [Lits α] [Elem α] [ExprLaws α]

theorem evalApply_of {t : Esm.Expr.Template} {σ : Bindings} {a : Ast} {env : Env α} {v : Val α}
    (he : expand t σ = .ok a) (hv : eval a env = .ok v) : evalApply t σ env = .ok v := by
  simp [evalApply, he, hv]

/-- **§9.2 `interp.searchsorted` is the `searchsorted` template of
`lib/interp.esm`.** Applied with the query bound to `X`, a non-decreasing axis
`xs` bound to `A` and `n = |xs|`, the expansion evaluates to the primitive's
result for every query, NaN included, and for `n = 0`. -/
theorem searchsorted_template_eq (a : List ℝ) (ha : a.Pairwise (· ≤ ·)) (h53 : a.length < 2 ^ 53)
    (x : α) :
    evalApply Esm.Lib.Interp.searchsorted
        [("x", .var "X"), ("xs", .var "A"), ("n", .num (a.length : ℤ) 0)]
        [("A", .arr1 (a.map fin)), ("X", .num x)] =
      .ok (.num (fin (Esm.Closed.searchsorted x (a.map fin) : ℝ))) := by
  have h := ev_searchsorted (a.map (fin : ℝ → α)) x (by simpa using h53)
  rw [List.length_map] at h
  rw [evalApply_of (expand_searchsorted a.length) h, Template.searchsorted_eq a ha x]

/-- **§9.2 `interp.linear` is the `linear` template of `lib/interp.esm`.** On a
non-decreasing axis of `2 ≤ n ≤ 2^53` knots (so every strictly increasing
one) and a table of the same length, the evaluated expansion equals the
primitive for every query, NaN included; at `Bin64`, bit for bit. -/
theorem linear_template_eq (t : List α) (a : List ℝ) (ha : a.Pairwise (· ≤ ·))
    (hn : 2 ≤ a.length) (h53 : a.length ≤ 2 ^ 53) (ht : t.length = a.length) (x : α) :
    evalApply Esm.Lib.Interp.linear
        [("table", .var "T"), ("axis", .var "A"), ("x", .var "X"), ("n", .num (a.length : ℤ) 0)]
        [("T", .arr1 t), ("A", .arr1 (a.map fin)), ("X", .num x)] =
      .ok (.num (Esm.Closed.linear t (a.map fin) x)) := by
  rw [evalApply_of (expand_linear a.length)
    (ev_linear t (a.map fin) x a.length hn h53 ht (by simp)), Template.linear_eq t a ha hn x]

/-- **§9.2 `interp.bilinear` is the `bilinear` template of `lib/interp.esm`.**
On non-decreasing axes of `2 ≤ n ≤ 2^53` knots each and a table of the
validated shape (`nx` rows of `ny` entries), the evaluated expansion equals the
primitive for every query, NaN in either coordinate included; at `Bin64`, bit
for bit. -/
theorem bilinear_template_eq (T : List (List α)) (ax ay : List ℝ) (hax : ax.Pairwise (· ≤ ·))
    (hay : ay.Pairwise (· ≤ ·)) (hx : 2 ≤ ax.length) (hy : 2 ≤ ay.length)
    (hx53 : ax.length ≤ 2 ^ 53) (hy53 : ay.length ≤ 2 ^ 53) (hT : T.length = ax.length)
    (hrows : ∀ row ∈ T, row.length = ay.length) (x y : α) :
    evalApply Esm.Lib.Interp.bilinear
        [("table", .var "T"), ("axis_x", .var "AX"), ("axis_y", .var "AY"), ("x", .var "X"),
          ("y", .var "Y"), ("nx", .num (ax.length : ℤ) 0), ("ny", .num (ay.length : ℤ) 0)]
        [("T", .arr2 T), ("AX", .arr1 (ax.map fin)), ("AY", .arr1 (ay.map fin)), ("X", .num x),
          ("Y", .num y)] =
      .ok (.num (Esm.Closed.bilinear T (ax.map fin) (ay.map fin) x y)) := by
  rw [evalApply_of (expand_bilinear ax.length ay.length)
    (ev_bilinear T (ax.map fin) (ay.map fin) x y ax.length ay.length hx hy hx53 hy53 (by simp)
      (by simp) hT hrows), Template.bilinear_eq T ax ay hax hay hx hy x y]

end Apply

/-! ## Binary64: the Q-6 bounds, about the evaluated templates -/

section Binary64

open Esm.F64 Esm.Closed.Rounding

/-- **Q-6 for the `linear` template, evaluated.** In binary64 (`Bin64`), on a
strictly increasing axis of at most `2^53` knots, a binary64 table of the same
length and a query inside cell `i` above the first knot, the evaluated
expansion is exactly the pinned `blend64` with the pinned `weight64`, within
`2 · ulp(max(|t_i|, |t_{i+1}|))` of the FMA blend. -/
theorem linear_template_fma_le_two_ulp (u a : List ℝ) (ha : a.Pairwise (· < ·))
    (hlen : u.length = a.length) (h53 : a.length ≤ 2 ^ 53) (i : ℕ) (x : ℝ)
    (hi : i + 1 < a.length) (h0 : a.getD 0 0 < x) (h1 : a.getD i 0 ≤ x)
    (h2 : x < a.getD (i + 1) 0) (hu0 : Repr (u.getD i 0)) (hu1 : Repr (u.getD (i + 1) 0)) :
    evalApply Esm.Lib.Interp.linear
        [("table", .var "T"), ("axis", .var "A"), ("x", .var "X"), ("n", .num (a.length : ℤ) 0)]
        [("T", .arr1 (u.map Bin64.fin)), ("A", .arr1 (a.map Bin64.fin)),
          ("X", .num (Bin64.fin x))] =
        .ok (.num (Bin64.fin (blend64 (u.getD i 0) (u.getD (i + 1) 0)
          (weight64 x (a.getD i 0) (a.getD (i + 1) 0))))) ∧
      |blend64 (u.getD i 0) (u.getD (i + 1) 0) (weight64 x (a.getD i 0) (a.getD (i + 1) 0)) -
          blendFMA (u.getD i 0) (u.getD (i + 1) 0) (weight64 x (a.getD i 0) (a.getD (i + 1) 0))| ≤
        2 * ulp (max |u.getD i 0| |u.getD (i + 1) 0|) := by
  obtain ⟨e, b⟩ := Template.linear64_fma_le_two_ulp u a ha hlen i x hi h0 h1 h2 hu0 hu1
  refine ⟨?_, b⟩
  rw [evalApply_of (expand_linear a.length)
    (ev_linear (α := Bin64) (u.map Bin64.fin) (a.map Bin64.fin) (Bin64.fin x) a.length
      (by omega) h53 (by simp [hlen]) (by simp)), e]

/-- **Q-6 for the `bilinear` template, evaluated.** In binary64, on strictly
increasing axes of at most `2^53` knots, a binary64 table of the validated
shape and a query in cell `(i, j)`, the evaluated expansion is exactly the
pinned `bilinear64` with the pinned weights, within `17/2 · ulp(max |corner|)`
of the all-FMA evaluation. -/
theorem bilinear_template_fma_le (U : List (List ℝ)) (ax ay : List ℝ)
    (hax : ax.Pairwise (· < ·)) (hay : ay.Pairwise (· < ·)) (hU : TableShape U ax.length ay.length)
    (hx53 : ax.length ≤ 2 ^ 53) (hy53 : ay.length ≤ 2 ^ 53) (i j : ℕ) (x y : ℝ)
    (hi : InCell ax i x) (hj : InCell ay j y)
    (h00 : Repr (rentry U i j)) (h10 : Repr (rentry U (i + 1) j))
    (h01 : Repr (rentry U i (j + 1))) (h11 : Repr (rentry U (i + 1) (j + 1))) :
    let wx := weight64 x (ax.getD i 0) (ax.getD (i + 1) 0)
    let wy := weight64 y (ay.getD j 0) (ay.getD (j + 1) 0)
    let c := bilinear64 (rentry U i j) (rentry U (i + 1) j) (rentry U i (j + 1))
      (rentry U (i + 1) (j + 1)) wx wy
    evalApply Esm.Lib.Interp.bilinear
        [("table", .var "T"), ("axis_x", .var "AX"), ("axis_y", .var "AY"), ("x", .var "X"),
          ("y", .var "Y"), ("nx", .num (ax.length : ℤ) 0), ("ny", .num (ay.length : ℤ) 0)]
        [("T", .arr2 (U.map (List.map Bin64.fin))), ("AX", .arr1 (ax.map Bin64.fin)),
          ("AY", .arr1 (ay.map Bin64.fin)), ("X", .num (Bin64.fin x)),
          ("Y", .num (Bin64.fin y))] = .ok (.num (Bin64.fin c)) ∧
      |c - bilinearFMA (rentry U i j) (rentry U (i + 1) j) (rentry U i (j + 1))
          (rentry U (i + 1) (j + 1)) wx wy| ≤
        17 / 2 * ulp (max (max |rentry U i j| |rentry U (i + 1) j|)
          (max |rentry U i (j + 1)| |rentry U (i + 1) (j + 1)|)) := by
  intro wx wy c
  obtain ⟨e, b⟩ := Template.bilinear64_fma_le U ax ay hax hay hU i j x y hi hj h00 h10 h01 h11
  refine ⟨?_, b⟩
  have hx : 2 ≤ ax.length := by have := hi.1; omega
  have hy : 2 ≤ ay.length := by have := hj.1; omega
  rw [evalApply_of (expand_bilinear ax.length ay.length)
    (ev_bilinear (α := Bin64) (U.map (List.map Bin64.fin)) (ax.map Bin64.fin) (ay.map Bin64.fin)
      (Bin64.fin x) (Bin64.fin y) ax.length ay.length hx hy hx53 hy53 (by simp) (by simp)
      (by simp [hU.1]) (by
        intro row hrow
        obtain ⟨r, hr, rfl⟩ := List.mem_map.mp hrow
        simp [hU.2 r hr])), e]

end Binary64

end Esm.Closed.TemplateAst
