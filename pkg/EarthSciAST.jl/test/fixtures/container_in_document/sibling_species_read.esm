{
 "esm": "1.0.0",
 "metadata": {
  "name": "GapBPlainRead",
  "description": "Variant: the sibling model READS a species directly (conc_A = Rs.A) with no D. Isolates whether the missing variable-dictionary entry is specific to the D(species, t) form.",
  "license": "MIT"
 },
 "reaction_systems": {
  "Rs": {
   "species": {
    "A": {
     "units": "mol/m^3",
     "default": 2.0,
     "description": "Substrate of R1."
    },
    "B": {
     "units": "mol/m^3",
     "default": 3.0,
     "description": "Substrate of R2."
    },
    "P": {
     "units": "mol/m^3",
     "default": 0.0,
     "description": "Product-only species: appears as a product in R1 and R2 and as a substrate nowhere."
    }
   },
   "parameters": {
    "k1": {
     "units": "1/s",
     "default": 0.5,
     "description": "Rate coefficient of R1."
    },
    "k2": {
     "units": "1/s",
     "default": 0.25,
     "description": "Rate coefficient of R2."
    }
   },
   "reactions": [
    {
     "id": "R1",
     "substrates": [
      {
       "species": "A",
       "stoichiometry": 1
      }
     ],
     "products": [
      {
       "species": "P",
       "stoichiometry": 1
      }
     ],
     "rate": "k1"
    },
    {
     "id": "R2",
     "substrates": [
      {
       "species": "B",
       "stoichiometry": 1
      }
     ],
     "products": [
      {
       "species": "P",
       "stoichiometry": 2
      }
     ],
     "rate": "k2"
    }
   ]
  }
 },
 "models": {
  "Reader": {
   "variables": {
    "conc_A": {
     "type": "unknown",
     "units": "mol/m^3",
     "description": "A copy of the substrate concentration A."
    }
   },
   "equations": [
    {
     "lhs": "conc_A",
     "rhs": "Rs.A"
    }
   ],
   "tests": [
    {
     "id": "plain_read_at_t0",
     "description": "A = 2 at t = 0, so conc_A = 2.",
     "time_span": {
      "start": 0,
      "end": 1
     },
     "tolerance": {
      "rel": 1e-09
     },
     "initial_conditions": {
      "Rs.A": 2.0,
      "Rs.B": 3.0,
      "Rs.P": 0.0
     },
     "assertions": [
      {
       "variable": "conc_A",
       "time": 0.0,
       "expected": 2.0
      }
     ]
    }
   ]
  }
 }
}