    "bilinear": {
      "params": [
        "table",
        "axis_x",
        "axis_y",
        "x",
        "y",
        "nx",
        "ny"
      ],
      "description": "2-D bilinear interpolation of the row-major `table` (nx rows of ny entries) over the strictly increasing axes `axis_x` (nx >= 2) and `axis_y` (ny >= 2). Each query is clamped to its axis, the cell index on each axis is the number of entries <= the clamped query held to [1, n - 1] (so a query on an interior knot k selects cell k), and the two x-blends, then the y-blend, are each the blend `linear` uses.",
      "body": {
        "op": "+",
        "args": [
          {
            "op": "+",
            "args": [
              {
                "op": "index",
                "args": [
                  "table",
                  {
                    "op": "min",
