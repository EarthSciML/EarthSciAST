{
  "esm": "2.0.0",
  "metadata": {
    "name": "Interp",
    "description": "Standard-library interpolation templates (esm-spec §9.7.1 template-library file). Three match-less expression templates give the pure-AST definitions of 1-D search, 1-D linear and 2-D bilinear interpolation, written with `faq` comparison counts, the `index` op and arithmetic: `searchsorted(x, xs, n)`, `linear(table, axis, x, n)` and `bilinear(table, axis_x, axis_y, x, y, nx, ny)`. Each axis length is an explicit integer parameter. Import with `expression_template_imports` and invoke with `apply_expression_template`; see docs/content/standard_library.md.",
    "authors": [
      "EarthSciML"
    ],
    "created": "2026-04-25T00:00:00Z",
    "tags": [
      "standard-library",
      "interpolation",
      "searchsorted",
      "expression-templates"
    ],
    "references": [
      {
        "citation": "esm-spec.md §9.6 (expression templates); §9.7.1 (template-library files); §4.3.3 (index op)."
      }
    ]
  },
  "expression_templates": {
    "searchsorted": {
      "params": [
        "x",
        "xs",
        "n"
      ],
      "description": "1-based index of the first entry of the non-decreasing axis `xs` (n entries) that is >= x: 1 plus the number of entries for which `xs[k] >= x` is false. Equal entries give the smallest such index, x above every entry (or NaN) gives n + 1, and n = 0 gives 1.",
      "body": {
        "op": "+",
        "args": [
          1,
          {
            "op": "faq",
            "args": [
              "xs"
            ],
            "output_idx": [],
            "reduce": "+",
            "ranges": {
              "k_ss": [
                1,
                "n"
              ]
            },
            "expr": {
              "op": "ifelse",
              "args": [
                {
                  "op": ">=",
                  "args": [
                    {
                      "op": "index",
                      "args": [
                        "xs",
                        "k_ss"
                      ]
                    },
                    "x"
                  ]
                },
                0,
                1
              ]
            }
          }
        ]
      }
    },
    "linear": {
      "params": [
        "table",
        "axis",
        "x",
        "n"
      ],
      "description": "1-D linear interpolation of `table` over the strictly increasing `axis` (both n >= 2 entries) at x, flat outside the axis. The cell index is the number of axis entries <= x held to [1, n - 1]; the blend is table[i] + w * (table[i+1] - table[i]) with w = (x - axis[i]) / (axis[i+1] - axis[i]), evaluated in that order. NaN x gives NaN.",
      "body": {
        "op": "ifelse",
        "args": [
          {
            "op": "<=",
            "args": [
              "x",
              {
                "op": "index",
                "args": [
                  "axis",
                  1
                ]
              }
            ]
          },
          {
            "op": "index",
            "args": [
              "table",
              1
            ]
          },
          {
            "op": "ifelse",
            "args": [
              {
                "op": ">=",
                "args": [
                  "x",
                  {
                    "op": "index",
