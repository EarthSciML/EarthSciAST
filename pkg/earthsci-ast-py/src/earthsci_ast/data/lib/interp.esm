                                                  "args": [
                                                    "axis_x",
                                                    "nx"
                                                  ]
                                                }
                                              ]
                                            },
                                            {
                                              "op": "index",
                                              "args": [
                                                "axis_x",
                                                "nx"
                                              ]
                                            },
                                            "x"
                                          ]
                                        }
                                      ]
                                    }
                                  ]
                                },
                                1,
                                0
                              ]
                            }
                          },
                          1
                        ]
