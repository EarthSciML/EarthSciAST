{
  "esm": "1.0.0",
  "metadata": {
    "name": "loader_consumer_injection",
    "description": "Data-source -> consumer fixture (esm-spec §8.5). Two document-scoped data sources: 'pl' (temporal grid -> discrete cadence) supplying wind 'U', and 'sfc' (static -> const cadence) supplying roughness 'Z0'. From 1.0.0 a data source is a registry entry, not a component, so there is no loader model and no coupling edge: model 'Plume' declares the parameters 'wind' and 'rough' directly, each with an `update` naming its source, and integrates D(c) = wind[2] + rough[2] - c. Run through simulate() with a deterministic loader_provider so the trajectory is analytic and network-free; the discrete source refreshes via terminal-event segmentation, the static source is read once."
  },
  "index_sets": {
    "met_cells": {
      "kind": "interval",
      "size": 3
    }
  },
  "data_sources": {
    "pl": {
      "kind": "grid",
      "source": {"url_template": "file:///met/{date:%Y%m%d}.nc"},
      "temporal": {"frequency": "PT1S", "start": "2018-01-01"}
    },
    "sfc": {
      "kind": "static",
      "source": {"url_template": "file:///met/z0.nc"}
    }
  },
  "models": {
    "Plume": {
      "variables": {
        "c": {"type": "unknown", "default": 0.0, "description": "tracer concentration"},
        "wind": {
          "type": "parameter",
          "units": "m/s",
          "default": 0.0,
          "shape": ["met_cells"],
          "update": {"kind": "data", "source": "pl", "from": {"file_variable": "U"}},
          "description": "eastward wind forcing, read from the 'pl' data source"
        },
        "rough": {
          "type": "parameter",
          "units": "m",
          "default": 0.0,
          "shape": ["met_cells"],
          "update": {"kind": "data", "source": "sfc", "from": {"file_variable": "Z0"}},
          "description": "surface roughness length, read from the 'sfc' data source"
        }
      },
      "equations": [
        {
          "lhs": {"op": "D", "args": ["c"], "wrt": "t"},
          "rhs": {
            "op": "-",
            "args": [
              {
                "op": "+",
                "args": [
                  {"op": "index", "args": ["wind", 2]},
                  {"op": "index", "args": ["rough", 2]}
                ]
              },
              "c"
            ]
          }
        }
      ]
    }
  }
}
