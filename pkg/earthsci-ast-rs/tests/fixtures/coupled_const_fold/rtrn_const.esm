{
  "esm": "1.0.0",
  "metadata": {
    "name": "RtrnConstLeaf",
    "description": "Tail of the coupling chain: gathers a Planck-function row out of a table declared as a BARE `const` array, at an index computed from the coupled-in temperature. `T` is the coupling target; its declared default (161) is deliberately different from the coupled value (163) so a fold that reads the wrong one is visible rather than merely lucky.",
    "authors": ["EarthSciML Authors and Contributors"]
  },
  "models": {
    "Rtrn": {
      "variables": {
        "T": { "type": "parameter", "default": 161.0 },
        "totplnk": { "type": "unknown", "shape": ["tbl"] },
        "plnk": { "type": "unknown" },
        "flux": { "type": "unknown", "default": 0.0 }
      },
      "equations": [
        {
          "lhs": "totplnk",
          "rhs": {
            "op": "const",
            "args": [],
            "value": [10.0, 20.0, 30.0, 40.0, 50.0]
          }
        },
        {
          "lhs": "plnk",
          "rhs": {
            "op": "index",
            "args": ["totplnk", { "op": "-", "args": ["T", 159] }]
          }
        },
        { "lhs": { "op": "D", "args": ["flux"], "wrt": "t" }, "rhs": 0.0 }
      ],
      "tests": [
        {
          "id": "coupled_temperature_picks_the_right_table_row",
          "description": "The chain delivers T = 163, so the gather is totplnk[163-159] = totplnk[4] = 40. Reading the parameter's own default (161) would give 20; reading an unbound 0 would index -159 and raise E_TREEWALK_CONSTARRAY_OOB.",
          "time_span": { "start": 0.0, "end": 1.0 },
          "assertions": [{ "variable": "plnk", "time": 0.0, "expected": 40.0 }]
        }
      ]
    }
  }
}
