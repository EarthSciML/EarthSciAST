{
  "esm": "1.0.0",
  "metadata": {
    "name": "HostMountsJoinLeaf",
    "description": "Regression fixture: a relational leaf mounted as a NESTED §4.7 subsystem keeps its `join.on` key columns.\n\nThe array runtime's mount renames every mounted variable to `<key>.<name>` and rewrites the `Expr::Variable` references that read them. A `join.on` key column is a plain STRING on the aggregate node rather than a child expression (CONFORMANCE_SPEC §5.5.6), so before `rename_free_symbol` learned to carry the join names it was left naming the leaf's bare `left_key` / `right_key`, and the build died with\n\n  Unsupported feature 'value-equality join over data-derived columns': join key column 'left_key' does not resolve to a loop index of this aggregate\n\nThe scalar flatten path never had this hole (`flatten.rs::namespace_join_names`); the array path — `simulate_array/compile.rs::mount_subsystems` — did.\n\n`join_leaf.esm` passes standalone, which is what attributes a failure here to the mount rather than to the leaf. Reported by the downstream EPA MOVES port as finding F1.",
    "authors": ["EarthSciML Authors and Contributors"]
  },
  "index_sets": { "probe_rows": { "kind": "interval", "size": 2 } },
  "models": {
    "Host": {
      "variables": {
        "probe": { "type": "unknown", "shape": ["probe_rows"] },
        "doubled": { "type": "unknown" }
      },
      "equations": [
        { "lhs": "probe", "rhs": { "op": "const", "args": [], "value": [1, 2] } },
        { "lhs": "doubled", "rhs": { "op": "*", "args": [2.0, "Leaf.matchedPairCount"] } }
      ],
      "subsystems": { "Leaf": { "ref": "./join_leaf.esm" } },
      "tests": [
        { "id": "the_mounted_join_still_matches",
          "description": "2 x 2 = 4: the leaf's join matches two pairs, exactly as it does standalone.",
          "time_span": { "start": 0.0, "end": 0.0 },
          "assertions": [ { "variable": "doubled", "time": 0.0, "expected": 4.0 } ] }
      ]
    }
  }
}
