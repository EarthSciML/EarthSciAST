{
  "esm": "1.0.0",
  "metadata": {
    "name": "WRF_Fixture",
    "description": "EarthSciData.jl WRF loader expressed in the STAC-like DataSource schema. Corresponds to EarthSciData.jl src/wrf.jl — struct WRFFileSet (lines 4-37) with relpath (lines 39-45) and loadmetadata (lines 61-100+). The Julia loader asserts Lambert Conformal Conic projection (MAP_PROJ == 1) and reads the truelat1/truelat2/stand_lon attributes from the NetCDF file at runtime; the PROJ string below is constructed from those attributes and is captured here as the runtime-equivalent CRS.",
    "authors": [
      "ESM Rust binding acceptance suite"
    ],
    "tags": [
      "fixture",
      "earthscidata",
      "gt-0c7"
    ]
  },
  "data_sources": {
    "WRF_Regional": {
      "kind": "grid",
      "source": {
        "url_template": "https://data.rda.ucar.edu/d340000/{date:%Y%m}/wrfout_hourly_d01_{date:%Y-%m-%d}_{date:%H:%M:%S}.nc"
      },
      "temporal": {
        "file_period": "PT1H",
        "frequency": "PT1H",
        "records_per_file": 1,
        "time_variable": "time"
      },
      "reference": {
        "citation": "Skamarock et al., 2008: A Description of the Advanced Research WRF Version 3. NCAR Technical Note NCAR/TN-475+STR",
        "url": "https://rda.ucar.edu/datasets/ds340.0/"
      },
      "metadata": {
        "tags": [
          "meteorology",
          "reanalysis",
          "regional"
        ],
        "earthscidata_source": "src/wrf.jl",
        "earthscidata_struct": "WRFFileSet",
        "earthscidata_note": "CRS attributes (truelat1, truelat2, moad_cen_lat, stand_lon) are read from the NetCDF file at runtime; the example PROJ string is representative."
      }
    }
  },
  "models": {
    "fixture_stub": {
      "variables": {
        "x": {
          "type": "unknown",
          "units": "1",
          "default": 0.0
        },
        "U": {
          "type": "parameter",
          "units": "m/s",
          "default": 0.0,
          "shape": [],
          "update": {
            "kind": "data",
            "source": "WRF_Regional",
            "from": {
              "file_variable": "U"
            }
          },
          "description": "x-wind component on staggered grid"
        },
        "V": {
          "type": "parameter",
          "units": "m/s",
          "default": 0.0,
          "shape": [],
          "update": {
            "kind": "data",
            "source": "WRF_Regional",
            "from": {
              "file_variable": "V"
            }
          },
          "description": "y-wind component on staggered grid"
        },
        "T": {
          "type": "parameter",
          "units": "K",
          "default": 0.0,
          "shape": [],
          "update": {
            "kind": "data",
            "source": "WRF_Regional",
            "from": {
              "file_variable": "T"
            }
          },
          "description": "Perturbation potential temperature"
        },
        "P": {
          "type": "parameter",
          "units": "Pa",
          "default": 0.0,
          "shape": [],
          "update": {
            "kind": "data",
            "source": "WRF_Regional",
            "from": {
              "file_variable": "P"
            }
          },
          "description": "Perturbation pressure"
        },
        "QVAPOR": {
          "type": "parameter",
          "units": "kg/kg",
          "default": 0.0,
          "shape": [],
          "update": {
            "kind": "data",
            "source": "WRF_Regional",
            "from": {
              "file_variable": "QVAPOR"
            }
          },
          "description": "Water vapor mixing ratio"
        },
        "PBLH": {
          "type": "parameter",
          "units": "m",
          "default": 0.0,
          "shape": [],
          "update": {
            "kind": "data",
            "source": "WRF_Regional",
            "from": {
              "file_variable": "PBLH"
            }
          },
          "description": "Planetary boundary layer height"
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "x"
            ],
            "wrt": "t"
          },
          "rhs": 0.0
        }
      ]
    }
  }
}
