      "params": [
        "f",
        "p",
        "n"
      ],
      "description": "`argmax` over the candidates k in [1, n] for which the predicate `p` holds: the 1-based index of the largest `f` among them, the smallest such index on a tie, the first NaN index among them when one is NaN, and n + 1 when no candidate passes `p`. `f` and `p` are expressions over the loop symbol `k_argmax_where_1`; `p` is the `filter` of both reductions, so an excluded candidate never competes.",
      "body": {
        "op": "min",
        "args": [
          {
            "op": "faq",
            "args": [],
            "output_idx": [],
            "reduce": "min",
            "ranges": {
              "k_argmax_where_1": [
                1,
                "n"
              ]
            },
            "filter": "p",
            "expr": {
              "op": "ifelse",
              "args": [
                {
