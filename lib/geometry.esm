      "body": {"op":"apply_expression_template","args":[],"name":"geo_cross2","bindings":{"gc_ux":{"op":"-","args":["gs_bx","gs_ax"]},"gc_uy":{"op":"-","args":["gs_by","gs_ay"]},"gc_wx":{"op":"-","args":["gs_px","gs_ax"]},"gc_wy":{"op":"-","args":["gs_py","gs_ay"]}}}
    },
    "geo_l1": {
      "params": [
        "gl_x",
        "gl_y"
      ],
      "description": "The L1 norm |x| + |y|.",
      "body": {"op":"+","args":[{"op":"abs","args":["gl_x"]},{"op":"abs","args":["gl_y"]}]}
    },
    "geo_tol2": {
      "params": [
        "gt_px",
        "gt_py",
        "gt_qx",
        "gt_qy",
        "gt_ax",
        "gt_ay",
        "gt_bx",
        "gt_by"
      ],
      "description": "The planar on-the-line tolerance of edge p -> q against the half-plane of edge a -> b: L1(b - a) (L1(p) + L1(q) + L1(a)) 1e-12.",
      "body": {"op":"*","args":[{"op":"apply_expression_template","args":[],"name":"geo_l1","bindings":{"gl_x":{"op":"-","args":["gt_bx","gt_ax"]},"gl_y":{"op":"-","args":["gt_by","gt_ay"]}}},{"op":"+","args":[{"op":"apply_expression_template","args":[],"name":"geo_l1","bindings":{"gl_x":"gt_px","gl_y":"gt_py"}},{"op":"apply_expression_template","args":[],"name":"geo_l1","bindings":{"gl_x":"gt_qx","gl_y":"gt_qy"}},{"op":"apply_expression_template","args":[],"name":"geo_l1","bindings":{"gl_x":"gt_ax","gl_y":"gt_ay"}}]},1e-12]}
    },
    "geo_dot3": {
      "params": [
        "gd_ux",
        "gd_uy",
        "gd_uz",
        "gd_wx",
        "gd_wy",
        "gd_wz"
      ],
      "description": "The dot product u . w.",
      "body": {"op":"+","args":[{"op":"*","args":["gd_ux","gd_wx"]},{"op":"*","args":["gd_uy","gd_wy"]},{"op":"*","args":["gd_uz","gd_wz"]}]}
    },
