    "lonlat_to_unit": {
      "params": [
        "ring",
        "cell",
        "vert",
        "comp"
      ],
      "description": "Component `comp` (1, 2, 3 = x, y, z) of the unit vector of vertex `vert` of cell `cell` of the `[cells, verts, 2]` lon-lat ring stack `ring` (degrees): (cos(lat) cos(lon), cos(lat) sin(lon), sin(lat)), with degrees converted by the binary64 constant pi/180. Applied in a `faq` over cells, vertex slots and a 3-element component axis, it builds the `[cells, verts, 3]` stack `overlap_area_spherical` takes.",
      "body": {"op":"ifelse","args":[{"op":"==","args":["comp",1]},{"op":"*","args":[{"op":"cos","args":[{"op":"*","args":[{"op":"index","args":["ring","cell","vert",2]},0.017453292519943295]}]},{"op":"cos","args":[{"op":"*","args":[{"op":"index","args":["ring","cell","vert",1]},0.017453292519943295]}]}]},{"op":"ifelse","args":[{"op":"==","args":["comp",2]},{"op":"*","args":[{"op":"cos","args":[{"op":"*","args":[{"op":"index","args":["ring","cell","vert",2]},0.017453292519943295]}]},{"op":"sin","args":[{"op":"*","args":[{"op":"index","args":["ring","cell","vert",1]},0.017453292519943295]}]}]},{"op":"sin","args":[{"op":"*","args":[{"op":"index","args":["ring","cell","vert",2]},0.017453292519943295]}]}]}]}
    },
    "geo_next": {
      "params": [
        "gn_v",
        "gn_n"
      ],
      "description": "The vertex slot after `gn_v` in a ring of `gn_n` slots: gn_v + 1, wrapping to 1.",
      "body": {"op":"ifelse","args":[{"op":"<","args":["gn_v","gn_n"]},{"op":"+","args":["gn_v",1]},1]}
    },
