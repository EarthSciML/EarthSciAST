      "params": [
        "gc_ux",
        "gc_uy",
        "gc_wx",
        "gc_wy"
      ],
      "description": "The planar cross product u x w = ux wy - uy wx.",
      "body": {"op":"-","args":[{"op":"*","args":["gc_ux","gc_wy"]},{"op":"*","args":["gc_uy","gc_wx"]}]}
    },
    "geo_side2": {
      "params": [
