        "gh_ay",
        "gh_az",
        "gh_bx",
        "gh_by",
        "gh_bz"
      ],
      "description": "(a x b) . p: positive when p is left of the great circle a -> b.",
      "body": {"op":"apply_expression_template","args":[],"name":"geo_dot3","bindings":{"gd_ux":{"op":"-","args":[{"op":"*","args":["gh_ay","gh_bz"]},{"op":"*","args":["gh_az","gh_by"]}]},"gd_uy":{"op":"-","args":[{"op":"*","args":["gh_az","gh_bx"]},{"op":"*","args":["gh_ax","gh_bz"]}]},"gd_uz":{"op":"-","args":[{"op":"*","args":["gh_ax","gh_by"]},{"op":"*","args":["gh_ay","gh_bx"]}]},"gd_wx":"gh_px","gd_wy":"gh_py","gd_wz":"gh_pz"}}
    },
    "geo_sign": {
      "params": [
        "gg_x"
      ],
      "description": "The orientation sign of a fan sum: 1 when gg_x >= 0, else -1.",
      "body": {"op":"ifelse","args":[{"op":">=","args":["gg_x",0]},1,-1]}
    },
    "geo_t0": {
      "params": [
        "gb_g0",
        "gb_g1",
        "gb_s",
        "gb_tol",
        "gb_cl"
      ],
      "description": "The lower chord-parameter bound one closed half-plane imposes on an edge whose endpoints lie at signed distances s g0, s g1 (>= 0 inside; s is the half-plane polygon's orientation, which cancels from the root g0 / (g0 - g1)). A distance within `tol` of zero is on the line; both endpoints on the line make a collinear edge, whose bound is `cl` (0: no constraint, 1: excluded). An endpoint on the line enters at exactly that endpoint.",
      "body": {"op":"ifelse","args":[{"op":"and","args":[{"op":"<=","args":[{"op":"abs","args":["gb_g0"]},"gb_tol"]},{"op":"<=","args":[{"op":"abs","args":["gb_g1"]},"gb_tol"]}]},"gb_cl",{"op":"ifelse","args":[{"op":"<","args":[{"op":"*","args":["gb_s","gb_g0"]},{"op":"-","args":["gb_tol"]}]},{"op":"ifelse","args":[{"op":"<","args":[{"op":"*","args":["gb_s","gb_g1"]},{"op":"-","args":["gb_tol"]}]},1,{"op":"ifelse","args":[{"op":"<=","args":[{"op":"abs","args":["gb_g1"]},"gb_tol"]},1,{"op":"/","args":["gb_g0",{"op":"ifelse","args":[{"op":"==","args":["gb_g0","gb_g1"]},1,{"op":"-","args":["gb_g0","gb_g1"]}]}]}]}]},0]}]}
    },
    "geo_t1": {
      "params": [
        "gb_g0",
        "gb_g1",
        "gb_s",
        "gb_tol"
      ],
      "description": "The upper chord-parameter bound one closed half-plane imposes on an edge (see geo_t0); a collinear edge is not bounded above, and an endpoint on the line leaves at exactly that endpoint.",
      "body": {"op":"ifelse","args":[{"op":"and","args":[{"op":"<=","args":[{"op":"abs","args":["gb_g0"]},"gb_tol"]},{"op":"<=","args":[{"op":"abs","args":["gb_g1"]},"gb_tol"]}]},1,{"op":"ifelse","args":[{"op":"<","args":[{"op":"*","args":["gb_s","gb_g0"]},{"op":"-","args":["gb_tol"]}]},1,{"op":"ifelse","args":[{"op":"<","args":[{"op":"*","args":["gb_s","gb_g1"]},{"op":"-","args":["gb_tol"]}]},{"op":"ifelse","args":[{"op":"<=","args":[{"op":"abs","args":["gb_g0"]},"gb_tol"]},0,{"op":"/","args":["gb_g0",{"op":"ifelse","args":[{"op":"==","args":["gb_g0","gb_g1"]},1,{"op":"-","args":["gb_g0","gb_g1"]}]}]}]},1]}]}]}
    },
    "geo_contrib2": {
      "params": [
        "gp_s",
        "gp_t0",
        "gp_t1",
        "gp_px",
        "gp_py",
        "gp_qx",
        "gp_qy",
        "gp_ox",
        "gp_oy"
      ],
      "description": "A planar edge p -> q's contribution over the chord interval [t0, t1], about the origin o: s max(0, t1 - t0) ((p - o) x (q - o)) / 2, s the edge's polygon's orientation.",
      "body": {"op":"*","args":["gp_s",{"op":"max","args":[0,{"op":"-","args":["gp_t1","gp_t0"]}]},{"op":"apply_expression_template","args":[],"name":"geo_cross2","bindings":{"gc_ux":{"op":"-","args":["gp_px","gp_ox"]},"gc_uy":{"op":"-","args":["gp_py","gp_oy"]},"gc_wx":{"op":"-","args":["gp_qx","gp_ox"]},"gc_wy":{"op":"-","args":["gp_qy","gp_oy"]}}},0.5]}
    },
    "geo_vos": {
      "params": [
        "gv_t",
        "gv_tau",
        "gv_oa1",
        "gv_lin",
        "gv_dd"
      ],
      "description": "atan2 of the Van Oosterom-Strackee half-angle of the spherical triangle (o, a, x(t)), x(t) the point at chord parameter t on the edge a -> q: atan2(t tau, (1 + o.a)(|a + t d| + 1) + t (o.d + a.d)) with d = q - a, tau = o . (a x q), dd = d . d and |a + t d| = sqrt(1 - t (1 - t) dd).",
