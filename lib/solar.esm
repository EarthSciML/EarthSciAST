                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        },
        {
          "lhs": "equation_of_time",
          "rhs": {
            "op": "*",
            "args": [
              "eot_scale",
              {
                "op": "+",
                "args": [
                  7.5e-05,
                  {
                    "op": "*",
                    "args": [
                      0.001868,
                      {
                        "op": "cos",
                        "args": [
                          "gamma"
                        ]
                      }
                    ]
