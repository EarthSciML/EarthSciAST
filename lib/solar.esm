          "rhs": {
            "op": "+",
            "args": [
              {
                "op": "*",
                "args": [
                  "min_of_clock",
                  {
                    "op": "+",
                    "args": [
                      {
                        "op": "*",
                        "args": [
                          "hour",
                          60.0
                        ]
