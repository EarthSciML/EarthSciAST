{
  "esm": "1.0.0",
  "metadata": {"name": "SimpleDecay", "description": "Exponential decay with a known analytical solution", "authors": ["Chris Tessum"]},
  "models": {
    "ExponentialDecay": {
      "variables": {
        "N": {"type": "unknown", "units": "mol", "default": 100.0, "description": "Amount of decaying species"},
        "lambda": {"type": "parameter", "units": "1/s", "default": 0.1, "description": "Decay constant"}
      },
      "equations": [
        {"lhs": {"op": "D", "args": ["N"], "wrt": "t"}, "rhs": {"op": "*", "args": [{"op": "-", "args": ["lambda"]}, "N"]}}
      ]
    }
  }
}
