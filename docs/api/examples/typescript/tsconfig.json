{
  // Type-checks the examples against the built package's declarations.
  // `scripts/api_docs/typescript.sh` builds the package first.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "typeRoots": ["../../../../pkg/earthsci-ast-ts/node_modules/@types"],
    "types": ["node"],
    "paths": {
      "@earthsciml/ast": ["../../../../pkg/earthsci-ast-ts/dist/index.d.ts"]
    }
  },
  "include": ["*.ts"]
}
