    "julian_day": {
      "params": ["t"],
      "description": "Julian Date of the UTC instant t, exactly esm-spec §9.2's pinned binary64 formula (d + 2440588) + ((s - 43200) + (t - floor(t))) / 86400, evaluated in that order, with d = floor(floor(t) / 86400) the day number and s = floor(t) - 86400 d the whole second of the day. Finite t with |t| < 2^52 s; outside it, and for NaN or an infinite t, the value is NaN (0/0).",
      "body": {
        "op": "ifelse",
        "args": [
          {"op": "<", "args": [{"op": "abs", "args": ["t"]}, {"op": "const", "args": [], "value": 4503599627370496, "units": "s"}]},
          {
            "op": "+",
            "args": [
              {"op": "+", "args": [{"op": "floor", "args": [{"op": "/", "args": [{"op": "floor", "args": ["t"]}, {"op": "const", "args": [], "value": 86400, "units": "s"}]}]}, 2440588]},
              {
                "op": "/",
                "args": [
                  {"op": "+", "args": [{"op": "-", "args": [{"op": "-", "args": [{"op": "floor", "args": ["t"]}, {"op": "*", "args": [{"op": "const", "args": [], "value": 86400, "units": "s"}, {"op": "floor", "args": [{"op": "/", "args": [{"op": "floor", "args": ["t"]}, {"op": "const", "args": [], "value": 86400, "units": "s"}]}]}]}]}, {"op": "const", "args": [], "value": 43200, "units": "s"}]}, {"op": "-", "args": ["t", {"op": "floor", "args": ["t"]}]}]},
                  {"op": "const", "args": [], "value": 86400, "units": "s"}
                ]
              }
            ]
          },
          {"op": "/", "args": [0, 0]}
        ]
      }
    },
    "is_leap_year": {
      "params": ["t"],
      "description": "1 if the proleptic-Gregorian year of the UTC instant t is a leap year (divisible by 4, and not by 100 unless by 400), else 0, the value datetime.is_leap_year gives (esm-spec §9.2). The rule reads the year modulo 400: Hinnant's year of era yoe from March to December, yoe + 1 in January and February. Finite t with |t| < 2^52 s; outside it, and for NaN or an infinite t, the value is NaN (0/0).",
      "body": {
        "op": "ifelse",
