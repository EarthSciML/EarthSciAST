              {"op": "*", "args": [60, {"op": "floor", "args": [{"op": "/", "args": [{"op": "/", "args": [{"op": "-", "args": [{"op": "floor", "args": ["t"]}, {"op": "*", "args": [{"op": "const", "args": [], "value": 86400, "units": "s"}, {"op": "floor", "args": [{"op": "/", "args": [{"op": "floor", "args": ["t"]}, {"op": "const", "args": [], "value": 86400, "units": "s"}]}]}]}]}, {"op": "const", "args": [], "value": 1, "units": "s"}]}, 3600]}]}]}
