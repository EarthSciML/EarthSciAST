{
  "esm": "1.0.0",
  "metadata": {
    "name": "loader_temporal_seed",
    "description": "M3 cadence-partition fixture (RFC semiring-faq-unified-ir §6.1 + RFC pure-io-data-loaders §4.6; CONFORMANCE_SPEC.md §5.7.2; bead ess-v9a.5): the LOADER-SEEDED-DISCRETE path. A boundary-condition relaxation RHS D(c[i])/dt = bc[i] - c[i], where `c` is integrated state (CONTINUOUS) and `bc` is a parameter read from a data source. The model variable `bc` is declared a `parameter` whose `update` is `{kind: data, source: bc_loader}` with a `from` binding to the source's `boundary_o3` file variable, and that loader HAS a `temporal` block — so its outputs are time-varying: the partition seeds `bc` DISCRETE (it refreshes on each ingest event, piecewise-constant between them; the refresh trigger is the loader's update times derived from `temporal`). The discrete bc[i] gather feeds the CONTINUOUS subtraction, so it materializes at the DISCRETE->CONTINUOUS threshold (bind provenance — a loaded external resource): recomputed by the per-event handler when the loader advances to the next record, NOT folded once at compile. This is the matched-pair sibling of loader_const_seed.esm: the two models are IDENTICAL except this loader declares `temporal` and that one does not — the SAME `parameter`+`data`-update declaration therefore seeds DISCRETE here and CONST there, which is exactly the §4.6 'loader with temporal vs without' contract. Every node carries an `expect_cadence` assertion the partition pass checks against its derived class. Validates against the schema with no evaluator (the top-level `data_loaders` block is attached to the model at load so the pass can resolve the loader's `temporal`); the golden class summary + materialization set live in tests/conformance/cadence/manifest.json.",
    "authors": [
      "EarthSciAST/polecats/gastown.nux"
    ],
    "tags": [
      "cadence-partition",
      "source-seeded",
      "data-source",
      "temporal",
      "discrete-variable",
      "refresh-trigger",
      "data-ingest",
      "materialization-point",
      "conformance",
      "schema",
      "ess-v9a.5"
    ]
  },
  "index_sets": {
    "cells": {
      "kind": "interval",
      "size": 4
    }
  },
  "data_sources": {
    "bc_loader": {
      "kind": "grid",
      "source": {
        "url_template": "file:///data/bc/o3_{date:%Y%m%d%H}.nc"
      },
      "temporal": {
        "frequency": "PT6H",
        "file_period": "P1D",
        "records_per_file": 4
      }
    }
  },
  "models": {
    "LoaderTemporalSeed": {
      "variables": {
        "c": {
          "type": "unknown",
          "shape": [
            "cells"
          ],
          "description": "Integrated tracer concentration — CONTINUOUS cadence (changes every step)."
        },
        "bc": {
          "type": "parameter",
          "units": "mol/mol",
          "shape": [
            "cells"
          ],
          "description": "Boundary-condition field bound to the `bc_loader` data source (`from.file_variable: boundary_o3`). The source declares a `temporal` block, so this parameter is time-varying: DISCRETE cadence, refreshed on each ingest event (the refresh trigger is the source's record advance). Materialized into a per-event buffer (bind provenance), recomputed when the source advances to the next record.",
          "update": {
            "kind": "data",
            "source": "bc_loader",
            "from": {
              "file_variable": "boundary_o3"
            }
          }
        }
      },
      "equations": [
        {
          "_comment": "D(c[i])/dt = bc[i] - c[i]. Pointwise BC relaxation. bc[i] is DISCRETE (loader WITH temporal) and feeds the CONTINUOUS subtraction, so it materializes at the DISCRETE->CONTINUOUS threshold (per-event handler); the c-loads are CONTINUOUS (hot tree).",
          "lhs": {
            "op": "aggregate",
            "args": [],
            "output_idx": [
              "i"
            ],
            "expr": {
              "op": "D",
              "args": [
                {
                  "op": "index",
                  "args": [
                    "c",
                    "i"
                  ]
                }
              ],
              "wrt": "t"
            },
            "ranges": {
              "i": [
                1,
                4
              ]
            }
          },
          "rhs": {
            "op": "aggregate",
            "args": [],
            "output_idx": [
              "i"
            ],
            "expect_cadence": "continuous",
            "ranges": {
              "i": [
                1,
                4
              ]
            },
            "expr": {
              "op": "-",
              "expect_cadence": "continuous",
              "args": [
                {
                  "op": "index",
                  "args": [
                    "bc",
                    "i"
                  ],
                  "expect_cadence": "discrete"
                },
                {
                  "op": "index",
                  "args": [
                    "c",
                    "i"
                  ],
                  "expect_cadence": "continuous"
                }
              ]
            }
          }
        }
      ]
    }
  }
}
