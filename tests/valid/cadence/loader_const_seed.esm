{
  "esm": "1.0.0",
  "metadata": {
    "name": "loader_const_seed",
    "description": "M3 cadence-partition fixture (RFC semiring-faq-unified-ir 6.1; CONFORMANCE_SPEC.md 5.7.2; bead ess-v9a.5): the SOURCE-SEEDED-CONST path. The matched-pair sibling of loader_temporal_seed.esm -- the SAME boundary-condition relaxation RHS D(c[i])/dt = bc[i] - c[i] and the SAME `update: {kind: data, source: bc_loader}` declaration of the parameter `bc`, but the top-level data source `bc_loader` declares NO `temporal` block. A source without `temporal` describes non-time-varying data (`temporal` is optional; absence implies non-time-varying), so the partition REFINES the declared DISCRETE seed down to CONST: the field is loaded once and folds at bind (external-resource provenance), never refreshing. The const bc[i] gather feeds the CONTINUOUS subtraction, so it materializes at the CONST->CONTINUOUS threshold -- and because nothing is DISCRETE, the per-event handler is EMPTY (unlike the temporal sibling). This is the whole point of the bead: toggling the source's `temporal` block -- and nothing else -- flips the same source-fed parameter between DISCRETE and CONST, exactly matching 6.1. Every node carries an `expect_cadence` assertion the partition pass checks against its derived class. Validates against the schema with no evaluator; the golden class summary + materialization set live in tests/conformance/cadence/manifest.json.",
    "authors": [
      "EarthSciAST/polecats/gastown.nux"
    ],
    "tags": [
      "cadence-partition",
      "source-seeded",
      "data-source",
      "non-temporal",
      "discrete-variable",
      "refresh-trigger",
      "data-ingest",
      "bind-fold",
      "materialization-point",
      "conformance",
      "schema",
      "ess-v9a.5"
    ]
  },
  "index_sets": {
    "cells": {
      "kind": "interval",
      "size": 4
    }
  },
  "data_sources": {
    "bc_loader": {
      "kind": "grid",
      "source": {
        "url_template": "file:///data/bc/o3_climatology.nc"
      }
    }
  },
  "models": {
    "LoaderConstSeed": {
      "variables": {
        "c": {
          "type": "unknown",
          "shape": [
            "cells"
          ],
          "description": "Integrated tracer concentration — CONTINUOUS cadence (changes every step)."
        },
        "bc": {
          "type": "parameter",
          "units": "mol/mol",
          "shape": [
            "cells"
          ],
          "description": "Boundary-condition field bound to the `bc_loader` data source (`from.file_variable: boundary_o3`). The source declares NO `temporal` block, so the partition refines this `data` update down to CONST: loaded once and folded at bind (external-resource provenance), never refreshing. Declared with the SAME `update: {kind: data}` as the temporal sibling — the source's missing `temporal` is what makes the difference.",
          "update": {
            "kind": "data",
            "source": "bc_loader",
            "from": {
              "file_variable": "boundary_o3"
            }
          }
        }
      },
      "equations": [
        {
          "_comment": "D(c[i])/dt = bc[i] - c[i]. Identical to loader_temporal_seed.esm, but bc[i] is CONST (loader WITHOUT temporal): it folds at bind and feeds the CONTINUOUS subtraction at the CONST->CONTINUOUS threshold. No DISCRETE node anywhere, so the per-event handler is empty.",
          "lhs": {
            "op": "aggregate",
            "args": [],
            "output_idx": [
              "i"
            ],
            "expr": {
              "op": "D",
              "args": [
                {
                  "op": "index",
                  "args": [
                    "c",
                    "i"
                  ]
                }
              ],
              "wrt": "t"
            },
            "ranges": {
              "i": [
                1,
                4
              ]
            }
          },
          "rhs": {
            "op": "aggregate",
            "args": [],
            "output_idx": [
              "i"
            ],
            "expect_cadence": "continuous",
            "ranges": {
              "i": [
                1,
                4
              ]
            },
            "expr": {
              "op": "-",
              "expect_cadence": "continuous",
              "args": [
                {
                  "op": "index",
                  "args": [
                    "bc",
                    "i"
                  ],
                  "expect_cadence": "const"
                },
                {
                  "op": "index",
                  "args": [
                    "c",
                    "i"
                  ],
                  "expect_cadence": "continuous"
                }
              ]
            }
          }
        }
      ]
    }
  }
}
