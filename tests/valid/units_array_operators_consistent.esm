{
  "esm": "1.2.0",
  "metadata": {
    "name": "UnitsArrayOperatorsConsistent",
    "description": "esm-spec §4.8.3 array operators in the checker: index, reshape and transpose have their array's unit; broadcast has the unit of its fn applied to its operands; concat and makearray regions agree like + operands (a bare-literal region is skipped); an faq has its body's unit under sum_product and max_product, its body's unit under reduce * only for a pure-number body, and is dimensionless under bool_and_or; a filter is walked. Every declaration agrees, so the document must validate. The units_array_*_mismatch.esm fixtures in tests/invalid are the refusals.",
    "authors": [
      "EarthSciML Authors and Contributors"
    ],
    "created": "2026-10-16T00:00:00Z"
  },
  "index_sets": {
    "rows": {
      "kind": "interval",
      "size": 2
    },
    "one": {
      "kind": "interval",
      "size": 1
    },
    "cols": {
      "kind": "interval",
      "size": 3
    }
  },
  "models": {
