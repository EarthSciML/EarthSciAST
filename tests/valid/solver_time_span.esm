{
  "esm": "1.3.0",
  "metadata": {
    "name": "SolverTimeSpan",
    "description": "A `solver` block carrying `time_span` as two RFC 3339 UTC timestamps beside the other hints (esm-spec §2.2.7, esm 1.3.0).",
    "authors": [
      "EarthSciML Test Suite"
    ],
    "license": "MIT",
    "tags": [
      "solver",
      "time_span"
    ]
  },
  "solver": {
    "stiffness": "high",
    "reltol": 0.0001,
    "time_span": {
      "start": "2019-07-01T00:00:00Z",
      "end": "2019-07-03T00:00:00Z"
    }
  },
  "domain": {
    "temporal": {
      "reference_time": "2019-07-01T00:00:00Z"
    }
  },
  "models": {
    "Decay": {
      "variables": {
        "A": {
          "type": "unknown",
          "units": "mol/m^3",
          "default": 2.0
        },
        "k": {
          "type": "parameter",
          "units": "1/s",
          "default": 0.5
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "A"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "neg",
            "args": [
              {
                "op": "*",
                "args": [
                  "k",
                  "A"
                ]
              }
            ]
          }
        }
      ]
    }
  }
}
