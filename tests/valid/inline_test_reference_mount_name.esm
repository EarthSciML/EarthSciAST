{
  "esm": "1.1.0",
  "metadata": {
    "name": "InlineTestReferenceMountName",
    "description": "Valid: a §6.6.5 assertion `reference` naming a MOUNTED SUBSYSTEM's parameter by the mount-relative spelling its own equations use. `P` mounts the subsystem `sub`, whose parameter `g` the model's RHS reads as `sub.g`; the build flattens it to `P.sub.g`. The sibling model `R` mounts a `sub` of its own, so the bare suffixes `sub.g` and `g` are carried by TWO flattened names and are globally AMBIGUOUS — exactly the shape of a coupling document, where every mounted component carries its own copy of a shared constants subsystem. What makes `sub.g` unambiguous inside `P`'s test is the component that owns the test: `P.sub.g` is the one key under `P.`, so `sub.g` is `P`'s own, which is what `P`'s equations already resolve it to. `u` is 1 in every cell and never moves before t = 0, so the relative L2 error against the constant field `sub.g` = 2 is |1 - 2| / 2 = 1/2 exactly, and the uniform norm against `1.5 * sub.g` = 3 is 2 exactly — both in build-time arithmetic, with no solver in the loop. Test 1 spells the reference `sub.g` (the spelling that survives being mounted under another key); test 2 spells the same constant `P.sub.g` and must agree. Before issue #408 only the model-qualified spelling resolved: the assertion scope bound the flattened name plus its bare tail and nothing else, so `sub.g` raised an unbound-name error in the one position where the model's own equations resolve it.",
    "authors": [
      "EarthSciML"
    ],
    "license": "MIT",
    "created": "2026-09-17T00:00:00Z",
    "tags": [
      "inline-test",
      "esm-spec-6.6.5",
      "reference",
      "subsystem-mount",
      "issue-408"
    ]
  },
  "index_sets": {
    "x": {
      "kind": "interval",
      "size": 3
    }
  },
  "models": {
    "P": {
      "variables": {
        "u": {
          "type": "unknown",
          "units": "1",
          "default": 1.0,
          "shape": [
            "x"
          ],
          "description": "Field over x, uniformly 1 at t = 0."
        }
      },
      "subsystems": {
        "sub": {
          "variables": {
            "g": {
              "type": "parameter",
              "units": "1/s",
              "default": 2.0,
              "description": "Decay rate, read by the enclosing model as `sub.g`."
            }
          },
          "equations": []
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "faq",
            "args": [],
            "output_idx": [
              "i"
            ],
            "ranges": {
              "i": {
                "from": "x"
              }
            },
            "expr": {
              "op": "D",
              "args": [
                {
                  "op": "index",
                  "args": [
                    "u",
                    "i"
                  ]
                }
              ],
              "wrt": "t"
            }
          },
          "rhs": {
            "op": "faq",
            "args": [],
            "output_idx": [
              "i"
            ],
            "ranges": {
              "i": {
                "from": "x"
              }
            },
            "expr": {
              "op": "*",
              "args": [
                {
                  "op": "-",
                  "args": [
                    "sub.g"
                  ]
                },
                {
                  "op": "index",
                  "args": [
                    "u",
                    "i"
                  ]
                }
              ]
            }
          }
        }
      ],
      "tests": [
        {
          "id": "reference_by_mount_relative_name",
          "description": "The reference names the mounted parameter the way the equations do: `sub.g`. Relative L2 error of the uniform field 1 against the constant 2 is 1/2; uniform norm against 1.5 * 2 = 3 is 2.",
          "time_span": {
            "start": 0.0,
            "end": 1.0
          },
          "assertions": [
            {
              "variable": "u",
              "time": 0.0,
              "expected": 0.5,
              "tolerance": {
                "rel": 1e-09
              },
              "reduce": "L2_error",
              "reference": "sub.g"
            },
            {
              "variable": "u",
              "time": 0.0,
              "expected": 2.0,
              "tolerance": {
                "rel": 1e-09
              },
              "reduce": "Linf_error",
              "reference": {
                "op": "*",
                "args": [
                  1.5,
                  "sub.g"
                ]
              }
            }
          ]
        },
        {
          "id": "reference_by_model_qualified_name",
          "description": "The same constant, spelled `P.sub.g`. The control: this spelling always resolved, and the mount-relative one above must give the identical number.",
          "time_span": {
            "start": 0.0,
            "end": 1.0
          },
          "assertions": [
            {
              "variable": "u",
              "time": 0.0,
              "expected": 0.5,
              "tolerance": {
                "rel": 1e-09
              },
              "reduce": "L2_error",
              "reference": "P.sub.g"
            }
          ]
        }
      ]
    },
    "R": {
      "variables": {
        "w": {
          "type": "unknown",
          "units": "1",
          "default": 1.0,
          "description": "Constant scalar."
        }
      },
      "subsystems": {
        "sub": {
          "variables": {
            "g": {
              "type": "parameter",
              "units": "1/s",
              "default": 7.0,
              "description": "A SECOND mount of a subsystem named `sub` carrying a `g`. It makes the flattened suffixes `sub.g` and `g` ambiguous document-wide, so `P`'s reference can only be resolved by the component that owns the test."
            }
          },
          "equations": []
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "w"
            ],
            "wrt": "t"
          },
          "rhs": 0.0
        }
      ]
    }
  }
}
