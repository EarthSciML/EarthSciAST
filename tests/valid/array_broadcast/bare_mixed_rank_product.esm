{
  "esm": "1.0.0",
  "metadata": {
    "name": "bare_mixed_rank_product",
    "description": "Cross-binding conformance fixture for esm-spec §4.3.4 name-based broadcast of TWO operands with disjoint missing axes (issue #100). The whole-array equation D(dp) ~ w2 * z1 multiplies a `[lon,lat]` field by a `[lev]` field into a `[lon,lat,lev]` result. Each operand broadcasts along the axes it does not declare — `w2` along `lev`, `z1` along `lon` and `lat` — so dp[i,j,k](t=1) = (i + 10 j) * 100 k, the outer product the index-set names describe, identical to the aggregate spelling sum_{i,j,k} index(w2,i,j) * index(z1,k). Because the two operands are missing DIFFERENT axes, no single positional rank-padding convention can produce this result: a binding that flattens both into the result's linear layout returns dp[1,1,2]=1100 instead of 2200 and zero in the last `lon` column.",
    "authors": [
      "EarthSciAST Test Suite"
    ],
    "tags": [
      "array-level",
      "broadcast",
      "index-set",
      "shape",
      "outer-product",
      "conformance",
      "issue-100"
    ]
  },
  "index_sets": {
    "lon": {
      "kind": "interval",
      "size": 3
    },
    "lat": {
      "kind": "interval",
      "size": 2
    },
    "lev": {
      "kind": "interval",
      "size": 2
    }
  },
  "models": {
    "bare_mixed_rank_product": {
      "tolerance": {
        "rel": 1e-08,
        "abs": 1e-10
      },
      "variables": {
        "dp": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "lon",
            "lat",
            "lev"
          ],
          "default": 0.0,
          "description": "Rank-3 accumulator over the full grid. Its tendency is CONSTANT in time and its initial value is 0, so dp(t=1) reads back the array-level RHS cell by cell."
        },
        "w2": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "lon",
            "lat"
          ],
          "description": "Rank-2 field over `lon`,`lat`: w2[i,j] = i + 10 j."
        },
        "z1": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "lev"
          ],
          "description": "Rank-1 field over `lev` only: z1[k] = 100 k, i.e. [100, 200]."
        }
      },
      "equations": [
        {
          "_comment": "D(dp)/dt = w2 * z1 with w2 over [lon,lat] and z1 over [lev]. dp[i,j,k](1) = (i + 10 j) * 100 k.",
          "lhs": {
            "op": "D",
            "args": [
              "dp"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "*",
            "args": [
              "w2",
              "z1"
            ]
          }
        },
        {
          "lhs": "w2",
          "rhs": {
            "op": "aggregate",
            "args": [],
            "output_idx": [
              "i",
              "j"
            ],
            "ranges": {
              "i": {
                "from": "lon"
              },
              "j": {
                "from": "lat"
              }
            },
            "expr": {
              "op": "+",
              "args": [
                "i",
                {
                  "op": "*",
                  "args": [
                    10,
                    "j"
                  ]
                }
              ]
            }
          }
        },
        {
          "lhs": "z1",
          "rhs": {
            "op": "aggregate",
            "args": [],
            "output_idx": [
              "k"
            ],
            "ranges": {
              "k": {
                "from": "lev"
              }
            },
            "expr": {
              "op": "*",
              "args": [
                100,
                "k"
              ]
            }
          }
        }
      ],
      "tests": [
        {
          "id": "bare_mixed_rank_product_t1",
          "description": "Sample the rank-3 result at t=1 through §6.6.5 `coords`, one probe per distinct broadcast outcome.",
          "time_span": {
            "start": 0.0,
            "end": 1.0
          },
          "assertions": [
            {
              "variable": "dp",
              "time": 1.0,
              "expected": 1100.0,
              "coords": {
                "lon": 1,
                "lat": 1,
                "lev": 1
              }
            },
            {
              "variable": "dp",
              "time": 1.0,
              "expected": 1300.0,
              "coords": {
                "lon": 3,
                "lat": 1,
                "lev": 1
              }
            },
            {
              "variable": "dp",
              "time": 1.0,
              "expected": 2100.0,
              "coords": {
                "lon": 1,
                "lat": 2,
                "lev": 1
              }
            },
            {
              "variable": "dp",
              "time": 1.0,
              "expected": 2300.0,
              "coords": {
                "lon": 3,
                "lat": 2,
                "lev": 1
              }
            },
            {
              "variable": "dp",
              "time": 1.0,
              "expected": 2200.0,
              "coords": {
                "lon": 1,
                "lat": 1,
                "lev": 2
              }
            },
            {
              "variable": "dp",
              "time": 1.0,
              "expected": 2600.0,
              "coords": {
                "lon": 3,
                "lat": 1,
                "lev": 2
              }
            },
            {
              "variable": "dp",
              "time": 1.0,
              "expected": 4400.0,
              "coords": {
                "lon": 2,
                "lat": 2,
                "lev": 2
              }
            },
            {
              "variable": "dp",
              "time": 1.0,
              "expected": 4600.0,
              "coords": {
                "lon": 3,
                "lat": 2,
                "lev": 2
              }
            }
          ]
        }
      ]
    }
  }
}
