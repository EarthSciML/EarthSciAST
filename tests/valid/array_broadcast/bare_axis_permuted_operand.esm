{
  "esm": "0.9.0",
  "metadata": {
    "name": "bare_axis_permuted_operand",
    "description": "Cross-binding conformance fixture pinning that axis ORDER is immaterial to esm-spec \u00a74.3.4 name-based broadcast (issue #100). The whole-array equation D(dp) ~ wT has an operand declared `[lat,lon]` \u2014 the same two index sets as the result's first two axes, in the OPPOSITE order \u2014 inside a `[lon,lat,lev]` result. Alignment is by NAME, so the operand TRANSPOSES rather than being reinterpreted positionally: dp[i,j,k](t=1) = wT[j,i] = i + 10 j, identical to the aggregate spelling sum_{i,j,k} index(wT, j, i). The extents differ (lon=3, lat=2), so a positional reading is not merely a different answer \u2014 it reads the operand off the end of its first axis and ghost-fills zeros.",
    "authors": [
      "EarthSciAST Test Suite"
    ],
    "tags": [
      "array-level",
      "broadcast",
      "index-set",
      "shape",
      "transpose",
      "conformance",
      "issue-100"
    ]
  },
  "index_sets": {
    "lon": {
      "kind": "interval",
      "size": 3
    },
    "lat": {
      "kind": "interval",
      "size": 2
    },
    "lev": {
      "kind": "interval",
      "size": 2
    }
  },
  "models": {
    "bare_axis_permuted_operand": {
      "tolerance": {
        "rel": 1e-08,
        "abs": 1e-10
      },
      "variables": {
        "dp": {
          "type": "state",
          "units": "1",
          "shape": [
            "lon",
            "lat",
            "lev"
          ],
          "default": 0.0,
          "description": "Rank-3 accumulator over the full grid. Its tendency is CONSTANT in time and its initial value is 0, so dp(t=1) reads back the array-level RHS cell by cell."
        },
        "wT": {
          "type": "observed",
          "units": "1",
          "shape": [
            "lat",
            "lon"
          ],
          "description": "Rank-2 field declared `lat`-major: wT[j,i] = i + 10 j. Same data as w2, transposed axis ORDER.",
          "expression": {
            "op": "aggregate",
            "args": [],
            "output_idx": [
              "j",
              "i"
            ],
            "ranges": {
              "j": {
                "from": "lat"
              },
              "i": {
                "from": "lon"
              }
            },
            "expr": {
              "op": "+",
              "args": [
                "i",
                {
                  "op": "*",
                  "args": [
                    10,
                    "j"
                  ]
                }
              ]
            }
          }
        }
      },
      "equations": [
        {
          "_comment": "D(dp)/dt = wT with wT declared [lat,lon] against a [lon,lat,lev] result: align by name, i.e. transpose. dp[i,j,k](1) = i + 10 j.",
          "lhs": {
            "op": "D",
            "args": [
              "dp"
            ],
            "wrt": "t"
          },
          "rhs": "wT"
        }
      ],
      "tests": [
        {
          "id": "bare_axis_permuted_operand_t1",
          "description": "Sample the rank-3 result at t=1 through \u00a76.6.5 `coords`, one probe per distinct broadcast outcome.",
          "time_span": {
            "start": 0.0,
            "end": 1.0
          },
          "assertions": [
            {
              "variable": "dp",
              "time": 1.0,
              "expected": 11.0,
              "coords": {
                "lon": 1,
                "lat": 1,
                "lev": 1
              }
            },
            {
              "variable": "dp",
              "time": 1.0,
              "expected": 13.0,
              "coords": {
                "lon": 3,
                "lat": 1,
                "lev": 1
              }
            },
            {
              "variable": "dp",
              "time": 1.0,
              "expected": 21.0,
              "coords": {
                "lon": 1,
                "lat": 2,
                "lev": 1
              }
            },
            {
              "variable": "dp",
              "time": 1.0,
              "expected": 23.0,
              "coords": {
                "lon": 3,
                "lat": 2,
                "lev": 1
              }
            },
            {
              "variable": "dp",
              "time": 1.0,
              "expected": 12.0,
              "coords": {
                "lon": 2,
                "lat": 1,
                "lev": 2
              }
            },
            {
              "variable": "dp",
              "time": 1.0,
              "expected": 23.0,
              "coords": {
                "lon": 3,
                "lat": 2,
                "lev": 2
              }
            }
          ]
        }
      ]
    }
  }
}
