{
  "esm": "1.0.0",
  "metadata": {
    "name": "discrete_variable_refresh",
    "description": "M3 schema fixture (RFC semiring-faq-unified-ir §6.1 / §8; bead ess-my4.3.2), restated for esm 1.0.0: the DISCRETE cadence class is seeded by a PARAMETER carrying an `update` block (esm-spec §5.4) — there is no third `discrete` variable type any more, and no `refresh` field. Such a parameter has a shape fixed at setup and values that refresh only at discrete events; it is the declared seed the dependency-partition pass schedules into a per-event handler. This fixture declares one parameter for each of the three discrete-cadence update kinds — `schedule` (tstops, the MTK PresetTimeCallback analogue; here a met field reloaded on a periodic interval), `data` (a boundary-condition field reloaded when its `data_sources` entry advances a record), and `remesh` (reloadable mesh topology under AMR) — plus one parameter with NO update at all (a setup-only buffer, e.g. a mesh loaded once, which is simply CONST). Each of the three declares its required `shape` and EXACTLY ONE value form (`from` for the data-bound one, a registered `handler` for the two the format cannot state symbolically). The model also carries an ordinary continuous unknown, so the partition is genuinely three-cadence. Validates against the schema with no evaluator.",
    "authors": [
      "EarthSciAST/polecats/gastown.capable"
    ],
    "tags": [
      "parameter-update",
      "discrete-cadence",
      "refresh-trigger",
      "cadence-partition",
      "conformance",
      "schema"
    ]
  },
  "index_sets": {
    "cells": {
      "kind": "interval",
      "size": 64
    },
    "levels": {
      "kind": "interval",
      "size": 8
    },
    "boundary": {
      "kind": "interval",
      "size": 24
    },
    "edges": {
      "kind": "interval",
      "size": 96
    }
  },
  "data_sources": {
    "bc_loader": {
      "kind": "grid",
      "source": {
        "url_template": "file:///data/bc/inflow_{date:%Y%m%d%H}.nc"
      },
      "temporal": {
        "frequency": "PT3H",
        "file_period": "P1D",
        "records_per_file": 8
      },
      "metadata": {
        "description": "Boundary-condition inflow source; its record advance drives the `bc_inflow` parameter refresh."
      }
    }
  },
  "models": {
    "DiscreteFields": {
      "variables": {
        "c": {
          "type": "unknown",
          "shape": [
            "cells",
            "levels"
          ],
          "description": "Continuous tracer concentration — the integrated state (CONTINUOUS cadence)."
        },
        "wind": {
          "type": "parameter",
          "shape": [
            "cells",
            "levels"
          ],
          "description": "Loaded meteorology (wind) field — shape fixed at setup, values reloaded on a fixed schedule by a registered handler (the reload is not statable as an expression).",
          "update": {
            "kind": "schedule",
            "interval": 3600.0,
            "initial_offset": 0.0,
            "handler": {
              "handler_id": "met_wind_reload"
            }
          }
        },
        "bc_inflow": {
          "type": "parameter",
          "units": "kg/m^3",
          "shape": [
            "boundary"
          ],
          "description": "Boundary-condition inflow field, reloaded when the `bc_loader` data source advances to the next record.",
          "update": {
            "kind": "data",
            "source": "bc_loader",
            "from": {
              "file_variable": "boundary_inflow"
            }
          }
        },
        "edge_normal": {
          "type": "parameter",
          "shape": [
            "edges"
          ],
          "description": "Reloadable mesh topology / edge-normal geometry, recomputed by a registered handler on an AMR remesh event.",
          "update": {
            "kind": "remesh",
            "hook": "amr_refine",
            "handler": {
              "handler_id": "edge_normal_recompute"
            }
          }
        },
        "cell_area": {
          "type": "parameter",
          "shape": [
            "cells"
          ],
          "description": "Cell areas from a mesh loaded once at setup — a shaped parameter with NO `update` at all, so it never refreshes (CONST cadence). Before 1.0.0 this was spelled as a `discrete` variable without a refresh trigger."
        },
        "decay_rate": {
          "type": "parameter",
          "default": 0.1,
          "description": "Externally set constant (CONST cadence)."
        }
      },
      "equations": [
        {
          "_comment": "An arrayed continuous decay over the cell/level grid; the updated parameters above seed the DISCRETE class and are inert to this algebra.",
          "lhs": {
            "op": "index",
            "args": [
              {
                "op": "D",
                "args": [
                  "c"
                ],
                "wrt": "t"
              },
              "i",
              "k"
            ]
          },
          "rhs": {
            "op": "*",
            "args": [
              {
                "op": "-",
                "args": [
                  "decay_rate"
                ]
              },
              {
                "op": "index",
                "args": [
                  "c",
                  "i",
                  "k"
                ]
              }
            ]
          }
        }
      ]
    }
  }
}
