{
  "esm": "1.0.0",
  "metadata": {
    "name": "cross_model_from_faq",
    "description": "esm-spec §9.7.5 fixture: `from_faq` resolves at DOCUMENT scope. `index_sets` is a document-scoped registry, so a `kind:\"derived\"` entry may name a producing node that lives in ANOTHER model — here `edges.from_faq` names `edge_enum`, defined at /models/EdgeProducer/equations/0/rhs, while the only consumer of `edges` is a range in /models/FluxConsumer. Every binding used to resolve `from_faq` against one model's nodes, which made this shape unresolvable (`unknown_faq_node`) even though the node plainly exists; tests/valid/wildfire_atmosphere_ocean.esm is the real-world instance. Node ids are unique across the whole document, not merely within a model.",
    "authors": [
      "EarthSciAST/polecats/gastown.rictus"
    ],
    "tags": [
      "aggregate",
      "node-addressing",
      "from_faq",
      "index-set",
      "document-scope",
      "conformance",
      "schema"
    ]
  },
  "index_sets": {
    "faces": {
      "kind": "interval",
      "size": 8
    },
    "edges": {
      "kind": "derived",
      "from_faq": "edge_enum"
    }
  },
  "models": {
    "EdgeProducer": {
      "variables": {
        "u": {
          "type": "unknown"
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "u"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "aggregate",
            "id": "edge_enum",
            "args": [],
            "semiring": "bool_and_or",
            "output_idx": [
              "edge"
            ],
            "expr": {
              "op": "index",
              "args": [
                "u",
                "f"
              ]
            },
            "ranges": {
              "f": {
                "from": "faces"
              }
            }
          }
        }
      ]
    },
    "FluxConsumer": {
      "variables": {
        "w": {
          "type": "unknown"
        },
        "flux": {
          "type": "unknown"
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "flux"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "aggregate",
            "args": [],
            "semiring": "sum_product",
            "output_idx": [],
            "expr": {
              "op": "index",
              "args": [
                "w",
                "e"
              ]
            },
            "ranges": {
              "e": {
                "from": "edges"
              }
            }
          }
        },
        {
          "lhs": {
            "op": "D",
            "args": [
              "w"
            ],
            "wrt": "t"
          },
          "rhs": 0.0
        }
      ]
    }
  }
}
