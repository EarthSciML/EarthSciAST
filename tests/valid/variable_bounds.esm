      "variables": {
        "E": {
          "type": "unknown",
          "units": "mol/m^3",
          "default": 0.5,
          "lb": 0,
          "ub": "E_max",
          "description": "Solid amount of a salt; zero when the salt is undersaturated"
        },
        "E_max": {
          "type": "unknown",
          "units": "mol/m^3",
          "lb": 0,
          "description": "The most solid the available ions allow"
        },
        "S": {
          "type": "unknown",
          "units": "1",
          "lb": 0,
          "ub": "f_max",
          "description": "Saturation ratio"
        },
