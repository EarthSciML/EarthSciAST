          "default": 1.0,
          "lb": 0
        },
        "f": {
          "type": "parameter",
          "units": "1",
          "default": 0.5,
          "lb": 0,
          "ub": 1
        },
        "f_max": {
          "type": "parameter",
          "units": "1",
          "default": 2.0
        },
        "k": {
          "type": "parameter",
          "units": "1/s",
          "default": 0.1,
          "lb": 0.1,
          "ub": 0.1,
          "description": "lb equal to ub is legal"
        },
        "W": {
          "type": "unknown",
          "units": "mol/m^3",
          "default": 0.1,
          "lb": -1.5,
          "ub": "Ions.cap",
          "description": "Bounded by a scoped reference into the subsystem"
        }
      },
      "equations": [
