              {
                "op": "-",
                "args": [
                  "k"
                ]
              },
              {
                "op": "-",
                "args": [
                  "E",
                  "E_max"
                ]
              }
            ]
          }
        },
        {
          "lhs": "E_max",
          "rhs": {
            "op": "*",
            "args": [
              "c_tot",
              "f"
            ]
          }
        },
        {
          "lhs": "S",
          "rhs": {
            "op": "/",
            "args": [
              "E",
              "E_max"
            ]
          }
        },
        {
          "lhs": {
            "op": "D",
            "args": [
              "W"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "*",
            "args": [
              {
                "op": "-",
                "args": [
                  "k"
                ]
              },
              "W"
            ]
          }
        }
      ],
