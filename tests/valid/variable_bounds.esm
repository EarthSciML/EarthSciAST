{
  "esm": "2.1.0",
  "metadata": {
    "name": "VariableBounds",
    "description": "Bounds on model variables (esm-spec §6.3.2): number bounds, an lb equal to its ub, a reference to an observed, a reference to a parameter, a scoped reference into a subsystem, and bounds on a state, an observed, a parameter and a subsystem variable. `E` is capped by the observed `E_max`, which depends on parameters only; `S` is bounded by `E_max`, which does not depend on `S`.",
    "authors": [
      "EarthSciML Test Suite"
    ],
    "license": "MIT",
    "tags": [
      "variable_bounds",
      "valid"
    ]
  },
  "models": {
