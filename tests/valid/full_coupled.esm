{
  "esm": "1.0.0",
  "metadata": {
    "name": "FullCoupledSystem",
    "description": "Comprehensive ESM test exercising all sections: models, reaction_systems, data_sources, operators, coupling, domain with spatial+temporal+ICs+BCs, and solver. The meteorology and emission fields the loaders used to publish are now parameters of the consuming components, each carrying an `update` that names its data source (esm-spec 8.5).\nMigrated from ESM v0.1.0 to v0.2.0 via esm-migrate.",
    "authors": [
      "Claude Test Generator"
    ],
    "created": "2026-02-16T16:00:00Z",
    "tags": [
      "comprehensive",
      "test",
      "all-sections",
      "migrated_from_v01"
    ],
    "license": "MIT"
  },
  "reaction_systems": {
    "AtmosphericChemistry": {
      "reference": {
        "notes": "Simplified atmospheric chemistry"
      },
      "species": {
        "O3": {
          "units": "mol/mol",
          "default": 4e-08,
          "description": "Ozone"
        },
        "NO": {
          "units": "mol/mol",
          "default": 1e-10,
          "description": "Nitric oxide"
        },
        "NO2": {
          "units": "mol/mol",
          "default": 1e-09,
          "description": "Nitrogen dioxide"
        },
        "OH": {
          "units": "mol/mol",
          "default": 5e-11,
          "description": "Hydroxyl radical"
        }
      },
      "parameters": {
        "T": {
          "units": "K",
          "default": 298.15,
          "description": "Temperature",
          "shape": [],
          "update": {
            "kind": "data",
            "source": "MeteoData",
            "from": {
              "file_variable": "T"
            }
          }
        },
        "M": {
          "units": "molec/cm^3",
          "default": 2.46e+19,
          "description": "Air density"
        },
        "jNO2": {
          "units": "1/s",
          "default": 0.005,
          "description": "NO2 photolysis"
        }
      },
      "reactions": [
        {
          "id": "R1",
          "name": "NO_O3_reaction",
          "substrates": [
            {
              "species": "NO",
              "stoichiometry": 1
            },
            {
              "species": "O3",
              "stoichiometry": 1
            }
          ],
          "products": [
            {
              "species": "NO2",
              "stoichiometry": 1
            }
          ],
          "rate": {
            "op": "*",
            "args": [
              1.8e-12,
              {
                "op": "exp",
                "args": [
                  {
                    "op": "/",
                    "args": [
                      -1370,
                      "T"
                    ]
                  }
                ]
              },
              "M"
            ]
          }
        }
      ]
    }
  },
  "models": {
    "Transport": {
      "reference": {
        "notes": "3D transport model"
      },
      "variables": {
        "u": {
          "type": "parameter",
          "units": "m/s",
          "default": 0.0,
          "description": "Eastward wind",
          "update": {
            "kind": "data",
            "source": "MeteoData",
            "from": {
              "file_variable": "u"
            }
          },
          "shape": []
        },
        "v": {
          "type": "parameter",
          "units": "m/s",
          "default": 0.0,
          "description": "Northward wind",
          "update": {
            "kind": "data",
            "source": "MeteoData",
            "from": {
              "file_variable": "v"
            }
          },
          "shape": []
        },
        "w": {
          "type": "parameter",
          "units": "m/s",
          "default": 0.0,
          "description": "Vertical wind"
        },
        "K_h": {
          "type": "parameter",
          "units": "m^2/s",
          "default": 100.0,
          "description": "Horizontal diffusion",
          "shape": [],
          "update": {
            "kind": "schedule",
            "interval": 3600.0,
            "handler": {
              "handler_id": "hourly_diffusion_update",
              "read_vars": [
                "_var"
              ],
              "read_params": [
                "K_h"
              ],
              "config": {
                "factor": 1.1
              }
            }
          }
        },
        "K_v": {
          "type": "parameter",
          "units": "m^2/s",
          "default": 10.0,
          "description": "Vertical diffusion",
          "shape": [],
          "update": {
            "kind": "schedule",
            "times": [
              86400,
              172800,
              259200
            ],
            "expression": {
              "op": "*",
              "args": [
                {
                  "op": "Pre",
                  "args": [
                    "K_v"
                  ]
                },
                0.9
              ]
            }
          }
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "u"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "+",
            "args": [
              {
                "op": "*",
                "args": [
                  {
                    "op": "-",
                    "args": [
                      "u"
                    ]
                  },
                  {
                    "op": "grad",
                    "args": [
                      "u"
                    ],
                    "dim": "lon"
                  }
                ]
              },
              {
                "op": "*",
                "args": [
                  {
                    "op": "-",
                    "args": [
                      "v"
                    ]
                  },
                  {
                    "op": "grad",
                    "args": [
                      "u"
                    ],
                    "dim": "lat"
                  }
                ]
              },
              {
                "op": "*",
                "args": [
                  {
                    "op": "-",
                    "args": [
                      "w"
                    ]
                  },
                  {
                    "op": "grad",
                    "args": [
                      "u"
                    ],
                    "dim": "lev"
                  }
                ]
              },
              {
                "op": "*",
                "args": [
                  "K_h",
                  {
                    "op": "laplacian",
                    "args": [
                      "u"
                    ],
                    "dim": "lon"
                  }
                ]
              },
              {
                "op": "*",
                "args": [
                  "K_v",
                  {
                    "op": "laplacian",
                    "args": [
                      "u"
                    ],
                    "dim": "lev"
                  }
                ]
              }
            ]
          }
        }
      ],
      "continuous_events": [
        {
          "name": "concentration_limit",
          "conditions": [
            {
              "op": "-",
              "args": [
                "u",
                0.001
              ]
            }
          ],
          "affects": [
            {
              "lhs": "_var",
              "rhs": 0.001
            }
          ],
          "affect_neg": [
            {
              "lhs": "_var",
              "rhs": {
                "op": "max",
                "args": [
                  0.0,
                  {
                    "op": "Pre",
                    "args": [
                      "u"
                    ]
                  }
                ]
              }
            }
          ],
          "root_find": "all"
        }
      ],
      "discrete_events": []
    }
  },
  "data_sources": {
    "MeteoData": {
      "kind": "grid",
      "source": {
        "url_template": "file:///data/GEOSFP/{date:%Y%m%d_%H%M}.nc"
      },
      "metadata": {
        "tags": [
          "meteorology",
          "reanalysis"
        ]
      }
    },
    "EmissionsData": {
      "kind": "grid",
      "source": {
        "url_template": "file:///data/EDGAR_v5/{date:%Y%m%d_%H%M}.nc"
      },
      "metadata": {
        "tags": [
          "emissions",
          "anthropogenic"
        ]
      }
    }
  },
  "coupling": [
    {
      "type": "operator_compose",
      "systems": [
        "AtmosphericChemistry",
        "Transport"
      ]
    },
    {
      "type": "callback",
      "callback_id": "apply_emissions"
    }
  ],
  "domain": {
    "temporal": {
      "start": "2024-07-01T00:00:00Z",
      "end": "2024-07-08T00:00:00Z"
    },
    "element_type": "Float64"
  }
}
