{
  "esm": "1.0.0",
  "metadata": {
    "name": "DataSourceRelativeUrlDocument",
    "description": "esm-spec §8.2.1: a source-catalog document whose data source names its input with a path RELATIVE TO THIS FILE rather than an absolute file:/// URL. That spelling is the portable one -- it is the only one a document whose data lives outside its own repository can carry and still be the same bytes on another checkout -- and every binding must accept it and resolve it against this file's own directory, exactly as §4.7 resolves a relative `ref`. Nothing here has to exist on disk: §8.2.1 resolution is lexical, so that a template carrying a {date:...} substitution -- which names a file per timestep, none of which exists at load time -- resolves the same way. The negative counterpart is tests/invalid/data_source_url_env_var.esm; the resolved values themselves are pinned across bindings by tests/conformance/data_source_url/manifest.json.",
    "authors": [
      "Test Suite"
    ],
    "license": "MIT",
    "tags": [
      "data-sources",
      "source-catalog",
      "url-template",
      "conformance"
    ]
  },
  "data_sources": {
    "sibling_tables": {
      "kind": "static",
      "source": {
        "url_template": "./data_source_tables/probe.parquet",
        "mirrors": [
          "../fixtures/data_source_tables/probe.parquet"
        ]
      }
    },
    "sibling_grid": {
      "kind": "grid",
      "source": {
        "url_template": "./data_source_tables/weather_{date:%Y%m%d_%H%M}.nc"
      },
      "temporal": {
        "frequency": "PT1H",
        "file_period": "PT1H",
        "records_per_file": 1
      }
    }
  }
}
