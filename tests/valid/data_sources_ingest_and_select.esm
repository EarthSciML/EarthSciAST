{
  "esm": "1.0.0",
  "metadata": {
    "name": "DataLoaderIngestAndSelect",
    "description": "The loader-ingest surface of esm-spec §8.9, in one document: reader_options (the zip member glob + asserted header row of an FF10 point inventory), codes (the text POLID column mapped to the pollutant enum, unrecognised values dropping the record), record_filter (a point with no coordinate and a row with no annual total are not records), extent (the surviving count binds the runtime-discovered metaparameter N_REC, which sizes the emis_records index set), and select (the store's full-grid W read whole as `W`, its [0:N_SRC] prefix read again as `src_W`, and — a THIRD variable over the same file_variable — `emis_W` gated on the derived set `emis_cells`, which is the one selector that DEFERS: its axis does not exist until value-invention has run, so the fetch is issued after it, pre-sliced to the discovered support set rather than to the full axis). Nothing here is model math: the point is that a document declaring these needs no caller to read the file, count the rows, map the codes and slice the prefix on its behalf. The url_templates are placeholders; the executable form of this fixture is pkg/earthsci-ast-rs/tests/loader_ingest_and_select.rs, which patches them onto real local fixtures.",
    "authors": [
      "Test Suite"
    ],
    "license": "MIT",
    "tags": [
      "data-sources",
      "pure-io",
      "reader-options",
      "record-filter",
      "source-extent",
      "range-select",
      "gated-select",
      "value-invention",
      "conformance"
    ]
  },
  "metaparameters": {
    "N_SRC": {
      "type": "integer",
      "default": 4,
      "description": "Source cells: the prefix of the full grid the SR block covers."
    },
    "N_POP": {
      "type": "integer",
      "default": 10,
      "description": "Full-grid length of W."
    },
    "N_REC": {
      "type": "integer",
      "default": 0,
      "description": "Emission records. Runtime-discovered: the EGU source's `extent` binds it to the number of records that survive its own record_filter, so the default is only what makes the document load standalone."
    }
  },
  "index_sets": {
    "src_cells": {
      "kind": "interval",
      "size": "N_SRC"
    },
    "pop_cells": {
      "kind": "interval",
      "size": "N_POP"
    },
    "emis_records": {
      "kind": "interval",
      "size": "N_REC"
    },
    "emis_cells": {
      "kind": "derived",
      "from_faq": "emis_cell_set"
    }
  },
  "data_sources": {
    "EGU_Emis": {
      "kind": "points",
      "source": {
        "url_template": "file:///data/2016fd_inputs_point.zip"
      },
      "reader_options": {
        "member_glob": "*egu*",
        "skip_header_row": true
      },
      "record_filter": {
        "require_finite": [
          "LONGITUDE",
          "LATITUDE",
          "ANN_VALUE"
        ]
      },
      "extent": {
        "metaparameter": "N_REC"
      },
      "metadata": {
        "esio_format": "ff10",
        "tags": [
          "ff10",
          "point_sources",
          "emissions"
        ]
      }
    },
    "Grid": {
      "kind": "static",
      "source": {
        "url_template": "file:///data/grid.zarr/"
      },
      "metadata": {
        "esio_format": "zarr",
        "tags": [
          "grid",
          "static"
        ]
      }
    }
  },
  "models": {
    "Ingest": {
      "system_kind": "nonlinear",
      "variables": {
        "pollutant": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [
            "emis_records"
          ],
          "description": "Per-record pollutant code; from EGU_Emis.pollutant.",
          "update": {
            "kind": "data",
            "source": "EGU_Emis",
            "from": {
              "file_variable": "POLID",
              "codes": {
                "map": {
                  "VOC": 1,
                  "NOX": 36,
                  "NH3": 40,
                  "SO2": 41,
                  "PM25-PRI": 42
                },
                "case_insensitive": true,
                "unmapped": "drop"
              }
            }
          }
        },
        "annual": {
          "type": "parameter",
          "units": "kg/yr",
          "default": 0.0,
          "shape": [
            "emis_records"
          ],
          "description": "Per-record annual emissions; from EGU_Emis.annual.",
          "update": {
            "kind": "data",
            "source": "EGU_Emis",
            "from": {
              "file_variable": "ANN_VALUE"
            }
          }
        },
        "lon": {
          "type": "parameter",
          "units": "degree",
          "default": 0.0,
          "shape": [
            "emis_records"
          ],
          "description": "Per-record longitude; from EGU_Emis.lon. Read by the emis_cell_set producer below, which is what makes the support set a property of the DATA rather than of the caller.",
          "update": {
            "kind": "data",
            "source": "EGU_Emis",
            "from": {
              "file_variable": "LONGITUDE"
            }
          }
        },
        "src_W": {
          "type": "parameter",
          "units": "m",
          "default": 0.0,
          "shape": [
            "src_cells"
          ],
          "description": "Source-cell west edges; from Grid.src_W.",
          "update": {
            "kind": "data",
            "source": "Grid",
            "from": {
              "file_variable": "W",
              "select": {
                "axes": [
                  {
                    "range": {
                      "start": 0,
                      "stop": "N_SRC"
                    }
                  }
                ]
              }
            }
          }
        },
        "emis_cell": {
          "type": "unknown",
          "description": "The value-invention producer's output variable (esm-spec §5.5): its equation below materializes the distinct set of emission-bearing cells, which `index_sets.emis_cells` names via from_faq. Never integrated — the materialized set replaces it before the numeric pipeline."
        },
        "emis_W": {
          "type": "parameter",
          "units": "m",
          "default": 0.0,
          "shape": [
            "emis_cells"
          ],
          "description": "West edges of the emission-bearing cells; from Grid.emis_W. Its axis is the derived set, so the array that arrives is already the compact slab — it is never a full-grid read that the model then subsets.",
          "update": {
            "kind": "data",
            "source": "Grid",
            "from": {
              "file_variable": "W",
              "select": {
                "axes": [
                  {
                    "gated_by": "emis_cells"
                  }
                ]
              }
            }
          }
        },
        "is_NOx": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "emis_records"
          ],
          "description": "Pathway membership, over the codes the source delivered."
        },
        "E_NOx": {
          "type": "unknown",
          "units": "kg/yr",
          "description": "Total NOx over every surviving record — a scalar whose value depends on the source having dropped exactly the right rows."
        },
        "src_width": {
          "type": "unknown",
          "units": "m",
          "shape": [
            "src_cells"
          ],
          "description": "Reads the prefix the source delivered; its shape is src_cells, not pop_cells."
        },
        "emis_width": {
          "type": "unknown",
          "units": "m",
          "shape": [
            "emis_cells"
          ],
          "description": "Reads the gated slab the source delivered; its extent is the number of emission-bearing cells the graph discovered, which no caller supplied."
        },
        "lat": {
          "type": "parameter",
          "units": "degree",
          "default": 0.0,
          "shape": [
            "emis_records"
          ],
          "update": {
            "kind": "data",
            "source": "EGU_Emis",
            "from": {
              "file_variable": "LATITUDE"
            }
          }
        },
        "W": {
          "type": "parameter",
          "units": "m",
          "default": 0.0,
          "shape": [
            "pop_cells"
          ],
          "update": {
            "kind": "data",
            "source": "Grid",
            "from": {
              "file_variable": "W"
            }
          },
          "description": "Cell west edge over the FULL grid."
        }
      },
      "equations": [
        {
          "_comment": "emis_cell_set: the index-set-producing node index_sets.emis_cells names via from_faq. Each surviving emission record is mapped to the grid cell containing it (1-based: floor((lon - lon0)/dlon) + 1 over the toy 1-degree grid whose western edge is -94), and distinct:true under bool_and_or reduces those to the sorted support set. The three records at -90, -92 and -93 therefore invent cells 5, 3 and 2 — the emission-bearing subset of the 10-cell grid, and the axis Grid.emis_W is fetched on.",
          "lhs": {
            "op": "index",
            "args": [
              "emis_cell",
              "m"
            ]
          },
          "rhs": {
            "op": "aggregate",
            "output_idx": [
              "m"
            ],
            "ranges": {
              "r": {
                "from": "emis_records"
              }
            },
            "args": [
              "lon"
            ],
            "semiring": "bool_and_or",
            "distinct": true,
            "id": "emis_cell_set",
            "key": {
              "op": "skolem",
              "label": "cell",
              "args": [
                {
                  "op": "+",
                  "args": [
                    {
                      "op": "floor",
                      "args": [
                        {
                          "op": "/",
                          "args": [
                            {
                              "op": "-",
                              "args": [
                                {
                                  "op": "index",
                                  "args": [
                                    "lon",
                                    "r"
                                  ]
                                },
                                -94.0
                              ]
                            },
                            1.0
                          ]
                        }
                      ]
                    },
                    1
                  ]
                }
              ]
            },
            "expr": {
              "op": "true",
              "args": []
            }
          }
        },
        {
          "lhs": "is_NOx",
          "rhs": {
            "op": "aggregate",
            "output_idx": [
              "r"
            ],
            "ranges": {
              "r": {
                "from": "emis_records"
              }
            },
            "args": [
              "pollutant"
            ],
            "expr": {
              "op": "ifelse",
              "args": [
                {
                  "op": "==",
                  "args": [
                    {
                      "op": "index",
                      "args": [
                        "pollutant",
                        "r"
                      ]
                    },
                    36
                  ]
                },
                1.0,
                0.0
              ]
            }
          }
        },
        {
          "lhs": "E_NOx",
          "rhs": {
            "op": "aggregate",
            "output_idx": [],
            "ranges": {
              "r": {
                "from": "emis_records"
              }
            },
            "args": [
              "annual",
              "is_NOx"
            ],
            "expr": {
              "op": "*",
              "args": [
                {
                  "op": "index",
                  "args": [
                    "annual",
                    "r"
                  ]
                },
                {
                  "op": "index",
                  "args": [
                    "is_NOx",
                    "r"
                  ]
                }
              ]
            }
          }
        },
        {
          "lhs": "src_width",
          "rhs": {
            "op": "aggregate",
            "output_idx": [
              "c"
            ],
            "ranges": {
              "c": {
                "from": "src_cells"
              }
            },
            "args": [
              "src_W"
            ],
            "expr": {
              "op": "+",
              "args": [
                {
                  "op": "index",
                  "args": [
                    "src_W",
                    "c"
                  ]
                },
                1.0
              ]
            }
          }
        },
        {
          "lhs": "emis_width",
          "rhs": {
            "op": "aggregate",
            "output_idx": [
              "c"
            ],
            "ranges": {
              "c": {
                "from": "emis_cells"
              }
            },
            "args": [
              "emis_W"
            ],
            "expr": {
              "op": "+",
              "args": [
                {
                  "op": "index",
                  "args": [
                    "emis_W",
                    "c"
                  ]
                },
                1.0
              ]
            }
          }
        }
      ]
    }
  }
}
