            ],
            "filter": {
              "op": ">",
              "args": [
                {
                  "op": "index",
                  "args": [
                    "A_ij",
                    "i",
                    "j"
                  ]
                },
                "atol"
              ]
            },
            "args": [],
            "expr": {
              "op": "index",
              "args": [
                "A_ij",
                "i",
                "j"
              ]
            }
          }
        },
        {
          "_comment": "(4)+(5) APPLY + NORMALIZE — D(F_tgt[j]) = Σ_i W_ij[i,j]·F_src[i], W_ij = A_ij/A_j (normalize folded into the inline weights). Same bin-key candidate join + zero-area filter. Zero IC ⇒ du[F_tgt] = F_tgt.",
          "lhs": {
            "op": "faq",
            "semiring": "sum_product",
            "output_idx": [
              "j"
            ],
            "ranges": {
              "j": [
                1,
                4
              ]
            },
            "args": [],
