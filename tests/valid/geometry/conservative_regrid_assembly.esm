            ],
            "ranges": {
              "j": {
                "from": "tgt_cells"
              }
            },
            "args": [],
            "expr": {
              "op": "floor",
              "args": [
                {
                  "op": "/",
                  "args": [
                    {
                      "op": "index",
                      "args": [
                        "tgt_lat",
                        "j"
                      ]
                    },
                    "dy"
                  ]
                }
              ]
            }
          }
        },
        {
          "_comment": "(1c) BROAD PHASE — candidate overlap-pair set = the bin-key equi-join (distinct bool_and_or, id candidate_set): keep (i,j) whose bin keys are EQUAL; a `pair_key` integer key names each surviving candidate.",
          "lhs": {
            "op": "index",
            "args": [
              "pair_exists",
              "p"
            ]
          },
          "rhs": {
            "op": "faq",
            "semiring": "bool_and_or",
            "output_idx": [
              "p"
            ],
            "ranges": {
              "i": {
                "from": "src_cells"
              },
              "j": {
                "from": "tgt_cells"
              }
            },
            "id": "candidate_set",
            "distinct": true,
            "join": [
              {
                "on": [
                  [
                    "src_bin_c1",
                    "tgt_bin_c1"
                  ],
                  [
                    "src_bin_c2",
                    "tgt_bin_c2"
                  ]
                ]
              }
            ],
            "key": {
              "op": "apply_expression_template",
              "args": [],
              "name": "pair_key",
              "bindings": {
                "a": "i",
                "b": "j",
                "lo_a": 1,
                "lo_b": 1,
                "n_a": 4,
                "n_b": 4
              }
            },
            "args": [],
            "expr": {
              "op": "true",
              "args": []
            }
          }
        },
        {
          "_comment": "(3) A_j[j] = Σ_i A_ij[i,j] over the bin-key candidate pairs (join on the materialized bin buffers) with the sliver filter. A_ij is computed inline from geometry above. Zero IC ⇒ du[A_j_check] = A_j.",
          "lhs": {
            "op": "faq",
            "semiring": "sum_product",
            "output_idx": [
              "j"
            ],
            "ranges": {
              "j": [
                1,
                4
              ]
            },
            "args": [],
            "expr": {
              "op": "D",
              "args": [
                {
                  "op": "index",
                  "args": [
                    "A_j_check",
                    "j"
                  ]
                }
