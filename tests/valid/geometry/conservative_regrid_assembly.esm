              ]
            }
          }
        },
        {
          "_comment": "Component 2 of the former `skolem` key `tgt_bin`: an integer join column.",
          "lhs": {
            "op": "index",
            "args": [
              "tgt_bin_c2",
              "j"
            ]
          },
          "rhs": {
            "op": "faq",
            "semiring": "sum_product",
            "output_idx": [
