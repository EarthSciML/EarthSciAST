{
  "esm": "2.0.0",
  "metadata": {
    "name": "bin_skolem_spatial_join",
    "description": "M4 schema fixture (RFC semiring-faq-unified-ir §A.8 / §8.1; CONFORMANCE_SPEC.md §5.8.5; bead ess-my4.4.2): the bin-key spatial-join REPRESENTATION for the conservative-regridding broad phase. The candidate overlap-pair set {(i,j)} is the spatial (theta) join of source and target cells — NOT covered by M2's equi-only join.on directly — realized as a bin-key EQUI-join. DECISION (bead item 3): no new `bin`/`floor` leaf op is needed; it COMPOSES from existing ops. Each cell's coordinate is quantized to an INTEGER lat-lon bin via the existing `floor` op, each bin component is its own integer join column, and the candidate pairs are the landed M2 `join.on` equi-join of source and target cells sharing a bin key. Integer bin keys keep the candidate set BYTE-IDENTICAL across bindings (§5.5 / §5.8.5 determinism contract — no floating-point coordinate comparison enters the broad phase); only the post-clip per-pair area (the overlap-area narrow phase, a separate fixture) is tolerance-based. The full worked overlap-join idiom + A.8 piece-by-piece mapping is bead ess-my4.4.5; STR-tree acceleration is an explicit perf follow-on, not represented here. This is a STRUCTURAL fixture: it validates against the additive schema with no evaluator.",
    "authors": [
      "EarthSciAST/polecats/gastown.furiosa"
    ],
    "tags": [
      "geometry",
      "spatial-join",
      "bin-key",
      "floor",
      "pair_key",
      "join",
      "value-invention",
      "conformance",
      "schema",
      "ess-my4.4.2"
    ]
  },
  "index_sets": {
    "src_cells": {
      "kind": "interval",
      "size": 4
    },
    "tgt_cells": {
      "kind": "interval",
      "size": 4
    },
    "candidate_pairs": {
      "kind": "derived",
      "from_faq": "candidate_set"
    }
  },
  "models": {
    "BinSkolemSpatialJoin": {
      "expression_template_imports": [
        {
          "ref": "esm:std/relational.esm",
          "only": [
            "pair_key"
          ]
        }
      ],
      "variables": {
        "src_lon": {
          "type": "parameter",
          "shape": [
            "src_cells"
          ],
          "description": "Source-cell representative longitude (e.g. bbox-min corner). Float coordinate — enters ONLY the integer binning via floor, never a raw join comparison."
        },
        "src_lat": {
          "type": "parameter",
          "shape": [
            "src_cells"
          ]
        },
        "tgt_lon": {
          "type": "parameter",
          "shape": [
            "tgt_cells"
          ]
        },
        "tgt_lat": {
          "type": "parameter",
          "shape": [
            "tgt_cells"
          ]
        },
        "dx": {
          "type": "parameter",
          "shape": [],
          "description": "Bin width in degrees — the exactly-defined integer quantization step (§5.8.5)."
        },
        "dy": {
          "type": "parameter",
          "shape": []
        },
        "pair_exists": {
          "type": "unknown",
          "shape": [
            "candidate_pairs"
          ],
          "description": "Membership over the candidate overlap-pair set produced by the bin-key equi-join (the broad phase). The byte-identical integer candidate set of §5.8.5."
        },
        "src_bin_c1": {
          "type": "unknown",
          "shape": [
            "src_cells"
          ],
          "description": "Component 1 of the key formerly `src_bin` (an integer join column)."
        },
        "src_bin_c2": {
          "type": "unknown",
          "shape": [
            "src_cells"
          ],
          "description": "Component 2 of the key formerly `src_bin` (an integer join column)."
        },
        "tgt_bin_c1": {
          "type": "unknown",
          "shape": [
            "tgt_cells"
          ],
          "description": "Component 1 of the key formerly `tgt_bin` (an integer join column)."
        },
        "tgt_bin_c2": {
          "type": "unknown",
          "shape": [
            "tgt_cells"
          ],
          "description": "Component 2 of the key formerly `tgt_bin` (an integer join column)."
        }
      },
      "equations": [
        {
          "_comment": "Component 1 of the former `skolem` key `src_bin`: an integer join column.",
          "lhs": {
            "op": "index",
            "args": [
              "src_bin_c1",
              "i"
            ]
          },
          "rhs": {
            "op": "faq",
            "semiring": "sum_product",
            "output_idx": [
              "i"
            ],
            "ranges": {
              "i": {
                "from": "src_cells"
              }
            },
            "args": [],
            "expr": {
              "op": "floor",
              "args": [
                {
                  "op": "/",
                  "args": [
                    {
                      "op": "index",
                      "args": [
                        "src_lon",
                        "i"
                      ]
                    },
                    "dx"
                  ]
                }
              ]
            }
          }
        },
        {
          "_comment": "Component 2 of the former `skolem` key `src_bin`: an integer join column.",
          "lhs": {
            "op": "index",
            "args": [
              "src_bin_c2",
              "i"
            ]
          },
          "rhs": {
            "op": "faq",
            "semiring": "sum_product",
            "output_idx": [
              "i"
            ],
            "ranges": {
              "i": {
                "from": "src_cells"
              }
            },
            "args": [],
            "expr": {
              "op": "floor",
              "args": [
                {
                  "op": "/",
                  "args": [
                    {
                      "op": "index",
                      "args": [
                        "src_lat",
                        "i"
                      ]
                    },
                    "dy"
                  ]
                }
              ]
            }
          }
        },
        {
          "_comment": "Component 1 of the former `skolem` key `tgt_bin`: an integer join column.",
          "lhs": {
            "op": "index",
            "args": [
              "tgt_bin_c1",
              "j"
            ]
          },
          "rhs": {
            "op": "faq",
            "semiring": "sum_product",
            "output_idx": [
              "j"
            ],
            "ranges": {
              "j": {
                "from": "tgt_cells"
              }
            },
            "args": [],
            "expr": {
              "op": "floor",
              "args": [
                {
                  "op": "/",
                  "args": [
                    {
                      "op": "index",
                      "args": [
                        "tgt_lon",
                        "j"
                      ]
                    },
                    "dx"
                  ]
                }
              ]
            }
          }
        },
        {
          "_comment": "Component 2 of the former `skolem` key `tgt_bin`: an integer join column.",
          "lhs": {
            "op": "index",
            "args": [
              "tgt_bin_c2",
              "j"
            ]
          },
          "rhs": {
            "op": "faq",
            "semiring": "sum_product",
            "output_idx": [
              "j"
            ],
            "ranges": {
              "j": {
                "from": "tgt_cells"
              }
            },
            "args": [],
            "expr": {
              "op": "floor",
              "args": [
                {
                  "op": "/",
                  "args": [
                    {
                      "op": "index",
                      "args": [
                        "tgt_lat",
                        "j"
                      ]
                    },
                    "dy"
                  ]
                }
              ]
            }
          }
        },
        {
          "_comment": "Candidate overlap-pair set = the bin-key EQUI-join: the index-set-producing faq (bool_and_or, distinct:true) ranges source i and target j, the M2 `join.on` keeps only (i,j) whose bin keys are EQUAL (join on [src_bin, tgt_bin]), and a `pair_key` integer key names each surviving candidate. The `true` body marks membership. This is the landed M2 equi-join reused on integer bin keys (§5.8.5) — no spatial-index op in the IR; the index is a physical-operator/planner concern (a non-goal here).",
          "lhs": {
            "op": "index",
            "args": [
              "pair_exists",
              "p"
            ]
          },
          "rhs": {
            "op": "faq",
            "id": "candidate_set",
            "semiring": "bool_and_or",
            "distinct": true,
            "output_idx": [
              "p"
            ],
            "ranges": {
              "i": {
                "from": "src_cells"
              },
              "j": {
                "from": "tgt_cells"
              }
            },
            "join": [
              {
                "on": [
                  [
                    "src_bin_c1",
                    "tgt_bin_c1"
                  ],
                  [
                    "src_bin_c2",
                    "tgt_bin_c2"
                  ]
                ]
              }
            ],
            "args": [
              "src_bin_c1",
              "src_bin_c2",
              "tgt_bin_c1",
              "tgt_bin_c2"
            ],
            "key": {
              "op": "apply_expression_template",
              "args": [],
              "name": "pair_key",
              "bindings": {
                "a": "i",
                "b": "j",
                "lo_a": 1,
                "lo_b": 1,
                "n_a": 4,
                "n_b": 4
              }
            },
            "expr": {
              "op": "true",
              "args": []
            }
          }
        }
      ]
    }
  }
}
