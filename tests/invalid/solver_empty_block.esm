{
  "esm": "1.1.0",
  "metadata": {
    "name": "solver_empty_block",
    "description": "An empty `solver` block. The schema sets `minProperties: 1` because `solver: {}` would be a SECOND SPELLING of absence, and the format keeps one representation per state \u2014 the same reasoning that makes a one-element `ParameterUpdate` array invalid. A document with nothing to declare omits the block. MUST be rejected."
  },
  "solver": {},
  "models": {
    "TestModel": {
      "variables": {
        "x": {
          "type": "unknown",
          "units": "m",
          "default": 1.0
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "x"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "neg",
            "args": [
              "x"
            ]
          }
        }
      ]
    }
  }
}
