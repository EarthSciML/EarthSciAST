{
  "esm": "1.0.0",
  "metadata": {
    "name": "UndefinedVariableInReactionSystemAssertionReference",
    "description": "Invalid: an undefined name inside a REACTION SYSTEM test assertion's `reference` expression (\u00a76.6.3). The reaction-system twin of undefined_variable_in_assertion_reference.esm: an inline test is the same site on a reaction system as on a model, so it carries the same code. `A`, `B` and `k` are declared; the ONLY defect is the undefined name `undefined_xyz`. Expected error: undefined_variable @ /reaction_systems/TestReactions/tests/0/assertions/0/reference.",
    "authors": [
      "EarthSciML"
    ],
    "created": "2026-09-14T00:00:00Z"
  },
  "reaction_systems": {
    "TestReactions": {
      "species": {
        "A": {
          "units": "mol/L",
          "default": 1.0,
          "description": "Reactant."
        },
        "B": {
          "units": "mol/L",
          "default": 0.0,
          "description": "Product."
        }
      },
      "parameters": {
        "k": {
          "units": "1/s",
          "default": 0.1,
          "description": "First-order rate constant."
        }
      },
      "reactions": [
        {
          "id": "R1",
          "substrates": [
            {
              "species": "A",
              "stoichiometry": 1
            }
          ],
          "products": [
            {
              "species": "B",
              "stoichiometry": 1
            }
          ],
          "rate": "k"
        }
      ],
      "tests": [
        {
          "id": "t0",
          "time_span": {
            "start": 0.0,
            "end": 1.0
          },
          "assertions": [
            {
              "variable": "A",
              "time": 1.0,
              "expected": 0.0,
              "reference": {
                "op": "*",
                "args": [
                  "k",
                  "undefined_xyz"
                ]
              }
            }
          ]
        }
      ]
    }
  }
}
