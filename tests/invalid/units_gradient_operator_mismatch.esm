{
  "esm": "1.0.0",
  "metadata": {
    "name": "UnitsGradientOperatorMismatch",
    "description": "Invalid file. The single defect is the bad_sum observed variable, which adds 'm' to 'kg' (an ordinary §4.8.3 dimensional mismatch). The file ALSO applies a user op, upwind_gradient, over a coordinate 'x' declared without units — that is DELIBERATELY NOT an error: a user op is an open-tier rewrite target with no dimensional rule (§4.8.3 'any other op'), so its dimension is undeterminable until lowered and a checker reports unknown and skips (§4.8.4). This fixture guards that — a binding must not invent a dimensional rule for an open-tier op (a coordinate-divided 'gradient' rule keyed on the op name or its dim field). It used the grad sugar until esm 3.0.0 removed grad/div/laplacian; the filename is kept.",
    "authors": [
      "Chris Tessum with Claude"
    ],
    "created": "2026-04-18T00:00:00Z"
  },
  "models": {
    "SpatialModel": {
      "variables": {
        "c": {
          "type": "unknown",
          "units": "mol/m^3",
          "default": 0.0,
          "description": "Tracer concentration (state)"
        },
        "x": {
          "type": "parameter",
          "default": 0.0,
          "description": "Spatial coordinate declared WITHOUT units. The upwind_gradient user op over dim 'x' therefore has an undeterminable dimension (§4.8.3 'any other op' -> §4.8.4 unknown, skip); a checker MUST NOT flag it. Only the bad_sum addition is a real mismatch."
        },
        "D_coef": {
          "type": "parameter",
          "units": "m^2/s",
          "default": 0.1,
          "description": "Diffusion coefficient"
        },
        "length": {
          "type": "parameter",
          "units": "m",
          "default": 1.0,
          "description": "Length parameter used to make the dimensional mismatch visible to bindings that only inspect observed variable additions"
        },
        "mass": {
          "type": "parameter",
          "units": "kg",
          "default": 1.0,
          "description": "Mass parameter used to trigger an addition unit mismatch"
        },
        "bad_sum": {
          "type": "unknown",
          "units": "1",
          "description": "Invalid: adds 'length' (m) to 'mass' (kg) — a dimensional mismatch any unit validator can detect. This is the sole pinned finding for this fixture."
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "c"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "*",
            "args": [
              "D_coef",
              {
                "op": "upwind_gradient",
                "args": [
                  "c"
                ],
                "dim": "x"
              }
            ]
          }
        },
        {
          "lhs": "bad_sum",
          "rhs": {
            "op": "+",
            "args": [
              "length",
              "mass"
            ]
          }
        }
      ]
    }
  },
  "domain": {
    "independent_variable": "t"
  }
}
