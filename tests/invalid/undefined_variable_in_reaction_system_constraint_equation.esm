{
  "esm": "1.0.0",
  "metadata": {
    "name": "UndefinedVariableInReactionSystemConstraintEquation",
    "description": "Invalid: an undefined name inside a REACTION SYSTEM constraint equation's right-hand side. A constraint equation is the same site on a reaction system as an equation on a model, so it carries the same code as undefined_variable_in_rhs.esm (only a reaction `rate` reports undefined_parameter). `A`, `B` and `k` are declared; the ONLY defect is the undefined name `undefined_xyz`. Expected error: undefined_variable @ /reaction_systems/TestReactions/constraint_equations/0/rhs.",
    "authors": [
      "EarthSciML"
    ],
    "created": "2026-09-15T00:00:00Z"
  },
  "reaction_systems": {
    "TestReactions": {
      "species": {
        "A": {
          "units": "mol/L",
          "default": 1.0,
          "description": "Reactant."
        },
        "B": {
          "units": "mol/L",
          "default": 0.0,
          "description": "Product."
        }
      },
      "parameters": {
        "k": {
          "units": "1/s",
          "default": 0.1,
          "description": "First-order rate constant."
        }
      },
      "reactions": [
        {
          "id": "R1",
          "substrates": [
            {
              "species": "A",
              "stoichiometry": 1
            }
          ],
          "products": [
            {
              "species": "B",
              "stoichiometry": 1
            }
          ],
          "rate": "k"
        }
      ],
      "constraint_equations": [
        {
          "lhs": "B",
          "rhs": {
            "op": "*",
            "args": [
              "k",
              "undefined_xyz"
            ]
          }
        }
      ]
    }
  }
}
