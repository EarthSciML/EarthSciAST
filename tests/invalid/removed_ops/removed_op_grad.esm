{
  "esm": "2.3.0",
  "metadata": {
    "name": "removed_op_grad",
    "description": "INVALID: the `grad` op was removed at esm 2.4.0. A loader rejects it BY NAME at the wire boundary with `removed_op`, whatever `esm` the document declares (this one declares 2.3.0, the release before the removal). There is no codemod: write `grad(f, dim: x)` as the spatial derivative `D(f, wrt: x)` (MIGRATION.md, \"esm 2.4.0\").",
    "authors": [
      "EarthSciAST"
    ],
    "tags": [
      "invalid",
      "removed_op",
      "esm-2.4.0",
      "grad"
    ]
  },
  "index_sets": {
    "x": {
      "kind": "interval",
      "size": 8
    }
  },
  "models": {
    "Diffusion": {
      "variables": {
        "u": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "x"
          ]
        },
        "k": {
          "type": "parameter",
          "units": "m^2/s",
          "default": 1.0
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "u"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "*",
            "args": [
              "k",
              {
                "op": "grad",
                "args": [
                  "u"
                ],
                "dim": "x"
              }
            ]
          }
        }
      ]
    }
  }
}
