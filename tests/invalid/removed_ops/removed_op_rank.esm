{
  "esm": "2.0.0",
  "metadata": {
    "name": "removed_op_rank",
    "description": "INVALID: the `rank` op was removed at esm 2.0.0. A loader rejects it BY NAME at the wire boundary with `removed_op`. Replacement: a member's rank is its loop index over the `distinct` set, or the `rank_of` / `rank_of_set` templates of esm:std/relational.esm. The 2.0.0 codemod (MIGRATION.md) rewrites it.",
    "authors": [
      "EarthSciAST"
    ],
