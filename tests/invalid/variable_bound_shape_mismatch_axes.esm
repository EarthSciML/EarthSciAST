{
  "esm": "2.1.0",
  "metadata": {
    "name": "VariableBoundShapeMismatchAxes",
    "description": "`Q` is shaped over `salt` and its lb over `ion`: two shapes of the same extent are still different shapes (esm-spec §6.3.2 rule 2).",
    "authors": [
      "EarthSciML Test Suite"
    ],
    "license": "MIT",
    "tags": [
      "variable_bounds",
      "invalid"
    ]
  },
  "models": {
    "M": {
      "variables": {
        "Q": {
          "type": "unknown",
          "units": "mol/m^3",
          "shape": [
            "salt"
          ],
          "default": 0.5,
          "lb": "Q_min"
        },
        "Q_min": {
          "type": "parameter",
          "units": "mol/m^3",
          "shape": [
            "ion"
          ],
          "default": [
            0.0,
            0.0
          ]
        },
        "k": {
          "type": "parameter",
          "units": "1/s",
          "default": 0.1
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "Q"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "*",
            "args": [
              {
                "op": "-",
                "args": [
                  "k"
                ]
              },
              "Q"
            ]
          }
        }
      ]
    }
  },
  "index_sets": {
    "salt": {
      "kind": "interval",
      "size": 2
    },
    "ion": {
      "kind": "interval",
      "size": 2
    }
  }
}
