{
  "esm": "1.2.0",
  "metadata": {
    "name": "ElementTypeOnNonCastNode",
    "description": "Invalid: `element_type` on a `*` node. It is legal only on a `cast` node (esm-spec §4.2); a variable's precision is declared on the variable.",
    "authors": [
      "Chris Tessum with Claude"
    ],
    "created": "2026-11-08T00:00:00Z"
  },
  "models": {
    "CastModel": {
      "variables": {
        "x": {
          "type": "parameter",
          "units": "1",
          "default": 0.1,
          "description": "A binary64 value."
        },
        "y": {
          "type": "unknown",
          "units": "1",
          "description": "Defined by a malformed cast."
        }
      },
      "equations": [
        {
          "lhs": "y",
          "rhs": {
            "op": "*",
            "element_type": "Float32",
            "args": [
              "x",
              2
            ]
          }
        }
      ]
    }
  }
}
