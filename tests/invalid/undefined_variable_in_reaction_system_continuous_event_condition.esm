      "EarthSciML"
    ],
    "created": "2026-09-15T00:00:00Z"
  },
  "reaction_systems": {
    "TestReactions": {
      "species": {
        "A": {
          "units": "mol/L",
          "default": 1.0,
          "description": "Reactant."
        },
        "B": {
          "units": "mol/L",
          "default": 0.0,
          "description": "Product."
        }
      },
      "parameters": {
        "k": {
          "units": "1/s",
          "default": 0.1,
          "description": "First-order rate constant."
        }
      },
      "reactions": [
        {
          "id": "R1",
          "substrates": [
            {
              "species": "A",
              "stoichiometry": 1
            }
          ],
          "products": [
            {
              "species": "B",
              "stoichiometry": 1
            }
          ],
          "rate": "k"
        }
      ],
      "continuous_events": [
        {
          "name": "evt",
          "conditions": [
            {
              "op": "-",
              "args": [
                "undefined_xyz",
                1.0
              ]
            }
          ],
          "affects": [
            {
              "lhs": "A",
              "rhs": 1.0
            }
          ]
        }
      ]
    }
  }
