    "Outer": {
      "variables": {},
      "equations": [],
      "subsystems": {
        "A": {
          "ref": "../conformance/url_substitutions/catalogue/catalogue.esm",
          "url_substitutions": {
            "snapshot": "a"
          }
        },
        "B": {
          "ref": "../conformance/url_substitutions/catalogue/catalogue.esm",
          "url_substitutions": {
            "snapshot": "b"
          }
        }
      }
    }
  }
}
