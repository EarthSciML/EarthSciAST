{
  "esm": "1.2.0",
  "metadata": {
    "name": "FaqBareArrayOperandFilter",
    "description": "INVALID: a `faq` `filter` reads the shaped variable `a_val` (declared over `a_rows`) by bare name (issue #441). A faq names its axes by its range symbols and evaluates its filter once per index tuple, so the bare array does not say which symbol its axis is. One evaluator aligned it to the output box by position and, the ranks differing (one axis against two output indices), kept every term: the filter was silently ignored and row 1, which `a_val > 1.5` excludes, came out 10, 20 instead of 0, 0. Another let array broadcasting align it with the box's LAST axis. Rejected by validate() with `faq_bare_array_operand` (esm-spec \u00a74.3.1). The positive control is the same filter spelled `index(a_val, i)`: tests/conformance/faq_pointwise_filter/fixtures/indexed_filter_two_outputs.esm.",
    "authors": [
      "EarthSciML Authors and Contributors"
    ],
    "tags": [
      "faq",
      "filter",
      "invalid"
    ]
  },
  "index_sets": {
    "a_rows": {
      "kind": "interval",
      "size": 3
    },
    "c_rows": {
      "kind": "interval",
      "size": 2
    }
  },
  "models": {
    "Probe": {
      "variables": {
        "a_val": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "a_rows"
          ],
          "description": "1, 2, 3"
        },
        "c_val": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "c_rows"
          ],
          "description": "10, 20"
        },
        "two_outputs": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "a_rows",
            "c_rows"
          ],
          "description": "a_val[i] * c_val[g] where a_val > 1.5 -- the filter names a_val bare"
        }
      },
      "equations": [
        {
          "lhs": "a_val",
          "rhs": {
            "op": "const",
            "args": [],
            "value": [
              1.0,
              2.0,
              3.0
            ]
          }
        },
        {
          "lhs": "c_val",
          "rhs": {
            "op": "const",
            "args": [],
            "value": [
              10.0,
              20.0
            ]
          }
        },
        {
          "lhs": "two_outputs",
          "rhs": {
            "op": "faq",
            "args": [],
            "semiring": "sum_product",
            "output_idx": [
              "i",
              "g"
            ],
            "ranges": {
              "i": {
                "from": "a_rows"
              },
              "g": {
                "from": "c_rows"
              }
            },
            "filter": {
              "op": "ifelse",
              "args": [
                {
                  "op": ">",
                  "args": [
                    "a_val",
                    1.5
                  ]
                },
                1.0,
                0.0
              ]
            },
            "expr": {
              "op": "*",
              "args": [
                {
                  "op": "index",
                  "args": [
                    "a_val",
                    "i"
                  ]
                },
                {
                  "op": "index",
                  "args": [
                    "c_val",
                    "g"
                  ]
                }
              ]
            }
          }
        }
      ]
    }
  }
}
