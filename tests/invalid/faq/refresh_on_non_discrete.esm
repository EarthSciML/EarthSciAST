{
  "esm": "1.0.0",
  "metadata": {
    "name": "refresh_on_non_discrete",
    "description": "INVALID (bead ess-my4.3.2; RFC semiring-faq-unified-ir §6.1 / §8), restated for esm 1.0.0: an `update` block placed on an UNKNOWN. From 1.0.0 an `update` says when a PARAMETER refreshes and what from (esm-spec §5.4); an unknown's behavior is stated by the model's `equations` and nowhere else, so the ModelVariable schema's conditional `allOf` forbids both `update` and `distribution` whenever `type` is not \"parameter\" (the guard the pre-1.0.0 schema spelled as brownian-only `noise_kind` / `correlation_group` and discrete-only `refresh`). Attaching an update to an unknown is a pure schema violation — caught by every binding. A `condition` update is used so that no OTHER rule fires: it is well-formed on its own terms (a boolean `when` plus exactly one value form) and, unlike `schedule` / `data` / `remesh`, carries no `shape` requirement. The only failure cause is therefore its placement on a non-parameter.",
    "authors": [
      "EarthSciAST/polecats/gastown.capable"
    ],
    "tags": [
      "parameter-update",
      "discrete-cadence",
      "refresh-trigger",
      "invalid",
      "schema"
    ]
  },
  "models": {
    "BadRefresh": {
      "variables": {
        "u": {
          "type": "unknown",
          "description": "A continuous unknown that wrongly carries a parameter `update` block — invalid.",
          "update": {
            "kind": "condition",
            "when": {
              "op": ">",
              "args": [
                "u",
                1.0
              ]
            },
            "expression": 0.0
          }
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "u"
            ],
            "wrt": "t"
          },
          "rhs": -1
        }
      ]
    }
  }
}
