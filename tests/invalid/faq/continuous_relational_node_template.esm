{
  "esm": "1.1.0",
  "metadata": {
    "name": "continuous_relational_nodeTemplate",
    "description": "The continuous_relational_node.esm document with its one-component skolem key written as the bare integer expression u[f] (the template rewrite of a one-component key, lib/relational.esm rulings). The producer still reads the state u, so it is refused exactly as the skolem form is.",
    "authors": [
      "EarthSciAST/polecats/gastown.furiosa"
    ],
    "tags": [
      "faq",
      "cadence-partition",
      "value-invention",
      "invalid",
      "resolver"
    ]
  },
  "index_sets": {
    "faces": {
      "kind": "interval",
      "size": 4
    }
  },
  "models": {
    "ContinuousRelationalNode": {
      "variables": {
        "u": {
          "type": "unknown"
        },
        "edge_exists": {
          "type": "unknown"
        }
      },
      "equations": [
        {
          "_comment": "REJECTED by §5.7 guard 2: this distinct/value-invention node reads the state variable u in its Skolem key, so class(node) = CONTINUOUS. Relational work may not run on the per-step hot path; declare the leaves CONST (document literals) or DISCRETE (a `discrete` variable refreshed at events) instead.",
          "lhs": {
            "op": "index",
            "args": [
              "edge_exists",
              "e"
            ]
          },
          "rhs": {
            "op": "faq",
            "args": [],
            "distinct": true,
            "semiring": "bool_and_or",
            "output_idx": [
              "e"
            ],
            "ranges": {
              "f": {
                "from": "faces"
              }
            },
            "key": {
              "op": "index",
              "args": [
                "u",
                "f"
              ]
            },
            "expr": {
              "op": "true",
              "args": []
            }
          }
        },
        {
          "_comment": "An ordinary continuous decay so u is a well-formed state with an ODE alongside the (rejected) value-invention node above.",
          "lhs": {
            "op": "D",
            "args": [
              "u"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "-",
            "args": [
              "u"
            ]
          }
        }
      ]
    }
  }
}
