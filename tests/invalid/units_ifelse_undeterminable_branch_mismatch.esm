{
  "esm": "1.0.0",
  "metadata": {
    "name": "UnitsIfelseUndeterminableBranchMismatch",
    "description": "Invalid: declares a mass equal to ifelse(c > 0, x [m], 0.5 * y [m]). The else branch 0.5 * y is undeterminable, but an undeterminable branch is skipped and the ifelse has the unit of its determinable branch, m (esm-spec §4.8.3), so the declaration is a provable mismatch.",
    "authors": [
      "Chris Tessum with Claude"
    ],
    "created": "2026-09-15T00:00:00Z"
  },
  "models": {
    "BadUnitsModel": {
      "variables": {
        "x": {
          "type": "parameter",
          "units": "m",
          "default": 2.0,
          "description": "A length"
        },
        "y": {
          "type": "parameter",
          "units": "m",
          "default": 3.0,
          "description": "Another length"
        },
        "c": {
          "type": "parameter",
          "units": "1",
          "default": 1.0,
          "description": "A dimensionless switch"
        },
        "total_mass": {
          "type": "unknown",
          "units": "kg",
          "description": "Invalid: declared in kg but defined as a length"
        }
      },
      "equations": [
        {
          "lhs": "total_mass",
          "rhs": {
            "op": "ifelse",
            "args": [
              {
                "op": ">",
                "args": [
                  "c",
                  0
                ]
              },
              "x",
              {
                "op": "*",
                "args": [
                  0.5,
                  "y"
                ]
              }
            ]
          }
        }
      ]
    }
  }
}
