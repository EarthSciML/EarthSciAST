{
  "esm": "1.0.0",
  "metadata": {
    "name": "UnknownOverrideKeyReactionSystem",
    "description": "Invalid: a REACTION SYSTEM test's `parameter_overrides` key `kx` matches no declared name (esm-spec §6.6.2). The system declares the parameter `k`; `kx` is a typo of it, and no flattened name is or ends with `kx`. Before this check the key was named only when a runtime built the system; a validator accepted the document. Expected error: unknown_override_key @ /reaction_systems/TestReactions/tests/0/parameter_overrides/kx.",
    "authors": [
      "EarthSciML"
    ],
    "created": "2026-09-15T00:00:00Z"
  },
  "reaction_systems": {
    "TestReactions": {
      "species": {
        "A": {
          "units": "mol/L",
          "default": 1.0,
          "description": "Reactant."
        },
        "B": {
          "units": "mol/L",
          "default": 0.0,
          "description": "Product."
        }
      },
      "parameters": {
        "k": {
          "units": "1/s",
          "default": 0.1,
          "description": "First-order rate constant."
        }
      },
      "reactions": [
        {
          "id": "R1",
          "substrates": [
            {
              "species": "A",
              "stoichiometry": 1
            }
          ],
          "products": [
            {
              "species": "B",
              "stoichiometry": 1
            }
          ],
          "rate": "k"
        }
      ],
      "tests": [
        {
          "id": "t0",
          "time_span": {
            "start": 0.0,
            "end": 1.0
          },
          "parameter_overrides": {
            "kx": 0.2
          },
          "assertions": [
            {
              "variable": "A",
              "time": 1.0,
              "expected": 0.8187
            }
          ]
        }
      ]
    }
  }
}
