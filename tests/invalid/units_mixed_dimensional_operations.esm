{
  "esm": "1.0.0",
  "metadata": {
    "name": "UnitsMixedDimensionalOperations",
    "description": "Invalid file demonstrating multiple unit inconsistencies in the same model (addition of incompatible units and a dimensionless function applied to a dimensional argument)",
    "authors": [
      "Chris Tessum with Claude"
    ],
    "created": "2026-04-16T00:00:00Z"
  },
  "models": {
    "ComplexUnitsModel": {
      "variables": {
        "length": {
          "type": "parameter",
          "units": "m",
          "default": 2.0,
          "description": "Length"
        },
        "mass": {
          "type": "parameter",
          "units": "kg",
          "default": 3.0,
          "description": "Mass"
        },
        "acceleration": {
          "type": "parameter",
          "units": "m/s^2",
          "default": 9.81,
          "description": "Acceleration"
        },
        "area_like": {
          "type": "unknown",
          "units": "m^2",
          "description": "Squared length"
        },
        "force_like": {
          "type": "unknown",
          "units": "kg*m/s^2",
          "description": "Mass times acceleration"
        },
        "invalid_sum": {
          "type": "unknown",
          "units": "1",
          "description": "Invalid: adds m^2 (area_like) to kg*m/s^2 (force_like) — unit inconsistency #1"
        },
        "invalid_transcendental": {
          "type": "unknown",
          "units": "1",
          "description": "Invalid: exp() requires dimensionless argument but 'mass' has units 'kg' — unit inconsistency #2"
        }
      },
      "equations": [
        {
          "lhs": "area_like",
          "rhs": {
            "op": "^",
            "args": [
              "length",
              2
            ]
          }
        },
        {
          "lhs": "force_like",
          "rhs": {
            "op": "*",
            "args": [
              "mass",
              "acceleration"
            ]
          }
        },
        {
          "lhs": "invalid_sum",
          "rhs": {
            "op": "+",
            "args": [
              "area_like",
              "force_like"
            ]
          }
        },
        {
          "lhs": "invalid_transcendental",
          "rhs": {
            "op": "exp",
            "args": [
              "mass"
            ]
          }
        }
      ]
    }
  }
}
