{
  "esm": "1.0.0",
  "metadata": {
    "name": "UnitsComparisonMismatchUnderNot",
    "description": "Invalid: a dimensionless flag is not(x > z), which compares a length with a mass. The not is dimensionless, but the mismatch inside its operand is still reported (esm-spec §4.8.3).",
    "authors": [
      "Chris Tessum with Claude"
    ],
    "created": "2026-09-15T00:00:00Z"
  },
  "models": {
    "BadUnitsModel": {
      "variables": {
        "x": {
          "type": "parameter",
          "units": "m",
          "default": 2.0,
          "description": "A length"
        },
        "y": {
          "type": "parameter",
          "units": "m",
          "default": 3.0,
          "description": "Another length"
        },
        "z": {
          "type": "parameter",
          "units": "kg",
          "default": 4.0,
          "description": "A mass"
        },
        "c": {
          "type": "parameter",
          "units": "1",
          "default": 1.0,
          "description": "A dimensionless switch"
        },
        "flag": {
          "type": "unknown",
          "units": "1",
          "description": "Invalid: the negation of a comparison of m with kg"
        }
      },
      "equations": [
        {
          "lhs": "flag",
          "rhs": {
            "op": "not",
            "args": [
              {
                "op": ">",
                "args": [
                  "x",
                  "z"
                ]
              }
            ]
          }
        }
      ]
    }
  }
}
