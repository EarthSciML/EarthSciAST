{
  "esm": "1.0.0",
  "metadata": {
    "name": "UndefinedVariableInUnitConversion",
    "description": "Invalid: an undefined variable inside a data-source binding's `unit_conversion` expression (esm-spec 8.5). Reference integrity must apply to EVERY expression-bearing field, not just `equations` (esm-spec 4.9.5). `y` and `k` are declared; the ONLY defect is the undefined name `undefined_xyz`. The file is schema-valid, so it reaches structural validation (CONFORMANCE_SPEC 7.1.2). Expected error: undefined_variable @ /models/TestModel/variables/v/update/from/unit_conversion.",
    "authors": [
      "EarthSciML"
    ],
    "created": "2026-07-14T00:00:00Z"
  },
  "models": {
    "TestModel": {
      "variables": {
        "y": {
          "type": "unknown",
          "units": "1",
          "description": "State."
        },
        "k": {
          "type": "parameter",
          "units": "1/s",
          "default": 1.0,
          "description": "Declared parameter."
        },
        "v": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "shape": [],
          "update": {
            "kind": "data",
            "source": "L",
            "from": {
              "file_variable": "v",
              "unit_conversion": {
                "op": "*",
                "args": [
                  "k",
                  "undefined_xyz"
                ]
              }
            }
          },
          "description": "Loaded parameter whose unit_conversion names `undefined_xyz`."
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "y"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "*",
            "args": [
              {
                "op": "-",
                "args": [
                  "k"
                ]
              },
              "y"
            ]
          }
        }
      ]
    }
  },
  "data_sources": {
    "L": {
      "kind": "grid",
      "source": {
        "url_template": "file:///data/{date:%Y%m%d}.nc"
      }
    }
  }
}
