{
  "esm": "1.0.0",
  "metadata": {
    "name": "FunctionTable_outputs_length_mismatch",
    "description": "Table `T` declares two outputs but `data` has one slab (step 7), and that slab has three values over a two-value axis (step 8); step 7 is reported. No `table_lookup` references `T`.",
    "authors": [
      "EarthSciML"
    ],
    "created": "2026-10-27T00:00:00Z"
  },
  "function_tables": {
    "T": {
      "axes": [
        {
          "name": "x",
          "values": [
            0,
            1
          ]
        }
      ],
      "interpolation": "linear",
      "outputs": [
        "a",
        "b"
      ],
      "data": [
        [
          1,
          2,
          3
        ]
      ]
    }
  },
  "models": {
    "M": {
      "variables": {
        "y": {
          "type": "unknown",
          "units": "1",
          "default": 1.0
        },
        "x": {
          "type": "parameter",
          "units": "1",
          "default": 0.5
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "y"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "*",
            "args": [
              -1.0,
              "y"
            ]
          }
        }
      ]
    }
  }
}
