{
  "esm": "1.0.0",
  "metadata": {
    "name": "UnitsComparisonMismatchInIfelseCondition",
    "description": "Invalid: the condition of an ifelse compares a length with a mass. The condition's own unit does not enter the result, but it is still checked (esm-spec §4.8.3), so the mismatch inside it is an error.",
    "authors": [
      "Chris Tessum with Claude"
    ],
    "created": "2026-09-15T00:00:00Z"
  },
  "models": {
    "BadUnitsModel": {
      "variables": {
        "x": {
          "type": "parameter",
          "units": "m",
          "default": 2.0,
          "description": "A length"
        },
        "y": {
          "type": "parameter",
          "units": "m",
          "default": 3.0,
          "description": "Another length"
        },
        "z": {
          "type": "parameter",
          "units": "kg",
          "default": 4.0,
          "description": "A mass"
        },
        "c": {
          "type": "parameter",
          "units": "1",
          "default": 1.0,
          "description": "A dimensionless switch"
        },
        "selected": {
          "type": "unknown",
          "units": "m",
          "description": "Invalid: selected by a condition that compares m with kg"
        }
      },
      "equations": [
        {
          "lhs": "selected",
          "rhs": {
            "op": "ifelse",
            "args": [
              {
                "op": ">",
                "args": [
                  "x",
                  "z"
                ]
              },
              "x",
              "y"
            ]
          }
        }
      ]
    }
  }
}
