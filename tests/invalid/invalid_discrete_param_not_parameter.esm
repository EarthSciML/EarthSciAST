{
  "esm": "1.0.0",
  "metadata": {
    "name": "InvalidDiscreteParamNotParameter",
    "description": "A periodic discrete event writes the parameter 'k'. esm 1.0.0 events may affect unknowns only — a rate that decays over the run declares update: {kind: \"schedule\", interval: 60.0, …} on itself (esm-spec §5.4) — so this is `event_affects_parameter`."
  },
  "models": {
    "TestModel": {
      "variables": {
        "x": { "type": "unknown", "units": "mol", "default": 1.0 },
        "k": { "type": "parameter", "units": "1/s", "default": 0.1 }
      },
      "equations": [
        {
          "lhs": { "op": "D", "args": ["x"], "wrt": "t" },
          "rhs": { "op": "*", "args": [-1, "k", "x"] }
        }
      ],
      "discrete_events": [
        {
          "name": "invalid_discrete_update",
          "trigger": {
            "type": "periodic",
            "interval": 60.0
          },
          "affects": [
            {
              "lhs": "k",
              "rhs": { "op": "*", "args": [1.1, "k"] }
            }
          ]
        }
      ]
    }
  }
}