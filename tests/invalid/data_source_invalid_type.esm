{
  "esm": "1.0.0",
  "metadata": {
    "name": "DataSourceInvalidKind",
    "description": "Test case: data source with invalid kind (not one of: grid, points, static).",
    "authors": [
      "Test Suite"
    ]
  },
  "data_sources": {
    "BadLoader": {
      "kind": "invalid_kind",
      "source": {
        "url_template": "file:///data/{date:%Y%m%d}.nc"
      }
    }
  },
  "models": {
    "TestModel": {
      "variables": {
        "x": {
          "type": "unknown",
          "units": "1",
          "default": 1.0
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "x"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "*",
            "args": [
              -0.1,
              "x"
            ]
          }
        }
      ]
    }
  }
}
