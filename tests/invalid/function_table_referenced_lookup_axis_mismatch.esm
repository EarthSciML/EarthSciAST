{
  "esm": "1.0.0",
  "metadata": {
    "name": "FunctionTable_referenced_lookup_axis_mismatch",
    "description": "Ruling Q-107: the table a `table_lookup` names is checked before the lookup's own args, axis keys and output. Table `T`'s axis is decreasing, and the one `table_lookup` that references `T` binds an axis `z` the table does not declare (`table_lookup_axis_name_mismatch`) and asks for output 3 of a single-output table (`table_lookup_output_out_of_range`). The table's code is reported.",
    "authors": [
      "EarthSciML"
    ],
    "created": "2026-10-27T00:00:00Z"
  },
  "function_tables": {
    "T": {
      "axes": [
        {
          "name": "x",
          "values": [
            2,
            1,
            0
          ]
        }
      ],
      "interpolation": "linear",
      "data": [
        1,
        2,
        3
      ]
    }
  },
  "models": {
    "M": {
      "variables": {
        "y": {
          "type": "unknown",
          "units": "1",
          "default": 1.0
        },
        "x": {
          "type": "parameter",
          "units": "1",
          "default": 0.5
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "y"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "table_lookup",
            "table": "T",
            "axes": {
              "z": "x"
            },
            "output": 3,
            "args": []
          }
        }
      ]
    }
  }
}
