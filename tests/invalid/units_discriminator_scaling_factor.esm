{
  "esm": "1.0.0",
  "metadata": {
    "name": "UnitsDiscriminatorScalingFactor",
    "description": "Invalid: a unit string denotes a UNIT, not a QUANTITY, so a numeric atom is admissible only when its value is exactly 1 (esm-spec §4.8.2). `wind_minus_third` declares `(m/s)^-1/3` -- which is what an author writes when reaching for a rational exponent, and is NOT what the grammar reads. `*` and `/` are one precedence level and an unparenthesised exponent stops at the first `/`, so the string parses as `((m/s)^-1) / 3`: a scaling factor of one third applied to s/m. This file is the NEGATIVE half of a real four-way divergence. The same string used to be accepted by four bindings and rejected by one, and the four that accepted it did not agree with each other: Julia returned s/m with the 1/3 SILENTLY DROPPED, Rust, Go and TypeScript returned s/m with the 1/3 RETAINED, and Python refused the whole string. None of the four is the (s/m)^(1/3) the author meant, and the two that differ in scale differ INVISIBLY -- a dimensional checker cannot see a scale. It was found in a real document: isrm.esm declared `(m/s)^-1/3` on InMAP's precomputed u^(-1/3) meteorology field, and the document loaded in Julia and failed in Python. The correct spelling of that unit is `(m/s)^(-1/3)`, which every binding reads the same way; see tests/conformance/unit_registry for the positive half. A binding that carries the old behaviour ACCEPTS this file; a correct binding REJECTS it with a diagnostic that names the scaling factor.",
    "authors": [
      "Chris Tessum with Claude"
    ],
    "created": "2026-08-19T00:00:00Z",
    "tags": [
      "units",
      "grammar",
      "scaling-factor",
      "rational-exponents",
      "conformance"
    ]
  },
  "models": {
    "BadUnitsModel": {
      "variables": {
        "y": {
          "type": "unknown",
          "units": "1",
          "default": 1.0,
          "description": "State. Dimensionally clean; not part of the defect."
        },
        "k": {
          "type": "parameter",
          "units": "1/s",
          "default": 1.0,
          "description": "Decay rate. Dimensionally clean; not part of the defect -- and note that its leading `1` IS a legal numeric atom, which is the whole reason the grammar admits a number at all."
        },
        "wind_minus_third": {
          "type": "parameter",
          "units": "(m/s)^-1/3",
          "default": 1.0,
          "description": "THE ONLY DEFECT: a unit string carrying a numeric scaling factor. Write `(m/s)^(-1/3)`."
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "y"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "*",
            "args": [
              {
                "op": "-",
                "args": [
                  "k"
                ]
              },
              "y"
            ]
          }
        }
      ]
    }
  }
}
