{
  "esm": "1.0.0",
  "metadata": {
    "name": "TemporalRecordsPerFileInvalid",
    "description": "Test case: data source temporal.records_per_file must be a positive integer or the string \"auto\".",
    "authors": [
      "Test Suite"
    ]
  },
  "data_sources": {
    "BadTemporal": {
      "kind": "points",
      "source": {
        "url_template": "file:///data/{date:%Y%m%d}.csv"
      },
      "temporal": {
        "frequency": "PT1H",
        "records_per_file": "not_auto"
      }
    }
  },
  "models": {
    "TestModel": {
      "variables": {
        "x": {
          "type": "unknown",
          "units": "1",
          "default": 1.0
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "x"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "*",
            "args": [
              -0.1,
              "x"
            ]
          }
        }
      ]
    }
  }
}
