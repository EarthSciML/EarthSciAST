{
  "esm": "1.0.0",
  "metadata": {
    "name": "InvalidDiscreteParamTest",
    "description": "Test case: a discrete event writes a PARAMETER. esm 1.0.0 events may affect unknowns only — a parameter that changes during a run carries its own `update` block (esm-spec §5.4) — so this is `event_affects_parameter`.",
    "authors": [
      "Test Suite"
    ]
  },
  "models": {
    "TestModel": {
      "variables": {
        "x": {
          "type": "unknown",
          "units": "1",
          "default": 1.0
        },
        "valid_param": {
          "type": "parameter",
          "units": "1",
          "default": 0.5
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "x"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "*",
            "args": [
              "valid_param",
              "x"
            ]
          }
        }
      ],
      "discrete_events": [
        {
          "name": "parameter_update",
          "trigger": {
            "type": "condition",
            "expression": {
              "op": ">",
              "args": [
                "x",
                2.0
              ]
            }
          },
          "affects": [
            {
              "lhs": "valid_param",
              "rhs": 0.1
            }
          ],
          "description": "This should fail - 'valid_param' is a parameter, and an event may affect unknowns only"
        }
      ]
    }
  },
  "domain": {
    "temporal": {
      "start": "2024-01-01T00:00:00Z",
      "end": "2024-01-01T00:01:00Z"
    }
  }
}
