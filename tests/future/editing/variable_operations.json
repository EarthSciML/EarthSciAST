[
  {
    "description": "Add state variable to existing model",
    "operation": "add_variable",
    "input_model": {
      "variables": {
        "x": {
          "type": "unknown",
          "units": "mol/mol",
          "default": 1e-09,
          "description": "Existing variable"
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "x"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "*",
            "args": [
              0.1,
              "x"
            ]
          }
        }
      ]
    },
    "parameters": {
      "name": "y",
      "variable": {
        "type": "state",
        "units": "mol/mol",
        "default": 2e-09,
        "description": "New state variable"
      }
    },
    "expected_model": {
      "variables": {
        "x": {
          "type": "unknown",
          "units": "mol/mol",
          "default": 1e-09,
          "description": "Existing variable"
        },
        "y": {
          "type": "unknown",
          "units": "mol/mol",
          "default": 2e-09,
          "description": "New state variable"
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "x"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "*",
            "args": [
              0.1,
              "x"
            ]
          }
        }
      ]
    },
    "expected_warnings": []
  },
