{
  "esm": "1.0.0",
  "metadata": {
    "name": "CircularExpressionRefs",
    "description": "Test circular reference detection in expressions within the same system",
    "authors": [
      "Security Test"
    ]
  },
  "models": {
    "TestModel": {
      "variables": {
        "x": {
          "type": "unknown",
          "units": "m",
          "default": 1.0
        },
        "y": {
          "type": "unknown",
          "units": "m"
        },
        "z": {
          "type": "unknown",
          "units": "m"
        },
        "w": {
          "type": "unknown",
          "units": "m"
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "x"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "+",
            "args": [
              "y",
              "z",
              "w"
            ]
          }
        },
        {
          "lhs": "y",
          "rhs": {
            "op": "+",
            "args": [
              "z",
              1.0
            ]
          }
        },
        {
          "lhs": "z",
          "rhs": {
            "op": "*",
            "args": [
              "w",
              2.0
            ]
          }
        },
        {
          "lhs": "w",
          "rhs": {
            "op": "-",
            "args": [
              "y",
              0.5
            ]
          }
        }
      ]
    }
  }
}
