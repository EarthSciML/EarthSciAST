{
  "esm": "1.0.0",
  "metadata": {
    "name": "ElasticCollisionValidation",
    "description": "Two-body elastic collision whose continuous event exchanges momentum between the bodies. Split out of mathematical_correctness.esm so that document's other components do not share a document with a continuous event: evaluators that do not run continuous events refuse the whole document (esm-spec \u00a79.6.6 unsupported_construct).",
    "authors": [
      "ESM Test Suite"
    ],
    "created": "2026-02-14T00:00:00Z",
    "tags": [
      "mathematical-correctness",
      "conservation",
      "events",
      "continuous"
    ]
  },
  "models": {
    "MomentumConservation": {
      "reference": {
        "notes": "Two-body collision with momentum and energy conservation"
      },
      "variables": {
        "x1": {
          "type": "unknown",
          "units": "m",
          "default": -1.0,
          "description": "Position of mass 1"
        },
        "x2": {
          "type": "unknown",
          "units": "m",
          "default": 1.0,
          "description": "Position of mass 2"
        },
        "v1": {
          "type": "unknown",
          "units": "m/s",
          "default": 1.0,
          "description": "Velocity of mass 1"
        },
        "v2": {
          "type": "unknown",
          "units": "m/s",
          "default": -0.5,
          "description": "Velocity of mass 2"
        },
        "m1": {
          "type": "parameter",
          "units": "kg",
          "default": 1.0,
          "description": "Mass 1"
        },
        "m2": {
          "type": "parameter",
          "units": "kg",
          "default": 2.0,
          "description": "Mass 2"
        },
        "total_momentum": {
          "type": "unknown",
          "units": "kg\u22c5m/s",
          "description": "Total momentum (conserved)"
        },
        "total_kinetic_energy": {
          "type": "unknown",
          "units": "J",
          "description": "Total kinetic energy"
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "x1"
            ],
            "wrt": "t"
          },
          "rhs": "v1"
        },
        {
          "lhs": {
            "op": "D",
            "args": [
              "x2"
            ],
            "wrt": "t"
          },
          "rhs": "v2"
        },
        {
          "lhs": {
            "op": "D",
            "args": [
              "v1"
            ],
            "wrt": "t"
          },
          "rhs": 0.0
        },
        {
          "lhs": {
            "op": "D",
            "args": [
              "v2"
            ],
            "wrt": "t"
          },
          "rhs": 0.0
        },
        {
          "lhs": {
            "op": "ic",
            "args": [
              "x1"
            ]
          },
          "rhs": -1.0
        },
        {
          "lhs": {
            "op": "ic",
            "args": [
              "x2"
            ]
          },
          "rhs": 1.0
        },
        {
          "lhs": {
            "op": "ic",
            "args": [
              "v1"
            ]
          },
          "rhs": 1.0
        },
        {
          "lhs": {
            "op": "ic",
            "args": [
              "v2"
            ]
          },
          "rhs": -0.5
        },
        {
          "lhs": "total_momentum",
          "rhs": {
            "op": "+",
            "args": [
              {
                "op": "*",
                "args": [
                  "m1",
                  "v1"
                ]
              },
              {
                "op": "*",
                "args": [
                  "m2",
                  "v2"
                ]
              }
            ]
          }
        },
        {
          "lhs": "total_kinetic_energy",
          "rhs": {
            "op": "+",
            "args": [
              {
                "op": "*",
                "args": [
                  0.5,
                  "m1",
                  {
                    "op": "^",
                    "args": [
                      "v1",
                      2
                    ]
                  }
                ]
              },
              {
                "op": "*",
                "args": [
                  0.5,
                  "m2",
                  {
                    "op": "^",
                    "args": [
                      "v2",
                      2
                    ]
                  }
                ]
              }
            ]
          }
        }
      ],
      "continuous_events": [
