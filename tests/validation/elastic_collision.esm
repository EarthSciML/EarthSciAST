              "args": [
                "x1",
                "x2"
              ]
            }
          ],
          "affects": [
            {
              "lhs": "v1",
              "rhs": {
                "op": "/",
                "args": [
                  {
                    "op": "+",
                    "args": [
                      {
                        "op": "*",
                        "args": [
                          {
                            "op": "-",
                            "args": [
                              "m1",
                              "m2"
                            ]
                          },
                          {
                            "op": "Pre",
                            "args": [
                              "v1"
                            ]
                          }
                        ]
                      },
                      {
                        "op": "*",
                        "args": [
                          2,
                          "m2",
                          {
                            "op": "Pre",
                            "args": [
                              "v2"
                            ]
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "op": "+",
                    "args": [
                      "m1",
                      "m2"
                    ]
                  }
                ]
              }
            },
            {
              "lhs": "v2",
              "rhs": {
                "op": "/",
                "args": [
                  {
                    "op": "+",
                    "args": [
                      {
                        "op": "*",
                        "args": [
                          {
                            "op": "-",
                            "args": [
                              "m2",
                              "m1"
                            ]
                          },
                          {
                            "op": "Pre",
                            "args": [
                              "v2"
                            ]
                          }
                        ]
                      },
                      {
                        "op": "*",
                        "args": [
                          2,
                          "m1",
                          {
                            "op": "Pre",
                            "args": [
                              "v1"
                            ]
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "op": "+",
                    "args": [
                      "m1",
                      "m2"
                    ]
                  }
                ]
              }
