{
  "esm": "1.0.0",
  "metadata": {
    "name": "MathematicalCorrectnessValidation",
    "description": "Test mathematical correctness verification across all operations",
    "authors": [
      "ESM Test Suite"
    ],
    "created": "2026-02-14T00:00:00Z",
    "tags": [
      "mathematical-correctness",
      "conservation",
      "verification"
    ]
  },
  "reaction_systems": {
    "MassConservationTest": {
      "reference": {
        "notes": "Test mass conservation in chemical reaction networks"
      },
      "species": {
        "A": {
          "units": "mol",
          "default": 1.0,
          "description": "Reactant A"
        },
        "B": {
          "units": "mol",
          "default": 0.0,
          "description": "Product B"
        },
        "C": {
          "units": "mol",
          "default": 0.0,
          "description": "Product C"
        }
      },
      "parameters": {
        "k1": {
          "units": "1/s",
          "default": 0.1,
          "description": "Forward rate"
        },
        "k2": {
          "units": "1/s",
          "default": 0.05,
          "description": "Reverse rate"
        },
        "k3": {
          "units": "1/s",
          "default": 0.02,
          "description": "Side reaction rate"
        }
      },
      "reactions": [
        {
          "id": "R1",
          "name": "forward_reaction",
          "substrates": [
            {
              "species": "A",
              "stoichiometry": 1
            }
          ],
          "products": [
            {
              "species": "B",
              "stoichiometry": 1
            }
          ],
          "rate": "k1"
        },
        {
          "id": "R2",
          "name": "reverse_reaction",
          "substrates": [
            {
              "species": "B",
              "stoichiometry": 1
            }
          ],
          "products": [
            {
              "species": "A",
              "stoichiometry": 1
            }
          ],
          "rate": "k2"
        },
        {
          "id": "R3",
          "name": "side_reaction",
          "substrates": [
            {
              "species": "A",
              "stoichiometry": 1
            }
          ],
          "products": [
            {
              "species": "C",
              "stoichiometry": 1
            }
          ],
          "rate": "k3"
        }
      ]
    },
    "StoichiometricBalance": {
      "reference": {
        "notes": "Test complex stoichiometric balancing: 2A + B \u2192 3C + D"
      },
      "species": {
        "A": {
          "units": "mol",
          "default": 2.0,
          "description": "Reactant A"
        },
        "B": {
          "units": "mol",
          "default": 1.0,
          "description": "Reactant B"
        },
        "C": {
          "units": "mol",
          "default": 0.0,
          "description": "Product C"
        },
        "D": {
          "units": "mol",
          "default": 0.0,
          "description": "Product D"
        }
      },
      "parameters": {
        "rate_constant": {
          "units": "mol^-2/s",
          "default": 0.01,
          "description": "Bimolecular rate"
        }
      },
      "reactions": [
        {
          "id": "R1",
          "name": "complex_stoichiometry",
          "substrates": [
            {
              "species": "A",
              "stoichiometry": 2
            },
            {
              "species": "B",
              "stoichiometry": 1
            }
          ],
          "products": [
            {
              "species": "C",
              "stoichiometry": 3
            },
            {
              "species": "D",
              "stoichiometry": 1
            }
          ],
          "rate": {
            "op": "*",
            "args": [
              "rate_constant",
              {
                "op": "^",
                "args": [
                  "A",
                  2
                ]
              },
              "B"
            ]
          }
        }
      ]
    }
  },
  "models": {
    "EnergyConservation": {
      "reference": {
        "notes": "Test energy conservation in mechanical systems"
      },
      "variables": {
        "position": {
          "type": "unknown",
          "units": "m",
          "default": 1.0,
          "description": "Position coordinate"
        },
        "velocity": {
          "type": "unknown",
          "units": "m/s",
          "default": 0.0,
          "description": "Velocity"
        },
        "mass": {
          "type": "parameter",
          "units": "kg",
          "default": 1.0,
          "description": "System mass"
        },
        "spring_constant": {
          "type": "parameter",
          "units": "N/m",
          "default": 1.0,
          "description": "Spring constant"
        },
        "kinetic_energy": {
          "type": "unknown",
          "units": "J",
          "description": "Kinetic energy = \u00bdmv\u00b2"
        },
        "potential_energy": {
          "type": "unknown",
          "units": "J",
          "description": "Potential energy = \u00bdkx\u00b2"
        },
        "total_energy": {
          "type": "unknown",
          "units": "J",
          "description": "Total energy (conserved)"
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "position"
            ],
            "wrt": "t"
          },
          "rhs": "velocity"
        },
        {
          "lhs": {
            "op": "D",
            "args": [
              "velocity"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "*",
            "args": [
              {
                "op": "/",
                "args": [
                  {
                    "op": "-",
                    "args": [
                      "spring_constant"
                    ]
                  },
                  "mass"
                ]
              },
              "position"
            ]
          }
        },
        {
          "lhs": {
            "op": "ic",
            "args": [
              "position"
            ]
          },
          "rhs": 1.0
        },
        {
          "lhs": {
            "op": "ic",
            "args": [
              "velocity"
            ]
          },
          "rhs": 0.0
        },
        {
          "lhs": "kinetic_energy",
          "rhs": {
            "op": "*",
            "args": [
              0.5,
              "mass",
              {
                "op": "^",
                "args": [
                  "velocity",
                  2
                ]
              }
            ]
          }
        },
        {
          "lhs": "potential_energy",
          "rhs": {
            "op": "*",
            "args": [
              0.5,
              "spring_constant",
              {
                "op": "^",
                "args": [
                  "position",
                  2
                ]
              }
            ]
          }
        },
        {
          "lhs": "total_energy",
          "rhs": {
            "op": "+",
            "args": [
              "kinetic_energy",
              "potential_energy"
            ]
          }
        }
      ]
    },
    "LinearityTest": {
      "reference": {
        "notes": "Test linearity of differential operators"
      },
      "variables": {
        "u": {
          "type": "unknown",
          "units": "dimensionless",
          "default": 1.0
        },
        "v": {
          "type": "unknown",
          "units": "dimensionless",
          "default": 2.0
        },
        "alpha": {
          "type": "parameter",
          "units": "dimensionless",
          "default": 3.0
        },
        "beta": {
          "type": "parameter",
          "units": "dimensionless",
          "default": -1.5
        },
        "linear_combination": {
          "type": "unknown",
          "units": "dimensionless",
          "description": "\u03b1u + \u03b2v"
        },
        "derivative_of_combination": {
          "type": "unknown",
          "units": "1/s",
          "description": "d(\u03b1u + \u03b2v)/dt"
        },
        "combination_of_derivatives": {
          "type": "unknown",
          "units": "1/s",
          "description": "\u03b1(du/dt) + \u03b2(dv/dt)"
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "u"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "*",
            "args": [
              -0.1,
              "u"
            ]
          }
        },
        {
          "lhs": {
            "op": "D",
            "args": [
              "v"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "*",
            "args": [
              0.05,
              "v"
            ]
          }
        },
        {
          "lhs": {
            "op": "ic",
            "args": [
              "u"
            ]
          },
          "rhs": 1.0
        },
        {
          "lhs": {
            "op": "ic",
            "args": [
              "v"
            ]
          },
          "rhs": 2.0
        },
        {
          "lhs": "linear_combination",
          "rhs": {
            "op": "+",
            "args": [
              {
                "op": "*",
                "args": [
                  "alpha",
                  "u"
                ]
              },
              {
                "op": "*",
                "args": [
                  "beta",
                  "v"
                ]
              }
            ]
          }
        },
        {
          "lhs": "derivative_of_combination",
          "rhs": {
            "op": "D",
            "args": [
              "linear_combination"
            ],
            "wrt": "t"
          }
        },
        {
          "lhs": "combination_of_derivatives",
          "rhs": {
            "op": "+",
            "args": [
              {
                "op": "*",
                "args": [
                  "alpha",
                  {
                    "op": "D",
                    "args": [
                      "u"
                    ],
                    "wrt": "t"
                  }
                ]
              },
              {
                "op": "*",
                "args": [
                  "beta",
                  {
                    "op": "D",
                    "args": [
                      "v"
                    ],
                    "wrt": "t"
                  }
                ]
              }
            ]
          }
        }
      ],
      "tests": [
        {
          "id": "linearity_of_the_time_derivative",
          "description": "d(alpha*u + beta*v)/dt equals alpha*du/dt + beta*dv/dt. Both sides are written as observeds over a right-hand-side structural D, so this executes esm-spec \u00a74.2's resolution: the left one needs the CHAIN RULE through the observed `linear_combination`, the right one only the states' own tendencies. At t = 0, u = 1 and v = 2, so both are alpha*(-0.1*1) + beta*(0.05*2) = 3*(-0.1) + (-1.5)*(0.1) = -0.45. Before the rule was stated in full this model could not run at all: Python and Julia refused the left-hand observed and Rust answered 0 for it, which made the two sides differ and the linearity this fixture is named for untestable.",
          "time_span": {
            "start": 0.0,
            "end": 1.0
          },
          "tolerance": {
            "rel": 1e-08,
            "abs": 1e-10
          },
          "assertions": [
            {
              "variable": "linear_combination",
              "time": 0.0,
              "expected": 0.0
            },
            {
              "variable": "derivative_of_combination",
              "time": 0.0,
              "expected": -0.45
            },
            {
              "variable": "combination_of_derivatives",
              "time": 0.0,
              "expected": -0.45
            }
          ]
        }
      ]
    }
  },
  "domain": {
    "independent_variable": "t",
    "temporal": {
      "start": "2024-01-01T00:00:00Z",
      "end": "2024-01-01T01:00:00Z"
    },
    "element_type": "Float64"
  }
}
