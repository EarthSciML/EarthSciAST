{
  "esm": "1.0.0",
  "metadata": {
    "name": "CoupledAtmosphericSystem",
    "description": "Complete end-to-end test for fully coupled atmospheric chemistry with transport, deposition, emissions, and meteorology\nMigrated from ESM v0.1.0 to v0.2.0 via esm-migrate.",
    "authors": [
      "ESM Test Suite"
    ],
    "license": "MIT",
    "created": "2026-02-14T00:00:00Z",
    "modified": "2026-02-14T00:00:00Z",
    "tags": [
      "end-to-end",
      "atmospheric-chemistry",
      "transport",
      "coupling",
      "migrated_from_v01"
    ],
    "references": [
      {
        "citation": "End-to-end test fixture for complete Earth system model workflow validation",
        "notes": "Tests all coupling types, system assembly, cross-system variable flow, and operator composition"
      }
    ]
  },
  "models": {
    "AtmosphericChemistry": {
      "reference": {
        "notes": "NOx-O3-VOC photochemistry with temperature-dependent kinetics",
        "doi": "10.5194/acp-8-6365-2008"
      },
      "variables": {
        "O3": {
          "type": "unknown",
          "units": "mol/mol",
          "default": 4e-08,
          "description": "Ozone mixing ratio"
        },
        "NO": {
          "type": "unknown",
          "units": "mol/mol",
          "default": 5e-10,
          "description": "Nitric oxide mixing ratio"
        },
        "NO2": {
          "type": "unknown",
          "units": "mol/mol",
          "default": 2e-09,
          "description": "Nitrogen dioxide mixing ratio"
        },
        "HCHO": {
          "type": "unknown",
          "units": "mol/mol",
          "default": 1e-09,
          "description": "Formaldehyde mixing ratio"
        },
        "HO2": {
          "type": "unknown",
          "units": "mol/mol",
          "default": 1e-12,
          "description": "Peroxy radical mixing ratio"
        },
        "temperature": {
          "type": "parameter",
          "units": "K",
          "default": 298.15,
          "description": "Air temperature",
          "update": {
            "kind": "data",
            "source": "MeteorologicalFields",
            "from": {
              "file_variable": "temperature"
            }
          },
          "shape": []
        },
        "pressure": {
          "type": "parameter",
          "units": "Pa",
          "default": 101325.0,
          "description": "Air pressure",
          "update": {
            "kind": "data",
            "source": "MeteorologicalFields",
            "from": {
              "file_variable": "pressure"
            }
          },
          "shape": []
        },
        "humidity": {
          "type": "parameter",
          "units": "mol/mol",
          "default": 0.01,
          "description": "Water vapor mixing ratio",
          "update": {
            "kind": "data",
            "source": "MeteorologicalFields",
            "from": {
              "file_variable": "humidity"
            }
          },
          "shape": []
        },
        "k_NO_O3": {
          "type": "parameter",
          "units": "cm^3/molec/s",
          "default": 1.8e-12,
          "description": "Rate constant NO + O3 → NO2"
        },
        "M": {
          "type": "parameter",
          "units": "molec/cm^3",
          "default": 2.5e+19,
          "description": "Air number density. REQUIRED to close the dimensions: k_NO_O3 and k_HO2_NO are NUMBER-DENSITY bimolecular rate constants (cm^3/molec/s), but O3/NO/HO2 are MIXING RATIOS (mol/mol, dimensionless). k*chi*chi is cm^3/molec/s -- a volume per time -- where d(mol/mol)/dt needs 1/s. Multiplying by M converts the number-density rate to a mixing-ratio rate: k[cm^3/molec/s] * M[molec/cm^3] = 1/s."
        },
        "jNO2": {
          "type": "parameter",
          "units": "1/s",
          "default": 0.008,
          "description": "NO2 photolysis rate coefficient",
          "update": {
            "kind": "crossing",
            "when": {
              "op": "-",
              "args": [
                "O3",
                7e-08
              ]
            },
            "expression": {
              "op": "*",
              "args": [
                {
                  "op": "Pre",
                  "args": [
                    "jNO2"
                  ]
                },
                1.2
              ]
            }
          }
        },
        "jHCHO": {
          "type": "parameter",
          "units": "1/s",
          "default": 3e-05,
          "description": "HCHO photolysis rate coefficient"
        },
        "k_HO2_NO": {
          "type": "parameter",
          "units": "cm^3/molec/s",
          "default": 8.1e-12,
          "description": "Rate constant HO2 + NO → OH + NO2"
        },
        "total_NOx": {
          "type": "unknown",
          "units": "mol/mol",
          "description": "Total reactive nitrogen"
        },
        "ozone_production_rate": {
          "type": "unknown",
          "units": "mol/mol/s",
          "description": "Instantaneous ozone production rate"
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "O3"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "+",
            "args": [
              {
                "op": "*",
                "args": [
                  {
                    "op": "-",
                    "args": [
                      "k_NO_O3"
                    ]
                  },
                  "O3",
                  "NO",
                  "M"
                ]
              },
              {
                "op": "*",
                "args": [
                  "jNO2",
                  "NO2"
                ]
              },
              {
                "op": "*",
                "args": [
                  "k_HO2_NO",
                  "HO2",
                  "NO",
                  "M"
                ]
              }
            ]
          }
        },
        {
          "lhs": {
            "op": "D",
            "args": [
              "NO"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "+",
            "args": [
              {
                "op": "*",
                "args": [
                  {
                    "op": "-",
                    "args": [
                      "k_NO_O3"
                    ]
                  },
                  "O3",
                  "NO",
                  "M"
                ]
              },
              {
                "op": "*",
                "args": [
                  {
                    "op": "-",
                    "args": [
                      "k_HO2_NO"
                    ]
                  },
                  "HO2",
                  "NO",
                  "M"
                ]
              },
              {
                "op": "*",
                "args": [
                  "jNO2",
                  "NO2"
                ]
              }
            ]
          }
        },
        {
          "lhs": {
            "op": "D",
            "args": [
              "NO2"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "+",
            "args": [
              {
                "op": "*",
                "args": [
                  "k_NO_O3",
                  "O3",
                  "NO",
                  "M"
                ]
              },
              {
                "op": "*",
                "args": [
                  "k_HO2_NO",
                  "HO2",
                  "NO",
                  "M"
                ]
              },
              {
                "op": "*",
                "args": [
                  {
                    "op": "-",
                    "args": [
                      "jNO2"
                    ]
                  },
                  "NO2"
                ]
              }
            ]
          }
        },
        {
          "lhs": {
            "op": "D",
            "args": [
              "HCHO"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "+",
            "args": [
              {
                "op": "*",
                "args": [
                  {
                    "op": "-",
                    "args": [
                      "jHCHO"
                    ]
                  },
                  "HCHO"
                ]
              },
              {
                "op": "*",
                "args": [
                  0.3,
                  "jNO2",
                  "NO2"
                ]
              }
            ]
          }
        },
        {
          "lhs": {
            "op": "D",
            "args": [
              "HO2"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "+",
            "args": [
              {
                "op": "*",
                "args": [
                  {
                    "op": "-",
                    "args": [
                      "k_HO2_NO"
                    ]
                  },
                  "HO2",
                  "NO",
                  "M"
                ]
              },
              {
                "op": "*",
                "args": [
                  2.0,
                  "jHCHO",
                  "HCHO"
                ]
              }
            ]
          }
        },
        {
          "lhs": {
            "op": "ic",
            "args": [
              "O3"
            ]
          },
          "rhs": 4e-08
        },
        {
          "lhs": {
            "op": "ic",
            "args": [
              "NO"
            ]
          },
          "rhs": 5e-10
        },
        {
          "lhs": {
            "op": "ic",
            "args": [
              "NO2"
            ]
          },
          "rhs": 2e-09
        },
        {
          "lhs": {
            "op": "ic",
            "args": [
              "HCHO"
            ]
          },
          "rhs": 1e-09
        },
        {
          "lhs": {
            "op": "ic",
            "args": [
              "HO2"
            ]
          },
          "rhs": 1e-12
        },
        {
          "lhs": "total_NOx",
          "rhs": {
            "op": "+",
            "args": [
              "NO",
              "NO2"
            ]
          }
        },
        {
          "lhs": "ozone_production_rate",
          "rhs": {
            "op": "+",
            "args": [
              {
                "op": "*",
                "args": [
                  "jNO2",
                  "NO2"
                ]
              },
              {
                "op": "*",
                "args": [
                  "k_HO2_NO",
                  "HO2",
                  "NO",
                  "M"
                ]
              }
            ]
          }
        }
      ],
      "continuous_events": []
    },
    "AtmosphericTransport": {
      "reference": {
        "notes": "Three-dimensional advection and turbulent diffusion using operator_compose coupling"
      },
      "variables": {
        "u": {
          "type": "unknown",
          "units": "mol/mol",
          "default": 0.0,
          "description": "Transported scalar concentration"
        },
        "u_wind": {
          "type": "parameter",
          "units": "m/s",
          "default": 8.0,
          "description": "Eastward wind velocity",
          "update": {
            "kind": "data",
            "source": "MeteorologicalFields",
            "from": {
              "file_variable": "u_wind"
            }
          },
          "shape": []
        },
        "v_wind": {
          "type": "parameter",
          "units": "m/s",
          "default": 3.0,
          "description": "Northward wind velocity",
          "update": {
            "kind": "data",
            "source": "MeteorologicalFields",
            "from": {
              "file_variable": "v_wind"
            }
          },
          "shape": []
        },
        "w_wind": {
          "type": "parameter",
          "units": "m/s",
          "default": 0.0,
          "description": "Vertical wind velocity"
        },
        "K_h": {
          "type": "parameter",
          "units": "m^2/s",
          "default": 1000.0,
          "description": "Horizontal diffusivity"
        },
        "K_z": {
          "type": "parameter",
          "units": "m^2/s",
          "default": 10.0,
          "description": "Vertical diffusivity",
          "update": {
            "kind": "crossing",
            "when": {
              "op": "-",
              "args": [
                "SurfaceExchange.boundary_layer_height",
                100.0
              ]
            },
            "expression": {
              "op": "*",
              "args": [
                {
                  "op": "Pre",
                  "args": [
                    "K_z"
                  ]
                },
                0.1
              ]
            }
          }
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "u"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "+",
            "args": [
              {
                "op": "*",
                "args": [
                  {
                    "op": "-",
                    "args": [
                      "u_wind"
                    ]
                  },
                  {
                    "op": "grad",
                    "args": [
                      "u"
                    ],
                    "dim": "x"
                  }
                ]
              },
              {
                "op": "*",
                "args": [
                  {
                    "op": "-",
                    "args": [
                      "v_wind"
                    ]
                  },
                  {
                    "op": "grad",
                    "args": [
                      "u"
                    ],
                    "dim": "y"
                  }
                ]
              },
              {
                "op": "*",
                "args": [
                  {
                    "op": "-",
                    "args": [
                      "w_wind"
                    ]
                  },
                  {
                    "op": "grad",
                    "args": [
                      "u"
                    ],
                    "dim": "z"
                  }
                ]
              },
              {
                "op": "*",
                "args": [
                  "K_h",
                  {
                    "op": "laplacian",
                    "args": [
                      "u"
                    ],
                    "dim": "x"
                  }
                ]
              },
              {
                "op": "*",
                "args": [
                  "K_z",
                  {
                    "op": "laplacian",
                    "args": [
                      "u"
                    ],
                    "dim": "z"
                  }
                ]
              }
            ]
          }
        }
      ]
    },
    "SurfaceExchange": {
      "reference": {
        "notes": "Bidirectional surface-atmosphere exchange via resistance model",
        "citation": "Wesely, 1989. Parameterization of surface resistances to gaseous dry deposition"
      },
      "variables": {
        "surface_resistance_O3": {
          "type": "parameter",
          "units": "s/m",
          "default": 120.0,
          "description": "Surface resistance for O3 deposition"
        },
        "surface_resistance_NO2": {
          "type": "parameter",
          "units": "s/m",
          "default": 150.0,
          "description": "Surface resistance for NO2 deposition"
        },
        "aerodynamic_resistance": {
          "type": "parameter",
          "units": "s/m",
          "default": 25.0,
          "description": "Aerodynamic resistance"
        },
        "boundary_layer_resistance": {
          "type": "parameter",
          "units": "s/m",
          "default": 5.0,
          "description": "Quasi-laminar boundary layer resistance"
        },
        "boundary_layer_height": {
          "type": "parameter",
          "units": "m",
          "default": 800.0,
          "description": "Mixed layer height",
          "update": {
            "kind": "data",
            "source": "MeteorologicalFields",
            "from": {
              "file_variable": "boundary_layer_height"
            }
          },
          "shape": []
        },
        "land_use_type": {
          "type": "parameter",
          "units": "dimensionless",
          "default": 3.0,
          "description": "Land use category (1=water, 3=crop, 5=forest)"
        },
        "deposition_velocity_O3": {
          "type": "unknown",
          "units": "m/s",
          "description": "O3 dry deposition velocity"
        },
        "deposition_velocity_NO2": {
          "type": "unknown",
          "units": "m/s",
          "description": "NO2 dry deposition velocity"
        }
      },
      "equations": [
        {
          "lhs": "deposition_velocity_O3",
          "rhs": {
            "op": "/",
            "args": [
              1.0,
              {
                "op": "+",
                "args": [
                  "aerodynamic_resistance",
                  "boundary_layer_resistance",
                  "surface_resistance_O3"
                ]
              }
            ]
          }
        },
        {
          "lhs": "deposition_velocity_NO2",
          "rhs": {
            "op": "/",
            "args": [
              1.0,
              {
                "op": "+",
                "args": [
                  "aerodynamic_resistance",
                  "boundary_layer_resistance",
                  "surface_resistance_NO2"
                ]
              }
            ]
          }
        }
      ]
    },
    "EmissionSources": {
      "reference": {
        "notes": "Time-varying anthropogenic and biogenic emissions with diurnal and seasonal cycles"
      },
      "variables": {
        "NO_emission_flux": {
          "type": "unknown",
          "units": "mol/mol/s",
          "description": "Emission tendency of NO. An observed unknown: its defining equation is below, and the couple connector adds it to AtmosphericChemistry.NO."
        },
        "HCHO_emission_flux": {
          "type": "unknown",
          "units": "mol/mol/s",
          "description": "Emission tendency of HCHO. An observed unknown: its defining equation is below, and the couple connector adds it to AtmosphericChemistry.HCHO."
        },
        "NOx_emission_rate": {
          "type": "parameter",
          "units": "mol/mol/s",
          "default": 2e-11,
          "description": "Base NOx emission rate",
          "update": [
            {
              "kind": "data",
              "source": "EmissionInventories",
              "from": {
                "file_variable": "NOx_emission_rate"
              }
            },
            {
              "kind": "crossing",
              "when": {
                "op": "-",
                "args": [
                  "AtmosphericChemistry.O3",
                  8e-08
                ]
              },
              "expression": {
                "op": "*",
                "args": [
                  {
                    "op": "Pre",
                    "args": [
                      "NOx_emission_rate"
                    ]
                  },
                  0.6
                ]
              }
            }
          ],
          "shape": []
        },
        "VOC_emission_rate": {
          "type": "parameter",
          "units": "mol/mol/s",
          "default": 5e-12,
          "description": "Base VOC emission rate (as HCHO)",
          "update": {
            "kind": "data",
            "source": "EmissionInventories",
            "from": {
              "file_variable": "VOC_emission_rate"
            }
          },
          "shape": []
        },
        "diurnal_factor": {
          "type": "parameter",
          "units": "dimensionless",
          "default": 1.0,
          "description": "Diurnal emission scaling",
          "shape": [],
          "update": {
            "kind": "schedule",
            "interval": 3600.0,
            "expression": {
              "op": "+",
              "args": [
                1.0,
                {
                  "op": "*",
                  "args": [
                    0.8,
                    {
                      "op": "sin",
                      "args": [
                        {
                          "op": "/",
                          "args": [
                            {
                              "op": "*",
                              "args": [
                                2,
                                3.14159,
                                {
                                  "op": "-",
                                  "args": [
                                    "t",
                                    21600
                                  ]
                                }
                              ]
                            },
                            86400
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          }
        },
        "temperature_factor": {
          "type": "parameter",
          "units": "dimensionless",
          "default": 1.0,
          "description": "Temperature-dependent biogenic scaling"
        },
        "weekday_factor": {
          "type": "parameter",
          "units": "dimensionless",
          "default": 1.0,
          "description": "Weekday vs weekend scaling",
          "update": {
            "kind": "condition",
            "when": {
              "op": ">=",
              "args": [
                {
                  "op": "-",
                  "args": [
                    {
                      "op": "floor",
                      "args": [
                        {
                          "op": "/",
                          "args": [
                            "t",
                            86400
                          ]
                        }
                      ]
                    },
                    {
                      "op": "*",
                      "args": [
                        {
                          "op": "floor",
                          "args": [
                            {
                              "op": "/",
                              "args": [
                                {
                                  "op": "floor",
                                  "args": [
                                    {
                                      "op": "/",
                                      "args": [
                                        "t",
                                        86400
                                      ]
                                    }
                                  ]
                                },
                                7
                              ]
                            }
                          ]
                        },
                        7
                      ]
                    }
                  ]
                },
                5
              ]
            },
            "expression": 0.75
          }
        }
      },
      "equations": [
        {
          "_comment": "Emission tendency for NO, delivered as a FLUX the coupling adds to the chemistry state. It was `D(NO)/dt` on a species this model never declared, which only validated because being a coupling endpoint exempted the model from reference integrity.",
          "lhs": "NO_emission_flux",
          "rhs": {
            "op": "*",
            "args": [
              "NOx_emission_rate",
              "diurnal_factor",
              "weekday_factor"
            ]
          }
        },
        {
          "_comment": "Emission tendency for HCHO, delivered as a FLUX the coupling adds to the chemistry state. It was `D(HCHO)/dt` on a species this model never declared, which only validated because being a coupling endpoint exempted the model from reference integrity.",
          "lhs": "HCHO_emission_flux",
          "rhs": {
            "op": "*",
            "args": [
              "VOC_emission_rate",
              "temperature_factor",
              "diurnal_factor"
            ]
          }
        }
      ],
      "discrete_events": []
    }
  },
  "data_sources": {
    "MeteorologicalFields": {
      "kind": "grid",
      "source": {
        "url_template": "file:///data/WRF_Output/{date:%Y%m%d_%H%M}.nc"
      },
      "temporal": {
        "frequency": "PT1H",
        "file_period": "PT1H",
        "records_per_file": 1
      },
      "reference": {
        "citation": "Weather Research and Forecasting (WRF) Model v4.3",
        "url": "https://www.mmm.ucar.edu/weather-research-and-forecasting-model"
      },
      "metadata": {
        "tags": [
          "meteorology",
          "reanalysis"
        ]
      }
    },
    "EmissionInventories": {
      "kind": "grid",
      "source": {
        "url_template": "file:///data/NEI_2017/{date:%Y%m%d_%H%M}.nc"
      },
      "reference": {
        "citation": "US EPA National Emissions Inventory 2017",
        "url": "https://www.epa.gov/air-emissions-inventories/2017-national-emissions-inventory-nei-data"
      },
      "metadata": {
        "tags": [
          "emissions",
          "anthropogenic"
        ]
      }
    }
  },
  "coupling": [
    {
      "type": "operator_compose",
      "systems": [
        "AtmosphericChemistry",
        "AtmosphericTransport"
      ],
      "description": "Couple 3D transport with gas-phase chemistry"
    },
    {
      "type": "couple",
      "systems": [
        "AtmosphericChemistry",
        "SurfaceExchange"
      ],
      "connector": {
        "equations": [
          {
            "from": "SurfaceExchange.deposition_velocity_O3",
            "to": "AtmosphericChemistry.O3",
            "transform": "additive",
            "expression": {
              "op": "*",
              "args": [
                {
                  "op": "-",
                  "args": [
                    "SurfaceExchange.deposition_velocity_O3"
                  ]
                },
                "AtmosphericChemistry.O3",
                {
                  "op": "/",
                  "args": [
                    1.0,
                    "SurfaceExchange.boundary_layer_height"
                  ]
                }
              ]
            }
          },
          {
            "from": "SurfaceExchange.deposition_velocity_NO2",
            "to": "AtmosphericChemistry.NO2",
            "transform": "additive",
            "expression": {
              "op": "*",
              "args": [
                {
                  "op": "-",
                  "args": [
                    "SurfaceExchange.deposition_velocity_NO2"
                  ]
                },
                "AtmosphericChemistry.NO2",
                {
                  "op": "/",
                  "args": [
                    1.0,
                    "SurfaceExchange.boundary_layer_height"
                  ]
                }
              ]
            }
          }
        ]
      },
      "description": "Couple dry deposition to atmospheric chemistry"
    },
    {
      "type": "couple",
      "systems": [
        "AtmosphericChemistry",
        "EmissionSources"
      ],
      "connector": {
        "equations": [
          {
            "from": "EmissionSources.NO_emission_flux",
            "to": "AtmosphericChemistry.NO",
            "transform": "additive",
            "expression": "EmissionSources.NO_emission_flux"
          },
          {
            "from": "EmissionSources.HCHO_emission_flux",
            "to": "AtmosphericChemistry.HCHO",
            "transform": "additive",
            "expression": "EmissionSources.HCHO_emission_flux"
          }
        ]
      },
      "description": "Add the emission fluxes to the chemistry tendencies. Before 1.0.0 the emissions reached the chemistry only implicitly: EmissionSources wrote D(NO)/dt and D(HCHO)/dt for species it never declared, and the document was accepted only because variable_map entries pointing at a data loader made it a coupling endpoint, which exempted it from the equation balance AND from reference integrity. Removing those entries -- a data source is no longer an endpoint -- exposed both defects."
    },
    {
      "type": "callback",
      "callback_id": "BiogenicEmissionTemperatureScaling",
      "config": {
        "update_frequency": 3600.0,
        "beta": 0.09,
        "base_temperature": 303.15
      },
      "description": "Scale biogenic emissions with temperature"
    },
    {
      "type": "callback",
      "callback_id": "WeekdayWeekendScaling",
      "config": {
        "weekday_factor": 1.0,
        "weekend_factor": 0.75,
        "transition_hours": 2
      },
      "description": "Scale anthropogenic emissions by day of week"
    }
  ],
  "domain": {
    "independent_variable": "t",
    "temporal": {
      "start": "2024-07-15T00:00:00Z",
      "end": "2024-07-17T00:00:00Z",
      "reference_time": "2024-07-15T00:00:00Z"
    },
    "element_type": "Float64"
  }
}
