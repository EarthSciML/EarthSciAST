    "VegetationDynamics": {
      "reference": {
        "notes": "Dynamic vegetation model with leaf area index, biomass, and phenology"
      },
      "variables": {
        "leaf_area_index": {
          "type": "unknown",
          "units": "m^2/m^2",
          "default": 3.0,
          "description": "Leaf area index"
        },
        "above_ground_biomass": {
          "type": "unknown",
          "units": "kg/m^2",
          "default": 2.0,
          "description": "Above-ground plant biomass"
        },
        "below_ground_biomass": {
          "type": "unknown",
          "units": "kg/m^2",
          "default": 1.5,
          "description": "Below-ground (root) biomass"
        },
        "max_photosynthesis_rate": {
          "type": "parameter",
          "units": "umol/m^2/s",
          "default": 25.0,
          "description": "Maximum photosynthetic rate at light saturation",
          "update": {
            "kind": "crossing",
            "when": {
              "op": "-",
              "args": [
                0.2,
                "SoilHydrologyThermal.water_stress_factor"
              ]
            },
            "expression": {
              "op": "*",
              "args": [
                {
                  "op": "Pre",
                  "args": [
                    "max_photosynthesis_rate"
                  ]
                },
                0.7
              ]
            }
          }
        },
        "light_saturation_point": {
          "type": "parameter",
          "units": "umol/m^2/s",
          "default": 800.0,
          "description": "Light saturation point for photosynthesis"
        },
        "growth_efficiency": {
          "type": "parameter",
          "units": "dimensionless",
          "default": 0.5,
          "description": "Growth efficiency (biomass per unit photosynthesis)"
        },
        "maintenance_respiration_rate": {
          "type": "parameter",
          "units": "1/s",
          "default": 3e-07,
          "description": "Maintenance respiration rate"
        },
        "allocation_to_roots": {
          "type": "parameter",
          "units": "dimensionless",
          "default": 0.4,
          "description": "Fraction of growth allocated to roots"
        },
        "specific_leaf_area": {
          "type": "parameter",
          "units": "m^2/kg",
          "default": 20.0,
          "description": "Specific leaf area (LAI per unit leaf biomass)"
        },
        "leaf_turnover_rate": {
          "type": "parameter",
          "units": "1/s",
          "default": 6e-08,
          "description": "Leaf turnover rate",
          "update": {
            "kind": "condition",
            "when": {
              "op": "and",
              "args": [
                {
                  "op": "<",
                  "args": [
                    "AtmosphericBoundaryLayer.air_temperature",
                    278.15
                  ]
                },
                {
                  "op": ">",
                  "args": [
                    {
                      "op": "-",
                      "args": [
                        "t",
                        {
                          "op": "*",
                          "args": [
                            {
                              "op": "floor",
                              "args": [
                                {
                                  "op": "/",
                                  "args": [
                                    "t",
                                    31536000
                                  ]
                                }
                              ]
                            },
                            31536000
                          ]
                        }
                      ]
                    },
                    24192000
                  ]
                }
              ]
            },
            "expression": {
              "op": "*",
              "args": [
                {
                  "op": "Pre",
                  "args": [
                    "leaf_turnover_rate"
                  ]
                },
                5.0
              ]
            }
          }
        },
        "root_turnover_rate": {
          "type": "parameter",
          "units": "1/s",
          "default": 2e-08,
          "description": "Root turnover rate"
        },
        "photosynthesis_rate": {
          "type": "unknown",
          "units": "umol/m^2/s",
          "description": "Actual photosynthesis rate with light and water limitations"
        },
        "net_primary_productivity": {
          "type": "unknown",
          "units": "kg/m^2/s",
          "description": "Net primary productivity (growth - respiration)"
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "above_ground_biomass"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "+",
            "args": [
              {
                "op": "*",
                "args": [
                  {
                    "op": "-",
                    "args": [
                      1,
                      "allocation_to_roots"
                    ]
                  },
                  "net_primary_productivity"
                ]
              },
              {
                "op": "*",
                "args": [
                  {
                    "op": "-",
                    "args": [
                      "leaf_turnover_rate"
                    ]
                  },
                  "above_ground_biomass"
                ]
              }
            ]
          }
        },
        {
          "lhs": {
            "op": "D",
            "args": [
              "below_ground_biomass"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "+",
            "args": [
              {
                "op": "*",
                "args": [
                  "allocation_to_roots",
                  "net_primary_productivity"
                ]
              },
              {
                "op": "*",
                "args": [
                  {
                    "op": "-",
                    "args": [
                      "root_turnover_rate"
                    ]
                  },
                  "below_ground_biomass"
                ]
              }
            ]
          }
        },
        {
          "lhs": {
            "op": "D",
            "args": [
              "leaf_area_index"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "*",
            "args": [
              "specific_leaf_area",
              {
                "op": "D",
                "args": [
                  "above_ground_biomass"
                ],
                "wrt": "t"
              }
            ]
          }
        },
        {
          "lhs": {
            "op": "ic",
            "args": [
              "leaf_area_index"
            ]
          },
          "rhs": 3.0
        },
        {
          "lhs": {
            "op": "ic",
            "args": [
              "above_ground_biomass"
            ]
          },
          "rhs": 2.0
        },
        {
          "lhs": {
            "op": "ic",
            "args": [
              "below_ground_biomass"
            ]
          },
          "rhs": 1.5
        },
        {
          "lhs": "photosynthesis_rate",
          "rhs": {
            "op": "*",
            "args": [
              "max_photosynthesis_rate",
              {
                "op": "/",
                "args": [
                  {
                    "op": "*",
                    "args": [
                      {
                        "op": "/",
                        "args": [
                          "incoming_radiation",
                          4.6
                        ]
                      },
                      "leaf_area_index"
                    ]
                  },
                  {
                    "op": "+",
                    "args": [
                      {
                        "op": "*",
                        "args": [
                          {
                            "op": "/",
                            "args": [
                              "incoming_radiation",
                              4.6
                            ]
                          },
                          "leaf_area_index"
                        ]
                      },
                      "light_saturation_point"
                    ]
                  }
                ]
              },
              "water_stress_factor"
            ]
          }
        },
        {
          "lhs": "net_primary_productivity",
          "rhs": {
            "op": "+",
            "args": [
              {
                "op": "*",
                "args": [
                  {
                    "op": "*",
                    "args": [
                      "photosynthesis_rate",
                      1.2e-05,
                      3600
                    ]
                  },
                  "growth_efficiency"
                ]
              },
              {
                "op": "*",
                "args": [
                  {
                    "op": "-",
                    "args": [
                      "maintenance_respiration_rate"
                    ]
                  },
                  {
                    "op": "+",
                    "args": [
                      "above_ground_biomass",
                      "below_ground_biomass"
                    ]
                  }
                ]
              }
            ]
          }
        }
      ]
    },
    "SurfaceEnergyBalance": {
      "reference": {
        "notes": "Surface energy balance with sensible and latent heat fluxes",
        "citation": "Monteith & Unsworth, 2013. Principles of Environmental Physics"
      },
      "variables": {
        "surface_temperature": {
          "type": "unknown",
          "units": "K",
          "default": 290.15,
          "description": "Surface skin temperature"
        },
        "albedo": {
          "type": "parameter",
          "units": "dimensionless",
          "default": 0.15,
          "description": "Surface albedo"
        },
        "emissivity": {
          "type": "parameter",
          "units": "dimensionless",
          "default": 0.95,
          "description": "Surface emissivity"
        },
        "stefan_boltzmann": {
          "type": "parameter",
          "units": "W/m^2/K^4",
          "default": 5.67e-08,
          "description": "Stefan-Boltzmann constant"
        },
        "aerodynamic_conductance": {
          "type": "parameter",
          "units": "m/s",
          "default": 0.01,
          "description": "Aerodynamic conductance for heat transfer"
        },
        "stomatal_conductance": {
          "type": "parameter",
          "units": "m/s",
          "default": 0.005,
          "description": "Canopy stomatal conductance"
        },
        "net_radiation": {
          "type": "unknown",
          "units": "W/m^2",
          "description": "Net radiation at surface"
        },
        "sensible_heat_flux": {
          "type": "unknown",
          "units": "W/m^2",
          "description": "Sensible heat flux to atmosphere"
        },
        "latent_heat_flux": {
          "type": "unknown",
          "units": "W/m^2",
          "description": "Latent heat flux (evapotranspiration)"
        },
        "ground_heat_flux": {
          "type": "unknown",
          "units": "W/m^2",
          "description": "Ground heat flux into soil"
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "surface_temperature"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "/",
            "args": [
              {
                "op": "+",
                "args": [
                  "net_radiation",
                  {
                    "op": "-",
                    "args": [
                      "sensible_heat_flux"
                    ]
                  },
                  {
                    "op": "-",
                    "args": [
                      "latent_heat_flux"
                    ]
                  },
                  {
                    "op": "-",
                    "args": [
                      "ground_heat_flux"
                    ]
                  }
                ]
              },
              500000.0
            ]
          }
        },
        {
          "lhs": {
            "op": "ic",
            "args": [
              "surface_temperature"
            ]
          },
          "rhs": 290.15
        },
        {
          "lhs": "net_radiation",
          "rhs": {
            "op": "+",
            "args": [
              {
                "op": "*",
                "args": [
                  {
                    "op": "-",
                    "args": [
                      1,
                      "albedo"
                    ]
                  },
                  "incoming_radiation"
                ]
              },
              "longwave_radiation",
              {
                "op": "*",
                "args": [
                  {
                    "op": "-",
                    "args": [
                      "emissivity"
                    ]
                  },
                  "stefan_boltzmann",
                  {
                    "op": "^",
                    "args": [
                      "surface_temperature",
                      4
                    ]
                  }
                ]
              }
            ]
          }
        },
        {
          "lhs": "sensible_heat_flux",
          "rhs": {
            "op": "*",
            "args": [
              1200.0,
              "aerodynamic_conductance",
              {
                "op": "-",
                "args": [
                  "surface_temperature",
                  "air_temperature"
                ]
              }
            ]
          }
        },
        {
          "lhs": "latent_heat_flux",
          "rhs": {
            "op": "*",
            "args": [
              2450000.0,
              {
                "op": "*",
                "args": [
                  "stomatal_conductance",
                  "water_stress_factor",
                  {
                    "op": "*",
                    "args": [
                      0.622,
                      {
                        "op": "/",
                        "args": [
                          {
                            "op": "+",
                            "args": [
                              {
                                "op": "exp",
                                "args": [
                                  {
                                    "op": "/",
                                    "args": [
                                      {
                                        "op": "*",
                                        "args": [
                                          17.67,
                                          {
                                            "op": "-",
                                            "args": [
                                              "surface_temperature",
                                              273.15
                                            ]
                                          }
                                        ]
                                      },
                                      {
                                        "op": "+",
                                        "args": [
                                          {
                                            "op": "-",
                                            "args": [
                                              "surface_temperature",
                                              273.15
                                            ]
                                          },
                                          243.5
                                        ]
                                      }
                                    ]
                                  }
                                ]
                              },
                              {
                                "op": "*",
                                "args": [
                                  {
                                    "op": "-",
                                    "args": [
                                      1
                                    ]
                                  },
                                  {
                                    "op": "exp",
                                    "args": [
                                      {
                                        "op": "/",
                                        "args": [
                                          {
                                            "op": "*",
                                            "args": [
                                              17.67,
                                              {
                                                "op": "-",
                                                "args": [
                                                  "air_temperature",
                                                  273.15
                                                ]
                                              }
                                            ]
                                          },
                                          {
                                            "op": "+",
                                            "args": [
                                              {
                                                "op": "-",
                                                "args": [
                                                  "air_temperature",
                                                  273.15
                                                ]
                                              },
                                              243.5
                                            ]
                                          }
                                        ]
                                      }
                                    ]
                                  }
                                ]
                              }
                            ]
                          },
                          "pressure"
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        },
        {
          "lhs": "ground_heat_flux",
          "rhs": {
            "op": "*",
            "args": [
              {
                "op": "/",
                "args": [
                  "thermal_conductivity",
                  {
                    "op": "*",
                    "args": [
                      "layer1_thickness",
                      0.5
                    ]
                  }
                ]
              },
              {
                "op": "-",
                "args": [
                  "surface_temperature",
                  "soil_temperature_layer1"
                ]
              }
            ]
          }
        }
      ]
    }
  },
  "data_sources": {
    "MeteorologicalForcing": {
      "kind": "grid",
      "source": {
        "url_template": "file:///data/ERA5_Hourly/{date:%Y%m%d_%H%M}.nc"
      },
      "metadata": {
        "tags": [
          "meteorology",
          "reanalysis"
        ]
      }
    },
    "SoilProperties": {
      "kind": "static",
      "source": {
        "url_template": "file:///data/SoilGrids250.nc"
      },
      "metadata": {
        "tags": [
          "static"
        ]
      }
    }
  },
  "coupling": [
    {
      "type": "couple",
      "systems": [
        "AtmosphericBoundaryLayer",
        "SurfaceEnergyBalance"
      ],
      "connector": {
        "equations": [
          {
            "from": "SurfaceEnergyBalance.sensible_heat_flux",
            "to": "AtmosphericBoundaryLayer.air_temperature",
            "transform": "additive",
            "expression": {
              "op": "/",
              "args": [
                "SurfaceEnergyBalance.sensible_heat_flux",
                {
                  "op": "*",
                  "args": [
                    1200.0,
                    1000.0
                  ]
                }
              ]
            }
          },
          {
            "from": "SurfaceEnergyBalance.latent_heat_flux",
            "to": "AtmosphericBoundaryLayer.specific_humidity",
            "transform": "additive",
            "expression": {
              "op": "/",
              "args": [
                {
                  "op": "/",
                  "args": [
                    "SurfaceEnergyBalance.latent_heat_flux",
                    2450000.0
                  ]
                },
                {
                  "op": "*",
                  "args": [
                    1.2,
                    1000.0
                  ]
                }
              ]
            }
          }
        ]
      },
      "description": "Bidirectional atmosphere-surface energy exchange"
    },
    {
      "type": "couple",
      "systems": [
        "SurfaceEnergyBalance",
        "SoilHydrologyThermal"
      ],
      "connector": {
        "equations": [
          {
            "from": "SurfaceEnergyBalance.ground_heat_flux",
            "to": "SoilHydrologyThermal.soil_temperature_layer1",
            "transform": "additive",
            "expression": {
              "op": "/",
              "args": [
                "SurfaceEnergyBalance.ground_heat_flux",
                {
                  "op": "*",
                  "args": [
                    "SoilHydrologyThermal.heat_capacity",
                    "SoilHydrologyThermal.layer1_thickness"
                  ]
                }
              ]
            }
          }
        ]
      },
      "description": "Surface-soil heat exchange coupling"
    },
    {
      "type": "couple",
      "systems": [
        "VegetationDynamics",
        "SoilHydrologyThermal"
      ],
      "connector": {
        "equations": [
          {
            "from": "VegetationDynamics.photosynthesis_rate",
            "to": "SoilHydrologyThermal.soil_moisture_layer2",
            "transform": "additive",
            "expression": {
              "op": "/",
              "args": [
                {
                  "op": "*",
                  "args": [
                    {
                      "op": "-",
                      "args": [
                        2e-09
                      ]
                    },
                    "VegetationDynamics.photosynthesis_rate",
                    "VegetationDynamics.leaf_area_index"
                  ]
                },
                "SoilHydrologyThermal.layer2_thickness"
              ]
            }
          }
        ]
      },
      "description": "Plant root water uptake from soil"
    },
    {
      "type": "callback",
      "callback_id": "PrecipitationInfiltration",
      "config": {
        "infiltration_capacity": "hydraulic_conductivity",
        "surface_runoff_threshold": 0.9,
        "update_frequency": 3600.0
      },
      "description": "Partition precipitation into infiltration and runoff"
    },
    {
      "type": "callback",
      "callback_id": "SeasonalPhenology",
      "config": {
        "growing_degree_days": 1000,
        "base_temperature": 278.15,
        "senescence_temperature": 268.15,
        "latitude_dependence": true
      },
      "description": "Control seasonal vegetation phenology"
    },
    {
      "type": "event",
      "event_type": "continuous",
      "name": "soil_moisture_saturation_runoff",
      "conditions": [
        {
          "op": "-",
          "args": [
            "SoilHydrologyThermal.soil_moisture_layer1",
            {
              "op": "*",
              "args": [
                "SoilHydrologyThermal.porosity",
                0.95
              ]
            }
          ]
        }
      ],
      "affects": [
        {
          "lhs": "SoilHydrologyThermal.soil_moisture_layer1",
          "rhs": {
            "op": "*",
            "args": [
              "SoilHydrologyThermal.porosity",
              0.95
            ]
          }
        }
      ],
      "description": "Prevent soil moisture from exceeding 95% of porosity (saturation excess runoff)"
    }
  ],
  "domain": {
    "independent_variable": "t",
    "temporal": {
      "start": "2023-01-01T00:00:00Z",
      "end": "2024-01-01T00:00:00Z",
      "reference_time": "2023-01-01T00:00:00Z"
    },
    "element_type": "Float64"
  }
}
