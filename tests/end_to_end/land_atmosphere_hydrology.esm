                                  273.15
                                ]
                              },
                              243.5
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        }
      ]
    },
    "SoilHydrologyThermal": {
      "reference": {
        "notes": "Multi-layer soil model with water and heat transport",
        "citation": "Campbell & Norman, 1998. Environmental Biophysics"
      },
      "variables": {
        "soil_moisture_layer1": {
          "type": "unknown",
          "units": "m^3/m^3",
          "default": 0.25,
          "description": "Volumetric soil moisture in layer 1 (0-10cm)"
        },
        "soil_moisture_layer2": {
          "type": "unknown",
          "units": "m^3/m^3",
          "default": 0.3,
          "description": "Volumetric soil moisture in layer 2 (10-50cm)"
        },
        "soil_moisture_layer3": {
          "type": "unknown",
          "units": "m^3/m^3",
          "default": 0.35,
          "description": "Volumetric soil moisture in layer 3 (50-150cm)"
        },
        "soil_temperature_layer1": {
          "type": "unknown",
          "units": "K",
          "default": 288.15,
          "description": "Soil temperature in layer 1"
        },
        "soil_temperature_layer2": {
          "type": "unknown",
          "units": "K",
          "default": 288.15,
          "description": "Soil temperature in layer 2"
        },
        "soil_temperature_layer3": {
          "type": "unknown",
          "units": "K",
          "default": 288.15,
          "description": "Soil temperature in layer 3"
        },
        "porosity": {
          "type": "parameter",
          "units": "m^3/m^3",
          "default": 0.45,
          "description": "Soil porosity",
          "update": {
            "kind": "data",
            "source": "SoilProperties",
            "from": {
              "file_variable": "porosity"
            }
          },
          "shape": []
        },
        "field_capacity": {
          "type": "parameter",
          "units": "m^3/m^3",
          "default": 0.35,
          "description": "Field capacity",
          "update": {
            "kind": "data",
            "source": "SoilProperties",
            "from": {
              "file_variable": "field_capacity"
            }
          },
          "shape": []
        },
        "wilting_point": {
          "type": "parameter",
          "units": "m^3/m^3",
          "default": 0.15,
          "description": "Permanent wilting point",
          "update": {
            "kind": "data",
            "source": "SoilProperties",
            "from": {
              "file_variable": "wilting_point"
            }
          },
          "shape": []
        },
        "hydraulic_conductivity": {
          "type": "parameter",
          "units": "m/s",
          "default": 1e-06,
          "description": "Saturated hydraulic conductivity"
        },
        "k_flux_12": {
          "type": "parameter",
          "units": "m/s",
          "default": 1e-07,
          "description": "Layer1->2 moisture exchange coefficient. Was a BARE LITERAL 1e-7: a dimensionless number times a dimensionless moisture difference, divided by a thickness, gives 1/m where d(m^3/m^3)/dt needs 1/s. As a velocity (m/s) the term closes: (m/s)*(1)/m = 1/s."
        },
        "k_flux_23": {
          "type": "parameter",
          "units": "m/s",
          "default": 5e-08,
          "description": "Layer2->3 moisture exchange coefficient (was the bare literal 5e-8). Units m/s, as for k_flux_12."
        },
        "k_drain": {
          "type": "parameter",
          "units": "m/s",
          "default": 1e-08,
          "description": "Bottom drainage coefficient (was the bare literal 1e-8). Units m/s, as for k_flux_12."
        },
        "thermal_conductivity": {
          "type": "parameter",
          "units": "W/m/K",
          "default": 1.5,
          "description": "Soil thermal conductivity"
        },
        "heat_capacity": {
          "type": "parameter",
          "units": "J/m^3/K",
          "default": 2500000.0,
          "description": "Volumetric heat capacity"
        },
        "layer1_thickness": {
          "type": "parameter",
          "units": "m",
          "default": 0.1,
          "description": "Thickness of soil layer 1"
        },
        "layer2_thickness": {
          "type": "parameter",
          "units": "m",
          "default": 0.4,
          "description": "Thickness of soil layer 2"
        },
        "layer3_thickness": {
          "type": "parameter",
          "units": "m",
          "default": 1.0,
          "description": "Thickness of soil layer 3"
        },
        "root_zone_moisture": {
          "type": "unknown",
          "units": "m^3/m^3",
          "description": "Root-zone weighted soil moisture"
        },
        "water_stress_factor": {
          "type": "unknown",
          "units": "dimensionless",
          "description": "Water stress factor for vegetation (0=stressed, 1=unstressed)"
        }
      },
