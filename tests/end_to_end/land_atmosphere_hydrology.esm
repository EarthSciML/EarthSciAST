{
  "esm": "1.0.0",
  "metadata": {
    "name": "LandAtmosphereHydrology",
    "description": "End-to-end test for coupled land-atmosphere water and energy cycles with vegetation dynamics\nMigrated from ESM v0.1.0 to v0.2.0 via esm-migrate.",
    "authors": [
      "ESM Test Suite"
    ],
    "license": "MIT",
    "created": "2026-02-14T00:00:00Z",
    "tags": [
      "end-to-end",
      "land-atmosphere",
      "hydrology",
      "vegetation",
      "energy-balance",
      "migrated_from_v01"
    ],
    "references": [
      {
        "citation": "Land-atmosphere coupling test fixture for hydrological and energy cycles",
        "notes": "Tests surface energy balance, soil moisture, vegetation growth, and feedback mechanisms"
      }
    ]
  },
  "models": {
    "AtmosphericBoundaryLayer": {
      "reference": {
        "notes": "Atmospheric boundary layer model with temperature, humidity, and momentum exchange"
      },
      "variables": {
        "air_temperature": {
          "type": "unknown",
          "units": "K",
          "default": 295.15,
          "description": "Air temperature at 2m height"
        },
        "specific_humidity": {
          "type": "unknown",
          "units": "kg/kg",
          "default": 0.008,
          "description": "Specific humidity at 2m height"
        },
        "wind_speed": {
          "type": "unknown",
          "units": "m/s",
          "default": 3.0,
          "description": "Wind speed at 10m height"
        },
        "pressure": {
          "type": "parameter",
          "units": "Pa",
          "default": 101325.0,
          "description": "Surface atmospheric pressure"
        },
        "incoming_radiation": {
          "type": "parameter",
          "units": "W/m^2",
          "default": 400.0,
          "description": "Incoming solar radiation",
          "update": {
            "kind": "data",
            "source": "MeteorologicalForcing",
            "from": {
              "file_variable": "incoming_radiation"
            }
          },
          "shape": []
        },
        "longwave_radiation": {
          "type": "parameter",
          "units": "W/m^2",
          "default": 350.0,
          "description": "Incoming longwave radiation",
          "update": {
            "kind": "data",
            "source": "MeteorologicalForcing",
            "from": {
              "file_variable": "longwave_radiation"
            }
          },
          "shape": []
        },
        "precipitation": {
          "type": "parameter",
          "units": "kg/m^2/s",
          "default": 3e-06,
          "description": "Precipitation rate",
          "update": {
            "kind": "data",
            "source": "MeteorologicalForcing",
            "from": {
              "file_variable": "precipitation"
            }
          },
          "shape": []
        },
        "relative_humidity": {
          "type": "unknown",
          "units": "dimensionless",
          "description": "Relative humidity from temperature and specific humidity"
        },
        "air_temperature_data": {
          "type": "parameter",
          "units": "K",
          "default": 0.0,
          "shape": [],
          "update": {
            "kind": "data",
            "source": "MeteorologicalForcing",
            "from": {
              "file_variable": "air_temperature"
            }
          },
          "description": "2m air temperature"
        },
        "specific_humidity_data": {
          "type": "parameter",
          "units": "kg/kg",
          "default": 0.0,
          "shape": [],
          "update": {
            "kind": "data",
            "source": "MeteorologicalForcing",
            "from": {
              "file_variable": "specific_humidity"
            }
          },
          "description": "2m specific humidity from dewpoint"
        },
        "wind_speed_data": {
          "type": "parameter",
          "units": "m/s",
          "default": 0.0,
          "shape": [],
          "update": {
            "kind": "data",
            "source": "MeteorologicalForcing",
            "from": {
              "file_variable": "wind_speed"
            }
          },
          "description": "10m wind speed magnitude"
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "air_temperature"
            ],
            "wrt": "t"
          },
          "rhs": 0.0
        },
        {
          "lhs": {
            "op": "D",
            "args": [
              "specific_humidity"
            ],
            "wrt": "t"
          },
          "rhs": 0.0
        },
        {
          "lhs": {
            "op": "D",
            "args": [
              "wind_speed"
            ],
            "wrt": "t"
          },
          "rhs": 0.0
        },
        {
          "lhs": {
            "op": "ic",
            "args": [
              "air_temperature"
            ]
          },
          "rhs": 295.15
        },
        {
          "lhs": {
            "op": "ic",
            "args": [
              "specific_humidity"
            ]
          },
          "rhs": 0.008
        },
        {
          "lhs": {
            "op": "ic",
            "args": [
              "wind_speed"
            ]
          },
          "rhs": 3.0
        },
        {
          "lhs": "relative_humidity",
          "rhs": {
            "op": "/",
            "args": [
              "specific_humidity",
              {
                "op": "*",
                "args": [
                  0.622,
                  {
                    "op": "exp",
                    "args": [
                      {
                        "op": "/",
                        "args": [
                          {
                            "op": "*",
                            "args": [
                              17.67,
