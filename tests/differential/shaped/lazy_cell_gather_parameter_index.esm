{
  "esm": "2.4.0",
  "metadata": {
    "name": "lazy_cell_gather_parameter_index",
    "description": "A parameter override selects the safe cell of a conditional broadcast through a computed subscript."
  },
  "models": {
    "Probe": {
      "variables": {
        "selected": {"type": "unknown", "units": "1"},
        "slot": {"type": "parameter", "units": "1", "default": 2}
      },
      "equations": [
        {
          "lhs": "selected",
          "rhs": {
            "op": "index",
            "args": [
              {
                "op": "broadcast",
                "fn": "ifelse",
                "args": [
                  {"op": "const", "args": [], "value": [1, 0]},
                  {"op": "const", "args": [], "value": [7, 8]},
                  {"op": "index", "args": [{"op": "const", "args": [], "value": [9]}, 0]}
                ]
              },
              {"op": "+", "args": ["slot", 0]}
            ]
          }
        }
      ],
      "tolerance": {"rel": 0, "abs": 0},
      "tests": [
        {
          "id": "probe",
          "time_span": {"start": 0, "end": 1},
          "parameter_overrides": {"slot": 1},
          "assertions": [{"variable": "selected", "time": 0, "expected": 7}]
        }
      ]
    }
  }
}
