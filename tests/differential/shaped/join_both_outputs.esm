{
 "esm": "2.4.0",
 "metadata": {
  "name": "static_join_both_outputs",
  "description": "An equality gate with both indices bound by the output suppresses unmatched cells.",
  "authors": [
   "EarthSciML Authors and Contributors"
  ]
 },
 "index_sets": {
  "rows": {
   "kind": "interval",
   "size": 4
  },
  "chosen": {
   "kind": "interval",
   "size": 3
  }
 },
 "models": {
  "Probe": {
   "variables": {
    "left_group": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "rows"
     ]
    },
    "right_group": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "chosen"
     ]
    },
    "left_bucket": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "rows"
     ]
    },
    "right_bucket": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "chosen"
     ]
    },
    "matches": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "rows",
      "chosen"
     ]
    }
   },
   "equations": [
    {
     "lhs": "left_group",
     "rhs": {
      "op": "const",
      "args": [],
      "value": [
       10,
       20,
       10,
       90
      ]
     }
    },
    {
     "lhs": "right_group",
     "rhs": {
      "op": "const",
      "args": [],
      "value": [
       10,
       20,
       10
      ]
     }
    },
    {
     "lhs": "left_bucket",
     "rhs": {
      "op": "const",
      "args": [],
      "value": [
       1,
       1,
       1,
       2
      ]
     }
    },
    {
     "lhs": "right_bucket",
     "rhs": {
      "op": "const",
      "args": [],
      "value": [
       1,
       1,
       2
      ]
     }
    },
    {
     "lhs": "matches",
     "rhs": {
      "op": "faq",
      "args": [],
      "output_idx": [
       "l",
       "r"
      ],
      "ranges": {
       "l": {
        "from": "rows"
       },
       "r": {
        "from": "chosen"
       }
      },
      "semiring": "sum_product",
      "expr": 17,
      "join": [
       {
        "on": [
         [
          "left_group",
          "right_group"
         ],
         [
          "left_bucket",
          "right_bucket"
         ]
        ]
       }
      ]
     }
    }
   ],
   "tolerance": {
    "rel": 0,
    "abs": 0
   },
   "tests": [
    {
     "id": "probe",
     "time_span": {
      "start": 0,
      "end": 1
     },
     "assertions": [
      {
       "variable": "matches",
       "time": 0,
       "expected": 17,
       "coords": {
        "rows": 1,
        "chosen": 1
       }
      },
      {
       "variable": "matches",
       "time": 0,
       "expected": 0,
       "coords": {
        "rows": 1,
        "chosen": 2
       }
      },
      {
       "variable": "matches",
       "time": 0,
       "expected": 0,
       "coords": {
        "rows": 1,
        "chosen": 3
       }
      },
      {
       "variable": "matches",
       "time": 0,
       "expected": 17,
       "coords": {
        "rows": 2,
        "chosen": 2
       }
      }
     ]
    }
   ]
  }
 }
}
