{
  "esm": "2.3.0",
  "metadata": {
    "name": "PermutedStaticAlias",
    "description": "A state-free alias reverses the declared named axes of a constant matrix."
  },
  "index_sets": {
    "rows": {"kind": "interval", "size": 2},
    "cols": {"kind": "interval", "size": 3}
  },
  "models": {
    "Probe": {
      "variables": {
        "matrix": {"type": "unknown", "units": "1", "shape": ["cols", "rows"]},
        "permuted": {"type": "unknown", "units": "1", "shape": ["rows", "cols"]}
      },
      "equations": [
        {"lhs": "matrix", "rhs": {"op": "const", "args": [], "value": [[1, 2], [3, 4], [5, 6]]}},
        {"lhs": "permuted", "rhs": "matrix"}
      ],
      "tests": [
        {
          "id": "probe",
          "time_span": {"start": 0, "end": 1},
          "assertions": [
            {"variable": "permuted", "time": 0, "expected": 3, "coords": {"rows": 1, "cols": 2}}
          ]
        }
      ]
    }
  }
}
