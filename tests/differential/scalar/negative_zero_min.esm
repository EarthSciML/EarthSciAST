{
  "esm": "2.4.0",
  "metadata": {
    "name": "ScalarProbe",
    "description": "IEEE minimum of positive zero and negative zero computed by unary negation."
  },
  "models": {
    "Probe": {
      "variables": {
        "zero": {
          "type": "parameter",
          "units": "1",
          "description": "Positive zero parameter",
          "default": 0
        },
        "result": {
          "type": "unknown",
          "units": "1",
          "description": "Scalar result"
        }
      },
      "equations": [
        {"lhs": "result", "rhs": {"op": "min", "args": ["zero", {"op": "-", "args": ["zero"]}]}}
      ],
      "tests": [
        {
          "id": "probe",
          "time_span": {"start": 0, "end": 1},
          "assertions": [{"variable": "result", "time": 0, "expected": 0}]
        }
      ]
    }
  }
}
