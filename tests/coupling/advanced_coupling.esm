{
  "esm": "1.0.0",
  "metadata": {
    "name": "AdvancedCouplingTests",
    "description": "Test all coupling types: couple, variable_map, operator_compose, callback\nMigrated from ESM v0.1.0 to v0.2.0 via esm-migrate.",
    "authors": [
      "Test Suite"
    ],
    "created": "2026-02-14T00:00:00Z",
    "tags": [
      "migrated_from_v01"
    ]
  },
  "models": {
    "Chemistry": {
      "variables": {
        "O3": {
          "type": "unknown",
          "units": "mol/mol",
          "default": 4e-08,
          "description": "Ozone"
        },
        "NO": {
          "type": "unknown",
          "units": "mol/mol",
          "default": 1e-10,
          "description": "NO"
        },
        "temperature": {
          "type": "parameter",
          "units": "K",
          "default": 298.15,
          "description": "Temperature",
          "update": {
            "kind": "data",
            "source": "MeteoData",
            "from": {
              "file_variable": "temperature"
            }
          },
          "shape": []
        },
        "deposition_flux": {
          "type": "unknown",
          "units": "mol/m^2/s",
          "description": "Surface deposition flux"
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "O3"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "*",
            "args": [
              -0.1,
              "O3",
              "NO"
            ]
          }
        },
        {
          "lhs": {
            "op": "D",
            "args": [
              "NO"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "*",
            "args": [
              -0.1,
              "O3",
              "NO"
            ]
          }
        },
        {
          "lhs": {
            "op": "ic",
            "args": [
              "O3"
            ]
          },
          "rhs": 1e-09
        },
        {
          "lhs": {
            "op": "ic",
            "args": [
              "NO"
            ]
          },
          "rhs": 1e-09
        },
        {
          "lhs": "deposition_flux",
          "rhs": {
            "op": "*",
            "args": [
              "O3",
              0.001
            ]
          }
        }
      ]
    },
    "Surface": {
      "variables": {
        "surface_resistance": {
          "type": "parameter",
          "units": "s/m",
          "default": 100.0,
          "description": "Surface resistance"
        },
        "deposition_velocity": {
          "type": "unknown",
          "units": "m/s",
          "description": "Deposition velocity"
        }
      },
      "equations": [
        {
          "lhs": "deposition_velocity",
          "rhs": {
            "op": "/",
            "args": [
              1.0,
              "surface_resistance"
            ]
          }
        }
      ]
    },
    "Transport": {
      "variables": {
        "wind_speed": {
          "type": "parameter",
          "units": "m/s",
          "default": 5.0,
          "description": "Wind speed",
          "update": {
            "kind": "data",
            "source": "MeteoData",
            "from": {
              "file_variable": "wind_u",
              "unit_conversion": 1.0
            }
          },
          "shape": []
        },
        "diffusivity": {
          "type": "parameter",
          "units": "m^2/s",
          "default": 10.0,
          "description": "Turbulent diffusivity"
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "_var"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "+",
            "args": [
              {
                "op": "*",
                "args": [
                  {
                    "op": "-",
                    "args": [
                      "wind_speed"
                    ]
                  },
                  {
                    "op": "grad",
                    "args": [
                      "_var"
                    ],
                    "dim": "x"
                  }
                ]
              },
              {
                "op": "*",
                "args": [
                  "diffusivity",
                  {
                    "op": "laplacian",
                    "args": [
                      "_var"
                    ]
                  }
                ]
              }
            ]
          }
        }
      ]
    }
  },
  "data_sources": {
    "MeteoData": {
      "kind": "grid",
      "source": {
        "url_template": "file:///data/WRF/{date:%Y%m%d_%H%M}.nc"
      },
      "temporal": {
        "frequency": "PT1H",
        "file_period": "PT1H",
        "records_per_file": 1
      },
      "metadata": {
        "tags": [
          "meteorology",
          "reanalysis"
        ]
      }
    }
  },
  "coupling": [
    {
      "type": "couple",
      "systems": [
        "Chemistry",
        "Surface"
      ],
      "connector": {
        "equations": [
          {
            "from": "Chemistry.deposition_flux",
            "to": "Chemistry.O3",
            "transform": "additive",
            "expression": {
              "op": "*",
              "args": [
                {
                  "op": "-",
                  "args": [
                    "Surface.deposition_velocity"
                  ]
                },
                "Chemistry.O3"
              ]
            }
          }
        ]
      },
      "description": "Bidirectional chemistry-surface coupling"
    },
    {
      "type": "variable_map",
      "from": "Chemistry.O3",
      "to": "Surface.surface_resistance",
      "transform": {
        "op": "*",
        "args": [
          100.0,
          {
            "op": "+",
            "args": [
              1.0,
              {
                "op": "*",
                "args": [
                  0.1,
                  "Chemistry.O3"
                ]
              }
            ]
          }
        ]
      },
      "description": "Ozone raises surface resistance: the constant parameter becomes a derived variable"
    },
    {
      "type": "operator_compose",
      "systems": [
        "Chemistry",
        "Transport"
      ],
      "translate": {
        "Chemistry.O3": "Transport._var",
        "Chemistry.NO": "Transport._var"
      },
      "description": "Add transport to chemistry species"
    },
    {
      "type": "callback",
      "callback_id": "DiagnosticOutput",
      "config": {
        "output_frequency": "PT10M",
        "variables": [
          "Chemistry.O3",
          "Chemistry.NO",
          "Surface.deposition_velocity"
        ],
        "output_file": "diagnostics.nc"
      },
      "description": "Write diagnostic output every 10 minutes"
    }
  ],
  "domain": {
    "temporal": {
      "start": "2024-06-01T00:00:00Z",
      "end": "2024-06-01T12:00:00Z"
    }
  }
}
