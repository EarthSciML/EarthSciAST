{
  "esm": "1.3.0",
  "metadata": {
    "name": "operator_declared_before_owner_compose",
    "description": "An operator_compose whose operator, declared BEFORE the component whose state it writes, authors that state's tendency by its scoped name (reseact's NEI2016 emission source and SuperFast). The merged equation belongs to Chem (esm-libraries-spec §4.7.1 step 4) and is appended to Chem's equations, after Chem's own: the flattened order is D(Chem.A), D(Chem.C), D(Chem.B), not D(Chem.B) first at Src's position."
  },
  "models": {
    "Src": {
      "variables": {
        "e": {"type": "parameter", "units": "1/s", "default": 0.0025}
      },
      "equations": [
        {"lhs": {"op": "D", "args": ["Chem.B"], "wrt": "t"}, "rhs": "Src.e"}
      ]
    },
    "Chem": {
      "variables": {
        "A": {"type": "unknown", "units": "1", "default": 5.5},
        "B": {"type": "unknown", "units": "1", "default": 10.5},
        "C": {"type": "unknown", "units": "1", "default": 40.5},
        "k": {"type": "parameter", "units": "1/s", "default": 0.0125}
      },
      "equations": [
        {"lhs": {"op": "D", "args": ["A"], "wrt": "t"}, "rhs": {"op": "-", "args": [{"op": "*", "args": ["k", "A"]}]}},
        {"lhs": {"op": "D", "args": ["B"], "wrt": "t"}, "rhs": {"op": "-", "args": [{"op": "*", "args": ["k", "A"]}, {"op": "*", "args": ["k", "B"]}]}},
        {"lhs": {"op": "D", "args": ["C"], "wrt": "t"}, "rhs": {"op": "*", "args": ["k", "B"]}}
      ]
    }
  },
  "coupling": [
    {"type": "operator_compose", "systems": ["Src", "Chem"], "require_match": false}
  ]
}
