{
  "esm": "1.1.0",
  "metadata": {
    "name": "interp_bilinear_template",
    "description": "The `bilinear` template of lib/interp.esm applied to scenarios of this directory's expected.json, which pins the binary64 reference values (those of the 1.x `interp.bilinear` closed function). Each scenario is one algebraic unknown defined by an `apply_expression_template` call with the scenario's arrays as `const` nodes, the axis lengths as integers and the query as a parameter; the inline test asserts the expected value exactly (tolerance 0). NaN scenarios stay in the binding harnesses, since JSON cannot write NaN. Run by the `interp_templates` inline-test conformance tier.",
    "authors": [
      "EarthSciML"
    ],
    "tags": [
      "interp",
      "bilinear",
      "expression-templates",
      "standard-library"
    ]
  },
  "models": {
    "interp_bilinear_template": {
