      "tests": [
        {
          "id": "interp_searchsorted_template_t0",
          "description": "Every scenario at t = 0.",
          "time_span": {
            "start": 0.0,
            "end": 1.0
          },
          "assertions": [
            {
              "variable": "r_below_minimum",
              "time": 0.0,
              "expected": 1.0
