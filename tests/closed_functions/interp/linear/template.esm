          "type": "unknown",
          "units": "1",
          "description": "`linear` template on scenario `exact_at_interior_knot` of expected.json: x on an interior knot (w = 0)."
        },
        "x_exact_at_last_knot": {
          "type": "parameter",
          "units": "1",
          "default": 4.0,
          "description": "Query of scenario `exact_at_last_knot`."
        },
