{
  "esm": "1.1.0",
  "metadata": {
    "name": "interp_linear_template",
    "description": "The `linear` template of lib/interp.esm applied to scenarios of this directory's expected.json, which pins the binary64 reference values (those of the 1.x `interp.linear` closed function). Each scenario is one algebraic unknown defined by an `apply_expression_template` call with the scenario's arrays as `const` nodes, the axis lengths as integers and the query as a parameter; the inline test asserts the expected value exactly (tolerance 0). NaN scenarios stay in the binding harnesses, since JSON cannot write NaN. Run by the `interp_templates` inline-test conformance tier.",
    "authors": [
      "EarthSciML"
    ],
    "tags": [
      "interp",
      "linear",
      "expression-templates",
      "standard-library"
    ]
  },
  "models": {
    "interp_linear_template": {
      "expression_template_imports": [
        {
          "ref": "esm:std/interp.esm",
          "only": [
            "linear"
          ]
        }
      ],
      "variables": {
        "s": {
          "type": "unknown",
          "units": "1",
          "default": 0.0,
          "description": "Trivial state, so the document has something to integrate."
        },
        "x_below_minimum_clamps": {
          "type": "parameter",
          "units": "1",
          "default": -5.0,
          "description": "Query of scenario `below_minimum_clamps`."
        },
        "r_below_minimum_clamps": {
          "type": "unknown",
          "units": "1",
          "description": "`linear` template on scenario `below_minimum_clamps` of expected.json: clamp below."
        },
        "x_above_maximum_clamps": {
          "type": "parameter",
          "units": "1",
          "default": 99.0,
          "description": "Query of scenario `above_maximum_clamps`."
        },
        "r_above_maximum_clamps": {
          "type": "unknown",
          "units": "1",
          "description": "`linear` template on scenario `above_maximum_clamps` of expected.json: clamp above."
        },
        "x_exact_at_first_knot": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "description": "Query of scenario `exact_at_first_knot`."
        },
