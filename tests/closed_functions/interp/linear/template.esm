          "type": "unknown",
          "units": "1",
          "description": "`linear` template on scenario `exact_at_first_knot` of expected.json: x on the first knot."
        },
        "x_exact_at_interior_knot": {
          "type": "parameter",
          "units": "1",
          "default": 2.0,
          "description": "Query of scenario `exact_at_interior_knot`."
        },
