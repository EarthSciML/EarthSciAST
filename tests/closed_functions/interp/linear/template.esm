          "type": "unknown",
          "units": "1",
          "description": "`linear` template on scenario `exact_at_last_knot` of expected.json: x on the last knot."
        },
        "x_midpoint_first_cell": {
          "type": "parameter",
          "units": "1",
          "default": 0.5,
          "description": "Query of scenario `midpoint_first_cell`."
        },
        "r_midpoint_first_cell": {
          "type": "unknown",
          "units": "1",
          "description": "`linear` template on scenario `midpoint_first_cell` of expected.json: blend in the first cell."
        },
        "x_quarter_point_interior_cell": {
