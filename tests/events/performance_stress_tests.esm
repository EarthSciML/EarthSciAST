    "EventErrorHandlingSystem": {
      "variables": {
        "normal_state": {
          "type": "unknown",
          "units": "1",
          "default": 1.0,
          "description": "Normal state variable"
        },
        "error_prone_state": {
          "type": "unknown",
          "units": "1",
          "default": 0.1,
          "description": "State that may cause errors"
        },
        "error_count": {
          "type": "parameter",
          "units": "1",
          "default": 0,
          "description": "Count of error conditions",
          "update": [
            {
              "kind": "condition",
              "when": {
                "op": ">",
                "args": [
                  "error_count",
                  5
                ]
              },
              "expression": 0
            },
            {
              "kind": "crossing",
              "when": {
                "op": "<",
                "args": [
                  "error_prone_state",
                  0.001
                ]
              },
              "expression": {
                "op": "+",
                "args": [
                  {
                    "op": "Pre",
                    "args": [
                      "error_count"
                    ]
                  },
                  1
                ]
              }
            },
            {
              "kind": "crossing",
              "when": {
                "op": ">",
                "args": [
                  "normal_state",
                  1000.0
                ]
              },
              "expression": {
                "op": "+",
                "args": [
                  {
                    "op": "Pre",
                    "args": [
                      "error_count"
                    ]
                  },
                  10
                ]
              }
            }
          ]
        },
        "recovery_attempts": {
          "type": "parameter",
          "units": "1",
          "default": 0,
          "description": "Recovery attempt counter",
          "update": {
            "kind": "condition",
            "when": {
              "op": ">",
              "args": [
                "error_count",
                5
              ]
            },
            "expression": {
              "op": "+",
              "args": [
                {
                  "op": "Pre",
                  "args": [
                    "recovery_attempts"
                  ]
                },
                1
              ]
            }
          }
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "normal_state"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "*",
            "args": [
              -0.1,
              "normal_state"
            ]
          }
        },
        {
          "lhs": {
            "op": "D",
            "args": [
              "error_prone_state"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "+",
            "args": [
              {
                "op": "*",
                "args": [
                  0.1,
                  "normal_state"
                ]
              },
              {
                "op": "*",
                "args": [
                  -0.2,
                  "error_prone_state"
                ]
              }
            ]
          }
        },
        {
          "lhs": {
            "op": "ic",
            "args": [
              "normal_state"
            ]
          },
          "rhs": 0.0
        },
        {
          "lhs": {
            "op": "ic",
            "args": [
              "error_prone_state"
            ]
          },
          "rhs": 0.0
        }
      ],
      "continuous_events": [
        {
          "name": "near_zero_division_guard",
          "conditions": [
            {
              "op": "<",
              "args": [
                "error_prone_state",
                0.001
              ]
            }
          ],
          "affects": [
            {
              "lhs": "error_prone_state",
              "rhs": 0.001
            }
          ],
          "reinitialize": true,
          "description": "Prevent near-zero values that could cause numerical issues"
        },
        {
          "name": "overflow_protection",
          "conditions": [
            {
              "op": ">",
              "args": [
                "normal_state",
                1000.0
              ]
            }
          ],
          "affects": [
            {
              "lhs": "normal_state",
              "rhs": 1000.0
            }
          ],
          "reinitialize": true,
          "description": "Prevent overflow conditions"
        }
      ],
      "discrete_events": [
        {
          "name": "error_recovery_attempt",
          "trigger": {
            "type": "condition",
            "expression": {
              "op": ">",
              "args": [
                "error_count",
                5
              ]
            }
          },
          "affects": [
            {
              "lhs": "normal_state",
              "rhs": 1.0
            },
            {
              "lhs": "error_prone_state",
              "rhs": 0.1
            }
          ],
          "reinitialize": true,
          "description": "Attempt system recovery after multiple errors"
        }
      ]
    }
