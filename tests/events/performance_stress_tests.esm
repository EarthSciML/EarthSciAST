        "stress_parameter": {
          "type": "parameter",
          "units": "1",
          "default": 1.0,
          "description": "Parameter modified by many events",
          "shape": [],
          "update": [
            {
              "kind": "schedule",
              "interval": 0.25,
              "expression": {
                "op": "*",
                "args": [
                  {
                    "op": "Pre",
                    "args": [
                      "stress_parameter"
                    ]
