{
  "esm": "1.0.0",
  "metadata": {
    "name": "ContinuousEventScenarios",
    "description": "Comprehensive continuous event detection and handling test cases",
    "authors": [
      "Test Suite"
    ],
    "created": "2026-02-14T00:00:00Z"
  },
  "models": {
    "RootFindingSystem": {
      "variables": {
        "x": {
          "type": "unknown",
          "units": "m",
          "default": 1.0,
          "description": "Oscillating variable"
        },
        "y": {
          "type": "unknown",
          "units": "m",
          "default": 0.5,
          "description": "Growing variable"
        },
        "z": {
          "type": "unknown",
          "units": "m",
          "default": -0.2,
          "description": "Decaying variable"
        },
        "event_log": {
          "type": "parameter",
          "units": "1",
          "default": 0,
          "description": "Event occurrence log",
          "update": [
            {
              "kind": "crossing",
              "when": {
                "op": "-",
                "args": [
                  "x",
                  0.5
                ]
              },
              "expression": {
                "op": "+",
                "args": [
                  {
                    "op": "Pre",
                    "args": [
                      "event_log"
                    ]
                  },
                  100
                ]
              }
            },
            {
              "kind": "crossing",
              "when": {
                "op": "-",
                "args": [
                  "x",
                  -0.5
                ]
              },
              "expression": {
                "op": "+",
                "args": [
                  {
                    "op": "Pre",
                    "args": [
                      "event_log"
                    ]
                  },
                  200
                ]
              }
            },
            {
              "kind": "crossing",
              "when": {
                "op": "and",
                "args": [
                  {
                    "op": "-",
                    "args": [
                      "x",
                      0.8
                    ]
                  },
                  {
                    "op": "-",
                    "args": [
                      "y",
                      1.0
                    ]
                  }
                ]
              },
              "expression": {
                "op": "+",
                "args": [
                  {
                    "op": "Pre",
                    "args": [
                      "event_log"
                    ]
                  },
                  1000
                ]
              }
            },
            {
              "kind": "crossing",
              "when": {
                "op": "or",
                "args": [
                  {
                    "op": "-",
                    "args": [
                      "z",
                      -0.05
                    ]
                  },
                  {
                    "op": "-",
                    "args": [
                      "y",
                      2.0
                    ]
                  }
                ]
              },
              "expression": {
                "op": "+",
                "args": [
                  {
                    "op": "Pre",
                    "args": [
                      "event_log"
                    ]
                  },
                  10000
                ]
              }
            }
          ]
        },
        "zero_cross_count": {
          "type": "parameter",
          "units": "1",
          "default": 0,
          "description": "Zero crossing counter",
          "update": {
            "kind": "crossing",
            "when": {
              "op": "-",
              "args": [
                "x",
                0
              ]
            },
            "expression": {
              "op": "+",
              "args": [
                {
                  "op": "Pre",
                  "args": [
                    "zero_cross_count"
                  ]
                },
                1
              ]
            }
          }
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "x"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "*",
            "args": [
              {
                "op": "sin",
                "args": [
                  "t"
                ]
              },
              2.0
            ]
          }
        },
        {
          "lhs": {
            "op": "D",
            "args": [
              "y"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "*",
            "args": [
              "y",
              0.1
            ]
          }
        },
        {
          "lhs": {
            "op": "D",
            "args": [
              "z"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "*",
            "args": [
              "z",
              -0.5
            ]
          }
        },
        {
          "lhs": {
            "op": "ic",
            "args": [
              "x"
            ]
          },
          "rhs": 0.0
        },
        {
          "lhs": {
            "op": "ic",
            "args": [
              "y"
            ]
          },
          "rhs": 0.0
        },
        {
          "lhs": {
            "op": "ic",
            "args": [
              "z"
            ]
          },
          "rhs": 0.0
        }
      ],
      "continuous_events": []
    },
    "MultipleEventsSystem": {
      "variables": {
        "state_var": {
          "type": "unknown",
          "units": "1",
          "default": 0.0,
          "description": "Main state variable"
        },
        "priority_counter": {
          "type": "parameter",
          "units": "1",
          "default": 0,
          "description": "Priority event counter",
          "update": [
            {
              "kind": "crossing",
              "when": {
                "op": "-",
                "args": [
                  "state_var",
                  1.0
                ]
              },
              "expression": {
                "op": "+",
                "args": [
                  {
                    "op": "Pre",
                    "args": [
                      "priority_counter"
                    ]
                  },
                  1
                ]
              }
            },
            {
              "kind": "crossing",
              "when": {
                "op": "-",
                "args": [
                  "state_var",
                  2.5
                ]
              },
              "expression": {
                "op": "+",
                "args": [
                  {
                    "op": "Pre",
                    "args": [
                      "priority_counter"
                    ]
                  },
                  10
                ]
              }
            }
          ]
        },
        "normal_counter": {
          "type": "parameter",
          "units": "1",
          "default": 0,
          "description": "Normal event counter",
          "update": [
            {
              "kind": "crossing",
              "when": {
                "op": "-",
                "args": [
                  "state_var",
                  1.0
                ]
              },
              "expression": {
                "op": "+",
                "args": [
                  {
                    "op": "Pre",
                    "args": [
                      "normal_counter"
                    ]
                  },
                  1
                ]
              }
            },
            {
              "kind": "crossing",
              "when": {
                "op": "-",
                "args": [
                  "state_var",
                  2.5
                ]
              },
              "expression": {
                "op": "+",
                "args": [
                  {
                    "op": "Pre",
                    "args": [
                      "normal_counter"
                    ]
                  },
                  10
                ]
              }
            }
          ]
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "state_var"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "*",
            "args": [
              "t",
              0.5
            ]
          }
        },
        {
          "lhs": {
            "op": "ic",
            "args": [
              "state_var"
            ]
          },
          "rhs": 0.0
        }
      ],
      "continuous_events": [
        {
          "name": "high_priority_event",
          "conditions": [
            {
              "op": "-",
              "args": [
                "state_var",
                1.0
              ]
            }
          ],
          "affects": [
            {
              "lhs": "state_var",
              "rhs": {
                "op": "*",
                "args": [
                  {
                    "op": "Pre",
                    "args": [
                      "state_var"
                    ]
                  },
                  0.8
                ]
              }
            }
          ],
          "reinitialize": true,
          "description": "High priority event with state modification"
        }
      ]
    },
    "AffectNegSystem": {
      "variables": {
        "oscillator": {
          "type": "unknown",
          "units": "1",
          "default": 1.0,
          "description": "Oscillating state"
        },
        "positive_hits": {
          "type": "parameter",
          "units": "1",
          "default": 0,
          "description": "Positive crossing count",
          "update": {
            "kind": "crossing",
            "when": {
              "op": "-",
              "args": [
                "oscillator",
                0.5
              ]
            },
            "direction": "up",
            "expression": {
              "op": "+",
              "args": [
                {
                  "op": "Pre",
                  "args": [
                    "positive_hits"
                  ]
                },
                1
              ]
            }
          }
        },
        "negative_hits": {
          "type": "parameter",
          "units": "1",
          "default": 0,
          "description": "Negative crossing count",
          "update": {
            "kind": "crossing",
            "when": {
              "op": "-",
              "args": [
                "oscillator",
                0.5
              ]
            },
            "direction": "down",
            "expression": {
              "op": "+",
              "args": [
                {
                  "op": "Pre",
                  "args": [
                    "negative_hits"
                  ]
                },
                1
              ]
            }
          }
        },
        "coefficient": {
          "type": "parameter",
          "units": "1",
          "default": 1.0,
          "description": "Damping coefficient",
          "update": [
            {
              "kind": "crossing",
              "when": {
                "op": "-",
                "args": [
                  "oscillator",
                  0.5
                ]
              },
              "direction": "up",
              "expression": {
                "op": "*",
                "args": [
                  {
                    "op": "Pre",
                    "args": [
                      "coefficient"
                    ]
                  },
                  0.95
                ]
              }
            },
            {
              "kind": "crossing",
              "when": {
                "op": "-",
                "args": [
                  "oscillator",
                  0.5
                ]
              },
              "direction": "down",
              "expression": {
                "op": "*",
                "args": [
                  {
                    "op": "Pre",
                    "args": [
                      "coefficient"
                    ]
                  },
                  1.05
                ]
              }
            }
          ]
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "oscillator"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "*",
            "args": [
              {
                "op": "sin",
                "args": [
                  {
                    "op": "*",
                    "args": [
                      3.0,
                      "t"
                    ]
                  }
                ]
              },
              {
                "op": "exp",
                "args": [
                  {
                    "op": "*",
                    "args": [
                      -0.1,
                      "t"
                    ]
                  }
                ]
              }
            ]
          }
        },
        {
          "lhs": {
            "op": "ic",
            "args": [
              "oscillator"
            ]
          },
          "rhs": 0.0
        }
      ],
      "continuous_events": []
    },
    "NestedEventChain": {
      "variables": {
        "primary": {
          "type": "unknown",
          "units": "1",
          "default": 0.0,
          "description": "Primary trigger variable"
        },
        "secondary": {
          "type": "unknown",
          "units": "1",
          "default": 0.0,
          "description": "Secondary cascade variable"
        },
        "tertiary": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "description": "Final cascade variable",
          "update": {
            "kind": "crossing",
            "when": {
              "op": "-",
              "args": [
                "secondary",
                3.0
              ]
            },
            "expression": 10.0
          }
        },
        "chain_depth": {
          "type": "parameter",
          "units": "1",
          "default": 0,
          "description": "Chain depth counter",
          "update": [
            {
              "kind": "crossing",
              "when": {
                "op": "-",
                "args": [
                  "primary",
                  1.0
                ]
              },
              "expression": 1
            },
            {
              "kind": "crossing",
              "when": {
                "op": "-",
                "args": [
                  "secondary",
                  3.0
                ]
              },
              "expression": 2
            },
            {
              "kind": "crossing",
              "when": {
                "op": "-",
                "args": [
                  "tertiary",
                  8.0
                ]
              },
              "expression": 3
            }
          ]
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "primary"
            ],
            "wrt": "t"
          },
          "rhs": 1.0
        },
        {
          "lhs": {
            "op": "D",
            "args": [
              "secondary"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "*",
            "args": [
              "tertiary",
              0.5
            ]
          }
        },
        {
          "lhs": {
            "op": "ic",
            "args": [
              "primary"
            ]
          },
          "rhs": 0.0
        },
        {
          "lhs": {
            "op": "ic",
            "args": [
              "secondary"
            ]
          },
          "rhs": 0.0
        }
      ],
      "continuous_events": [
        {
          "name": "cascade_level_1",
          "conditions": [
            {
              "op": "-",
              "args": [
                "primary",
                1.0
              ]
            }
          ],
          "affects": [
            {
              "lhs": "secondary",
              "rhs": 5.0
            }
          ],
          "reinitialize": true,
          "description": "First level of event cascade"
        },
        {
          "name": "cascade_level_3",
          "conditions": [
            {
              "op": "-",
              "args": [
                "tertiary",
                8.0
              ]
            }
          ],
          "affects": [
            {
              "lhs": "primary",
              "rhs": 0.0
