{
  "esm": "1.0.0",
  "metadata": {
    "name": "ComplexPhysicalScenarios",
    "description": "Complex event scenarios: bouncing ball, reactor control, epidemic models, and ecosystem dynamics",
    "authors": [
      "Test Suite"
    ],
    "created": "2026-02-14T00:00:00Z"
  },
  "models": {
    "AdvancedBouncingBall": {
      "variables": {
        "height": {
          "type": "unknown",
          "units": "m",
          "default": 2.0,
          "description": "Ball height"
        },
        "velocity": {
          "type": "unknown",
          "units": "m/s",
          "default": 0.0,
          "description": "Ball velocity"
        },
        "g": {
          "type": "parameter",
          "units": "m/s^2",
          "default": 9.81,
          "description": "Gravitational acceleration"
        },
        "drag_coefficient": {
          "type": "parameter",
          "units": "1",
          "default": 0.01,
          "description": "Air resistance coefficient",
          "update": {
            "kind": "crossing",
            "when": {
              "op": "and",
              "args": [
                {
                  "op": "<",
                  "args": [
                    "total_energy",
                    0.01
                  ]
                },
                {
                  "op": "<",
                  "args": [
                    "height",
                    0.001
                  ]
                }
              ]
            },
            "expression": 1000.0
          }
        },
        "restitution": {
          "type": "parameter",
          "units": "1",
          "default": 0.8,
          "description": "Coefficient of restitution",
          "update": {
            "kind": "condition",
            "when": {
              "op": ">",
              "args": [
                "bounce_count",
                5
              ]
            },
            "expression": {
              "op": "*",
              "args": [
                {
                  "op": "Pre",
                  "args": [
                    "restitution"
                  ]
                },
                0.95
              ]
            }
          }
        },
        "bounce_count": {
          "type": "parameter",
          "units": "1",
          "default": 0,
          "description": "Number of bounces",
          "update": {
            "kind": "crossing",
            "when": {
              "op": "-",
              "args": [
                0.0,
                "height"
              ]
            },
            "expression": {
              "op": "+",
              "args": [
                {
                  "op": "Pre",
                  "args": [
                    "bounce_count"
                  ]
                },
                1
              ]
            }
          }
        },
        "total_energy": {
          "type": "unknown",
          "units": "J",
          "description": "Total mechanical energy"
        },
        "energy_loss_rate": {
          "type": "parameter",
          "units": "J/s",
          "default": 0.0,
          "description": "Energy loss tracking",
          "update": {
            "kind": "crossing",
            "when": {
              "op": "-",
              "args": [
                0.0,
                "height"
              ]
            },
            "expression": {
              "op": "*",
              "args": [
                0.5,
                {
                  "op": "*",
                  "args": [
                    {
                      "op": "-",
                      "args": [
                        1.0,
                        {
                          "op": "^",
                          "args": [
                            "restitution",
                            2
                          ]
                        }
                      ]
                    },
                    {
                      "op": "^",
                      "args": [
                        {
                          "op": "Pre",
                          "args": [
                            "velocity"
                          ]
                        },
                        2
                      ]
                    }
                  ]
                }
              ]
            }
          }
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "height"
            ],
            "wrt": "t"
          },
          "rhs": "velocity"
        },
        {
          "lhs": {
            "op": "D",
            "args": [
              "velocity"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "-",
            "args": [
              "g",
              {
                "op": "*",
                "args": [
                  "drag_coefficient",
                  {
                    "op": "*",
                    "args": [
                      "velocity",
                      {
                        "op": "abs",
                        "args": [
                          "velocity"
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        },
        {
          "lhs": {
            "op": "ic",
            "args": [
              "height"
            ]
          },
          "rhs": 0.0
        },
        {
          "lhs": {
            "op": "ic",
            "args": [
              "velocity"
            ]
          },
          "rhs": 0.0
        },
        {
          "lhs": "total_energy",
          "rhs": {
            "op": "+",
            "args": [
              {
                "op": "*",
                "args": [
                  0.5,
                  {
                    "op": "^",
                    "args": [
                      "velocity",
                      2
                    ]
                  }
                ]
              },
              {
                "op": "*",
                "args": [
                  "g",
                  "height"
                ]
              }
            ]
          }
        }
      ],
      "continuous_events": [
        {
          "name": "ground_impact",
          "conditions": [
            {
              "op": "-",
              "args": [
                0.0,
                "height"
              ]
            }
          ],
          "affects": [
            {
              "lhs": "velocity",
              "rhs": {
                "op": "*",
                "args": [
                  -1.0,
                  "restitution",
                  {
                    "op": "Pre",
                    "args": [
                      "velocity"
                    ]
                  }
                ]
              }
            }
          ],
          "reinitialize": true,
          "root_find": "left",
          "description": "Ball bounces with energy loss on ground contact"
        },
        {
          "name": "low_energy_stop",
          "conditions": [
            {
              "op": "and",
              "args": [
                {
                  "op": "<",
                  "args": [
                    "total_energy",
                    0.01
                  ]
                },
                {
                  "op": "<",
                  "args": [
                    "height",
                    0.001
                  ]
                }
              ]
            }
          ],
          "affects": [
            {
              "lhs": "velocity",
              "rhs": 0.0
            }
          ],
          "reinitialize": true,
          "description": "Stop simulation when energy becomes negligible"
        }
      ],
      "discrete_events": []
    },
    "ChemicalReactorController": {
      "variables": {
        "temperature": {
          "type": "unknown",
          "units": "K",
          "default": 298.15,
          "description": "Reactor temperature"
        },
        "concentration": {
          "type": "unknown",
          "units": "mol/L",
          "default": 1.0,
          "description": "Reactant concentration"
        },
        "cooling_flow": {
          "type": "parameter",
          "units": "L/min",
          "default": 5.0,
          "description": "Coolant flow rate",
          "update": [
            {
              "kind": "crossing",
              "when": {
                "op": "-",
                "args": [
                  "temperature",
                  400.0
                ]
              },
              "expression": {
                "op": "*",
                "args": [
                  {
                    "op": "Pre",
                    "args": [
                      "cooling_flow"
                    ]
                  },
                  2.0
                ]
              }
            },
            {
              "kind": "crossing",
              "when": {
                "op": "-",
                "args": [
                  "temperature",
                  450.0
                ]
              },
              "expression": 50.0
            },
            {
              "kind": "crossing",
              "when": {
                "op": "-",
                "args": [
                  380.0,
                  "temperature"
                ]
              },
              "expression": 5.0
            }
          ]
        },
        "heating_power": {
          "type": "parameter",
          "units": "W",
          "default": 100.0,
          "description": "Heater power",
          "shape": [],
          "update": [
            {
              "kind": "schedule",
              "interval": 3600.0,
              "expression": {
                "op": "*",
                "args": [
                  {
                    "op": "Pre",
                    "args": [
                      "heating_power"
                    ]
                  },
                  0.99
                ]
              }
            },
            {
              "kind": "crossing",
              "when": {
                "op": "-",
                "args": [
                  "temperature",
                  450.0
                ]
              },
              "expression": 0.0
            }
          ]
        },
        "setpoint_temp": {
          "type": "parameter",
          "units": "K",
          "default": 350.0,
          "description": "Temperature setpoint",
          "update": {
            "kind": "condition",
            "when": {
              "op": "<",
              "args": [
                "concentration",
                0.1
              ]
            },
            "expression": {
              "op": "+",
              "args": [
                {
                  "op": "Pre",
                  "args": [
                    "setpoint_temp"
                  ]
                },
                10.0
              ]
            }
          }
        },
        "safety_state": {
          "type": "parameter",
          "units": "1",
          "default": 0,
          "description": "Safety system state (0=normal, 1=warning, 2=emergency)",
          "update": [
            {
              "kind": "crossing",
              "when": {
                "op": "-",
                "args": [
                  "temperature",
                  400.0
                ]
              },
              "expression": 1
            },
            {
              "kind": "crossing",
              "when": {
                "op": "-",
                "args": [
                  "temperature",
                  450.0
                ]
              },
              "expression": 2
            },
            {
              "kind": "crossing",
              "when": {
                "op": "-",
                "args": [
                  380.0,
                  "temperature"
                ]
              },
              "expression": 0
            }
          ]
        },
        "reaction_rate": {
          "type": "unknown",
          "units": "mol/(L*s)",
          "description": "Arrhenius reaction rate"
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "temperature"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "+",
            "args": [
              {
                "op": "*",
                "args": [
                  0.01,
                  {
                    "op": "-",
                    "args": [
                      "setpoint_temp",
                      "temperature"
                    ]
                  }
                ]
              },
              {
                "op": "*",
                "args": [
                  0.001,
                  "heating_power"
                ]
              },
              {
                "op": "*",
                "args": [
                  -0.002,
                  "cooling_flow",
                  {
                    "op": "-",
                    "args": [
                      "temperature",
                      298.15
                    ]
                  }
                ]
              },
              {
                "op": "*",
                "args": [
                  50.0,
                  "reaction_rate"
                ]
              }
            ]
          }
        },
        {
          "lhs": {
            "op": "D",
            "args": [
              "concentration"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "*",
            "args": [
              -1.0,
              "reaction_rate"
            ]
          }
        },
        {
          "lhs": {
            "op": "ic",
            "args": [
              "temperature"
            ]
          },
          "rhs": 0.0
        },
        {
          "lhs": {
            "op": "ic",
            "args": [
              "concentration"
            ]
          },
          "rhs": 0.0
        },
        {
          "lhs": "reaction_rate",
          "rhs": {
            "op": "*",
            "args": [
              0.001,
              "concentration",
              {
                "op": "exp",
                "args": [
                  {
                    "op": "/",
                    "args": [
                      {
                        "op": "-",
                        "args": [
                          5000.0
                        ]
                      },
                      "temperature"
                    ]
                  }
                ]
              }
            ]
          }
        }
      ],
      "continuous_events": [],
      "discrete_events": []
    },
