{
  "esm": "1.0.0",
  "metadata": {
    "name": "MixedEventInteractions",
    "description": "Test cases for mixed continuous/discrete event interactions and cross-system events",
    "authors": [
      "Test Suite"
    ],
    "created": "2026-02-14T00:00:00Z"
  },
  "models": {
    "HybridControlSystem": {
      "variables": {
        "plant_output": {
          "type": "unknown",
          "units": "1",
          "default": 0.0,
          "description": "Plant output"
        },
        "controller_state": {
          "type": "unknown",
          "units": "1",
          "default": 0.0,
          "description": "Controller integrator state"
        },
        "setpoint": {
          "type": "parameter",
          "units": "1",
          "default": 5.0,
          "description": "Control setpoint",
          "shape": [],
          "update": [
            {
              "kind": "schedule",
              "times": [
                5.0,
                15.0,
                25.0
              ],
              "expression": {
                "op": "*",
                "args": [
                  {
                    "op": "Pre",
                    "args": [
                      "setpoint"
                    ]
                  },
                  -1
                ]
              }
            },
            {
              "kind": "condition",
              "when": {
                "op": ">",
                "args": [
                  "EventLoggingSystem.event_count_total",
                  20
                ]
              },
              "expression": 0.0
            }
          ]
        },
        "control_gain": {
          "type": "parameter",
          "units": "1",
          "default": 2.0,
          "description": "Control gain",
          "shape": [],
          "update": [
            {
              "kind": "schedule",
              "interval": 8.0,
              "expression": 2.0
            },
            {
              "kind": "condition",
              "when": {
                "op": ">",
                "args": [
                  {
                    "op": "abs",
                    "args": [
                      {
                        "op": "-",
                        "args": [
                          "plant_output",
                          "setpoint"
                        ]
                      }
                    ]
                  },
                  1.0
                ]
              },
              "expression": {
                "op": "+",
                "args": [
                  {
                    "op": "Pre",
                    "args": [
                      "control_gain"
                    ]
                  },
                  {
                    "op": "*",
                    "args": [
                      {
                        "op": "sign",
                        "args": [
                          {
                            "op": "-",
                            "args": [
                              "setpoint",
                              "plant_output"
                            ]
                          }
                        ]
                      },
                      0.1
                    ]
                  }
                ]
              }
            },
            {
              "kind": "crossing",
              "when": {
                "op": "-",
                "args": [
                  {
                    "op": "*",
                    "args": [
                      "setpoint",
                      0.5
                    ]
                  },
                  "plant_output"
                ]
              },
              "expression": {
                "op": "*",
                "args": [
                  {
                    "op": "Pre",
                    "args": [
                      "control_gain"
                    ]
                  },
                  1.5
                ]
              }
            }
          ]
        },
        "discrete_mode": {
          "type": "parameter",
          "units": "1",
          "default": 1,
          "description": "Discrete control mode (0=off, 1=PI, 2=bang-bang)",
          "shape": [],
          "update": [
            {
              "kind": "schedule",
              "interval": 8.0,
              "expression": 1
            },
            {
              "kind": "crossing",
              "when": {
                "op": "-",
                "args": [
                  "plant_output",
                  {
                    "op": "*",
                    "args": [
                      "setpoint",
                      1.2
                    ]
                  }
                ]
              },
              "expression": 2
            }
          ]
        },
        "event_log": {
          "type": "parameter",
          "units": "1",
          "default": 0,
          "description": "Event occurrence log",
          "update": [
            {
              "kind": "crossing",
              "when": {
                "op": "-",
                "args": [
                  "plant_output",
                  {
                    "op": "*",
                    "args": [
                      "setpoint",
                      1.2
                    ]
                  }
                ]
              },
              "expression": {
                "op": "+",
                "args": [
                  {
                    "op": "Pre",
                    "args": [
                      "event_log"
                    ]
                  },
                  1000
                ]
              }
            },
            {
              "kind": "crossing",
              "when": {
                "op": "-",
                "args": [
                  {
                    "op": "*",
                    "args": [
                      "setpoint",
                      0.5
                    ]
                  },
                  "plant_output"
                ]
              },
              "expression": {
                "op": "+",
                "args": [
                  {
                    "op": "Pre",
                    "args": [
                      "event_log"
                    ]
                  },
                  100
                ]
              }
            }
          ]
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "plant_output"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "+",
            "args": [
              {
                "op": "*",
                "args": [
                  {
                    "op": "-",
                    "args": [
                      "controller_state"
                    ]
                  },
                  0.8
                ]
              },
              {
                "op": "*",
                "args": [
                  "plant_output",
                  -0.1
                ]
              }
            ]
          }
        },
        {
          "lhs": {
            "op": "D",
            "args": [
              "controller_state"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "*",
            "args": [
              {
                "op": "-",
                "args": [
                  "setpoint",
                  "plant_output"
                ]
              },
              "control_gain"
            ]
          }
        },
        {
          "lhs": {
            "op": "ic",
            "args": [
              "plant_output"
            ]
          },
          "rhs": 0.0
        },
        {
          "lhs": {
            "op": "ic",
            "args": [
              "controller_state"
            ]
          },
          "rhs": 0.0
        }
      ],
      "continuous_events": [],
      "discrete_events": []
    },
    "EventSynchronizationSystem": {
      "variables": {
        "sync_state": {
          "type": "unknown",
          "units": "1",
          "default": 1.0,
          "description": "Synchronization state variable"
        },
        "discrete_trigger": {
          "type": "parameter",
          "units": "1",
          "default": 0,
          "description": "Discrete event trigger flag",
          "shape": [],
          "update": [
            {
              "kind": "schedule",
              "interval": 3.0,
              "expression": 1
            },
            {
              "kind": "crossing",
              "when": {
                "op": "and",
                "args": [
                  {
                    "op": "==",
                    "args": [
                      "continuous_trigger",
                      1
                    ]
                  },
                  {
                    "op": "==",
                    "args": [
                      "discrete_trigger",
                      1
                    ]
                  }
                ]
              },
              "expression": 0
            },
            {
              "kind": "crossing",
              "when": {
                "op": ">",
                "args": [
                  "HybridControlSystem.plant_output",
                  8.0
                ]
              },
              "expression": 1
            }
          ]
        },
        "continuous_trigger": {
          "type": "parameter",
          "units": "1",
          "default": 0,
          "description": "Continuous event trigger flag",
          "update": [
            {
              "kind": "crossing",
              "when": {
                "op": "-",
                "args": [
                  "sync_state",
                  1.5
                ]
              },
              "expression": 1
            },
            {
              "kind": "crossing",
              "when": {
                "op": "and",
                "args": [
                  {
                    "op": "==",
                    "args": [
                      "continuous_trigger",
                      1
                    ]
                  },
                  {
                    "op": "==",
                    "args": [
                      "discrete_trigger",
                      1
                    ]
                  }
                ]
              },
              "expression": 0
            }
          ]
        },
        "sync_counter": {
          "type": "parameter",
          "units": "1",
          "default": 0,
          "description": "Synchronization event counter",
          "update": {
            "kind": "crossing",
            "when": {
              "op": "and",
              "args": [
                {
                  "op": "==",
                  "args": [
                    "continuous_trigger",
                    1
                  ]
                },
                {
                  "op": "==",
                  "args": [
                    "discrete_trigger",
                    1
                  ]
                }
              ]
            },
            "expression": {
              "op": "+",
              "args": [
                {
                  "op": "Pre",
                  "args": [
                    "sync_counter"
                  ]
                },
                1
              ]
            }
          }
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "sync_state"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "*",
            "args": [
              {
                "op": "sin",
                "args": [
                  {
                    "op": "*",
                    "args": [
                      "t",
                      1.5
                    ]
                  }
                ]
              },
              {
                "op": "+",
                "args": [
                  1.0,
                  {
                    "op": "*",
                    "args": [
                      "discrete_trigger",
                      0.5
                    ]
                  }
                ]
              }
            ]
          }
        },
        {
          "lhs": {
            "op": "ic",
            "args": [
              "sync_state"
            ]
          },
          "rhs": 0.0
        }
      ],
      "continuous_events": [],
      "discrete_events": []
    },
    "EventLoggingSystem": {
      "variables": {
        "monitored_variable": {
          "type": "unknown",
          "units": "1",
          "default": 0.0,
          "description": "Variable being monitored"
        },
        "event_timestamp": {
          "type": "parameter",
          "units": "s",
          "default": 0.0,
          "description": "Last event timestamp",
          "shape": [],
          "update": [
            {
              "kind": "schedule",
              "interval": 5.0,
              "expression": "t"
            },
            {
              "kind": "crossing",
              "when": {
                "op": "-",
                "args": [
                  "monitored_variable",
                  0.6
                ]
              },
              "expression": "t"
            },
            {
              "kind": "crossing",
              "when": {
                "op": "-",
                "args": [
                  -0.6,
                  "monitored_variable"
                ]
              },
              "expression": "t"
            }
          ]
        },
        "event_type_log": {
          "type": "parameter",
          "units": "1",
          "default": 0,
          "description": "Event type identifier log",
          "shape": [],
          "update": [
            {
              "kind": "schedule",
              "interval": 5.0,
              "expression": 100
            },
            {
              "kind": "crossing",
              "when": {
                "op": "-",
                "args": [
                  "monitored_variable",
                  0.6
                ]
              },
              "expression": 1
            },
            {
              "kind": "crossing",
              "when": {
                "op": "-",
                "args": [
                  -0.6,
                  "monitored_variable"
                ]
              },
              "expression": -1
            }
          ]
        },
        "event_count_total": {
          "type": "parameter",
          "units": "1",
          "default": 0,
          "description": "Total event count",
          "shape": [],
          "update": [
            {
              "kind": "schedule",
              "interval": 5.0,
              "expression": {
                "op": "+",
                "args": [
                  {
                    "op": "Pre",
                    "args": [
                      "event_count_total"
                    ]
                  },
                  1
                ]
              }
            },
            {
              "kind": "crossing",
              "when": {
                "op": "-",
                "args": [
                  "monitored_variable",
                  0.6
                ]
              },
              "expression": {
                "op": "+",
                "args": [
                  {
                    "op": "Pre",
                    "args": [
                      "event_count_total"
                    ]
                  },
                  1
                ]
              }
            },
            {
              "kind": "crossing",
              "when": {
                "op": "-",
                "args": [
                  -0.6,
                  "monitored_variable"
                ]
              },
              "expression": {
                "op": "+",
                "args": [
                  {
                    "op": "Pre",
                    "args": [
                      "event_count_total"
                    ]
                  },
                  1
                ]
              }
            }
          ]
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "monitored_variable"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "+",
            "args": [
              {
                "op": "*",
                "args": [
                  0.5,
                  {
                    "op": "sin",
                    "args": [
                      {
                        "op": "*",
                        "args": [
                          "t",
                          2.0
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "op": "*",
                "args": [
                  0.2,
                  {
                    "op": "cos",
                    "args": [
                      {
                        "op": "*",
                        "args": [
                          "t",
                          0.7
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        },
        {
          "lhs": {
            "op": "ic",
            "args": [
              "monitored_variable"
            ]
          },
          "rhs": 0.0
        }
      ],
      "continuous_events": [],
      "discrete_events": []
    }
  },
  "coupling": [],
  "domain": {
    "temporal": {
      "start": "2024-01-01T00:00:00Z",
      "end": "2024-01-01T00:30:00Z"
    }
  }
}
