{
  "esm": "1.0.0",
  "metadata": {
    "name": "ComprehensiveEventTests",
    "description": "Complete test coverage for all event system capabilities",
    "authors": [
      "Test Suite"
    ],
    "created": "2026-02-14T00:00:00Z"
  },
  "models": {
    "BouncingBall": {
      "variables": {
        "x": {
          "type": "unknown",
          "units": "m",
          "default": 1.0,
          "description": "Position"
        },
        "v": {
          "type": "unknown",
          "units": "m/s",
          "default": -5.0,
          "description": "Velocity"
        },
        "y": {
          "type": "unknown",
          "units": "m",
          "default": 0.0,
          "description": "Y position"
        },
        "vy": {
          "type": "unknown",
          "units": "m/s",
          "default": 2.0,
          "description": "Y velocity"
        },
        "g": {
          "type": "parameter",
          "units": "m/s^2",
          "default": 9.81,
          "description": "Gravity",
          "shape": [],
          "update": {
            "kind": "schedule",
            "interval": 1.0,
            "handler": {
              "handler_id": "PIDController",
              "read_vars": [
                "x",
                "v",
                "total_energy"
              ],
              "read_params": [
                "bounce_count",
                "friction_active"
              ],
              "config": {
                "setpoint": 0.5,
                "kp": 0.1,
                "ki": 0.01,
                "kd": 0.05
              }
            }
          }
        },
        "bounce_count": {
          "type": "parameter",
          "units": "1",
          "default": 0,
          "description": "Number of bounces",
          "update": {
            "kind": "condition",
            "when": {
              "op": "and",
              "args": [
                {
                  "op": "<",
                  "args": [
                    "x",
                    0.01
                  ]
                },
                {
                  "op": "<",
                  "args": [
                    "v",
                    0
                  ]
                }
              ]
            },
            "expression": {
              "op": "+",
              "args": [
                {
                  "op": "Pre",
                  "args": [
                    "bounce_count"
                  ]
                },
                1
              ]
            }
          }
        },
        "friction_active": {
          "type": "parameter",
          "units": "1",
          "default": 1,
          "description": "Friction flag",
          "update": {
            "kind": "crossing",
            "when": {
              "op": "-",
              "args": [
                {
                  "op": "abs",
                  "args": [
                    "v"
                  ]
                },
                0.1
              ]
            },
            "expression": 0
          }
        },
        "total_energy": {
          "type": "unknown",
          "units": "J",
          "description": "Total mechanical energy"
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "x"
            ],
            "wrt": "t"
          },
          "rhs": "v"
        },
        {
          "lhs": {
            "op": "D",
            "args": [
              "v"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "-",
            "args": [
              "g"
            ]
          }
        },
        {
          "lhs": {
            "op": "D",
            "args": [
              "y"
            ],
            "wrt": "t"
          },
          "rhs": "vy"
        },
        {
          "lhs": {
            "op": "D",
            "args": [
              "vy"
            ],
            "wrt": "t"
          },
          "rhs": 0.0
        },
        {
          "lhs": {
            "op": "ic",
            "args": [
              "x"
            ]
          },
          "rhs": 0.0
        },
        {
          "lhs": {
            "op": "ic",
            "args": [
              "v"
            ]
          },
          "rhs": 0.0
        },
        {
          "lhs": {
            "op": "ic",
            "args": [
              "y"
            ]
          },
          "rhs": 0.0
        },
        {
          "lhs": {
            "op": "ic",
            "args": [
              "vy"
            ]
          },
          "rhs": 0.0
        },
        {
          "lhs": "total_energy",
          "rhs": {
            "op": "+",
            "args": [
              {
                "op": "*",
                "args": [
                  0.5,
                  {
                    "op": "^",
                    "args": [
                      "v",
                      2
                    ]
                  }
                ]
              },
              {
                "op": "*",
                "args": [
                  "g",
                  "x"
                ]
              }
            ]
          }
        }
      ],
      "continuous_events": [
        {
          "name": "ground_bounce",
          "conditions": [
            {
              "op": "-",
              "args": [
                "x",
                0
              ]
            }
          ],
          "affects": [
            {
              "lhs": "v",
              "rhs": {
                "op": "*",
                "args": [
                  -0.8,
                  {
                    "op": "Pre",
                    "args": [
                      "v"
                    ]
                  }
                ]
              }
            }
          ],
          "affect_neg": [
            {
              "lhs": "v",
              "rhs": {
                "op": "*",
                "args": [
                  -0.9,
                  {
                    "op": "Pre",
                    "args": [
                      "v"
                    ]
                  }
                ]
              }
            }
          ],
          "root_find": "left",
          "reinitialize": true,
          "description": "Ball bounces off ground with different coefficients for up/down crossings"
        },
        {
          "name": "wall_collision",
          "conditions": [
            {
              "op": "-",
              "args": [
                "y",
                -1.5
              ]
            },
            {
              "op": "-",
              "args": [
                "y",
                1.5
              ]
            }
          ],
          "affects": [
            {
              "lhs": "vy",
              "rhs": {
                "op": "*",
                "args": [
                  -1,
                  {
                    "op": "Pre",
                    "args": [
                      "vy"
                    ]
                  }
                ]
              }
            }
          ],
          "description": "Elastic collision with walls at y = ±1.5"
        }
      ],
      "discrete_events": [
        {
          "name": "periodic_damping",
          "trigger": {
            "type": "periodic",
            "interval": 2.0,
            "initial_offset": 0.5
          },
          "affects": [
            {
              "lhs": "v",
              "rhs": {
                "op": "*",
                "args": [
                  {
                    "op": "Pre",
                    "args": [
                      "v"
                    ]
                  },
                  0.95
                ]
              }
            },
            {
              "lhs": "vy",
              "rhs": {
                "op": "*",
                "args": [
                  {
                    "op": "Pre",
                    "args": [
                      "vy"
                    ]
                  },
                  0.95
                ]
              }
            }
          ],
          "description": "Apply 5% velocity damping every 2 seconds"
        },
        {
          "name": "measurement_times",
          "trigger": {
            "type": "preset_times",
            "times": [
              1.0,
              2.5,
              5.0,
              10.0
            ]
          },
          "affects": [],
          "description": "Mark measurement times (no state change)"
        }
      ]
    },
    "EmissionController": {
      "variables": {
        "emission_rate": {
          "type": "parameter",
          "units": "kg/s",
          "default": 1.0,
          "description": "Emission rate",
          "update": {
            "kind": "crossing",
            "when": {
              "op": "-",
              "args": [
                "BouncingBall.total_energy",
                10.0
              ]
            },
            "expression": {
              "op": "*",
              "args": [
                {
                  "op": "Pre",
                  "args": [
                    "emission_rate"
                  ]
                },
                0.5
              ]
            }
          }
        },
        "temperature": {
          "type": "unknown",
          "units": "K",
          "default": 298.15,
          "description": "Temperature"
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "temperature"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "*",
            "args": [
              0.001,
              {
                "op": "-",
                "args": [
                  300,
                  "temperature"
                ]
              }
            ]
          }
        },
        {
          "lhs": {
            "op": "ic",
            "args": [
              "temperature"
            ]
          },
          "rhs": 0.0
        }
      ],
      "discrete_events": []
    }
  },
  "coupling": [],
  "domain": {
    "temporal": {
      "start": "2024-01-01T00:00:00Z",
      "end": "2024-01-01T00:01:00Z"
    }
  }
}
