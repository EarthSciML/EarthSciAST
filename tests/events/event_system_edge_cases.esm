{
  "esm": "1.0.0",
  "metadata": {
    "name": "EventSystemEdgeCases",
    "description": "Edge case test fixtures for advanced event system behaviors",
    "authors": [
      "Test Suite"
    ],
    "created": "2026-02-14T00:00:00Z"
  },
  "models": {
    "EventOrderingSystem": {
      "variables": {
        "x": {
          "type": "unknown",
          "units": "m",
          "default": 1.0,
          "description": "Primary variable"
        },
        "y": {
          "type": "unknown",
          "units": "m",
          "default": 2.0,
          "description": "Secondary variable"
        },
        "z": {
          "type": "unknown",
          "units": "m",
          "default": 0.0,
          "description": "Tertiary variable"
        },
        "event_counter": {
          "type": "parameter",
          "units": "1",
          "default": 0,
          "description": "Event counter",
          "update": [
            {
              "kind": "crossing",
              "when": {
                "op": "-",
                "args": [
                  "x",
                  0.5
                ]
              },
              "expression": {
                "op": "+",
                "args": [
                  {
                    "op": "Pre",
                    "args": [
                      "event_counter"
                    ]
                  },
                  100
                ]
              }
            },
            {
              "kind": "crossing",
              "when": {
                "op": "-",
                "args": [
                  "y",
                  1.0
                ]
              },
              "expression": {
                "op": "+",
                "args": [
                  {
                    "op": "Pre",
                    "args": [
                      "event_counter"
                    ]
                  },
                  10
                ]
              }
            }
          ]
        },
        "priority_flag": {
          "type": "parameter",
          "units": "1",
          "default": 0,
          "description": "Priority processing flag",
          "update": {
            "kind": "crossing",
            "when": {
              "op": "-",
              "args": [
                "x",
                0.5
              ]
            },
            "expression": 1
          }
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "x"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "-",
            "args": [
              "x"
            ]
          }
        },
        {
          "lhs": {
            "op": "D",
            "args": [
              "y"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "*",
            "args": [
              -2.0,
              "y"
            ]
          }
        },
        {
          "lhs": {
            "op": "D",
            "args": [
              "z"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "+",
            "args": [
              "x",
              "y"
            ]
          }
        },
        {
          "lhs": {
            "op": "ic",
            "args": [
              "x"
            ]
          },
          "rhs": 0.0
        },
        {
          "lhs": {
            "op": "ic",
            "args": [
              "y"
            ]
          },
          "rhs": 0.0
        },
        {
          "lhs": {
            "op": "ic",
            "args": [
              "z"
            ]
          },
          "rhs": 0.0
        }
      ],
      "continuous_events": [
        {
          "name": "simultaneous_zero_crossing_2",
          "conditions": [
            {
              "op": "-",
              "args": [
                "y",
                1.0
              ]
            }
          ],
          "affects": [
            {
              "lhs": "z",
              "rhs": {
                "op": "*",
                "args": [
                  {
                    "op": "Pre",
                    "args": [
                      "z"
                    ]
                  },
                  -1
                ]
              }
            }
          ],
          "description": "Second event in simultaneous firing"
        },
        {
          "name": "chained_condition_dependency",
          "conditions": [
            {
              "op": "-",
              "args": [
                "priority_flag",
                0.5
              ]
            }
          ],
          "affects": [
            {
              "lhs": "z",
              "rhs": {
                "op": "+",
                "args": [
                  {
                    "op": "Pre",
                    "args": [
                      "z"
                    ]
                  },
                  1000
                ]
              }
            }
          ],
          "description": "Event that depends on another event's discrete parameter change"
        }
      ],
      "discrete_events": [
        {
          "name": "discrete_chain_start",
          "trigger": {
            "type": "condition",
            "expression": {
              "op": ">",
              "args": [
                "event_counter",
                50
              ]
            }
          },
          "affects": [
            {
              "lhs": "x",
              "rhs": 10.0
            }
          ],
          "description": "Discrete event triggered by continuous event counter"
        }
      ]
    },
    "BoundaryConditionSystem": {
      "variables": {
        "position": {
          "type": "unknown",
          "units": "m",
          "default": 1e-15,
          "description": "Near-zero position"
        },
        "velocity": {
          "type": "unknown",
          "units": "m/s",
          "default": -1e-10,
          "description": "Very small velocity"
        },
        "temperature": {
          "type": "unknown",
          "units": "K",
          "default": 273.15000001,
          "description": "Temperature near freezing"
        },
        "precision_counter": {
          "type": "parameter",
          "units": "1",
          "default": 0,
          "description": "Precision event counter",
          "update": [
            {
              "kind": "crossing",
              "when": {
                "op": "-",
                "args": [
                  "position",
                  0.0
                ]
              },
              "expression": {
                "op": "+",
                "args": [
                  {
                    "op": "Pre",
                    "args": [
                      "precision_counter"
                    ]
                  },
                  1
                ]
              }
            },
            {
              "kind": "crossing",
              "when": {
                "op": "-",
                "args": [
                  "temperature",
                  273.15
                ]
              },
              "direction": "up",
              "expression": {
                "op": "+",
                "args": [
                  {
                    "op": "Pre",
                    "args": [
                      "precision_counter"
                    ]
                  },
                  10
                ]
              }
            },
            {
              "kind": "crossing",
              "when": {
                "op": "-",
                "args": [
                  "temperature",
                  273.15
                ]
              },
              "direction": "down",
              "expression": {
                "op": "+",
                "args": [
                  {
                    "op": "Pre",
                    "args": [
                      "precision_counter"
                    ]
                  },
                  20
                ]
              }
            }
          ]
        },
        "epsilon": {
          "type": "parameter",
          "units": "1",
          "default": 1e-12,
          "description": "Machine epsilon tolerance"
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "position"
            ],
            "wrt": "t"
          },
          "rhs": "velocity"
        },
        {
          "lhs": {
            "op": "D",
            "args": [
              "velocity"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "*",
            "args": [
              -0.001,
              "velocity"
            ]
          }
        },
        {
          "lhs": {
            "op": "D",
            "args": [
              "temperature"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "*",
            "args": [
              0.1,
              {
                "op": "-",
                "args": [
                  273.15,
                  "temperature"
                ]
              }
            ]
          }
        },
        {
          "lhs": {
            "op": "ic",
            "args": [
              "position"
            ]
          },
          "rhs": 0.0
        },
        {
          "lhs": {
            "op": "ic",
            "args": [
              "velocity"
            ]
          },
          "rhs": 0.0
        },
        {
          "lhs": {
            "op": "ic",
            "args": [
              "temperature"
            ]
          },
          "rhs": 0.0
        }
      ],
      "continuous_events": [
        {
          "name": "near_zero_tolerance",
          "conditions": [
            {
              "op": "-",
              "args": [
                {
                  "op": "abs",
                  "args": [
                    "velocity"
                  ]
                },
                "epsilon"
              ]
            }
          ],
          "affects": [
            {
              "lhs": "velocity",
              "rhs": 0.0
            }
          ],
          "description": "Snap to zero when velocity is within machine epsilon"
        }
      ]
    },
    "VariableScopingSystem": {
      "variables": {
        "local_var": {
          "type": "unknown",
          "units": "1",
          "default": 1.0,
          "description": "Local state variable"
        },
        "shared_param": {
          "type": "parameter",
          "units": "1",
          "default": 5.0,
          "description": "Parameter shared across systems",
          "update": {
            "kind": "crossing",
            "when": {
              "op": "-",
              "args": [
                "BoundaryConditionSystem.position",
                -1e-10
              ]
            },
            "expression": {
              "op": "Pre",
              "args": [
                "BoundaryConditionSystem.precision_counter"
              ]
            }
          }
        },
        "observed_value": {
          "type": "unknown",
          "units": "1",
          "description": "Observed variable for testing scoped access"
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "local_var"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "*",
            "args": [
              0.1,
              {
                "op": "-",
                "args": [
                  1.0,
                  "local_var"
                ]
              }
            ]
          }
        },
        {
          "lhs": {
            "op": "ic",
            "args": [
              "local_var"
            ]
          },
          "rhs": 0.0
        },
        {
          "lhs": "observed_value",
          "rhs": {
            "op": "*",
            "args": [
              "local_var",
              "shared_param"
            ]
          }
        }
      ],
      "continuous_events": [
        {
          "name": "observed_variable_in_condition",
          "conditions": [
            {
              "op": "-",
              "args": [
                "observed_value",
                10.0
              ]
            }
          ],
          "affects": [
            {
              "lhs": "local_var",
              "rhs": {
                "op": "/",
                "args": [
                  {
                    "op": "Pre",
                    "args": [
                      "local_var"
                    ]
                  },
                  2
                ]
              }
            }
          ],
          "description": "Event condition using observed variable"
        }
      ]
    },
    "DiscreteParameterChainSystem": {
      "variables": {
        "state_var": {
          "type": "unknown",
          "units": "1",
          "default": 1.0,
          "description": "State variable"
        },
        "param_a": {
          "type": "parameter",
          "units": "1",
          "default": 1.0,
          "description": "First parameter in chain",
          "update": {
            "kind": "condition",
            "when": {
              "op": ">",
              "args": [
                "state_var",
                5.0
              ]
            },
            "expression": {
              "op": "*",
              "args": [
                {
                  "op": "Pre",
                  "args": [
                    "param_a"
                  ]
                },
                2
              ]
            }
          }
        },
        "param_b": {
          "type": "parameter",
          "units": "1",
          "default": 2.0,
          "description": "Second parameter in chain",
          "update": {
            "kind": "condition",
            "when": {
              "op": "==",
              "args": [
                "chain_trigger",
                1
              ]
            },
            "expression": {
              "op": "+",
              "args": [
                {
                  "op": "Pre",
                  "args": [
                    "param_b"
                  ]
                },
                {
                  "op": "Pre",
                  "args": [
                    "param_a"
                  ]
                }
              ]
            }
          }
        },
        "param_c": {
          "type": "parameter",
          "units": "1",
          "default": 3.0,
          "description": "Third parameter in chain",
          "update": {
            "kind": "condition",
            "when": {
              "op": "==",
              "args": [
                "chain_trigger",
                2
              ]
            },
            "expression": {
              "op": "*",
              "args": [
                {
                  "op": "Pre",
                  "args": [
                    "param_c"
                  ]
                },
                {
                  "op": "Pre",
                  "args": [
                    "param_b"
                  ]
                }
              ]
            }
          }
        },
        "chain_trigger": {
          "type": "parameter",
          "units": "1",
          "default": 0,
          "description": "Chain trigger flag",
          "update": [
            {
              "kind": "condition",
              "when": {
                "op": ">",
                "args": [
                  "state_var",
                  5.0
                ]
              },
              "expression": 1
            },
            {
              "kind": "condition",
              "when": {
                "op": "==",
                "args": [
                  "chain_trigger",
                  1
                ]
              },
              "expression": 2
            },
            {
              "kind": "condition",
              "when": {
                "op": "==",
                "args": [
                  "chain_trigger",
                  2
                ]
              },
              "expression": 0
            }
          ]
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "state_var"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "*",
            "args": [
              "param_a",
              {
                "op": "-",
                "args": [
                  "param_b",
                  "state_var"
                ]
              }
            ]
          }
        },
        {
          "lhs": {
            "op": "ic",
            "args": [
              "state_var"
            ]
          },
          "rhs": 0.0
        }
      ],
      "discrete_events": []
    },
    "FunctionalAffectEdgeCases": {
      "variables": {
        "input_signal": {
          "type": "unknown",
          "units": "V",
          "default": 0.0,
          "description": "Input signal"
        },
        "output_signal": {
          "type": "unknown",
          "units": "V",
          "default": 0.0,
          "description": "Output signal"
        },
        "controller_state": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "description": "Internal controller state",
          "shape": [],
          "update": {
            "kind": "schedule",
            "interval": 0.1,
            "initial_offset": 0.0,
            "handler": {
              "handler_id": "AdvancedPIDController",
              "read_vars": [
                "input_signal",
                "output_signal"
              ],
              "read_params": [
                "setpoint",
                "error_accumulator"
              ],
              "config": {
                "kp": 2.0,
                "ki": 0.5,
                "kd": 0.1,
                "anti_windup": true,
                "output_limits": [
                  -10.0,
                  10.0
                ],
                "derivative_filter": 0.8,
                "deadband": 0.01
              }
            }
          }
        },
        "error_accumulator": {
          "type": "parameter",
          "units": "V*s",
          "default": 0.0,
          "description": "Error integral",
          "shape": [],
          "update": {
            "kind": "schedule",
            "interval": 0.1,
            "initial_offset": 0.0,
            "handler": {
              "handler_id": "AdvancedPIDController",
              "read_vars": [
                "input_signal",
                "output_signal"
              ],
              "read_params": [
                "setpoint",
                "error_accumulator"
              ],
              "config": {
                "kp": 2.0,
                "ki": 0.5,
                "kd": 0.1,
                "anti_windup": true,
                "output_limits": [
                  -10.0,
                  10.0
                ],
                "derivative_filter": 0.8,
                "deadband": 0.01
              }
            }
          }
        },
        "setpoint": {
          "type": "parameter",
          "units": "V",
          "default": 5.0,
          "description": "Target setpoint",
          "update": [
            {
              "kind": "condition",
              "when": {
                "op": ">",
                "args": [
                  {
                    "op": "abs",
                    "args": [
                      {
                        "op": "-",
                        "args": [
                          "input_signal",
                          "setpoint"
                        ]
                      }
                    ]
                  },
                  1.0
                ]
              },
              "handler": {
                "handler_id": "AdaptiveSetpointController",
                "read_vars": [
                  "input_signal",
                  "output_signal"
                ],
                "read_params": [
                  "setpoint",
                  "controller_state"
                ],
                "config": {
                  "adaptation_rate": 0.1,
                  "stability_threshold": 0.05,
                  "max_setpoint_change": 0.5
                }
              }
            },
            {
              "kind": "condition",
              "when": {
                "op": "and",
                "args": [
                  {
                    "op": ">",
                    "args": [
                      "DiscreteParameterChainSystem.param_c",
                      50.0
                    ]
                  },
                  {
                    "op": "<",
                    "args": [
                      "BoundaryConditionSystem.position",
                      1e-12
                    ]
                  }
                ]
              },
              "expression": {
                "op": "Pre",
                "args": [
                  "VariableScopingSystem.shared_param"
                ]
              }
            }
          ]
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "input_signal"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "*",
            "args": [
              0.1,
              {
                "op": "-",
                "args": [
                  "output_signal",
                  "input_signal"
                ]
              }
            ]
          }
        },
        {
          "lhs": {
            "op": "D",
            "args": [
              "output_signal"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "*",
            "args": [
              "controller_state",
              {
                "op": "-",
                "args": [
                  "setpoint",
                  "input_signal"
                ]
              }
            ]
          }
        },
        {
          "lhs": {
            "op": "ic",
            "args": [
              "input_signal"
            ]
          },
          "rhs": 0.0
        },
        {
          "lhs": {
            "op": "ic",
            "args": [
              "output_signal"
            ]
          },
          "rhs": 0.0
        }
      ],
      "discrete_events": []
    }
  },
  "coupling": [
    {
      "type": "event",
      "event_type": "continuous",
      "conditions": [
        {
          "op": ">",
          "args": [
            "EventOrderingSystem.event_counter",
            150
          ]
        }
      ],
      "affects": [
        {
          "lhs": "BoundaryConditionSystem.temperature",
          "rhs": {
            "op": "+",
            "args": [
              {
                "op": "Pre",
                "args": [
                  "BoundaryConditionSystem.temperature"
                ]
              },
              10.0
            ]
          }
        },
        {
          "lhs": "VariableScopingSystem.local_var",
          "rhs": 0.5
        }
      ],
      "description": "Cross-system event affecting multiple systems simultaneously"
    }
  ],
  "domain": {
    "temporal": {
      "start": "2024-01-01T00:00:00Z",
      "end": "2024-01-01T00:10:00Z"
    }
  }
}
