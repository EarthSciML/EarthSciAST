{
  "esm": "1.0.0",
  "metadata": {
    "name": "OrnsteinUhlenbeck",
    "description": "Minimal SDE: Ornstein–Uhlenbeck process driven by a single Wiener noise source. Exercises a parameter whose `update.kind` is `wiener` (esm-spec §5.4) and its promotion of the enclosing model to an SDE system.",
    "authors": ["gt-kuxo"],
    "created": "2026-04-19T00:00:00Z",
    "tags": ["sde", "brownian", "regression"]
  },
  "models": {
    "OU": {
      "variables": {
        "x": {
          "type": "unknown",
          "units": "1",
          "default": 0.0,
          "description": "OU state variable"
        },
        "theta": {
          "type": "parameter",
          "units": "1/s",
          "default": 1.0,
          "description": "Mean-reversion rate"
        },
        "sigma": {
          "type": "parameter",
          "units": "1/s^0.5",
          "default": 0.5,
          "description": "Noise amplitude"
        },
        "Bw": {
          "type": "parameter",
          "units": "1/s^0.5",
          "description": "Wiener noise source driving x: a standard Wiener increment resampled every step with √dt scaling. The intensity lives in the units and in `sigma`.",
          "distribution": { "kind": "normal", "mean": 0.0, "std": 1.0 },
          "update": { "kind": "wiener" }
        }
      },
      "equations": [
        {
          "lhs": { "op": "D", "args": ["x"], "wrt": "t" },
          "rhs": {
            "op": "+",
            "args": [
              { "op": "*", "args": [{ "op": "-", "args": ["theta"] }, "x"] },
              { "op": "*", "args": ["sigma", "Bw"] }
            ]
          }
        }
      ]
    }
  }
}
