{
  "esm": "1.1.0",
  "metadata": {
    "name": "native_probe_datetime_float32",
    "description": "The datetime closed functions evaluated for Float32 variables (esm-spec 11.3.1) in a Float64 document: each observed c_k is one calendar field (every entry but julian_day, which Float32 may not use) of a 6-cell array of instants that advance with the solver time, and a Float32 state integrates their sum. The interpreter evaluates the calendar in binary64 on the binary32 argument and hands the result back unrounded; native must return the same bits, which a binary32 expansion of the calendar arithmetic does not.",
    "authors": [
      "EarthSciML"
    ],
    "tags": [
      "native",
      "probe",
      "element_type"
    ]
  },
  "index_sets": {
    "cells": {
      "kind": "interval",
      "size": 6
    }
  },
