{
  "esm": "1.1.0",
  "metadata": {
    "name": "native_probe_periodic_partial_roll",
    "description": "The periodic-wrap index idiom over boxes that are not one full period of their source: an interior-only update reading both wrapped neighbours of a period-6 ring and a const table two cells ahead, an update over a period-8 ring whose wrap window covers only its first six cells, an update over the second half of a ring reading three cells ahead, and a 4-cell source read through a period-6 window, where subscript 5 and a read thirteen ahead (folded once, still past the window) fall off the source and read the zero ghost.",
    "authors": [
      "EarthSciML"
    ],
    "tags": [
      "native",
      "probe"
    ]
  },
