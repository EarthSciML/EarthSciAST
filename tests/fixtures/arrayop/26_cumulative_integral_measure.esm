{
  "esm": "1.0.0",
  "metadata": {
    "name": "arrayop_26_cumulative_integral_measure",
    "description": "Cross-port conformance fixture for the measure-weighted cumulative INTEGRAL — esm-spec §4.3.1 'Cumulative (prefix) reductions', the 'a cumulative sum is not a cumulative integral' rule. The format carries no measure concept (§6.6.5 convention 2), so a Riemann-sum cumulative integral F(x_i) = integral of u dx' from the left edge is spelled by multiplying the per-cell measure into the aggregate body as an ordinary factor. Here u(x) = 2x on a NON-UNIFORM 4-cell grid with widths dx = [0.5, 0.25, 0.125, 0.125] (cell midpoints x = [0.25, 0.625, 0.8125, 0.9375]), so the left-edge-anchored midpoint rule gives exactly F = [0.25, 0.5625, 0.765625, 1.0] — the analytic x^2 at each cell's right edge, because the midpoint rule is exact for a linear integrand. The non-uniform spacing is the point: an UNWEIGHTED prefix sum of u would give [0.5, 1.75, 3.375, 5.25] instead, so this fixture fails loudly if a binding ever supplies or infers a measure of its own. Its twin 25_cumulative_prefix_reduction.esm pins the unweighted form. Executing ports: Python, Rust, Julia. Non-executing: TypeScript, Go (no arrayop numeric executor).",
    "authors": [
      "EarthSciAST cumulative-reduction conformance"
    ],
    "tags": [
      "arrayop",
      "aggregate",
      "conformance",
      "cumulative",
      "integral",
      "measure",
      "quadrature",
      "filter",
      "reduce-plus"
    ]
  },
  "index_sets": {
    "x": {
      "kind": "interval",
      "size": 4
    }
  },
  "models": {
    "CumulativeIntegralMeasure": {
      "tolerance": {
        "rel": 1e-06,
        "abs": 1e-09
      },
      "variables": {
        "dx": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "x"
          ],
          "description": "Per-cell measure — a NON-UNIFORM grid spacing, declared as ordinary data exactly as grid geometry is since v0.8.0."
        },
        "u": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "x"
          ],
          "description": "Integrand u = 2x sampled at the cell midpoints [0.25, 0.625, 0.8125, 0.9375]."
        },
        "F": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "x"
          ],
          "default": 0.0,
          "description": "Cumulative integral of u up to each cell's right edge — the discrete counterpart of the `integral` op's partial/cumulative mode, but evaluable core."
        }
      },
      "equations": [
        {
          "_comment": "D(F[i])/dt = sum_{j<=i} u[j]*dx[j] = [0.25, 0.5625, 0.765625, 1.0] = x_right^2.",
          "lhs": {
            "op": "aggregate",
            "args": [],
            "output_idx": [
              "i"
            ],
            "expr": {
              "op": "D",
              "args": [
                {
                  "op": "index",
                  "args": [
                    "F",
                    "i"
                  ]
                }
              ],
              "wrt": "t"
            },
            "ranges": {
              "i": {
                "from": "x"
              }
            }
          },
          "rhs": {
            "op": "aggregate",
            "args": [
              "u",
              "dx"
            ],
            "output_idx": [
              "i"
            ],
            "reduce": "+",
            "ranges": {
              "i": {
                "from": "x"
              },
              "j": {
                "from": "x"
              }
            },
            "filter": {
              "op": "<=",
              "args": [
                "j",
                "i"
              ]
            },
            "expr": {
              "op": "*",
              "args": [
                {
                  "op": "index",
                  "args": [
                    "u",
                    "j"
                  ]
                },
                {
                  "op": "index",
                  "args": [
                    "dx",
                    "j"
                  ]
                }
              ]
            }
          }
        },
        {
          "lhs": "dx",
          "rhs": {
            "op": "makearray",
            "regions": [
              [
                [
                  1,
                  1
                ]
              ],
              [
                [
                  2,
                  2
                ]
              ],
              [
                [
                  3,
                  3
                ]
              ],
              [
                [
                  4,
                  4
                ]
              ]
            ],
            "values": [
              0.5,
              0.25,
              0.125,
              0.125
            ],
            "args": []
          }
        },
        {
          "lhs": "u",
          "rhs": {
            "op": "makearray",
            "regions": [
              [
                [
                  1,
                  1
                ]
              ],
              [
                [
                  2,
                  2
                ]
              ],
              [
                [
                  3,
                  3
                ]
              ],
              [
                [
                  4,
                  4
                ]
              ]
            ],
            "values": [
              0.5,
              1.25,
              1.625,
              1.875
            ],
            "args": []
          }
        }
      ],
      "tests": [
        {
          "id": "cumulative_integral_t1",
          "description": "Constant RHS from a zero IC over a unit interval, so F at t = 1 IS the quadrature. Expected values are the analytic integral of 2x, i.e. x^2 at each cell's right edge (0.5, 0.75, 0.875, 1.0) — the midpoint rule is exact for a linear integrand, so this is an equality check, not a discretization-error check.",
          "initial_conditions": {
            "F[1]": 0.0,
            "F[2]": 0.0,
            "F[3]": 0.0,
            "F[4]": 0.0
          },
          "time_span": {
            "start": 0.0,
            "end": 1.0
          },
          "assertions": [
            {
              "variable": "F[1]",
              "time": 1.0,
              "expected": 0.25
            },
            {
              "variable": "F[2]",
              "time": 1.0,
              "expected": 0.5625
            },
            {
              "variable": "F[3]",
              "time": 1.0,
              "expected": 0.765625
            },
            {
              "variable": "F[4]",
              "time": 1.0,
              "expected": 1.0
            }
          ]
        }
      ]
    }
  }
}
