{
  "esm": "1.2.0",
  "metadata": {
    "name": "RecurrenceGroupContractingMember",
    "description": "A recurrence GROUP (esm-spec 4.3.1.2) one of whose members CONTRACTS: a[k] = sum over j in 1..3 of ifelse(k <= 1, 1, a[k-1] + j * b[k-1]), so a[1] = 3 and a[k] = 3 a[k-1] + 6 b[k-1]; b[k] = ifelse(k <= 1, 1, a[k-1] - b[k-1]) does not contract. Answer a = [3, 15, 57, 249], b = [1, 2, 13, 44]. Pins that a member's cell body carries its own reduction exactly once: a binding that copies the contracted range onto the stacked recurrence or the member slices sums every member's body |j| = 3 times again.",
    "authors": [
      "EarthSciML Authors and Contributors"
    ],
    "tags": [
      "recurrence",
      "recurrence-group",
      "faq",
      "contraction",
      "causal-self-reference"
    ]
  },
  "index_sets": {
    "lev": {
      "kind": "interval",
      "size": 4
    }
  },
  "models": {
    "RecurrenceGroupContractingMember": {
      "tolerance": {
        "rel": 0.0,
        "abs": 0.0
      },
      "variables": {
        "a": {
          "type": "unknown",
          "shape": [
            "lev"
          ],
          "units": "1",
          "description": "3 at the first level, then a three-term sum over j of the previous cells of both members."
        },
        "b": {
          "type": "unknown",
          "shape": [
            "lev"
          ],
          "units": "1",
          "description": "1 at the first level, then the difference of both members' previous cells."
        }
      },
      "equations": [
        {
          "lhs": "a",
          "rhs": {
            "op": "faq",
            "args": [],
            "output_idx": [
              "k"
            ],
            "ranges": {
              "k": {
                "from": "lev"
              },
              "j": [
                1,
                3
              ]
            },
            "expr": {
              "op": "ifelse",
              "args": [
                {
                  "op": "<=",
                  "args": [
                    "k",
                    1
                  ]
                },
                1.0,
                {
                  "op": "+",
                  "args": [
                    {
                      "op": "index",
                      "args": [
                        "a",
                        {
                          "op": "-",
                          "args": [
                            "k",
                            1
                          ]
                        }
                      ]
                    },
                    {
                      "op": "*",
                      "args": [
                        "j",
                        {
                          "op": "index",
                          "args": [
                            "b",
                            {
                              "op": "-",
                              "args": [
                                "k",
                                1
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          }
        },
        {
          "lhs": "b",
          "rhs": {
            "op": "faq",
            "args": [],
            "output_idx": [
              "k"
            ],
            "ranges": {
              "k": {
                "from": "lev"
              }
            },
            "expr": {
              "op": "ifelse",
              "args": [
                {
                  "op": "<=",
                  "args": [
                    "k",
                    1
                  ]
                },
                1.0,
                {
                  "op": "-",
                  "args": [
                    {
                      "op": "index",
                      "args": [
                        "a",
                        {
                          "op": "-",
                          "args": [
                            "k",
                            1
                          ]
                        }
                      ]
                    },
                    {
                      "op": "index",
                      "args": [
                        "b",
                        {
                          "op": "-",
                          "args": [
                            "k",
                            1
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          }
        }
      ],
      "tests": [
        {
          "id": "contracting_member_evaluates",
          "description": "a = [3, 15, 57, 249], b = [1, 2, 13, 44].",
          "time_span": {
            "start": 0.0,
            "end": 0.0
          },
          "assertions": [
            {
              "variable": "a",
              "time": 0.0,
              "expected": 3.0,
              "coords": {
                "lev": 1
              }
            },
            {
              "variable": "a",
              "time": 0.0,
              "expected": 15.0,
              "coords": {
                "lev": 2
              }
            },
            {
              "variable": "a",
              "time": 0.0,
              "expected": 57.0,
              "coords": {
                "lev": 3
              }
            },
            {
              "variable": "a",
              "time": 0.0,
              "expected": 249.0,
              "coords": {
                "lev": 4
              }
            },
            {
              "variable": "b",
              "time": 0.0,
              "expected": 1.0,
              "coords": {
                "lev": 1
              }
            },
            {
              "variable": "b",
              "time": 0.0,
              "expected": 2.0,
              "coords": {
                "lev": 2
              }
            },
            {
              "variable": "b",
              "time": 0.0,
              "expected": 13.0,
              "coords": {
                "lev": 3
              }
            },
            {
              "variable": "b",
              "time": 0.0,
              "expected": 44.0,
              "coords": {
                "lev": 4
              }
            }
          ]
        }
      ]
    }
  }
}
