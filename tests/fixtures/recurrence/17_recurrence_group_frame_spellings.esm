{
  "esm": "1.2.0",
  "metadata": {
    "name": "RecurrenceGroupFrameSpellings",
    "description": "The group of 13 (esm-spec 4.3.1.2) with its one frame spelled two ways: a sweeps k over {from: lev}, and b is written in the indexed-faq LHS form faq{expr: index(b, k)} ~ faq{body} with k over the literal [1, 4]. Over a 4-element lev the two are ONE frame -- a validator compares resolved bounds, and so must every build. Answer a = [1, 3, 5, 11], b = [2, 2, 6, 30], as 13.",
    "authors": [
      "EarthSciML Authors and Contributors"
    ],
    "tags": [
      "recurrence",
      "recurrence-group",
      "faq",
      "indexed-lhs",
      "causal-self-reference"
    ]
  },
  "index_sets": {
    "lev": {
      "kind": "interval",
      "size": 4
    }
  },
  "models": {
    "RecurrenceGroupFrameSpellings": {
      "tolerance": {
        "rel": 0.0,
        "abs": 0.0
      },
      "variables": {
        "a": {
          "type": "unknown",
          "shape": [
            "lev"
          ],
          "units": "1",
          "description": "1 at the first level, then the sum of both members' previous cells."
        },
        "b": {
          "type": "unknown",
          "shape": [
            "lev"
          ],
          "units": "1",
          "description": "2 at the first level, then the product of both members' previous cells."
        }
      },
      "equations": [
        {
          "lhs": "a",
          "rhs": {
            "op": "faq",
            "args": [],
            "output_idx": [
              "k"
            ],
            "ranges": {
              "k": {
                "from": "lev"
              }
            },
            "expr": {
              "op": "ifelse",
              "args": [
                {
                  "op": "<=",
                  "args": [
                    "k",
                    1
                  ]
                },
                1.0,
                {
                  "op": "+",
                  "args": [
                    {
                      "op": "index",
                      "args": [
                        "a",
                        {
                          "op": "-",
                          "args": [
                            "k",
                            1
                          ]
                        }
                      ]
                    },
                    {
                      "op": "index",
                      "args": [
                        "b",
                        {
                          "op": "-",
                          "args": [
                            "k",
                            1
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          }
        },
        {
          "lhs": {
            "op": "faq",
            "args": [],
            "output_idx": [
              "k"
            ],
            "ranges": {
              "k": [
                1,
                4
              ]
            },
            "expr": {
              "op": "index",
              "args": [
                "b",
                "k"
              ]
            }
          },
          "rhs": {
            "op": "faq",
            "args": [],
            "output_idx": [
              "k"
            ],
            "ranges": {
              "k": [
                1,
                4
              ]
            },
            "expr": {
              "op": "ifelse",
              "args": [
                {
                  "op": "<=",
                  "args": [
                    "k",
                    1
                  ]
                },
                2.0,
                {
                  "op": "*",
                  "args": [
                    {
                      "op": "index",
                      "args": [
                        "a",
                        {
                          "op": "-",
                          "args": [
                            "k",
                            1
                          ]
                        }
                      ]
                    },
                    {
                      "op": "index",
                      "args": [
                        "b",
                        {
                          "op": "-",
                          "args": [
                            "k",
                            1
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          }
        }
      ],
      "tests": [
        {
          "id": "frame_spellings_evaluate",
          "description": "a = [1, 3, 5, 11], b = [2, 2, 6, 30].",
          "time_span": {
            "start": 0.0,
            "end": 0.0
          },
          "assertions": [
            {
              "variable": "a",
              "time": 0.0,
              "expected": 1.0,
              "coords": {
                "lev": 1
              }
            },
            {
              "variable": "a",
              "time": 0.0,
              "expected": 3.0,
              "coords": {
                "lev": 2
              }
            },
            {
              "variable": "a",
              "time": 0.0,
              "expected": 5.0,
              "coords": {
                "lev": 3
              }
            },
            {
              "variable": "a",
              "time": 0.0,
              "expected": 11.0,
              "coords": {
                "lev": 4
              }
            },
            {
              "variable": "b",
              "time": 0.0,
              "expected": 2.0,
              "coords": {
                "lev": 1
              }
            },
            {
              "variable": "b",
              "time": 0.0,
              "expected": 2.0,
              "coords": {
                "lev": 2
              }
            },
            {
              "variable": "b",
              "time": 0.0,
              "expected": 6.0,
              "coords": {
                "lev": 3
              }
            },
            {
              "variable": "b",
              "time": 0.0,
              "expected": 30.0,
              "coords": {
                "lev": 4
              }
            }
          ]
        }
      ]
    }
  }
}
