{
  "esm": "1.1.0",
  "metadata": {
    "name": "faq_30_lifted_makearray_upwind",
    "description": "A whole-array equation D(u) = faq_i(index(makearray(...), i)), the form an operator's derived document writes for a lifted stencil (EarthSciIntegrator spec/plan.md section 6.1.2): the makearray's interior region [2,6] holds the first-order upwind stencil -k*(u[i]-u[i-1]) as an faq over its own range, and the face region [1,1] holds 0, a fixed inflow cell. The makearray is gathered at the lifted faq's own index i, not at the equation's loop index, so a compiler must select the region per cell through that binding; Julia's native compiler once gave every cell the face's value (all zeros). From u[2]=2 and u[i]=1 elsewhere, u[1]=1 and u[i](t)=1+(k t)^(i-2)/(i-2)! exp(-k t) for i>=2.",
    "authors": [
      "EarthSciAST contributors"
    ],
    "tags": [
      "faq",
      "makearray",
      "stencil",
      "lifted",
      "region_dispatch",
      "conformance"
    ]
  },
  "index_sets": {
    "x": {
      "kind": "interval",
      "size": 6
    }
  },
  "models": {
    "Upwind1D": {
      "tolerance": {
        "rel": 1e-06,
        "abs": 1e-09
      },
      "variables": {
        "u": {
          "type": "unknown",
          "shape": [
            "x"
          ]
        },
        "k": {
          "type": "parameter",
          "default": 2.0
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "u"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "faq",
            "args": [],
            "output_idx": [
              "i"
            ],
            "ranges": {
              "i": {
                "from": "x"
              }
            },
            "expr": {
              "op": "index",
              "args": [
                {
                  "op": "makearray",
                  "args": [],
                  "regions": [
                    [
                      [
                        2,
                        6
                      ]
                    ],
                    [
                      [
                        1,
                        1
                      ]
                    ]
                  ],
                  "values": [
                    {
                      "op": "faq",
                      "args": [],
                      "output_idx": [
                        "i"
                      ],
                      "ranges": {
                        "i": [
                          2,
                          6
                        ]
                      },
                      "expr": {
                        "op": "*",
                        "args": [
                          {
                            "op": "-",
                            "args": [
                              "k"
                            ]
                          },
                          {
                            "op": "-",
                            "args": [
                              {
                                "op": "index",
                                "args": [
                                  "u",
                                  "i"
                                ]
                              },
                              {
                                "op": "index",
                                "args": [
                                  "u",
                                  {
                                    "op": "-",
                                    "args": [
                                      "i",
                                      1
                                    ]
                                  }
                                ]
                              }
                            ]
                          }
                        ]
                      }
                    },
                    0
                  ]
                },
                "i"
              ]
            }
          }
        }
      ],
      "tests": [
        {
          "id": "upwind_pulse_t1",
          "description": "The pulse at u[2] advects down the chain: u[i](1) = 1 + 2^(i-2)/(i-2)! exp(-2) for i>=2, and the inflow cell stays at 1.",
          "initial_conditions": {
            "u[1]": 1.0,
            "u[2]": 2.0,
            "u[3]": 1.0,
            "u[4]": 1.0,
            "u[5]": 1.0,
            "u[6]": 1.0
          },
          "time_span": {
            "start": 0.0,
            "end": 1.0
          },
          "assertions": [
            {
              "variable": "u[1]",
              "time": 1.0,
              "expected": 1.0
            },
            {
              "variable": "u[2]",
              "time": 1.0,
              "expected": 1.1353352832366128
            },
            {
              "variable": "u[3]",
              "time": 1.0,
              "expected": 1.2706705664732254
            },
            {
              "variable": "u[4]",
              "time": 1.0,
              "expected": 1.2706705664732254
            },
            {
              "variable": "u[5]",
              "time": 1.0,
              "expected": 1.1804470443154835
            },
            {
              "variable": "u[6]",
              "time": 1.0,
              "expected": 1.0902235221577419
            }
          ]
        }
      ]
    }
  }
}
