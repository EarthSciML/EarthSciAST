{
  "esm": "1.0.0",
  "metadata": {
    "name": "leaf_v100_solver",
    "description": "A leaf that declares esm 1.0.0 but carries a top-level `solver` block, which arrives at 1.1.0 (esm-spec §2.2.4). Invalid on its own. tests/invalid/version_gate_newer_mounts_older_solver.esm mounts it from a 1.1.0 root: the gate reads THIS file's version (esm-spec §4.7), so the mount is still rejected.",
    "authors": [
      "EarthSciAST"
    ],
    "created": "2026-10-30T00:00:00Z",
    "tags": [
      "version",
      "mount"
    ]
  },
  "solver": {
    "stiffness": "high"
  },
  "models": {
    "Leaf": {
      "variables": {
        "x": {
          "type": "unknown",
          "units": "m",
          "default": 1.0,
          "description": "Decaying state."
        },
        "k": {
          "type": "parameter",
          "units": "1/s",
          "default": 0.5,
          "description": "Rate."
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "x"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "*",
            "args": [
              {
                "op": "neg",
                "args": [
                  "k"
                ]
              },
              "x"
            ]
          }
        }
      ]
    }
  }
}
