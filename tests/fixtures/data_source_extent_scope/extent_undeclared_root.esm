{
  "esm": "1.1.0",
  "metadata": {
    "name": "ExtentUndeclaredRoot",
    "description": "INVALID: the `extent` binds `N_RECS`, which neither this document nor the leaf it mounts declares."
  },
  "data_sources": {
    "EGU_Emis": {
      "kind": "points",
      "source": {
        "url_template": "file://./records.csv"
      },
      "extent": {
        "metaparameter": "N_RECS"
      },
      "metadata": {
        "esio_format": "ff10"
      }
    }
  },
  "models": {
    "Ingest": {
      "ref": "./extent_axis_leaf.esm"
    }
  }
}
