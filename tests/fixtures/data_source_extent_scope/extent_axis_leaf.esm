{
  "esm": "1.1.0",
  "metadata": {
    "name": "ExtentAxisLeaf",
    "description": "Owns the record axis and the metaparameter a data source's `extent` discovers (esm-spec \u00a78.9.4)."
  },
  "metaparameters": {
    "N_REC": {
      "type": "integer",
      "default": 0,
      "description": "Records in the source. A placeholder the source overrides."
    }
  },
  "index_sets": {
    "records": {
      "kind": "interval",
      "size": "N_REC"
    }
  },
  "models": {
    "Ingest": {
      "system_kind": "nonlinear",
      "variables": {
        "annual": {
          "type": "parameter",
          "units": "kg/yr",
          "default": 0.0,
          "shape": [
            "records"
          ],
          "description": "Per-record annual emissions, read from the source.",
          "update": {
            "kind": "data",
            "source": "EGU_Emis",
            "from": {
              "file_variable": "ANN_VALUE"
            }
          }
        },
        "annual_obs": {
          "type": "unknown",
          "units": "kg/yr",
          "shape": [
            "records"
          ],
          "description": "Identity over the ingested column."
        }
      },
      "equations": [
        {
          "lhs": "annual_obs",
          "rhs": {
            "op": "faq",
            "output_idx": [
              "r"
            ],
            "ranges": {
              "r": {
                "from": "records"
              }
            },
            "args": [
              "annual"
            ],
            "expr": {
              "op": "index",
              "args": [
                "annual",
                "r"
              ]
            }
          }
        }
      ]
    }
  }
}
