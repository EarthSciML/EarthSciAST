{
  "esm": "1.1.0",
  "metadata": {
    "name": "ExtentTypoNoMount",
    "description": "INVALID, and the PUREST typo case: a single file, no mounts, no imports. It declares `N_REC` and sizes its axis by it, but the `extent` says `N_RECS`. Nothing but the author's own document is needed to see it."
  },
  "metaparameters": {
    "N_REC": { "type": "integer", "default": 0, "description": "Records in the source." }
  },
  "index_sets": { "records": { "kind": "interval", "size": "N_REC" } },
  "data_sources": {
    "EGU_Emis": {
      "kind": "points",
      "source": { "url_template": "file://./records.csv" },
      "extent": { "metaparameter": "N_RECS" },
      "metadata": { "esio_format": "ff10" }
    }
  },
  "models": {
    "Ingest": {
      "system_kind": "nonlinear",
      "variables": {
        "annual": { "type": "parameter", "units": "kg/yr", "default": 0.0, "shape": ["records"],
                    "description": "Per-record annual emissions, read from the source.",
                    "update": { "kind": "data", "source": "EGU_Emis", "from": { "file_variable": "ANN_VALUE" } } },
        "annual_obs": { "type": "unknown", "units": "kg/yr", "shape": ["records"], "description": "Identity." }
      },
      "equations": [
        { "lhs": "annual_obs",
          "rhs": { "op": "faq", "output_idx": ["r"], "ranges": { "r": { "from": "records" } },
                   "args": ["annual"], "expr": { "op": "index", "args": ["annual", "r"] } } }
      ]
    }
  }
}
