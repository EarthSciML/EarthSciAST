{
  "esm": "1.1.0",
  "metadata": {
    "name": "AssemblerAxisLeafWithImport",
    "description": "Axis sized by a metaparameter only the ASSEMBLER declares; carries an expression_template_import it never calls."
  },
  "index_sets": {
    "records": {
      "kind": "interval",
      "size": "N_REC"
    }
  },
  "models": {
    "Ingest": {
      "system_kind": "nonlinear",
      "variables": {
        "annual": {
          "type": "parameter",
          "units": "kg/yr",
          "default": 0.0,
          "shape": [
            "records"
          ],
          "description": "Per-record annual emissions, read from the source.",
          "update": {
            "kind": "data",
            "source": "EGU_Emis",
            "from": {
              "file_variable": "ANN_VALUE"
            }
          }
        },
        "annual_obs": {
          "type": "unknown",
          "units": "kg/yr",
          "shape": [
            "records"
          ],
          "description": "Identity over the ingested column."
        }
      },
      "equations": [
        {
          "lhs": "annual_obs",
          "rhs": {
            "op": "faq",
            "output_idx": [
              "r"
            ],
            "ranges": {
              "r": {
                "from": "records"
              }
            },
            "args": [
              "annual"
            ],
            "expr": {
              "op": "index",
              "args": [
                "annual",
                "r"
              ]
            }
          }
        }
      ],
      "expression_template_imports": [
        {
          "ref": "./unused_lib.esm"
        }
      ]
    }
  }
}
