{
  "esm": "1.0.0",
  "metadata": {
    "name": "toplevel_ref_metaparameter_axis",
    "description": "Regression pin for the §4.7 top-level mount merge's FOLD GUARD. Mounts toplevel_ref_metaparameter_axis_lib.esm through a top-level models.<k> {ref}. The leaf's only axis is sized by the leaf's OWN metaparameter, and a top-level mount edge does not close the leaf's metaparameters (it is a raw pre-pass that drops the leaf's `metaparameters` block and defers §9.7 to the root pass). Merging an unfolded `size` would resolve it in the wrong scope — a raw Int coercion failure when the root does not declare the name, or the ROOT's value silently overriding the leaf's own default when it does. Julia and Rust therefore hold such a declaration back and this document loads with `lev` still undeclared. Python's top-level mount DOES close the leaf's metaparameters, so it merges `lev` = 4; that divergence is recorded in ESM_COMPLIANCE_VALIDATION_MATRIX.md BEHAV-04-D-003 and is why this pair lives under tests/fixtures/ rather than tests/valid/.",
    "authors": ["EarthSciAST"],
    "created": "2026-09-07T00:00:00Z",
    "tags": ["subsystem", "index_sets", "metaparameter", "mount", "toplevel-ref", "regression"]
  },
  "models": {
    "M": { "ref": "./toplevel_ref_metaparameter_axis_lib.esm" }
  }
}
