{
  "esm": "2.3.0",
  "metadata": {
    "name": "mount_json_content",
    "description": "Mounts ./json_content.md, a file holding JSON text, as a subsystem: it is read as Markdown, which refuses it (unresolved_subsystem_ref).",
    "authors": [
      "EarthSciML"
    ]
  },
  "models": {
    "M": {
      "subsystems": {
        "Leaf": {
          "ref": "./json_content.md"
        }
      },
      "variables": {
        "y": {
          "type": "unknown",
          "units": "1",
          "default": 1.0
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "y"
            ],
            "wrt": "t"
          },
          "rhs": 0.0
        }
      ]
    }
  }
}
