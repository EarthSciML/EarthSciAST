{
  "esm": "2.3.0",
  "metadata": {
    "name": "mount_removed_op",
    "description": "Mounts ./removed_op.md as a subsystem: its equation calls fn, an operator removed at esm 2.0.0, so the Markdown reader refuses it and the mount keeps the reader's code (removed_op).",
    "authors": [
      "EarthSciML"
    ]
  },
  "models": {
    "M": {
      "subsystems": {
        "Leaf": {
          "ref": "./removed_op.md"
        }
      },
      "variables": {
        "y": {
          "type": "unknown",
          "units": "1",
          "default": 1.0
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "y"
            ],
            "wrt": "t"
          },
          "rhs": 0.0
        }
      ]
    }
  }
}
