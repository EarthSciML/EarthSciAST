          "default": 1.0
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "y"
            ],
            "wrt": "t"
          },
          "rhs": 0.0
        }
      ]
    }
  },
  "coupling": [
    {
      "type": "coupling_import",
      "ref": "./json_content.typ",
      "bind": {
        "R": "A"
      }
    }
  ]
