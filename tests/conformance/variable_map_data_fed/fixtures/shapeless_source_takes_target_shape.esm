{
  "esm": "1.1.0",
  "metadata": {
    "name": "variable_map_data_fed_shapeless_source_takes_target_shape",
    "description": "`Met.K` is data-fed and declares NO `shape`; the `param_to_var` target `Box.F_k` is shaped [rec, x]. A shapeless data-fed source takes the shape of the target it replaces (esm-libraries-spec 4.7.3, esm-spec 8.5.1), so the surviving `Met.K` is shaped [rec, x] and keeps its own `data` update: it is in `discrete_parameters` and agrees with `loader_fields`. This is how a data component declares a field once and a consumer gives it the record axis and the grid (reseact's GEOSFP.PBLH -> Transport3D.F_PBLH). Contrast scalar_source_onto_shaped_target.esm, where `shape: []` declares a scalar and is refused.",
    "tags": [
      "variable_map",
      "param_to_var",
      "data-source",
      "shape",
      "conformance"
    ]
  },
  "index_sets": {
    "rec": {
      "kind": "interval",
      "size": 2
    },
    "x": {
      "kind": "interval",
      "size": 4
    }
  },
  "data_sources": {
    "met_source": {
      "kind": "grid",
      "source": {
        "url_template": "file:///data/met/met_{date:%Y%m%d}.nc"
      },
      "temporal": {
        "frequency": "PT1H",
        "file_period": "P1D",
        "records_per_file": 24
      }
    }
  },
  "models": {
    "Met": {
      "variables": {
        "K": {
          "type": "parameter",
          "units": "1/s",
          "description": "Data-fed rate field, read from met_source file variable K.",
          "update": {
            "kind": "data",
            "source": "met_source",
            "from": {
              "file_variable": "K"
            }
          }
        }
      },
      "equations": []
    },
    "Box": {
      "variables": {
        "c": {
          "type": "unknown",
          "units": "mol/mol",
          "shape": [
            "x"
          ],
          "default": 1.0,
          "description": "Tracer concentration per cell."
        },
        "F_k": {
          "type": "parameter",
          "units": "1/s",
          "shape": [
            "rec",
            "x"
          ],
          "default": 0.0,
          "description": "Rate field, two bracketing records per cell. Coupled from Met.K."
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "faq",
            "args": [],
            "output_idx": [
              "i"
            ],
            "ranges": {
              "i": {
                "from": "x"
              }
            },
            "expr": {
              "op": "D",
              "args": [
                {
                  "op": "index",
                  "args": [
                    "c",
                    "i"
                  ]
                }
              ],
              "wrt": "t"
            }
          },
          "rhs": {
            "op": "faq",
            "args": [],
            "output_idx": [
              "i"
            ],
            "ranges": {
              "i": {
                "from": "x"
              }
            },
            "expr": {
              "op": "-",
              "args": [
                {
                  "op": "*",
                  "args": [
                    {
                      "op": "index",
                      "args": [
                        "F_k",
                        1,
                        "i"
                      ]
                    },
                    {
                      "op": "index",
                      "args": [
                        "c",
                        "i"
                      ]
                    }
                  ]
                }
              ]
            }
          }
        }
      ]
    }
  },
  "coupling": [
    {
      "type": "variable_map",
      "from": "Met.K",
      "to": "Box.F_k",
      "transform": "param_to_var"
    }
  ]
}
