{
  "esm": "1.0.0",
  "metadata": {
    "name": "LoaderUnitConversion",
    "description": "esm-spec §8.5 `unit_conversion`, executed: \"either a plain multiplicative factor or a full Expression AST (§4); the runtime applies it when producing values in the declared `units`\". One FF10 point source over a committed four-record fixture, consumed by four parameters of the `Stacks_Ingest` model whose `update.from` bindings cover the four cases the runtime must distinguish: a NUMERIC factor (feet -> metres), an OPEN Expression (degF -> K, which §4.8.1 says MUST be an expression because the affine offset is deliberately absent from the dimensional metadata), a CLOSED Expression (no free variable, folding to a constant factor), and NO conversion at all -- the control that pins the no-op property, since a document declaring no conversion must deliver exactly the raw on-disk column. From 1.0.0 the `units` are declared once, on the consuming PARAMETER, and the binding carries only the file variable plus its conversion. Nothing here is model math: the point is that a document declaring a conversion needs no caller to apply it, and that the three bindings apply it to the same bits. The url_template is a placeholder; each binding's adapter patches it onto the committed CSV next to this file.",
    "authors": [
      "Test Suite"
    ],
    "license": "MIT",
    "tags": [
      "data-sources",
      "pure-io",
      "unit-conversion",
      "conformance"
    ]
  },
  "metaparameters": {
    "N_STACK": {
      "type": "integer",
      "default": 4,
      "description": "Records in the committed stacks_ff10_point.csv fixture."
    }
  },
  "index_sets": {
    "stacks": {
      "kind": "interval",
      "size": "N_STACK"
    }
  },
  "data_sources": {
    "Stacks": {
      "kind": "points",
      "metadata": {
        "esio_format": "ff10"
      },
      "source": {
        "url_template": "file:///replaced/by/the/adapter/stacks_ff10_point.csv"
      }
    }
  },
  "models": {
    "Stacks_Ingest": {
      "system_kind": "nonlinear",
      "variables": {
        "annual": {
          "type": "parameter",
          "units": "ton/yr",
          "default": 0.0,
          "shape": [
            "stacks"
          ],
          "update": {
            "kind": "data",
            "source": "Stacks",
            "from": {
              "file_variable": "ANN_VALUE"
            }
          },
          "description": "THE CONTROL: units match the raw column and no conversion is declared, so the delivered array must be the raw column, bit for bit."
        },
        "stkhgt": {
          "type": "parameter",
          "units": "m",
          "default": 0.0,
          "shape": [
            "stacks"
          ],
          "update": {
            "kind": "data",
            "source": "Stacks",
            "from": {
              "file_variable": "STKHGT",
              "unit_conversion": 0.3048
            }
          },
          "description": "Feet on disk, metres declared: a plain multiplicative factor."
        },
        "stkdiam": {
          "type": "parameter",
          "units": "m",
          "default": 0.0,
          "shape": [
            "stacks"
          ],
          "update": {
            "kind": "data",
            "source": "Stacks",
            "from": {
              "file_variable": "STKDIAM",
              "unit_conversion": {
                "op": "*",
                "args": [
                  0.3048,
                  1.0
                ]
              }
            }
          },
          "description": "The same feet->metres conversion spelled as a CLOSED Expression (no free variable), which folds to a constant factor."
        },
        "stktemp": {
          "type": "parameter",
          "units": "K",
          "default": 0.0,
          "shape": [
            "stacks"
          ],
          "update": {
            "kind": "data",
            "source": "Stacks",
            "from": {
              "file_variable": "STKTEMP",
              "unit_conversion": {
                "op": "*",
                "args": [
                  {
                    "op": "+",
                    "args": [
                      "stktemp",
                      459.67
                    ]
                  },
                  0.5555555555555556
                ]
              }
            }
          },
          "description": "Fahrenheit on disk, kelvin declared. Affine, so it CANNOT be a factor: §4.8.1 keeps the zero offset out of the dimensional metadata on purpose, and says a conversion that needs it is a `unit_conversion` expression."
        }
      },
      "equations": []
    }
  }
}
