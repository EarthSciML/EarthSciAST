{
  "esm": "1.0.0",
  "metadata": {
    "name": "UnboundScalarForcing",
    "description": "A SCALAR data-fed parameter whose `update.source` RESOLVES to a declared data source, in a document nothing supplies data for. Built with no `providers` and no `p` binding for `Forcing.k`, nothing binds the parameter, so its declared `default` (0.1) is its value (esm-spec §6.3; user ruling 2026-09-29) and the build runs: the inline test pins exp(-0.1).",
    "authors": [
      "Test Suite"
    ],
    "tags": [
      "conformance",
      "data_source_unbound",
      "refusal"
    ]
  },
  "data_sources": {
    "Wind": {
      "kind": "static",
      "source": {
        "url_template": "file:///data/wind_that_is_never_read.nc"
      }
    }
  },
  "models": {
    "Forcing": {
      "variables": {
        "x": {
          "type": "unknown",
          "units": "1",
          "default": 1.0
        },
        "k": {
          "type": "parameter",
          "units": "1/s",
          "default": 0.1,
          "shape": [],
          "update": {
            "kind": "data",
            "source": "Wind",
            "from": {
              "file_variable": "k_decay"
            }
          },
          "description": "Data-fed from the Wind source; with nothing bound, its declared `default` is its value (esm-spec §6.3)."
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "x"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "*",
            "args": [
              -1.0,
              "k",
              "x"
            ]
          }
        }
      ],
      "tests": [
        {
          "id": "decay_at_the_rate_the_data_would_have_supplied",
          "description": "The number here is exp(-0.1), the trajectory the `default` of 0.1 produces: nothing binds `Forcing.k`, so its declared default serves (esm-spec §6.3; user ruling 2026-09-29).",
          "time_span": {
            "start": 0.0,
            "end": 1.0
          },
          "assertions": [
            {
              "variable": "x",
              "time": 1.0,
              "expected": 0.9048374180359595
            }
          ]
        }
      ]
    }
  }
}
