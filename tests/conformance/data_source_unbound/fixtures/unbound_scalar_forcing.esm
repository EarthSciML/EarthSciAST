{
  "esm": "1.0.0",
  "metadata": {
    "name": "UnboundScalarForcing",
    "description": "A SCALAR data-fed parameter whose `update.source` RESOLVES to a declared data source, in a document nothing supplies data for. Built with no `providers` and no `p` binding for `Forcing.k`, the parameter has no source bound and MUST be refused at construction (`data_source_unbound`, esm-spec 9.6.6). Before the ruling the bindings bound it from its `default` of 0.1 and integrated an exponential decay that the document does not describe: the answer looked like a rate the file names, but came from a placeholder.",
    "authors": [
      "Test Suite"
    ],
    "tags": [
      "conformance",
      "data_source_unbound",
      "refusal"
    ]
  },
  "data_sources": {
    "Wind": {
      "kind": "static",
      "source": {
        "url_template": "file:///data/wind_that_is_never_read.nc"
      }
    }
  },
  "models": {
    "Forcing": {
      "variables": {
        "x": {
          "type": "unknown",
          "units": "1",
          "default": 1.0
        },
        "k": {
          "type": "parameter",
          "units": "1/s",
          "default": 0.1,
          "shape": [],
          "update": {
            "kind": "data",
            "source": "Wind",
            "from": {
              "file_variable": "k_decay"
            }
          },
          "description": "Data-fed: its value comes from the Wind source, never from `default`."
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "x"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "*",
            "args": [
              -1.0,
              "k",
              "x"
            ]
          }
        }
      ],
      "tests": [
        {
          "id": "decay_at_the_rate_the_data_would_have_supplied",
          "description": "The number here is exp(-0.1), the trajectory the `default` of 0.1 produces. It is exactly the plausible-looking wrong answer the ruling exists to prevent: nothing bound `Forcing.k`, so no run may report it. A build MUST refuse instead of producing it.",
          "time_span": {
            "start": 0.0,
            "end": 1.0
          },
          "assertions": [
            {
              "variable": "x",
              "time": 1.0,
              "expected": 0.9048374180359595
            }
          ]
        }
      ]
    }
  }
}
