{
  "esm": "1.0.0",
  "metadata": {
    "name": "UnboundArrayForcing",
    "description": "The SHAPED counterpart of unbound_scalar_forcing: `Forcing.k` is a data-fed parameter over the declared index set `cell`, and the document declares no `default` for it (a field has no scalar placeholder to fall back to). Built with no `providers` the array is never filled, so the right-hand side reads whatever the binding seeded it with. It MUST be refused at construction with `data_source_unbound` rather than integrated.",
    "authors": [
      "Test Suite"
    ],
    "tags": [
      "conformance",
      "data_source_unbound",
      "refusal"
    ]
  },
  "index_sets": {
    "cell": {
      "kind": "interval",
      "size": 3
    }
  },
  "data_sources": {
    "Wind": {
      "kind": "grid",
      "source": {
        "url_template": "file:///data/wind_that_is_never_read.nc"
      }
    }
  },
  "models": {
    "Forcing": {
      "variables": {
        "x": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "cell"
          ],
          "default": 1.0
        },
        "k": {
          "type": "parameter",
          "units": "1/s",
          "shape": [
            "cell"
          ],
          "update": {
            "kind": "data",
            "source": "Wind",
            "from": {
              "file_variable": "k_decay"
            }
          },
          "description": "Data-fed FIELD: no `default` exists for it, so nothing but the source can bind it."
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "x"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "*",
            "args": [
              -1.0,
              "k",
              "x"
            ]
          }
        }
      ],
      "tests": [
        {
          "id": "the_field_is_integrated_against_whatever_seeded_it",
          "description": "`Forcing.k` has no `default`, so whatever this assertion compares against is a property of the binding's seeding, not of the document. Refusal is the only answer that does not depend on it.",
          "time_span": {
            "start": 0.0,
            "end": 1.0
          },
          "assertions": [
            {
              "variable": "x",
              "time": 1.0,
              "expected": 1.0,
              "coords": {
                "cell": 1
              }
            }
          ]
        }
      ]
    }
  }
}
