    "element_type": "Float32"
  },
  "models": {
    "Outer": {
      "variables": {
        "y": {
          "type": "unknown",
          "units": "1"
        }
      },
      "equations": [
        {
          "lhs": "y",
          "rhs": 2
        }
      ],
      "subsystems": {
        "Inner": {
          "ref": "./leaf_none.esm"
        }
      }
    }
  }
}
