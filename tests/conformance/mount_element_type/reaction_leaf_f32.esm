          "units": "mol/mol",
          "default": 1.0
        },
        "B": {
          "units": "mol/mol",
          "default": 0.0
        }
      },
      "parameters": {
        "k": {
          "units": "1/s",
          "default": 0.1
        }
      },
      "reactions": [
        {
          "id": "R1",
          "substrates": [
            {
              "species": "A",
              "stoichiometry": 1
            }
          ],
          "products": [
            {
              "species": "B",
              "stoichiometry": 1
            }
          ],
          "rate": "k"
        }
      ]
    }
  }
