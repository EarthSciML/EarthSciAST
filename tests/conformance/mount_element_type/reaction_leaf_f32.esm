{
  "esm": "1.2.0",
  "metadata": {
    "name": "mount_element_type_reaction_leaf_f32",
    "description": "A Float32 leaf whose component is a reaction system. Species and reaction parameters have no per-variable element_type, so a mount into a document of another precision cannot carry it."
