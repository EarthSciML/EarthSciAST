{
  "esm": "2.3.0",
  "metadata": {
    "name": "mount_element_type_root_legacy",
    "description": "The same mounts as root_unspecified.esm under an esm 2.3.0 root. Below esm 2.4.0 an omitted root precision declares Float64, so the Float64 leaf needs nothing written and the undeclared leaf inherits a Float64 declaration."
  },
  "models": {
    "Wide": { "ref": "./leaf_f64.esm" },
    "Plain": { "ref": "./leaf_none.esm" }
  }
}
