{
  "esm": "1.0.0",
  "metadata": {
    "name": "DOfObserved",
    "description": "esm-spec §4.2, REFUSE half: D of an OBSERVED resolves to no tendency (the format defines no symbolic differentiation) and MUST be refused with `unlowered_operator` rather than given a value — in particular not 0.",
    "authors": ["EarthSciAST conformance"],
    "created": "2026-09-07T00:00:00Z",
    "tags": ["conformance", "esm-spec-4.2", "unlowered-operator"]
  },
  "models": {
    "M": {
      "variables": {
        "x": { "type": "unknown", "units": "kg", "default": 2.0 },
        "k": { "type": "parameter", "units": "1/s", "default": 3.0 },
        "combo": { "type": "unknown", "units": "kg", "description": "An OBSERVED: bare-variable LHS, no differential equation" },
        "dcombo": { "type": "unknown", "units": "kg/s", "description": "D of that observed — unresolvable" }
      },
      "equations": [
        {
          "lhs": { "op": "D", "args": ["x"], "wrt": "t" },
          "rhs": { "op": "*", "args": [{ "op": "-", "args": ["k"] }, "x"] }
        },
        { "lhs": "combo", "rhs": { "op": "*", "args": [2.0, "x"] } },
        {
          "_comment": "combo has no D(combo)/dt equation, so this names no tendency. Chain-ruling it would be symbolic differentiation, which this format does not define.",
          "lhs": "dcombo",
          "rhs": { "op": "D", "args": ["combo"], "wrt": "t" }
        }
      ],
      "tests": [
        {
          "id": "d_of_observed_is_refused",
          "description": "The run must be refused. The value a conforming runtime must NOT invent is -12 (2*(-k*x)); the value the pre-fix bindings returned was 0.",
          "time_span": { "start": 0.0, "end": 1.0 },
          "assertions": [
            { "variable": "dcombo", "time": 0.0, "expected": -12.0, "tolerance": { "abs": 1e-9 } }
          ]
        }
      ]
    }
  },
  "domain": { "temporal": {} }
}
