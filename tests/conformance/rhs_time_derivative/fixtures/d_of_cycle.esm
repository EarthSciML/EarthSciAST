{
  "esm": "1.0.0",
  "metadata": {
    "name": "DOfCycle",
    "description": "esm-spec §4.2, REFUSE half: a SELF-REFERENTIAL tendency. `x`'s own differential equation names `D(x, t)` on its right-hand side, so resolving that node would substitute the equation into itself without end. The resolution must stop at the cycle and leave the node standing for the `unlowered_operator` gate — never loop, never overflow the stack, and never invent a value. This is the shape that makes the chain guard load-bearing rather than defensive.",
    "authors": ["EarthSciAST conformance"],
    "created": "2026-09-08T00:00:00Z",
    "tags": ["conformance", "esm-spec-4.2", "unlowered-operator", "refusal", "cycle"]
  },
  "models": {
    "M": {
      "variables": {
        "x": { "type": "unknown", "units": "kg", "default": 2.0, "description": "A state whose tendency names its own tendency" },
        "k": { "type": "parameter", "units": "dimensionless", "default": 0.5, "description": "Self-reference coefficient" },
        "dx": { "type": "unknown", "units": "kg/s", "description": "The tendency, asserted so the refusal names a quantity" }
      },
      "equations": [
        {
          "_comment": "d(x)/dt = k * d(x)/dt. Mathematically this pins d(x)/dt = 0 for k != 1, but that is an ALGEBRAIC deduction over the whole equation, not a substitution — the resolution is a rewrite, not a solver, and must not pretend otherwise.",
          "lhs": { "op": "D", "args": ["x"], "wrt": "t" },
          "rhs": { "op": "*", "args": ["k", { "op": "D", "args": ["x"], "wrt": "t" }] }
        },
        {
          "lhs": "dx",
          "rhs": { "op": "D", "args": ["x"], "wrt": "t" }
        }
      ],
      "tests": [
        {
          "id": "d_of_cycle_is_refused",
          "description": "The run must be refused with `unlowered_operator`. `expected` is 0 for the same reason the other refusal fixtures use it: 0 is what an inventing binding answers, and it is also the value the algebra would give — so only the outcome class catches it.",
          "time_span": { "start": 0.0, "end": 1.0 },
          "assertions": [
            { "variable": "dx", "time": 0.0, "expected": 0.0, "tolerance": { "abs": 1e-9 } }
          ]
        }
      ]
    }
  },
  "domain": { "temporal": {} }
}
