{
  "esm": "1.0.0",
  "metadata": {
    "name": "MergedTendencyResolution",
    "description": "esm-spec §4.2 / esm-libraries-spec §4.7.5 step 3a: a right-hand-side structural D over a state that operator_compose MERGED reads the whole merged tendency, not the first contributing term. Resolution runs after the coupling rules for exactly this reason.",
    "authors": ["EarthSciAST conformance"],
    "created": "2026-09-14T00:00:00Z",
    "tags": ["conformance", "esm-spec-4.2", "tendency", "operator_compose"]
  },
  "reaction_systems": {
    "Chem": {
      "reference": {
        "notes": "A -> B at a first-order rate k, so the mechanism alone gives d(A)/dt = -k*A (§7.4)."
      },
      "species": {
        "A": { "units": "mol/mol", "default": 4.0, "description": "Decaying species" },
        "B": { "units": "mol/mol", "default": 0.0, "description": "Product" }
      },
      "parameters": {
        "k": { "units": "1/s", "default": 0.5, "description": "First-order rate constant" }
      },
      "reactions": [
        {
          "id": "R1",
          "name": "first_order_decay",
          "substrates": [{ "species": "A", "stoichiometry": 1 }],
          "products": [{ "species": "B", "stoichiometry": 1 }],
          "rate": "k"
        }
      ]
    }
  },
  "models": {
    "Sink": {
      "reference": {
        "notes": "A first-order loss operator, composed onto every Chem species through the _var placeholder (§4.7.1)."
      },
      "variables": {
        "kd": { "type": "parameter", "units": "1/s", "default": 0.25, "description": "Loss rate" }
      },
      "equations": [
        {
          "lhs": { "op": "D", "args": ["_var"], "wrt": "t" },
          "rhs": { "op": "*", "args": [{ "op": "-", "args": ["kd"] }, "_var"] }
        }
      ]
    },
    "M": {
      "variables": {
        "dAdt": { "type": "unknown", "units": "mol/mol/s", "description": "D(Chem.A, t), read after the merge" }
      },
      "equations": [
        {
          "_comment": "The merged tendency is -k*A - kd*A = -2 - 1 = -3 at t = 0. A resolution that ran before coupling would read only the mechanism's -k*A = -2.",
          "lhs": "dAdt",
          "rhs": { "op": "D", "args": ["Chem.A"], "wrt": "t" }
        }
      ],
      "tests": [
        {
          "id": "merged_tendency_resolves",
          "description": "A right-hand-side D over an operator_compose-merged state is the whole merged tendency.",
          "time_span": { "start": 0.0, "end": 2.0 },
          "tolerance": { "rel": 1e-8, "abs": 1e-10 },
          "assertions": [
            { "variable": "dAdt", "time": 0.0, "expected": -3.0 },
            { "variable": "Chem.A", "time": 2.0, "expected": 0.8925206405937194 }
          ]
        }
      ]
    }
  },
  "coupling": [
    {
      "type": "operator_compose",
      "systems": ["Chem", "Sink"],
      "description": "Add the Sink loss to every Chem species."
    }
  ],
  "domain": { "temporal": {} }
}
