{
  "esm": "1.3.0",
  "metadata": {
    "name": "SolverExternal_space_hash",
    "description": "esm-spec §2.2.6 percent-encoding: a relative `solver.external` holding a space and a `#`. The location is a `file://` URL built from a path, so each byte outside `A-Za-z0-9-._~/:` is percent-encoded: the space becomes `%20` and the `#` `%23`, rather than being read as a fragment. The document keeps the authored string. The target does not exist on disk.",
    "authors": [
      "EarthSciML Test Suite"
    ],
    "license": "MIT",
    "tags": [
      "solver",
      "external",
      "conformance"
    ]
  },
  "solver": {
    "external": "runs/case #2.json"
  },
  "models": {
    "Decay": {
      "variables": {
        "A": {
          "type": "unknown",
          "units": "mol/m^3",
          "default": 2.0
        },
        "k": {
          "type": "parameter",
          "units": "1/s",
          "default": 0.5
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "A"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "neg",
            "args": [
              {
                "op": "*",
                "args": [
                  "k",
                  "A"
                ]
              }
            ]
          }
        }
      ]
    }
  }
}
