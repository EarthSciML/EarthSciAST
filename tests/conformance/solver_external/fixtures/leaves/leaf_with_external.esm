{
  "esm": "1.3.0",
  "metadata": {
    "name": "SolverExternal_leaf",
    "description": "A single-component leaf, mounted by the mount_* fixtures one directory up. Its own `solver` block carries `external`; that block MUST NOT cross the mount edge (esm-spec §4.7, §2.2.6), so a root that mounts this leaf reports its OWN `external`, or none.",
    "authors": [
      "EarthSciML Test Suite"
    ],
    "license": "MIT",
    "tags": [
      "solver",
      "external",
      "conformance",
      "mount",
      "leaf"
    ]
  },
  "solver": {
    "stiffness": "low",
    "external": "./leaf.run.json"
  },
  "models": {
    "LeafDecay": {
      "variables": {
        "A": {
          "type": "unknown",
          "units": "mol/m^3",
          "default": 2.0
        },
        "k": {
          "type": "parameter",
          "units": "1/s",
          "default": 0.5
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "A"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "neg",
            "args": [
              {
                "op": "*",
                "args": [
                  "k",
                  "A"
                ]
              }
            ]
          }
        }
      ]
    }
  }
}
