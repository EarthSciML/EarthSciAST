{
  "esm": "1.3.0",
  "metadata": {
    "name": "SolverExternal_env_var",
    "description": "esm-spec §2.2.6 REFUSAL conformance fixture: a `solver.external` that needs an environment variable. The document is SCHEMA-VALID, so the rejection is the resolver's: every binding refuses it at load with `solver_external_unresolved`, and the message names `/solver/external` and quotes the string.",
    "authors": [
      "EarthSciML Test Suite"
    ],
    "license": "MIT",
    "tags": [
      "solver",
      "external",
      "conformance",
      "negative"
    ]
  },
  "solver": {
    "external": "${RUNS}/x.json"
  },
  "models": {
    "Decay": {
      "variables": {
        "A": {
          "type": "unknown",
          "units": "mol/m^3",
          "default": 2.0
        },
        "k": {
          "type": "parameter",
          "units": "1/s",
          "default": 0.5
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "A"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "neg",
            "args": [
              {
                "op": "*",
                "args": [
                  "k",
                  "A"
                ]
              }
            ]
          }
        }
      ]
    }
  }
}
