{
  "esm": "1.3.0",
  "metadata": {
    "name": "SolverExternal_mount_subsystem_leaf_env_var",
    "description": "A root whose `solver` block declares only `reltol`, mounting at the `subsystems.<k>` form a leaf whose `external` carries `${`. The leaf's block does not cross the mount (esm-spec §2.2.6 'Mounting', §4.7): the root loads, has no `external`, and emits exactly `{\"reltol\": 1e-06}`.",
    "authors": [
      "EarthSciML Test Suite"
    ],
    "license": "MIT",
    "tags": [
      "solver",
      "external",
      "conformance",
      "mount",
      "subsystem"
    ]
  },
  "solver": {
    "reltol": 1e-06
  },
  "models": {
    "Outer": {
      "variables": {
        "A": {
          "type": "unknown",
          "units": "mol/m^3",
          "default": 2.0
        },
        "k": {
          "type": "parameter",
          "units": "1/s",
          "default": 0.5
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "A"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "neg",
            "args": [
              {
                "op": "*",
                "args": [
                  "k",
                  "A"
                ]
              }
            ]
          }
        }
      ],
      "subsystems": {
        "Inner": {
          "ref": "./leaves/leaf_env_var.esm"
        }
      }
    }
  }
}
