{
  "esm": "1.3.0",
  "metadata": {
    "name": "SolverExternal_absolute_encoded",
    "description": "esm-spec §2.2.6 percent-encoding, pinned literally: an absolute `solver.external` holding a space, a `#`, a `%` and a non-ASCII name. The input is a path, not a URL, so `%` itself is encoded as `%25`, and the location is `file:///srv/runs/case%20%232%20100%25/caf%C3%A9.json`. The target does not exist on disk.",
    "authors": [
      "EarthSciML Test Suite"
    ],
    "license": "MIT",
    "tags": [
      "solver",
      "external",
      "conformance"
    ]
  },
  "solver": {
    "external": "/srv/runs/case #2 100%/café.json"
  },
  "models": {
    "Decay": {
      "variables": {
        "A": {
          "type": "unknown",
          "units": "mol/m^3",
          "default": 2.0
        },
        "k": {
          "type": "parameter",
          "units": "1/s",
          "default": 0.5
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "A"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "neg",
            "args": [
              {
                "op": "*",
                "args": [
                  "k",
                  "A"
                ]
              }
            ]
          }
        }
      ]
    }
  }
}
