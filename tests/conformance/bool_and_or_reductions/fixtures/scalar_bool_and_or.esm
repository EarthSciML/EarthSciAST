{
  "esm": "1.1.0",
  "metadata": {
    "name": "scalar_bool_and_or",
    "description": "Scalar (rank-0) bool_and_or reductions, which every numeric evaluator runs under every compiler (CONFORMANCE_SPEC 5.6.1): the result is 1 when some admitted term is non-zero and 0 otherwise, 0 being the empty reduction. `u` decays from five distinct values, so each predicate is true at t = 0 and false at t = 1: `any_hot` over one contracted index, `spread` over two with a filter excluding the diagonal, and `never` false throughout. `hot_count` integrates `any_hot`, so the reduction's value also reaches the dynamics.",
    "authors": [
      "EarthSciAST"
    ],
    "tags": [
      "faq",
      "semiring",
      "bool_and_or",
      "conformance-spec-5.6.1"
    ]
  },
  "index_sets": {
    "x": {
      "kind": "interval",
      "size": 5
    }
  },
  "models": {
    "scalar_bool_and_or": {
      "variables": {
        "u": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "x"
          ],
          "default": [
            0.5,
            1.5,
            0.25,
            2.0,
            1.0
          ],
          "description": "Five distinct values, each decaying at rate 0.1."
        },
        "any_hot": {
          "type": "unknown",
          "units": "1",
          "description": "1 while some u exceeds 1.9 (only u[4], until t = ln(2/1.9)/0.1, about 0.51)."
        },
        "spread": {
          "type": "unknown",
          "units": "1",
          "description": "1 while two distinct cells differ by more than 1.6 (2.0 - 0.25 = 1.75 at t = 0, 1.58 at t = 1)."
        },
        "never": {
          "type": "unknown",
          "units": "1",
          "description": "0 throughout: no u exceeds 100."
        },
        "hot_count": {
          "type": "unknown",
          "units": "1",
          "default": 0.0,
          "description": "Integrates any_hot + never."
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "faq",
            "args": [],
            "output_idx": [
              "i"
            ],
            "ranges": {
              "i": [
                1,
                5
              ]
            },
            "expr": {
              "op": "D",
              "args": [
                {
                  "op": "index",
                  "args": [
                    "u",
                    "i"
                  ]
                }
              ],
              "wrt": "t"
            }
          },
          "rhs": {
            "op": "faq",
            "args": [],
            "output_idx": [
              "i"
            ],
            "ranges": {
              "i": [
                1,
                5
              ]
            },
            "expr": {
              "op": "*",
              "args": [
                -0.1,
                {
                  "op": "index",
                  "args": [
                    "u",
                    "i"
                  ]
                }
              ]
            }
          }
        },
        {
          "lhs": "any_hot",
          "rhs": {
            "op": "faq",
            "args": [],
            "output_idx": [],
            "ranges": {
              "k": [
                1,
                5
              ]
            },
            "expr": {
              "op": ">",
              "args": [
                {
                  "op": "index",
                  "args": [
                    "u",
                    "k"
                  ]
                },
                1.9
              ]
            },
            "semiring": "bool_and_or"
          }
        },
        {
          "lhs": "spread",
          "rhs": {
            "op": "faq",
            "args": [],
            "output_idx": [],
            "ranges": {
              "k": [
                1,
                5
              ],
              "m": [
                1,
                5
              ]
            },
            "expr": {
              "op": ">",
              "args": [
                {
                  "op": "-",
                  "args": [
                    {
                      "op": "index",
                      "args": [
                        "u",
                        "k"
                      ]
                    },
                    {
                      "op": "index",
                      "args": [
                        "u",
                        "m"
                      ]
                    }
                  ]
                },
                1.6
              ]
            },
            "semiring": "bool_and_or",
            "filter": {
              "op": "!=",
              "args": [
                "k",
                "m"
              ]
            }
          }
        },
        {
          "lhs": "never",
          "rhs": {
            "op": "faq",
            "args": [],
            "output_idx": [],
            "ranges": {
              "k": [
                1,
                5
              ]
            },
            "expr": {
              "op": ">",
              "args": [
                {
                  "op": "index",
                  "args": [
                    "u",
                    "k"
                  ]
                },
                100.0
              ]
            },
            "semiring": "bool_and_or"
          }
        },
        {
          "lhs": {
            "op": "D",
            "args": [
              "hot_count"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "+",
            "args": [
              "any_hot",
              "never"
            ]
          }
        }
      ],
      "tolerance": {
        "rel": 1e-06,
        "abs": 1e-08
      },
      "tests": [
        {
          "id": "scalar_bool_and_or_t0",
          "description": "Each reduction at t = 0.",
          "time_span": {
            "start": 0.0,
            "end": 1.0
          },
          "assertions": [
            {
              "variable": "any_hot",
              "time": 0.0,
              "expected": 1.0
            },
            {
              "variable": "spread",
              "time": 0.0,
              "expected": 1.0
            },
            {
              "variable": "never",
              "time": 0.0,
              "expected": 0.0
            }
          ]
        },
        {
          "id": "scalar_bool_and_or_t1",
          "description": "Each reduction at t = 1, every predicate now false.",
          "time_span": {
            "start": 0.0,
            "end": 1.0
          },
          "assertions": [
            {
              "variable": "any_hot",
              "time": 1.0,
              "expected": 0.0
            },
            {
              "variable": "spread",
              "time": 1.0,
              "expected": 0.0
            },
            {
              "variable": "never",
              "time": 1.0,
              "expected": 0.0
            }
          ]
        }
      ]
    }
  }
}
