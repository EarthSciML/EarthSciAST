{
  "esm": "1.1.0",
  "metadata": {
    "name": "refuse_offset_subscript",
    "description": "A bare-index definition with a NON-IDENTITY subscript (`w_offset[k+1] ~ faq{k}(2*k)`). It names w_offset as its base, but it writes a shifted window rather than the whole array, so it is not the definition §6.3.1 runs. It MUST be refused with indexed_definition_unsupported_form (CONFORMANCE_SPEC §5.36.2)."
  },
  "index_sets": {
    "lev": {
      "kind": "interval",
      "size": 4
    }
  },
  "models": {
    "M": {
      "variables": {
        "u": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "lev"
          ]
        },
        "w_offset": {
          "type": "unknown",
          "units": "1/s",
          "shape": [
            "lev"
          ]
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "index",
            "args": [
              "w_offset",
              {
                "op": "+",
                "args": [
                  "k",
                  1
                ]
              }
            ]
          },
          "rhs": {
            "op": "faq",
            "args": [],
            "output_idx": [
              "k"
            ],
            "ranges": {
              "k": {
                "from": "lev"
              }
            },
            "expr": {
              "op": "*",
              "args": [
                2.0,
                "k"
              ]
            }
          }
        },
        {
          "lhs": {
            "op": "ic",
            "args": [
              "u"
            ]
          },
          "rhs": 0.0
        },
        {
          "lhs": {
            "op": "faq",
            "args": [],
            "output_idx": [
              "k"
            ],
            "ranges": {
              "k": {
                "from": "lev"
              }
            },
            "expr": {
              "op": "D",
              "args": [
                {
                  "op": "index",
                  "args": [
                    "u",
                    "k"
                  ]
                }
              ],
              "wrt": "t"
            }
          },
          "rhs": {
            "op": "faq",
            "args": [],
            "output_idx": [
              "k"
            ],
            "ranges": {
              "k": {
                "from": "lev"
              }
            },
            "expr": {
              "op": "index",
              "args": [
                "w_offset",
                "k"
              ]
            }
          }
        }
      ],
      "tests": [
        {
          "id": "refuse_offset_subscript",
          "description": "Every assertion must be REFUSED: no actual, not passed, the message carrying indexed_definition_unsupported_form and naming w_offset. Both expected values are what an inventing binding would plausibly answer, so only the outcome separates a refusal from a wrong number.",
          "time_span": {
            "start": 0.0,
            "end": 1.0
          },
          "assertions": [
            {
              "variable": "w_offset",
              "time": 1.0,
              "coords": {
                "lev": 3
              },
              "expected": 5.0,
              "tolerance": {
                "abs": 1e-09
              }
            },
            {
              "variable": "u",
              "time": 1.0,
              "coords": {
                "lev": 3
              },
              "expected": 5.0,
              "tolerance": {
                "abs": 1e-09
              }
            }
          ]
        }
      ]
    }
  }
}
