      "tests": [
        {
          "id": "observed_bare_index_lhs",
          "description": "The bare-index observeds are asserted DIRECTLY, alongside the states they drive. wb[k] = 2*k is [2, 4, 6, 8] at every time (max 8, mean 5). wbs[k] = 3*u[k] = 6*k*t: [6, 12, 18, 24] at t = 1 (max 24, mean 15) and [3, 6, 9, 12] at t = 0.5. wn[k] = 4*k has no declared shape and is read through z: z[k](t) = 4*k*t, so z = [4, 8, 12, 16] at t = 1 (z[3] = 12, mean 10). u[k](t) = 2*k*t, so u = [2, 4, 6, 8] at t = 1 (max 8, mean 5); v[k](t) = 3*k*t^2, so v = [3, 6, 9, 12] at t = 1 (mean 7.5).",
          "time_span": {
            "start": 0.0,
            "end": 1.0
          },
          "assertions": [
            {
              "variable": "wb",
              "time": 1.0,
              "coords": {
                "lev": 3
              },
              "expected": 6.0,
              "tolerance": {
                "abs": 1e-09
              }
            },
            {
              "variable": "wb",
              "time": 0.0,
              "reduce": "max",
              "expected": 8.0,
              "tolerance": {
                "abs": 1e-09
              }
            },
            {
              "variable": "wb",
              "time": 1.0,
              "reduce": "mean",
              "expected": 5.0,
              "tolerance": {
                "abs": 1e-09
              }
            },
            {
              "variable": "wbs",
              "time": 1.0,
              "coords": {
                "lev": 2
              },
              "expected": 12.0,
              "tolerance": {
                "abs": 1e-09
              }
            },
            {
              "variable": "wbs",
              "time": 1.0,
              "reduce": "max",
              "expected": 24.0,
              "tolerance": {
                "abs": 1e-09
              }
            },
            {
              "variable": "wbs",
              "time": 0.5,
              "coords": {
                "lev": 3
              },
              "expected": 9.0,
              "tolerance": {
                "abs": 1e-09
              }
            },
            {
              "variable": "z",
              "time": 1.0,
              "coords": {
                "lev": 3
              },
              "expected": 12.0,
              "tolerance": {
                "abs": 1e-09
