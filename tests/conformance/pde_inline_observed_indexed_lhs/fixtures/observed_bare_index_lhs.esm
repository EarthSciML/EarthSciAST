              "time": 1.0,
              "reduce": "mean",
              "expected": 10.0,
              "tolerance": {
                "abs": 1e-09
              }
            },
            {
              "variable": "u",
              "time": 1.0,
              "coords": {
                "lev": 1
              },
              "expected": 2.0,
              "tolerance": {
                "abs": 1e-09
              }
            },
            {
              "variable": "u",
              "time": 1.0,
              "reduce": "mean",
              "expected": 5.0,
