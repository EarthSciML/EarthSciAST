{
  "esm": "1.1.0",
  "metadata": {
    "name": "pde_inline_observed_bare_index_lhs",
    "description": "§6.3.1's BARE-INDEX spelling of the equation that defines an arrayed observed: `index(V, k) ~ faq{k}(…)`, with no `faq` shell on the left. The left side carries no binder for `k`; the right-hand `faq` does, and its `output_idx` names exactly the left side's subscripts in order, so the index range comes from the right-hand side (CONFORMANCE_SPEC §5.36.2). `wb` is STATE-FREE and `wbs` is STATE-DEPENDENT, the same controlled pair as the shelled fixture, with the same numbers: D(u) = wb = 2k gives u[k](t) = 2*k*t, and D(v) = wbs = 3*u gives v[k](t) = 3*k*t^2. `wn` declares NO `shape`: its right-hand `faq` is the only place its extent comes from, and it is asserted through the shaped state `z` it drives, D(z) = wn, so z[k](t) = 4*k*t."
  },
  "index_sets": {
    "lev": {
      "kind": "interval",
      "size": 4
    }
  },
  "models": {
    "M": {
      "variables": {
        "u": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "lev"
          ],
          "description": "state driven by the STATE-FREE bare-index observed; u[k](t) = 2*k*t"
        },
        "v": {
          "type": "unknown",
          "units": "s",
          "shape": [
            "lev"
          ],
          "description": "state driven by the STATE-DEPENDENT bare-index observed; v[k](t) = 3*k*t^2"
        },
        "wb": {
          "type": "unknown",
          "units": "1/s",
          "shape": [
            "lev"
          ],
          "description": "state-free array observed, BARE-INDEX LHS: wb[k] = 2*k"
        },
        "wbs": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "lev"
          ],
          "description": "state-dependent array observed, BARE-INDEX LHS: wbs[k] = 3*u[k]"
        },
        "wn": {
          "type": "unknown",
          "units": "1",
          "description": "UNSHAPED array observed, BARE-INDEX LHS: wn[k] = 4*k; its extent comes only from the right-hand faq. Asserted through the state z it drives."
        },
        "z": {
          "type": "unknown",
          "units": "s",
          "shape": [
            "lev"
          ],
          "description": "state driven by the UNSHAPED bare-index observed; z[k](t) = 4*k*t"
        }
      },
