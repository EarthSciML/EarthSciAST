{
 "category": "ic_system",
 "version": "1.0",
 "description": "Generalized `ic` equations and the initialization system (esm 2.5.0; esm-spec 11.4.2-11.4.4, API_SPEC 5.8; issue #817). `ic(v)` is v's value at t0 anywhere in an equation; an explicit initial condition `ic(u) ~ e` (e mentions no ic) is evaluated directly; every other initialization equation is an equation of one system. Every simulating binding solves a triangular system by substitution in dependency order, refuses a truly implicit one with unsupported_construct, or hands it to the caller under strip class `initialization`. A supplied value (u0, run-time override) of an ODE state is a known of the system; one of an algebraic unknown is a starting guess. The loader rewrites a deprecated `initialization_equations` block into ic equations (or into guesses for a model with no time derivative) and warns deprecated_field. Expected values are the documents' own formulas in binary64.",
 "spec": [
  "esm-spec.md 11.4.2 (item 8: starting values in the start-of-run scope)",
  "esm-spec.md 11.4.3 (the initialization system, balance, precedence, triangular systems)",
  "esm-spec.md 11.4.4 (migration from initialization_equations)",
  "API_SPEC.md 5.8 (initial_state; strip class `initialization`)"
 ],
 "bindings_required": [
  "julia",
  "python",
  "rust"
 ],
 "compilers": {
  "julia": [
   "native",
   "interpreter"
  ],
  "rust": [
   "native"
  ],
  "python": [
   "default"
  ]
 },
 "scope_excluded": {
  "typescript": "No simulator (API_SPEC 3); loads are checked by its own loader tests.",
  "go": "No simulator (API_SPEC 3); loads are checked by its own loader tests."
 },
 "checks": {
  "expected": "the Problem built from the case's tspan, p, u0 and strip starts from `expected`, every state element by flattened name, and the map covers the whole state",
  "error_code": "building the Problem raises an error whose text carries `error_code`",
  "stripped": "with `strip`, the members named here of the stripped object (canonical JSON, parsed) equal the ones given; numbers compare by value",
  "solved": "a binding with a nonlinear initialization solve (Julia compiler = mtk) starts from these values instead of refusing",
  "not_solvable": "solve on the stripped Problem raises stripped_problem_not_solvable"
 },
 "tolerances": {
  "rtol": 1e-14,
  "atol": 1e-14
 },
