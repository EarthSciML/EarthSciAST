{
  "esm": "2.5.0",
  "metadata": {
    "name": "ic_element_equation",
    "description": "esm-spec 11.4.3: ic(u) ~ faq(i in [1,2]: i) sets cells 1 and 2 of u; cell 3 is an unknown of the system. index(ic(u), 3) ~ 7 reads one element and is not in solved form, so a binding without a solver refuses it with unsupported_construct, or strips it (u[3] then starts from 0: no guess, no default). validate reports nothing: a partial explicit ic removes no cell from the count.",
    "authors": [
      "EarthSciAST conformance"
    ],
    "tags": [
      "conformance",
      "esm-spec-11.4.3",
      "ic"
    ]
  },
