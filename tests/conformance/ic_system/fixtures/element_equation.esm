              "i"
            ],
            "ranges": {
              "i": [
                1,
                2
              ]
            },
            "expr": {
              "op": "*",
              "args": [
                1.0,
                "i"
              ]
            }
          }
        },
        {
          "lhs": {
            "op": "index",
            "args": [
              {
                "op": "ic",
                "args": [
                  "u"
                ]
              },
              3
