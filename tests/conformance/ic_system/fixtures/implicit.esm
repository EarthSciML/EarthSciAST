{
  "esm": "2.5.0",
  "metadata": {
    "name": "ic_implicit",
    "description": "esm-spec 11.4.3: a truly implicit initialization system, two equations solved simultaneously for ic(x) and ic(y). A binding without a nonlinear solver refuses it with unsupported_construct, or hands it to the caller under strip class `initialization` (API_SPEC 5.8). The explicit ic(w) ~ 7 is still evaluated. x and y have no default (a default would be a known starting value, 11.4.3 'Declared defaults'); they start from their guesses 1.5 and 0.25. A solve gives x = 6, y = 4.",
    "authors": [
      "EarthSciAST conformance"
    ],
    "tags": [
      "conformance",
      "esm-spec-11.4.3",
      "ic"
    ]
  },
  "models": {
    "M": {
      "variables": {
        "total": {
          "type": "parameter",
          "units": "1",
          "default": 10.0,
          "description": "x + y at the start"
        },
        "diff": {
          "type": "parameter",
          "units": "1",
          "default": 2.0,
          "description": "x - y at the start"
        },
        "x": {
          "type": "unknown",
          "units": "1",
          "description": "unknown of the implicit system; guess 1.5"
        },
        "y": {
          "type": "unknown",
          "units": "1",
          "description": "unknown of the implicit system; default 0.25"
        },
        "w": {
          "type": "unknown",
          "units": "1",
          "default": 100.0,
          "description": "explicit: ic(w) ~ 7"
        }
      },
      "guesses": {
        "x": 1.5,
        "y": 0.25
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "x"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "-",
            "args": [
              "x"
            ]
          }
        },
        {
          "lhs": {
            "op": "D",
            "args": [
              "y"
            ],
            "wrt": "t"
          },
          "rhs": 0.0
        },
        {
          "lhs": {
            "op": "D",
            "args": [
              "w"
            ],
            "wrt": "t"
          },
          "rhs": 0.0
        },
        {
          "lhs": {
            "op": "+",
            "args": [
              {
                "op": "ic",
                "args": [
                  "x"
                ]
              },
              {
                "op": "ic",
                "args": [
                  "y"
                ]
              }
            ]
          },
          "rhs": "total"
        },
        {
          "lhs": {
            "op": "-",
            "args": [
              {
                "op": "ic",
                "args": [
                  "x"
                ]
              },
              {
                "op": "ic",
                "args": [
                  "y"
                ]
              }
            ]
          },
          "rhs": "diff"
        },
        {
          "lhs": {
            "op": "ic",
            "args": [
              "w"
            ]
          },
          "rhs": 7.0
        }
      ]
    }
  }
}
