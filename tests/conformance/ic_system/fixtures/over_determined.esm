{
  "esm": "2.5.0",
  "metadata": {
    "name": "ic_over_determined",
    "description": "esm-spec 11.4.3 'Balance', 'What validate reports': ic(x) is set by an explicit initial condition, and the equation 2*ic(x) ~ total mentions no other starting value, so the system has one equation and no unknown. Both validate and the build report ic_system_unbalanced.",
    "authors": [
      "EarthSciAST conformance"
    ],
    "tags": [
      "conformance",
      "esm-spec-11.4.3",
      "ic"
    ]
  },
  "models": {
    "M": {
      "variables": {
        "total": {
          "type": "parameter",
          "units": "1",
          "default": 10.0,
          "description": "twice x at the start"
        },
        "x": {
          "type": "unknown",
          "units": "1",
          "default": 100.0,
          "description": "explicit: ic(x) ~ 1"
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "x"
            ],
            "wrt": "t"
          },
          "rhs": 0.0
        },
        {
          "lhs": {
            "op": "ic",
            "args": [
              "x"
            ]
          },
          "rhs": 1.0
        },
        {
          "lhs": {
            "op": "*",
            "args": [
              2.0,
              {
                "op": "ic",
                "args": [
                  "x"
                ]
              }
            ]
          },
          "rhs": "total"
        }
      ]
    }
  }
}
