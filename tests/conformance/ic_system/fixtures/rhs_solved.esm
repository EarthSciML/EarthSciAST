{
  "esm": "2.5.0",
  "metadata": {
    "name": "ic_rhs_solved",
    "description": "esm-spec 11.4.3: `e ~ ic(u)` is solved form exactly like `ic(u) ~ e` when e reads no ic(u). 3 ~ ic(x) is an explicit initial condition; ic(x) + 1 ~ ic(z) is a triangular equation for z.",
    "authors": [
      "EarthSciAST conformance"
    ],
    "tags": [
      "conformance",
      "esm-spec-11.4.3",
      "ic"
    ]
  },
