      "variables": {
        "x": {
          "type": "unknown",
          "units": "1",
          "default": 100.0,
          "description": "explicit, right-hand side form: 3 ~ ic(x)"
        },
        "z": {
          "type": "unknown",
          "units": "1",
          "default": 100.0,
          "description": "triangular, right-hand side form: ic(x) + 1 ~ ic(z)"
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "x"
            ],
            "wrt": "t"
          },
          "rhs": 0.0
        },
        {
          "lhs": {
            "op": "D",
            "args": [
              "z"
            ],
            "wrt": "t"
          },
          "rhs": 0.0
        },
        {
          "lhs": {
            "op": "+",
            "args": [
              {
                "op": "ic",
                "args": [
                  "x"
                ]
              },
              1.0
            ]
          },
          "rhs": {
            "op": "ic",
            "args": [
              "z"
            ]
          }
        },
        {
          "lhs": 3.0,
          "rhs": {
            "op": "ic",
            "args": [
              "x"
            ]
          }
        }
      ]
    }
  }
