{
  "esm": "2.5.0",
  "metadata": {
    "name": "ic_default_tendency",
    "description": "esm-spec 11.4.3 'Declared defaults': x's default 2 is its known starting value, so ic(z) ~ ic(D(x)) gives z = -3 * 2. z's default yields to the solved-form equation.",
    "authors": [
      "EarthSciAST conformance"
    ],
    "tags": [
      "conformance",
      "esm-spec-11.4.3",
      "ic"
    ]
  },
  "models": {
    "M": {
      "variables": {
        "x": {
          "type": "unknown",
          "units": "1",
          "default": 2.0
        },
        "z": {
          "type": "unknown",
          "units": "1",
          "default": 100.0
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "x"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "*",
            "args": [
              -3.0,
              "x"
            ]
          }
        },
        {
          "lhs": {
            "op": "D",
            "args": [
              "z"
            ],
            "wrt": "t"
          },
          "rhs": 0.0
        },
        {
          "lhs": {
            "op": "ic",
            "args": [
              "z"
            ]
          },
          "rhs": {
            "op": "ic",
            "args": [
              {
                "op": "D",
                "args": [
                  "x"
                ],
                "wrt": "t"
              }
            ]
          }
        }
      ]
    }
  }
}
