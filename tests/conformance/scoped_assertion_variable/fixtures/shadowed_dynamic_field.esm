{
 "esm": "1.1.0",
 "metadata": {
  "name": "scoped_assertion_shadowed_dynamic_field",
  "description": "Two components answer to `Leaf`, and only the WRONG one's field is a build-time constant. The top-level `Leaf` carries `key = [7, 9, 4]`, which the build materializes; `Host`'s own subsystem `Leaf` carries `key[k] = s * k` with `s` held at 5, which depends on state and so is not a build product. A runner that answers `Leaf.key` from whatever materialized field is spelled closest reports 9 and 7 - the top-level component's column - for an assertion whose owner is the subsystem, which `w = 3 * Leaf.s` reads. A scoped name may only be read under a spelling its OWNER holds.",
  "authors": [
   "EarthSciML Authors and Contributors"
  ]
 },
 "index_sets": {
  "leaf_axis": {
   "kind": "interval",
   "size": 3
  }
 },
 "models": {
  "Leaf": {
   "variables": {
    "u": {
     "type": "unknown",
     "units": "1",
     "default": 1.0,
     "description": "Decaying state, so the top-level component is integrated too."
    },
    "key": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "leaf_axis"
     ],
     "description": "The constant column [7, 9, 4]: a build-time product, and distinct from the subsystem's at every cell."
    }
   },
   "equations": [
    {
     "lhs": {
      "op": "D",
      "args": [
       "u"
      ],
      "wrt": "t"
     },
     "rhs": {
      "op": "*",
      "args": [
       -1.0,
       "u"
      ]
     }
    },
    {
     "lhs": "key",
     "rhs": {
      "op": "const",
      "args": [],
      "value": [
       7,
       9,
       4
      ]
     }
    }
   ]
  },
  "Host": {
   "variables": {
    "w": {
     "type": "unknown",
     "units": "1",
     "description": "3 * Leaf.s, bound to the SUBSYSTEM's state s = 5."
    }
   },
   "equations": [
    {
     "lhs": "w",
     "rhs": {
      "op": "*",
      "args": [
       3.0,
       "Leaf.s"
      ]
     }
    }
   ],
   "subsystems": {
    "Leaf": {
     "variables": {
      "s": {
       "type": "unknown",
       "units": "1",
       "default": 5.0,
       "description": "Held constant at 5."
      },
      "key": {
       "type": "unknown",
       "units": "1",
       "shape": [
        "leaf_axis"
       ],
       "description": "s * k over the axis, so [5, 10, 15]: STATE-DEPENDENT, and therefore not a field the build materializes."
      }
     },
     "equations": [
      {
       "lhs": {
        "op": "D",
        "args": [
         "s"
        ],
        "wrt": "t"
       },
       "rhs": 0.0
      },
      {
       "lhs": {
        "op": "index",
        "args": [
         "key",
         "k"
        ]
       },
       "rhs": {
        "op": "faq",
        "args": [],
        "output_idx": [
         "k"
        ],
        "ranges": {
         "k": {
          "from": "leaf_axis"
         }
        },
        "expr": {
         "op": "*",
         "args": [
          "s",
          "k"
         ]
        }
       }
      }
     ]
    }
   },
   "tests": [
    {
     "id": "a_scoped_field_is_never_read_from_another_component",
     "description": "The subsystem's column is [5, 10, 15]. The top-level leaf's is [7, 9, 4], which is what a runner reading the closest materialized field reports (9 for the max, 7 for cell 1).",
     "time_span": {
      "start": 0.0,
      "end": 1.0
     },
     "tolerance": {
      "rel": 0.0001
     },
     "assertions": [
      {
       "variable": "w",
       "time": 1.0,
       "expected": 15.0
      },
      {
       "variable": "Leaf.key",
       "time": 1.0,
       "expected": 15.0,
       "reduce": "max"
      },
      {
       "variable": "Leaf.key",
       "time": 1.0,
       "expected": 5.0,
       "coords": {
        "leaf_axis": 1
       }
      }
     ]
    }
   ]
  }
 }
}
