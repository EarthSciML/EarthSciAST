{
  "esm": "1.0.0",
  "metadata": {
    "name": "scoped_assertion_deep_mount",
    "description": "A THREE-level mount chain: `Host` mounts `Mid`, which mounts the leaf. `Mid.Leaf.u` asserted in `Host` is component-relative at its head (`Mid` is a subsystem of `Host`) and walks one level further, so it denotes `Host.Mid.Leaf.u` - exactly what it denotes in `Host`'s equation. The two-level fixtures cannot see a runner that strips only ONE level of the owner path from the name the build keyed the row by.",
    "authors": [
      "EarthSciML Authors and Contributors"
    ]
  },
  "index_sets": {
    "leaf_axis": {
      "kind": "interval",
      "size": 3
    }
  },
  "models": {
    "Host": {
      "variables": {
        "w": {
          "type": "unknown",
          "units": "1",
          "description": "The control: the same scoped name as an equation OPERAND."
        }
      },
      "equations": [
        {
          "lhs": "w",
          "rhs": {
            "op": "*",
            "args": [
              3.0,
              "Mid.Leaf.u"
            ]
          }
        }
      ],
      "tests": [
        {
          "id": "asserts_a_leaf_two_mounts_down_by_scoped_name",
          "description": "Assertion 1 is the control (an operand); 2-5 read the leaf two mount levels down through `Mid.Leaf.<name>`.",
          "time_span": {
            "start": 0.0,
            "end": 1.0
          },
          "tolerance": {
            "rel": 0.0001
          },
          "assertions": [
            {
              "variable": "w",
              "time": 1.0,
              "expected": 1.103638323514327
            },
            {
              "variable": "Mid.Leaf.u",
              "time": 1.0,
              "expected": 0.36787944117144233
            },
            {
              "variable": "Mid.Leaf.v",
              "time": 1.0,
              "expected": 0.7357588823428847
            },
            {
              "variable": "Mid.Leaf.key",
              "time": 1.0,
              "expected": 7.0,
              "coords": {
                "leaf_axis": 1
              }
            },
            {
              "variable": "Mid.Leaf.key",
              "time": 1.0,
              "expected": 9.0,
              "reduce": "max"
            }
          ]
        }
      ],
      "subsystems": {
        "Mid": {
          "variables": {},
          "equations": [],
          "subsystems": {
            "Leaf": {
              "ref": "./leaf.esm"
            }
          }
        }
      }
    }
  }
}
