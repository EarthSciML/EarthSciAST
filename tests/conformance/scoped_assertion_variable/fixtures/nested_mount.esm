{
  "esm": "1.0.0",
  "metadata": {
    "name": "scoped_assertion_nested_mount",
    "description": "`Host` asserts the variables of its own `subsystems` mount. `Leaf.u` is a component-relative scoped reference: its head names a subsystem of `Host`, so it denotes `Host.Leaf.u`, exactly as it does in `Host`'s equation.",
    "authors": [
      "EarthSciML Authors and Contributors"
    ]
  },
  "index_sets": {
    "leaf_axis": {
      "kind": "interval",
      "size": 3
    }
  },
  "models": {
    "Host": {
      "variables": {
        "w": {
          "type": "unknown",
          "units": "1",
          "description": "The control: the same scoped name as an equation OPERAND, which already resolved before this fixture existed."
        }
      },
      "equations": [
        {
          "lhs": "w",
          "rhs": {
            "op": "*",
            "args": [
              3.0,
              "Leaf.u"
            ]
          }
        }
      ],
      "tests": [
        {
          "id": "asserts_the_mounted_leaf_by_scoped_name",
          "description": "Assertion 1 is the control (an operand); 2-5 read the leaf through `Leaf.<name>`, the scoped reference the Assertion schema documents. The leaf is `Host`'s own subsystem.",
          "time_span": {
            "start": 0.0,
            "end": 1.0
          },
          "tolerance": {
            "rel": 0.0001
          },
          "assertions": [
            {
              "variable": "w",
              "time": 1.0,
              "expected": 1.103638323514327
            },
            {
              "variable": "Leaf.u",
              "time": 1.0,
              "expected": 0.36787944117144233
            },
            {
              "variable": "Leaf.v",
              "time": 1.0,
              "expected": 0.7357588823428847
            },
            {
              "variable": "Leaf.key",
              "time": 1.0,
              "expected": 7.0,
              "coords": {
                "leaf_axis": 1
              }
            },
            {
              "variable": "Leaf.key",
              "time": 1.0,
              "expected": 9.0,
              "reduce": "max"
            }
          ]
        }
      ],
      "subsystems": {
        "Leaf": {
          "ref": "./leaf.esm"
        }
      }
    }
  }
}
