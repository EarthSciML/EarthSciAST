{
  "esm": "1.0.0",
  "metadata": {
    "name": "scalar_ic",
    "description": "esm-spec 11.4: a 0-D component's `ic` RHS is a scalar, and every state SHOULD have exactly one `ic` equation (a missing one falls back to the declared `default`). Every state here declares a `default` that DIFFERS from its `ic`, so a binding that drops the `ic` equation and seeds from the default is caught rather than masked. The three RHS forms are separated: `u` a plain literal, `q` a literal ARITHMETIC expression, `w` a PARAMETER-referencing expression (the 6.6.5 build-time evaluation scope). `y` is the non-vacuity anchor -- it carries no interesting ic of its own but integrates D(y)/dt = u, so the seeded value of `u` reaches y(1) through the dynamics and a dropped ic cannot hide in u0 alone. `z` declares NO ic at all and pins the default fallback.",
    "authors": [
      "EarthSciAST"
    ],
    "tags": [
      "inline-test",
      "esm-spec-11.4",
      "esm-spec-6.6",
      "esm-spec-6.6.5",
      "scalar-ic",
      "zero-dimensional",
      "initial-conditions"
    ]
  },
  "models": {
    "M": {
      "variables": {
        "A": {
          "type": "parameter",
          "units": "1",
          "default": 2.0,
          "description": "Referenced ONLY by ic(w) -- never by an equation -- so an override moves the answer through the build-time ic scope and nowhere else."
        },
        "u": {
          "type": "unknown",
          "units": "1",
          "default": 0.0,
          "description": "ic(u) = 3.0, a plain literal. `default` is 0.0 so a dropped ic reads 0."
        },
        "q": {
          "type": "unknown",
          "units": "1",
          "default": 0.0,
          "description": "ic(q) = 1.5 + 2*0.25, a literal arithmetic expression that must const-fold to 2.0."
        },
        "w": {
          "type": "unknown",
          "units": "1",
          "default": 0.0,
          "description": "ic(w) = 2*A, a parameter-referencing expression (esm-spec 6.6.5)."
        },
        "y": {
          "type": "unknown",
          "units": "1",
          "default": 0.0,
          "description": "Non-vacuity anchor: ic(y) = 0.0 and D(y)/dt = u, so y(1) equals u's seeded value exactly."
        },
        "z": {
          "type": "unknown",
          "units": "1",
          "default": 7.0,
          "description": "NO ic equation: pins the declared-default fallback of esm-spec 11.4."
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "u"
            ],
            "wrt": "t"
          },
          "rhs": 0.0
        },
        {
          "lhs": {
            "op": "D",
            "args": [
              "q"
            ],
            "wrt": "t"
          },
          "rhs": 0.0
        },
        {
          "lhs": {
            "op": "D",
            "args": [
              "w"
            ],
            "wrt": "t"
          },
          "rhs": 0.0
        },
        {
          "lhs": {
            "op": "D",
            "args": [
              "y"
            ],
            "wrt": "t"
          },
          "rhs": "u"
        },
        {
          "lhs": {
            "op": "D",
            "args": [
              "z"
            ],
            "wrt": "t"
          },
          "rhs": 0.0
        },
        {
          "lhs": {
            "op": "ic",
            "args": [
              "u"
            ]
          },
          "rhs": 3.0
        },
        {
          "lhs": {
            "op": "ic",
            "args": [
              "q"
            ]
          },
          "rhs": {
            "op": "+",
            "args": [
              1.5,
              {
                "op": "*",
                "args": [
                  2,
                  0.25
                ]
              }
            ]
          }
        },
        {
          "lhs": {
            "op": "ic",
            "args": [
              "w"
            ]
          },
          "rhs": {
            "op": "*",
            "args": [
              2.0,
              "A"
            ]
          }
        },
        {
          "lhs": {
            "op": "ic",
            "args": [
              "y"
            ]
          },
          "rhs": 0.0
        }
      ],
      "tolerance": {
        "rel": 1e-09,
        "abs": 1e-11
      },
      "tests": [
        {
          "id": "scalar_ic_defaults",
          "description": "No overrides. Each state is seeded by its own `ic` (u=3, q=2, w=2A=4) except `z`, which has none and falls back to its declared default 7. y(1)=3 proves the seeded u reached the integrator, not just the reported u0.",
          "time_span": {
            "start": 0.0,
            "end": 1.0
          },
          "assertions": [
            {
              "variable": "u",
              "time": 0.0,
              "expected": 3.0
            },
            {
              "variable": "q",
              "time": 0.0,
              "expected": 2.0
            },
            {
              "variable": "w",
              "time": 0.0,
              "expected": 4.0
            },
            {
              "variable": "z",
              "time": 0.0,
              "expected": 7.0
            },
            {
              "variable": "y",
              "time": 0.0,
              "expected": 0.0
            },
            {
              "variable": "y",
              "time": 1.0,
              "expected": 3.0
            }
          ]
        },
        {
          "id": "scalar_ic_parameter_override",
          "description": "parameter_overrides {A: 10} must reach the build-time scope of the SCALAR ic (esm-spec 6.6.5), keyed by LOCAL parameter name (6.6): w(0) = 2*10 = 20. u and y are parameter-free and must not move.",
          "parameter_overrides": {
            "A": 10.0
          },
          "time_span": {
            "start": 0.0,
            "end": 1.0
          },
          "assertions": [
            {
              "variable": "w",
              "time": 0.0,
              "expected": 20.0
            },
            {
              "variable": "u",
              "time": 0.0,
              "expected": 3.0
            },
            {
              "variable": "y",
              "time": 1.0,
              "expected": 3.0
            }
          ]
        },
        {
          "id": "scalar_ic_run_override",
          "description": "esm-spec 11.4 'Run-time overrides': a test's `initial_conditions` overrides the `ic` equation's value for that run. u(0) = 9 (not the ic's 3), and y(1) = 9 carries it through the dynamics; w keeps its ic-seeded 4.",
          "initial_conditions": {
            "u": 9.0
          },
          "time_span": {
            "start": 0.0,
            "end": 1.0
          },
          "assertions": [
            {
              "variable": "u",
              "time": 0.0,
              "expected": 9.0
            },
            {
              "variable": "y",
              "time": 1.0,
              "expected": 9.0
            },
            {
              "variable": "w",
              "time": 0.0,
              "expected": 4.0
            }
          ]
        }
      ]
    }
  }
}
