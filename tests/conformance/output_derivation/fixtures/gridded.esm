{
  "esm": "1.0.0",
  "metadata": {
    "name": "OutputDerivationGridded",
    "description": "Output-derivation conformance fixture: a single gridded model over a rectilinear [lon, lat] grid, with the additive `coordinates` registry (streaming-output-sinks RFC §8.3) keyed BY THE DIMENSION NAMES so both entries resolve to CF dimension coordinates with values + standard_name/units/axis. Exercises the whole §7–§9 chain on one grid: the column-major `name[i,j]` cell-key inversion, the rename of positional `<base>_d0` axes to the declared `index_sets` names, per-variable CF attribute retention, dimension-coordinate planning, and the record-axis-first on-disk dimension order.",
    "authors": [
      "EarthSciML Test Suite"
    ],
    "created": "2026-08-11T00:00:00Z",
    "tags": [
      "conformance",
      "output-derivation",
      "streaming-output",
      "gridded",
      "cf-conventions"
    ]
  },
  "domain": {
    "independent_variable": "time"
  },
  "index_sets": {
    "lon": {
      "kind": "interval",
      "size": 3
    },
    "lat": {
      "kind": "interval",
      "size": 2
    }
  },
  "coordinates": {
    "lon": {
      "values": [-100.0, -99.0, -98.0],
      "standard_name": "longitude",
      "units": "degrees_east",
      "axis": "X"
    },
    "lat": {
      "values": [30.0, 31.0],
      "standard_name": "latitude",
      "units": "degrees_north",
      "axis": "Y"
    }
  },
  "models": {
    "Grid": {
      "reference": {
        "notes": "Two tracers on the SAME [lon, lat] grid, so they must land in ONE emergent grid — grids are clustered by spatial-dim signature, never declared."
      },
      "variables": {
        "c": {
          "type": "unknown",
          "units": "kg/kg",
          "shape": ["lon", "lat"],
          "default": 0.0,
          "description": "Gridded tracer."
        },
        "w": {
          "type": "unknown",
          "units": "m/s",
          "shape": ["lon", "lat"],
          "default": 0.0
        }
      },
      "equations": [
        {
          "lhs": { "op": "D", "args": ["c"], "wrt": "t" },
          "rhs": { "op": "*", "args": [-0.001, "c"] }
        },
        {
          "lhs": { "op": "D", "args": ["w"], "wrt": "t" },
          "rhs": { "op": "*", "args": [-0.002, "w"] }
        }
      ]
    }
  }
}
