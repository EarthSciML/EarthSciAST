{
  "esm": "0.9.0",
  "metadata": {
    "name": "OutputDerivationScalar0D",
    "description": "Output-derivation conformance fixture: a purely 0-D model. Every state variable is a bare scalar, so the flat state's element names carry NO `[...]` cell suffix at all. This is the case that exposed the Julia/Rust divergence recorded in streaming-output-sinks RFC §16.12: a scalar must be genuinely 0-spatial-dimensional (shape `[]`, on-disk dims exactly `[time]`), so ALL scalars share ONE emergent grid. Giving each scalar a synthetic `<base>_d0` singleton axis instead would make every scalar its own single-member grid — a 66-state 0-D model would emit 66 length-1 dimensions named after their own variables and 66 separate stores. The observed variable `flux` is here so the RFC decision-8 gate (output is the state PLUS a caller-named subset of observed fields) is exercised on the same document.",
    "authors": [
      "EarthSciML Test Suite"
    ],
    "created": "2026-08-11T00:00:00Z",
    "tags": [
      "conformance",
      "output-derivation",
      "streaming-output",
      "scalar",
      "zero-dimensional"
    ]
  },
  "domain": {
    "independent_variable": "time"
  },
  "models": {
    "Box": {
      "reference": {
        "notes": "A three-state well-mixed box. No index_sets, no shapes, no grid — the common case for the 0-D models this derivation mostly runs."
      },
      "variables": {
        "T": {
          "type": "state",
          "units": "K",
          "default": 288.0,
          "description": "Box temperature."
        },
        "C": {
          "type": "state",
          "units": "kg",
          "default": 1.0,
          "description": "Box tracer mass."
        },
        "E": {
          "type": "state",
          "units": "J",
          "default": 0.0
        },
        "k": {
          "type": "parameter",
          "units": "1/s",
          "default": 0.5
        },
        "flux": {
          "type": "observed",
          "units": "kg/s",
          "description": "Derived loss rate; written only when the caller names it.",
          "expression": { "op": "*", "args": ["k", "C"] }
        }
      },
      "equations": [
        {
          "lhs": { "op": "D", "args": ["T"], "wrt": "t" },
          "rhs": { "op": "*", "args": [-0.01, "T"] }
        },
        {
          "lhs": { "op": "D", "args": ["C"], "wrt": "t" },
          "rhs": { "op": "-", "args": ["flux"] }
        },
        {
          "lhs": { "op": "D", "args": ["E"], "wrt": "t" },
          "rhs": { "op": "*", "args": [1.0, "flux"] }
        }
      ]
    }
  }
}
