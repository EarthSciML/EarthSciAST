        },
        {
          "lhs": "tig_next",
          "rhs": {
            "op": "faq",
            "args": [],
            "output_idx": [
              "i"
            ],
            "ranges": {
              "i": {
                "from": "x"
              }
            },
            "expr": {
              "op": "ifelse",
              "args": [
                {
                  "op": "<=",
                  "args": [
                    {
                      "op": "index",
                      "args": [
                        "psi",
                        "i"
                      ]
                    },
                    0.0
                  ]
                },
                {
                  "op": "min",
                  "args": [
                    {
                      "op": "index",
