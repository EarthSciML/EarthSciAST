            "args": [],
            "output_idx": [
              "i"
            ],
            "ranges": {
              "i": {
                "from": "x"
              }
            },
            "expr": {
              "op": "/",
              "args": [
                "dx",
                {
                  "op": "abs",
                  "args": [
                    {
                      "op": "index",
