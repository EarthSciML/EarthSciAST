{
  "esm": "1.1.0",
  "metadata": {
    "name": "PostValue",
    "description": "The swap event with its first affect reading `b` BARE. `b` is assigned by the same event, so the bare read names its post-event value and the affect is an implicit system: compiling it as a kernel MUST be refused with `affect_reads_post_value`. CONFORMANCE_SPEC \u00a75.57.",
    "authors": [
      "EarthSciML Authors and Contributors"
    ],
    "tags": [
      "conformance",
      "strip_and_expose",
      "events",
      "kernels"
    ]
  },
  "models": {
    "PostValue": {
      "variables": {
        "a": {
          "type": "unknown",
          "units": "1",
          "default": 0.0,
          "description": "Climbs at rate 1."
        },
        "b": {
          "type": "unknown",
          "units": "1",
          "default": 2.0,
          "description": "Falls at rate 1."
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "a"
            ],
            "wrt": "t"
          },
          "rhs": 1.0
        },
        {
          "lhs": {
            "op": "D",
            "args": [
              "b"
            ],
            "wrt": "t"
          },
          "rhs": -1.0
        }
      ],
      "discrete_events": [
        {
          "name": "swap",
          "trigger": {
            "type": "condition",
            "expression": {
              "op": ">",
              "args": [
                "a",
                "b"
              ]
            }
          },
          "affects": [
            {
              "lhs": "a",
              "rhs": "b"
            },
            {
              "lhs": "b",
              "rhs": {
                "op": "Pre",
                "args": [
                  "a"
                ]
              }
            }
          ],
          "description": "Exchange a and b at the end of a step where a > b."
        }
      ]
    }
  }
}
