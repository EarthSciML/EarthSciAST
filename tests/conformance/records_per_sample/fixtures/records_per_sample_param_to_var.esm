{
  "esm": "1.3.0",
  "metadata": {
    "name": "RecordsPerSampleParamToVar",
    "description": "A scalar data-fed parameter with records_per_sample 2, mapped by param_to_var onto a parameter shaped [rec, x], rec of size 2: its record shape is the target's (esm-spec 8.5.1 rule 3), so the document is valid. This is reseact's GEOSFP.PBLH -> Transport3D.F_PBLH."
  },
  "index_sets": {
    "rec": {
      "kind": "interval",
      "size": 2
    },
    "x": {
      "kind": "interval",
      "size": 4
    }
  },
  "data_sources": {
    "met_source": {
      "kind": "grid",
      "source": {
        "url_template": "file:///data/met/met_{date:%Y%m%d}.nc"
      },
      "temporal": {
        "start": "2024-05-01T00:00:00Z",
        "frequency": "PT1H",
        "file_period": "P1D",
        "records_per_file": 24
      },
      "metadata": {
        "esio_format": "netcdf"
      }
    }
  },
  "models": {
    "Met": {
      "variables": {
        "K": {
          "type": "parameter",
          "units": "1/s",
          "shape": [],
          "default": 0.1,
          "description": "Declared once, as a scalar; the consumer gives it the record axis and the grid.",
          "update": {
            "kind": "data",
            "source": "met_source",
            "from": {
              "file_variable": "K",
              "records_per_sample": 2
            }
          }
        }
      },
      "equations": []
    },
    "Box": {
      "variables": {
        "c": {
          "type": "unknown",
          "units": "1",
          "default": 1.0
        },
        "F_k": {
          "type": "parameter",
          "units": "1/s",
          "shape": [
            "rec",
            "x"
          ],
          "default": 0.1,
          "description": "Replaced by Met.K."
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "c"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "*",
            "args": [
              {
                "op": "-",
                "args": [
                  {
                    "op": "index",
                    "args": [
                      "F_k",
                      1,
                      1
                    ]
                  }
                ]
              },
              "c"
            ]
          }
        }
      ]
    }
  },
  "coupling": [
    {
      "type": "variable_map",
      "from": "Met.K",
      "to": "Box.F_k",
      "transform": "param_to_var"
    }
  ]
}
