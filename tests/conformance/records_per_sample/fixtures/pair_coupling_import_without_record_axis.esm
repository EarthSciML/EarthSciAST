{
  "esm": "1.3.0",
  "metadata": {
    "name": "PairCouplingImportWithoutRecordAxis",
    "description": "As records_per_sample_coupling_import, but the imported edge's target is shaped [x, rec]: validation passes and flatten refuses it after expansion (esm-spec 8.5.1 'When rule 3 is checked')."
  },
  "index_sets": {
    "rec": {
      "kind": "interval",
      "size": 2
    },
    "x": {
      "kind": "interval",
      "size": 4
    }
  },
  "data_sources": {
    "met_source": {
      "kind": "grid",
      "source": {
        "url_template": "file:///data/met/met_{date:%Y%m%d}.nc"
      },
      "temporal": {
        "start": "2024-05-01T00:00:00Z",
        "frequency": "PT1H",
        "file_period": "P1D",
        "records_per_file": 24
      },
      "metadata": {
        "esio_format": "netcdf"
      }
    }
  },
  "models": {
    "Met": {
      "variables": {
        "K": {
          "type": "parameter",
          "units": "1/s",
          "default": 0.1,
          "description": "Declared once, with no shape; the consumer gives it the record axis and the grid.",
          "update": {
            "kind": "data",
            "source": "met_source",
            "from": {
              "file_variable": "K",
              "records_per_sample": 2
            }
          }
        }
      },
      "equations": []
    },
    "Box": {
      "variables": {
        "c": {
          "type": "unknown",
          "units": "1",
          "default": 1.0
        },
        "F_k": {
          "type": "parameter",
          "units": "1/s",
          "shape": [
            "x",
            "rec"
          ],
          "default": 0.1,
          "description": "Replaced by Met.K."
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "c"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "*",
            "args": [
              {
                "op": "-",
                "args": [
                  {
                    "op": "index",
                    "args": [
                      "F_k",
                      1,
                      1
                    ]
                  }
                ]
              },
              "c"
            ]
          }
        }
      ]
    }
  },
  "coupling": [
    {
      "type": "coupling_import",
      "ref": "./components/records_per_sample_library.esm",
      "bind": {
        "Data": "Met",
        "Consumer": "Box"
      }
    }
  ]
}
