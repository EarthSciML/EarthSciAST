{
  "esm": "1.3.0",
  "metadata": {
    "name": "RecordAxisRefTarget",
    "description": "The param_to_var target sits in a model mounted by ref (models.Box = {ref}); its declared shape [rec, x], rec a record axis declared by the mounted file, is the record shape once the ref is mounted (esm-spec 8.5.1)."
  },
  "data_sources": {
    "met_source": {
      "kind": "grid",
      "source": {
        "url_template": "file:///data/met/met_{date:%Y%m%d}.nc"
      },
      "temporal": {
        "start": "2024-05-01T00:00:00Z",
        "frequency": "PT1H",
        "file_period": "P1D",
        "records_per_file": 24
      },
      "metadata": {
        "esio_format": "netcdf"
      }
    }
  },
  "models": {
    "Met": {
      "variables": {
        "K": {
          "type": "parameter",
          "units": "1/s",
          "default": 0.1,
          "description": "Declared once, with no shape; the consumer gives it the record axis and the grid.",
          "update": {
            "kind": "data",
            "source": "met_source",
            "from": {
              "file_variable": "K"
            }
          }
        }
      },
      "equations": []
    },
    "Box": {
      "ref": "./components/transport_rec_first.esm"
    }
  },
  "coupling": [
    {
      "type": "variable_map",
      "from": "Met.K",
      "to": "Box.F_k",
      "transform": "param_to_var"
    }
  ]
}
