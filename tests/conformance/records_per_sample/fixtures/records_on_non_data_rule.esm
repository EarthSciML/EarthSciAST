{
  "esm": "1.3.0",
  "metadata": {
    "name": "records_on_non_data_rule",
    "description": "from.records_per_sample on a `condition` rule, which names no source (esm-spec 8.5.1 rule 1)."
  },
  "index_sets": {
    "rec": {
      "kind": "interval",
      "size": 2
    },
    "x": {
      "kind": "interval",
      "size": 3
    },
    "pair": {
      "kind": "categorical",
      "members": [
        "before",
        "after"
      ]
    }
  },
  "data_sources": {
    "Met": {
      "kind": "grid",
      "source": {
        "url_template": "file:///data/met/{date:%Y%m%d}.nc"
      },
      "temporal": {
        "start": "2024-05-01T00:00:00Z",
        "end": "2024-05-31T21:00:00Z",
        "file_period": "P1D",
        "frequency": "PT3H",
        "records_per_file": 8
      },
      "metadata": {
        "esio_format": "netcdf"
      }
    }
  },
  "models": {
    "Box": {
      "variables": {
        "c": {
          "type": "unknown",
          "units": "1",
          "default": 1.0
        },
        "k": {
          "type": "parameter",
          "units": "1/s",
          "default": 0.1
        },
        "G": {
          "type": "parameter",
          "units": "1",
          "default": 1.0,
          "update": {
            "kind": "condition",
            "when": {
              "op": ">",
              "args": [
                "c",
                0.5
              ]
            },
            "from": {
              "file_variable": "PBLH",
              "records_per_sample": 1
            }
          }
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "c"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "*",
            "args": [
              {
                "op": "-",
                "args": [
                  "k"
                ]
              },
              "c"
            ]
          }
        }
      ]
    }
  }
}
