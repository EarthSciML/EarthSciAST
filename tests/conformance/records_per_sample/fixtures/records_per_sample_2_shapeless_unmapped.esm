{
  "esm": "1.3.0",
  "metadata": {
    "name": "RecordsPerSample2ShapelessUnmapped",
    "description": "Met.K declares no shape, writes from.records_per_sample 2, and is the from of no param_to_var entry, and the document imports no coupling: its record shape is empty and gives one record, so the field disagrees (esm-spec 8.5.1, records_per_sample_invalid)."
  },
  "index_sets": {
    "rec": {
      "kind": "interval",
      "size": 2
    },
    "x": {
      "kind": "interval",
      "size": 4
    }
  },
  "data_sources": {
    "met_source": {
      "kind": "grid",
      "source": {
        "url_template": "file:///data/met/met_{date:%Y%m%d}.nc"
      },
      "temporal": {
        "start": "2024-05-01T00:00:00Z",
        "frequency": "PT1H",
        "file_period": "P1D",
        "records_per_file": 24
      },
      "metadata": {
        "esio_format": "netcdf"
      }
    }
  },
  "models": {
    "Met": {
      "variables": {
        "K": {
          "type": "parameter",
          "units": "1/s",
          "default": 0.1,
          "description": "Declared once, with no shape; the consumer gives it the record axis and the grid.",
          "update": {
            "kind": "data",
            "source": "met_source",
            "from": {
              "file_variable": "K",
              "records_per_sample": 2
            }
          }
        }
      },
      "equations": []
    }
  }
}
