{
  "esm": "1.3.0",
  "metadata": {
    "name": "RecordsPerSample2WithoutRecordAxis",
    "description": "F writes the deprecated from.records_per_sample 2 but is shaped [x]: its record shape gives one record, so the field disagrees (esm-spec 8.5.1, records_per_sample_invalid)."
  },
  "index_sets": {
    "rec": {
      "kind": "interval",
      "size": 2
    },
    "x": {
      "kind": "interval",
      "size": 3
    },
    "pair": {
      "kind": "categorical",
      "members": [
        "before",
        "after"
      ]
    }
  },
  "data_sources": {
    "Met": {
      "kind": "grid",
      "source": {
        "url_template": "file:///data/met/{date:%Y%m%d}.nc"
      },
      "temporal": {
        "start": "2024-05-01T00:00:00Z",
        "end": "2024-05-31T21:00:00Z",
        "file_period": "P1D",
        "frequency": "PT3H",
        "records_per_file": 8
      },
      "metadata": {
        "esio_format": "netcdf"
      }
    }
  },
  "models": {
    "Box": {
      "variables": {
        "c": {
          "type": "unknown",
          "units": "1",
          "default": 1.0
        },
        "k": {
          "type": "parameter",
          "units": "1/s",
          "default": 0.1
        },
        "F": {
          "type": "parameter",
          "units": "1",
          "shape": [
            "x"
          ],
          "default": 1.0,
          "update": {
            "kind": "data",
            "source": "Met",
            "from": {
              "file_variable": "PBLH",
              "records_per_sample": 2
            }
          }
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "c"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "*",
            "args": [
              {
                "op": "-",
                "args": [
                  "k"
                ]
              },
              "c"
            ]
          }
        }
      ]
    }
  }
}
