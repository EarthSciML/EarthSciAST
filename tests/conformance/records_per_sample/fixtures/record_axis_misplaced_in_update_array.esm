{
  "esm": "1.3.0",
  "metadata": {
    "name": "RecordAxisMisplacedInUpdateArray",
    "description": "The data rule is the SECOND entry of an array-form update of a parameter shaped [x, rec], rec a record axis, so the record_axis_misplaced pointer is /update/1 (esm-spec 8.5.1)."
  },
  "index_sets": {
    "rec": {
      "kind": "interval",
      "size": 2,
      "records": true
    },
    "x": {
      "kind": "interval",
      "size": 4
    }
  },
  "data_sources": {
    "met_source": {
      "kind": "grid",
      "source": {
        "url_template": "file:///data/met/met_{date:%Y%m%d}.nc"
      },
      "temporal": {
        "start": "2024-05-01T00:00:00Z",
        "frequency": "PT1H",
        "file_period": "P1D",
        "records_per_file": 24
      },
      "metadata": {
        "esio_format": "netcdf"
      }
    }
  },
  "models": {
    "Box": {
      "variables": {
        "c": {
          "type": "unknown",
          "units": "1",
          "default": 1.0
        },
        "F_k": {
          "type": "parameter",
          "units": "1/s",
          "shape": [
            "x",
            "rec"
          ],
          "default": 0.1,
          "description": "Replaced by Met.K.",
          "update": [
            {
              "kind": "schedule",
              "interval": 3600.0,
              "expression": 0.1
            },
            {
              "kind": "data",
              "source": "met_source",
              "from": {
                "file_variable": "K"
              }
            }
          ]
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "c"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "*",
            "args": [
              {
                "op": "-",
                "args": [
                  {
                    "op": "index",
                    "args": [
                      "F_k",
                      1,
                      1
                    ]
                  }
                ]
              },
              "c"
            ]
          }
        }
      ]
    }
  }
}
