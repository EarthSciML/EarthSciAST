{
  "esm": "1.3.0",
  "metadata": {
    "name": "PairInSubsystemWithoutRecordAxis",
    "description": "records_per_sample 2 on a parameter of a SUBSYSTEM whose first dimension has 4 members (esm-spec 8.5.1 rule 3 applies at any depth)."
  },
  "index_sets": {
    "rec": {
      "kind": "interval",
      "size": 2
    },
    "x": {
      "kind": "interval",
      "size": 4
    }
  },
  "data_sources": {
    "met_source": {
      "kind": "grid",
      "source": {
        "url_template": "file:///data/met/met_{date:%Y%m%d}.nc"
      },
      "temporal": {
        "start": "2024-05-01T00:00:00Z",
        "frequency": "PT1H",
        "file_period": "P1D",
        "records_per_file": 24
      },
      "metadata": {
        "esio_format": "netcdf"
      }
    }
  },
  "models": {
    "Outer": {
      "variables": {},
      "equations": [],
      "subsystems": {
        "Inner": {
          "variables": {
            "c": {
              "type": "unknown",
              "units": "1",
              "default": 1.0
            },
            "F_k": {
              "type": "parameter",
              "units": "1/s",
              "shape": [
                "x",
                "rec"
              ],
              "default": 0.1,
              "description": "Two records per sample, but its first dimension has 4 members.",
              "update": {
                "kind": "data",
                "source": "met_source",
                "from": {
                  "file_variable": "K",
                  "records_per_sample": 2
                }
              }
            }
          },
          "equations": [
            {
              "lhs": {
                "op": "D",
                "args": [
                  "c"
                ],
                "wrt": "t"
              },
              "rhs": {
                "op": "*",
                "args": [
                  {
                    "op": "-",
                    "args": [
                      {
                        "op": "index",
                        "args": [
                          "F_k",
                          1,
                          1
                        ]
                      }
                    ]
                  },
                  "c"
                ]
              }
            }
          ]
        }
      }
    }
  }
}
