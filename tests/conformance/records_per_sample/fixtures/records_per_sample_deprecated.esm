{
  "esm": "1.3.0",
  "metadata": {
    "name": "RecordsPerSampleDeprecated",
    "description": "The deprecated records_per_sample fields (esm-spec 8.5.1), written so that each agrees with the parameter's record shape: from 2 on a parameter shaped over the record axis rec first, the source default 2 inherited by one, overridden back to 1 on a parameter with no record axis, 1 on a parameter whose first axis is a categorical of two members (not a record axis), and 1 on a static source. The document loads with one deprecated_records_per_sample warning naming every place the field is written, and each loader_fields entry reports the count the shape gives."
  },
  "index_sets": {
    "rec": {
      "kind": "interval",
      "size": 2,
      "records": true
    },
    "x": {
      "kind": "interval",
      "size": 3
    },
    "pair": {
      "kind": "categorical",
      "members": [
        "before",
        "after"
      ]
    }
  },
  "data_sources": {
    "Met": {
      "kind": "grid",
      "source": {
        "url_template": "file:///data/met/{date:%Y%m%d}.nc"
      },
      "temporal": {
        "start": "2024-05-01T00:00:00Z",
        "end": "2024-05-31T21:00:00Z",
        "file_period": "P1D",
        "frequency": "PT3H",
        "records_per_file": 8
      },
      "metadata": {
        "esio_format": "netcdf"
      }
    },
    "MetPair": {
      "kind": "grid",
      "source": {
        "url_template": "file:///data/met/{date:%Y%m%d}.nc"
      },
      "temporal": {
        "start": "2024-05-01T00:00:00Z",
        "end": "2024-05-31T21:00:00Z",
        "file_period": "P1D",
        "frequency": "PT3H",
        "records_per_file": 8,
        "records_per_sample": 2
      },
      "metadata": {
        "esio_format": "netcdf"
      }
    },
    "Static": {
      "kind": "static",
      "source": {
        "url_template": "file:///data/met/{date:%Y%m%d}.nc"
      },
      "metadata": {
        "esio_format": "netcdf"
      }
    }
  },
  "models": {
    "Box": {
      "variables": {
        "c": {
          "type": "unknown",
          "units": "1",
          "default": 1.0
        },
        "k": {
          "type": "parameter",
          "units": "1/s",
          "default": 0.1
        },
        "F_pair": {
          "type": "parameter",
          "units": "m",
          "shape": [
            "rec",
            "x"
          ],
          "default": 500.0,
          "update": {
            "kind": "data",
            "source": "Met",
            "from": {
              "file_variable": "PBLH",
              "records_per_sample": 2
            }
          },
          "description": "from.records_per_sample 2 on a parameter shaped [rec, x], rec a record axis: agrees."
        },
        "F_one": {
          "type": "parameter",
          "units": "K",
          "shape": [
            "x"
          ],
          "default": 290.0,
          "update": {
            "kind": "data",
            "source": "Met",
            "from": {
              "file_variable": "T2M"
            }
          },
          "description": "Nothing set anywhere: 1."
        },
        "F_cat": {
          "type": "parameter",
          "units": "m/s",
          "shape": [
            "pair",
            "x"
          ],
          "default": 1.0,
          "update": {
            "kind": "data",
            "source": "Met",
            "from": {
              "file_variable": "U10M",
              "records_per_sample": 1
            }
          },
          "description": "1 on a categorical first axis of two members, which is not a record axis."
        },
        "F_inherit": {
          "type": "parameter",
          "units": "m/s",
          "shape": [
            "rec",
            "x"
          ],
          "default": 1.0,
          "update": {
            "kind": "data",
            "source": "MetPair",
            "from": {
              "file_variable": "V10M"
            }
          },
          "description": "Inherits the source's temporal.records_per_sample 2; shaped [rec, x]: agrees."
        },
        "F_override": {
          "type": "parameter",
          "units": "kg/kg",
          "shape": [
            "x"
          ],
          "default": 0.01,
          "update": {
            "kind": "data",
            "source": "MetPair",
            "from": {
              "file_variable": "QV2M",
              "records_per_sample": 1
            }
          },
          "description": "Overrides the source's 2 with 1; shaped [x]: agrees."
        },
        "K_static": {
          "type": "parameter",
          "units": "1",
          "shape": [],
          "default": 0.5,
          "update": {
            "kind": "data",
            "source": "Static",
            "from": {
              "file_variable": "FRLAND",
              "records_per_sample": 1
            }
          },
          "description": "A static source at an explicit 1."
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "c"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "*",
            "args": [
              {
                "op": "-",
                "args": [
                  "k"
                ]
              },
              "c"
            ]
          }
        }
      ]
    }
  }
}
