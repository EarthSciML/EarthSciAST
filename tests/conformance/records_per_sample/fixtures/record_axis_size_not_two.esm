{
  "esm": "1.3.0",
  "metadata": {
    "name": "RecordAxisSizeNotTwo",
    "description": "rec carries records: true with size 3; a record axis holds exactly two members (esm-spec 8.5.1 rule 1, record_axis_invalid)."
  },
  "index_sets": {
    "rec": {
      "kind": "interval",
      "size": 3,
      "records": true
    },
    "x": {
      "kind": "interval",
      "size": 3
    },
    "pair": {
      "kind": "categorical",
      "members": [
        "before",
        "after"
      ]
    }
  },
  "data_sources": {
    "Met": {
      "kind": "grid",
      "source": {
        "url_template": "file:///data/met/{date:%Y%m%d}.nc"
      },
      "temporal": {
        "file_period": "P1D",
        "frequency": "PT3H",
        "records_per_file": 8,
        "start": "2024-05-01T00:00:00Z"
      },
      "metadata": {
        "esio_format": "netcdf"
      }
    }
  },
  "models": {
    "Box": {
      "variables": {
        "c": {
          "type": "unknown",
          "units": "1",
          "default": 1.0
        },
        "k": {
          "type": "parameter",
          "units": "1/s",
          "default": 0.1
        },
        "F": {
          "type": "parameter",
          "units": "1",
          "shape": [
            "rec",
            "x"
          ],
          "default": 1.0,
          "update": {
            "kind": "data",
            "source": "Met",
            "from": {
              "file_variable": "PBLH"
            }
          }
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "c"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "*",
            "args": [
              {
                "op": "-",
                "args": [
                  "k"
                ]
              },
              "c"
            ]
          }
        }
      ]
    }
  }
}
