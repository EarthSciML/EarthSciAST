{
 "esm": "2.4.0",
 "metadata": {
  "name": "static_join_single_axis",
  "description": "Distinct columns on one loop symbol compare their keys at the same position. Only matching rows contribute.",
  "authors": [
   "EarthSciML Authors and Contributors"
  ]
 },
 "index_sets": {
  "rows": {
   "kind": "interval",
   "size": 5
  }
 },
 "models": {
  "SingleAxisJoin": {
   "variables": {
    "prior": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "rows"
     ]
    },
    "id": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "rows"
     ]
    },
    "payload": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "rows"
     ]
    },
    "selected_key": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "rows"
     ]
    },
    "selected": {
     "type": "unknown",
     "units": "1"
    }
   },
   "equations": [
    {
     "lhs": "prior",
     "rhs": {
      "op": "const",
      "args": [],
      "value": [
       0,
       1,
       2,
       3,
       4
      ]
     }
    },
    {
     "lhs": "id",
     "rhs": {
      "op": "const",
      "args": [],
      "value": [
       1,
       2,
       3,
       4,
       5
      ]
     }
    },
    {
     "lhs": "payload",
     "rhs": {
      "op": "const",
      "args": [],
      "value": [
       1,
       10,
       100,
       1000,
       10000
      ]
     }
    },
    {
     "lhs": "selected_key",
     "rhs": {
      "op": "const",
      "args": [],
      "value": [
       1,
       2,
       99,
       4,
       99
      ]
     }
    },
    {
     "lhs": "selected",
     "rhs": {
      "op": "faq",
      "args": [],
      "output_idx": [],
      "ranges": {
       "a": {
        "from": "rows"
       }
      },
      "join": [
       {
        "on": [
         [
          "id",
          "selected_key"
         ]
        ]
       }
      ],
      "expr": {
       "op": "index",
       "args": [
        "payload",
        "a"
       ]
      }
     }
    }
   ],
   "tolerance": {
    "rel": 0,
    "abs": 0
   },
   "tests": [
    {
