{
 "esm": "2.4.0",
 "metadata": {
  "name": "RankTwoIndexedLhs",
  "description": "State-free indexed definitions with both LHS spellings. The values are the same in named coordinates even though the second output uses the opposite axis order.",
  "authors": [
   "EarthSciML Authors and Contributors"
  ]
 },
 "index_sets": {
  "rows": {
   "kind": "interval",
   "size": 2
  },
  "cols": {
   "kind": "interval",
   "size": 3
  }
 },
 "models": {
  "RankTwoIndexedLhs": {
   "variables": {
    "shelled": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "rows",
      "cols"
     ]
    },
    "bare": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "cols",
      "rows"
     ]
    }
   },
   "equations": [
    {
     "lhs": {
      "op": "faq",
      "args": [],
      "output_idx": [
       "i",
       "j"
      ],
      "ranges": {
       "i": {
        "from": "rows"
       },
       "j": {
        "from": "cols"
       }
      },
      "expr": {
       "op": "index",
       "args": [
        "shelled",
        "i",
        "j"
       ]
      }
     },
     "rhs": {
      "op": "faq",
      "args": [],
      "output_idx": [
       "i",
       "j"
      ],
      "ranges": {
       "i": {
        "from": "rows"
       },
       "j": {
        "from": "cols"
       }
      },
      "expr": {
       "op": "+",
       "args": [
        {
         "op": "*",
         "args": [
          10,
          "i"
         ]
        },
        "j"
       ]
      }
     }
    },
    {
     "lhs": {
      "op": "index",
      "args": [
       "bare",
       "j",
       "i"
      ]
     },
     "rhs": {
      "op": "faq",
      "args": [],
      "output_idx": [
       "j",
       "i"
      ],
      "ranges": {
       "i": {
        "from": "rows"
       },
       "j": {
        "from": "cols"
       }
      },
      "expr": {
       "op": "+",
       "args": [
        {
         "op": "*",
         "args": [
          10,
          "i"
         ]
        },
        "j"
       ]
      }
     }
    }
   ],
   "tolerance": {
    "rel": 0,
    "abs": 0
   },
   "tests": [
    {
     "id": "probe",
     "time_span": {
      "start": 0,
      "end": 1
     },
     "assertions": [
      {
       "variable": "shelled",
       "time": 0,
       "expected": 13,
       "coords": {
        "rows": 1,
        "cols": 3
       }
      },
      {
       "variable": "shelled",
       "time": 0,
       "expected": 21,
       "coords": {
        "rows": 2,
        "cols": 1
       }
      },
      {
       "variable": "shelled",
       "time": 0,
       "expected": 23,
       "coords": {
        "rows": 2,
        "cols": 3
       }
      },
      {
       "variable": "bare",
       "time": 0,
       "expected": 13,
       "coords": {
        "rows": 1,
        "cols": 3
       }
      },
      {
       "variable": "bare",
       "time": 0,
       "expected": 21,
       "coords": {
        "rows": 2,
        "cols": 1
       }
      },
      {
       "variable": "bare",
       "time": 0,
       "expected": 23,
       "coords": {
        "rows": 2,
        "cols": 3
       }
      }
     ]
    }
   ]
  }
 }
}
