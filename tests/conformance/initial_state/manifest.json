{
  "category": "initial_state",
  "version": "1.0",
  "description": "Cross-binding conformance for the public initial-state accessor (API_SPEC 5.8 `initial_state`, CONFORMANCE_SPEC 5.53): the state a Problem integrates from, one value per state element keyed by its flattened name, built as a solve builds it. Per element the first of: the Problem's `u0` entry, an initialization equation (esm-spec 6.2), an `ic` equation or field initial condition (11.4, 11.4.1), the declared `default`; the Problem's `p` (else the parameter defaults) bound in every initial condition's scope (6.6.5). Every fixture is REFERENCED from another category, where its inline tests pin the same values at t = 0 through a solve. The expected values are the documents' own formulas, evaluated in binary64 in the operation order the documents write.",
  "bindings_required": [
    "rust"
  ],
  "bindings_pending": {
    "julia": "no exported accessor: the seeded initial state is the `prob.u0` field (an extension seam, not stable API), indexed through `prob.var_map`",
    "python": "no accessor: `prob.u0` is the caller's override dict, and the built state is reachable only as `init(prob).u` before the first step (SciPy required; refused for the segmented engines)"
  },
  "scope_excluded": {
    "go": "parse and validate only; no simulator",
    "typescript": "no simulator"
  },
  "tolerances": {
    "rtol": 1e-14,
    "atol": 1e-15
  },
  "cases": [
    {
      "id": "scalar_ic_defaults",
      "fixture": "scalar_ic/fixtures/scalar_ic.esm",
      "p": {},
      "u0": {},
      "expected": {
        "M.u": 3.0,
        "M.q": 2.0,
        "M.w": 4.0,
        "M.y": 0.0,
        "M.z": 7.0
      },
      "note": "each state seeded by its own `ic` (u = 3, q = 1.5 + 2*0.25, w = 2*A with A at its default 2, y = 0); z has no `ic` and keeps its declared default 7"
    },
    {
      "id": "scalar_ic_parameter",
      "fixture": "scalar_ic/fixtures/scalar_ic.esm",
      "p": {
        "A": 10.0
      },
      "u0": {},
      "expected": {
        "M.u": 3.0,
        "M.q": 2.0,
        "M.w": 20.0,
        "M.y": 0.0,
        "M.z": 7.0
      },
      "note": "the Problem's parameter A = 10 binds in the `ic` scope (esm-spec 6.6.5): w = 2*10"
    },
    {
      "id": "scalar_ic_u0_override",
      "fixture": "scalar_ic/fixtures/scalar_ic.esm",
      "p": {},
      "u0": {
        "u": 9.0
      },
      "expected": {
        "M.u": 9.0,
        "M.q": 2.0,
        "M.w": 4.0,
        "M.y": 0.0,
        "M.z": 7.0
      },
      "note": "the Problem's u0 entry beats the `ic` equation for u only"
    },
    {
      "id": "array_model_defaults",
      "fixture": "scalar_ic/fixtures/scalar_ic_in_array_model.esm",
      "p": {},
      "u0": {},
      "expected": {
        "N.f[1]": 1.5,
        "N.f[2]": 1.5,
        "N.f[3]": 1.5,
        "N.f[4]": 1.5,
        "N.s": 6.0
      },
      "note": "the array `ic` broadcasts 1.5 over every cell; the 0-D `ic` gives s = 2*B with B at its default 3"
    },
    {
      "id": "array_model_parameter",
      "fixture": "scalar_ic/fixtures/scalar_ic_in_array_model.esm",
      "p": {
        "B": 10.0
      },
      "u0": {},
      "expected": {
        "N.f[1]": 1.5,
        "N.f[2]": 1.5,
        "N.f[3]": 1.5,
        "N.f[4]": 1.5,
        "N.s": 20.0
      },
      "note": "B = 10 reaches the 0-D `ic` in the array runtime"
    },
    {
      "id": "initialization_equation_defaults",
      "fixture": "scalar_ic/fixtures/faq_initialization_equation.esm",
      "p": {},
      "u0": {},
      "expected": {
        "F.u[1]": 3.5,
        "F.u[2]": 4.0,
        "F.u[3]": 4.5,
        "F.u[4]": 5.0,
        "F.u[5]": 5.5,
        "F.w[1]": 9.0,
        "F.w[2]": 20.0,
        "F.w[3]": 0.0,
        "F.w[4]": 40.0,
        "F.w[5]": 9.0,
        "F.y[1]": 0.0,
        "F.y[2]": 0.0,
        "F.y[3]": 0.0,
        "F.y[4]": 0.0,
        "F.y[5]": 0.0
      },
      "note": "initialization equations (esm-spec 6.2): u = A*i + B; w = 10*i over cells 2..4, 0 at the filtered-out cell 3, and the declared default 9 outside the range; y keeps its default"
    },
    {
      "id": "initialization_equation_parameter",
      "fixture": "scalar_ic/fixtures/faq_initialization_equation.esm",
      "p": {
        "A": 1.0
      },
      "u0": {},
      "expected": {
        "F.u[1]": 4.0,
        "F.u[2]": 5.0,
        "F.u[3]": 6.0,
        "F.u[4]": 7.0,
        "F.u[5]": 8.0,
        "F.w[1]": 9.0,
        "F.w[2]": 20.0,
        "F.w[3]": 0.0,
        "F.w[4]": 40.0,
        "F.w[5]": 9.0,
        "F.y[1]": 0.0,
        "F.y[2]": 0.0,
        "F.y[3]": 0.0,
        "F.y[4]": 0.0,
        "F.y[5]": 0.0
      },
      "note": "A = 1 reaches the initialization equation: u = i + 3"
    },
    {
      "id": "initialization_equation_u0_override",
      "fixture": "scalar_ic/fixtures/faq_initialization_equation.esm",
      "p": {},
      "u0": {
        "u[2]": 7.0
      },
      "expected": {
        "F.u[1]": 3.5,
        "F.u[2]": 7.0,
        "F.u[3]": 4.5,
        "F.u[4]": 5.0,
        "F.u[5]": 5.5,
        "F.w[1]": 9.0,
        "F.w[2]": 20.0,
        "F.w[3]": 0.0,
        "F.w[4]": 40.0,
        "F.w[5]": 9.0,
        "F.y[1]": 0.0,
        "F.y[2]": 0.0,
        "F.y[3]": 0.0,
        "F.y[4]": 0.0,
        "F.y[5]": 0.0
      },
      "note": "a u0 entry for one cell beats the initialization equation for that cell only"
    },
    {
      "id": "coordinate_ic_defaults",
      "fixture": "pde_inline_ic_param_override/fixtures/ic_param_override.esm",
      "p": {},
      "u0": {},
      "expected": {
        "M.u[1]": 0.9510565162951535,
        "M.u[2]": 0.587785252292473,
        "M.u[3]": 6.123233995736766e-17,
        "M.u[4]": -0.587785252292473,
        "M.u[5]": -0.9510565162951535,
        "M.v[1]": 0.9510565162951535,
        "M.v[2]": 0.587785252292473,
        "M.v[3]": 6.123233995736766e-17,
        "M.v[4]": -0.587785252292473,
        "M.v[5]": -0.9510565162951535
      },
      "note": "coordinate-expression `ic`s (esm-spec 11.4.1): u = A*cos(pi*(i - 1/2)/5) with A at its default 1, v = cos(pi*(i - 1/2)/5)"
    },
    {
      "id": "coordinate_ic_parameter",
      "fixture": "pde_inline_ic_param_override/fixtures/ic_param_override.esm",
      "p": {
        "A": 2.0
      },
      "u0": {},
      "expected": {
        "M.u[1]": 1.902113032590307,
        "M.u[2]": 1.175570504584946,
        "M.u[3]": 1.2246467991473532e-16,
        "M.u[4]": -1.175570504584946,
        "M.u[5]": -1.902113032590307,
        "M.v[1]": 0.9510565162951535,
        "M.v[2]": 0.587785252292473,
        "M.v[3]": 6.123233995736766e-17,
        "M.v[4]": -0.587785252292473,
        "M.v[5]": -0.9510565162951535
      },
      "note": "A = 2 binds in the coordinate-expression `ic` of u; v is parameter-free"
    },
    {
      "id": "coordinate_ic_parameter_zero",
      "fixture": "pde_inline_ic_param_override/fixtures/ic_param_override.esm",
      "p": {
        "A": 0.0
      },
      "u0": {},
      "expected": {
        "M.u[1]": 0.0,
        "M.u[2]": 0.0,
        "M.u[3]": 0.0,
        "M.u[4]": -0.0,
        "M.u[5]": -0.0,
        "M.v[1]": 0.9510565162951535,
        "M.v[2]": 0.587785252292473,
        "M.v[3]": 6.123233995736766e-17,
        "M.v[4]": -0.587785252292473,
        "M.v[5]": -0.9510565162951535
      },
      "note": "A = 0: u is identically zero"
    }
  ]
}
