              "tolerance": {
                "rel": 0.0,
                "abs": 1e-12
              },
              "reduce": "L2_error",
              "reference": {
                "op": "faq",
                "args": [],
                "output_idx": [
                  "i"
                ],
                "ranges": {
                  "i": {
                    "from": "x"
                  }
                },
                "expr": {
                  "op": "cos",
                  "args": [
                    {
                      "op": "*",
                      "args": [
                        3.141592653589793,
                        {
                          "op": "/",
