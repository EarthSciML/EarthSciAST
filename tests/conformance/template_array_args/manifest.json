 "version": "1.0",
 "description": "An expression template of lib/interp.esm applied with an array bound to a scalar-role parameter (esm-spec \u00a79.6.11): the application is evaluated elementwise over the array's index sets, and every element equals the `interp.*` closed function at that element's argument, bit for bit (tolerance 0). Covers a 1-D query defining a shaped and an unshaped observed, the application inside larger arithmetic and on an expression argument, a 3-D query, a level column replicated over a 3-D field, `bilinear` with one and with both coordinates arrays (1-D and 2-D), and `searchsorted`.",
 "reference_binding": "julia",
 "reference_compiler": "interpreter",
 "bindings_required": [
  "julia",
  "python",
  "rust"
 ],
 "scope_excluded": {
  "go": "No simulator and no inline-test runner, so a tier that DRIVES one cannot be run here (API_SPEC.md \u00a73, capability profiles). This is an exclusion from the CATEGORY, not from the rule.",
