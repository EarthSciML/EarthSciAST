     "rhs": {
      "op": "faq",
      "args": [],
      "output_idx": [
       "i",
       "j",
       "k"
      ],
      "ranges": {
       "i": {
        "from": "x"
       },
       "j": {
        "from": "y"
       },
       "k": {
        "from": "z"
       }
      },
