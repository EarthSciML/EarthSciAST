{
 "esm": "1.2.0",
 "metadata": {
  "name": "template_array_args_lin3d",
  "description": "esm-spec \u00a79.6.11: `linear` applied to a `[x, y, z]` parameter. Every element must equal the `interp.*` closed function at that element's argument, bit for bit."
 },
 "index_sets": {
  "x": {
   "kind": "interval",
   "size": 2
  },
  "y": {
   "kind": "interval",
   "size": 3
  },
  "z": {
   "kind": "interval",
   "size": 4
  }
 },
 "models": {
  "template_array_args_lin3d": {
   "variables": {
    "q": {
     "type": "parameter",
     "shape": [
      "x",
      "y",
      "z"
     ],
     "default": [
      [
       [
        0.1,
        0.47,
        0.84,
        1.21
       ],
       [
        1.1,
        1.4700000000000002,
        1.84,
        2.21
       ],
       [
        2.1,
        2.47,
        2.84,
        3.21
       ]
      ],
      [
       [
        0.2,
        0.5700000000000001,
        0.94,
        1.3099999999999998
       ],
