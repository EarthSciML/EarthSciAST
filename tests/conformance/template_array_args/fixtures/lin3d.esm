       ],
       [
        2.2,
        2.5700000000000003,
        2.9400000000000004,
        3.31
       ]
      ]
     ]
    },
    "Dz": {
     "type": "unknown"
    },
    "s_Dz": {
     "type": "unknown",
     "shape": [
      "x",
      "y",
      "z"
     ],
     "default": 0.0
    },
    "Dz_out": {
     "type": "unknown",
     "shape": [
      "x",
      "y",
      "z"
     ],
     "description": "`Dz` read element by element, so the test can assert on a declared shape (esm-spec \u00a76.6.5)."
    }
   },
   "equations": [
    {
     "lhs": "Dz",
     "rhs": {
      "op": "apply_expression_template",
      "args": [],
      "name": "linear",
      "bindings": {
       "table": {
        "op": "const",
        "args": [],
        "value": [
         10.0,
         20.0,
         40.0,
         80.0,
         160.0
        ]
       },
       "axis": {
        "op": "const",
        "args": [],
        "value": [
         1,
         2,
         3,
         4,
         5
        ]
       },
       "x": "q",
       "n": 5
      }
     }
    },
    {
     "lhs": {
      "op": "D",
      "args": [
       "s_Dz"
      ],
      "wrt": "t"
     },
     "rhs": {
      "op": "faq",
      "args": [],
      "output_idx": [
       "i",
       "j",
       "k"
      ],
      "ranges": {
       "i": {
        "from": "x"
       },
       "j": {
        "from": "y"
       },
       "k": {
        "from": "z"
       }
      },
      "expr": {
       "op": "index",
       "args": [
        "Dz",
        "i",
        "j",
        "k"
       ]
      }
     }
    },
    {
