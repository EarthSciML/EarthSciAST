             3,
             4,
             5
            ]
           },
           "x": "lev",
           "n": 5
          }
         }
        ]
       },
       "lev"
      ]
     }
    },
    {
     "lhs": {
      "op": "D",
      "args": [
       "s_Dz"
      ],
      "wrt": "t"
     },
     "rhs": {
      "op": "faq",
      "args": [],
