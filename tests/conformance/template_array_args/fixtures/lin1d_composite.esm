     "type": "unknown"
    },
    "s_E": {
     "type": "unknown",
     "shape": [
      "c"
     ],
     "default": 0.0
    },
    "Dz_out": {
     "type": "unknown",
     "shape": [
      "c"
     ],
     "description": "`Dz` read element by element, so the test can assert on a declared shape (esm-spec \u00a76.6.5)."
    },
    "E_out": {
     "type": "unknown",
     "shape": [
      "c"
     ],
     "description": "`E` read element by element, so the test can assert on a declared shape (esm-spec \u00a76.6.5)."
    }
   },
   "equations": [
    {
