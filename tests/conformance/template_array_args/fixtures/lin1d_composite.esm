         {
          "op": "apply_expression_template",
          "args": [],
          "name": "linear",
          "bindings": {
           "table": {
            "op": "const",
            "args": [],
            "value": [
             10.0,
             20.0,
             40.0,
             80.0,
             160.0
            ]
           },
           "axis": {
            "op": "const",
            "args": [],
            "value": [
             1,
