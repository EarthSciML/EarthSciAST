{
 "esm": "1.2.0",
 "metadata": {
  "name": "template_array_args_lin1d_composite",
  "description": "esm-spec \u00a79.6.11: `linear` inside larger arithmetic (`a * linear(lev) + lev`), and applied to an expression (`lev * 0.5`). Every element must equal the `interp.*` closed function at that element's argument, bit for bit."
 },
 "index_sets": {
  "c": {
   "kind": "interval",
   "size": 4
  }
 },
 "models": {
  "template_array_args_lin1d_composite": {
   "variables": {
    "lev": {
     "type": "parameter",
     "shape": [
      "c"
     ],
     "default": [
      0.5,
      2.5,
      4.0,
      7.0
     ]
    },
    "a": {
     "type": "parameter",
     "default": 3.0
    },
    "Dz": {
     "type": "unknown"
    },
    "s_Dz": {
     "type": "unknown",
     "shape": [
      "c"
     ],
     "default": 0.0
    },
