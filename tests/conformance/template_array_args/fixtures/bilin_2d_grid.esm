{
 "esm": "1.2.0",
 "metadata": {
  "name": "template_array_args_bilin_2d_grid",
  "description": "esm-spec \u00a79.6.11: `bilinear` with `x` and `y` both over `[x, y]`, defining an observed declared over `[x, y]`. Every element must equal the `interp.*` closed function at that element's argument, bit for bit."
 },
 "index_sets": {
  "x": {
   "kind": "interval",
   "size": 2
  },
  "y": {
   "kind": "interval",
   "size": 3
  }
 },
 "models": {
  "template_array_args_bilin_2d_grid": {
   "variables": {
    "px": {
     "type": "parameter",
     "shape": [
      "x",
      "y"
     ],
     "default": [
      [
       0.2,
       1.0,
       2.0
      ],
      [
       3.0,
       3.9,
       0.0
      ]
     ]
    },
    "py": {
     "type": "parameter",
     "shape": [
      "x",
      "y"
     ],
     "default": [
      [
       11.0,
       15.0,
       22.0
      ],
      [
       25.0,
       29.9,
       10.0
      ]
     ]
    },
    "B": {
     "type": "unknown",
     "shape": [
      "x",
      "y"
     ]
    },
    "s_B": {
     "type": "unknown",
     "shape": [
      "x",
      "y"
     ],
     "default": 0.0
    }
   },
   "equations": [
    {
     "lhs": "B",
     "rhs": {
      "op": "apply_expression_template",
      "args": [],
      "name": "bilinear",
      "bindings": {
       "table": {
        "op": "const",
        "args": [],
        "value": [
         [
          1.0,
          2.0,
          4.0
         ],
         [
          3.0,
          5.0,
          9.0
         ],
         [
          7.0,
          11.0,
          13.0
         ],
         [
          17.0,
          19.0,
          23.0
         ]
        ]
       },
       "axis_x": {
        "op": "const",
        "args": [],
        "value": [
         0.0,
         1.0,
         2.5,
         4.0
        ]
       },
       "axis_y": {
        "op": "const",
        "args": [],
        "value": [
         10.0,
         20.0,
         30.0
        ]
       },
       "x": "px",
       "y": "py",
       "nx": 4,
       "ny": 3
      }
     }
    },
    {
     "lhs": {
      "op": "D",
      "args": [
       "s_B"
      ],
      "wrt": "t"
     },
     "rhs": {
      "op": "faq",
      "args": [],
      "output_idx": [
       "i",
       "j"
      ],
      "ranges": {
       "i": {
        "from": "x"
       },
       "j": {
        "from": "y"
       }
      },
      "expr": {
       "op": "index",
       "args": [
        "B",
        "i",
        "j"
       ]
      }
     }
    }
   ],
   "expression_template_imports": [
    {
     "ref": "esm:std/interp.esm",
     "only": [
      "bilinear"
     ]
    }
   ],
   "tolerance": {
    "abs": 0,
    "rel": 0
   },
   "tests": [
    {
     "id": "template_array_args_bilin_2d_grid_t0",
     "description": "Every element at t = 0.",
     "time_span": {
      "start": 0.0,
      "end": 1.0
     },
     "assertions": [
      {
       "variable": "B",
       "time": 0.0,
       "coords": {
        "x": 1,
        "y": 1
       },
       "expected": 1.52
      },
      {
       "variable": "B",
       "time": 0.0,
       "coords": {
        "x": 1,
        "y": 2
       },
       "expected": 4.0
      },
      {
       "variable": "B",
       "time": 0.0,
       "coords": {
        "x": 1,
        "y": 3
       },
       "expected": 9.533333333333333
      },
      {
       "variable": "B",
       "time": 0.0,
       "coords": {
        "x": 2,
        "y": 1
       },
       "expected": 15.0
      },
      {
       "variable": "B",
       "time": 0.0,
       "coords": {
        "x": 2,
        "y": 2
       },
       "expected": 22.294666666666664
      },
      {
       "variable": "B",
       "time": 0.0,
       "coords": {
        "x": 2,
        "y": 3
       },
       "expected": 1.0
      }
