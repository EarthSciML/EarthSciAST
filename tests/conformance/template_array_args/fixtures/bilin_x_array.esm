{
 "esm": "1.2.0",
 "metadata": {
  "name": "template_array_args_bilin_x_array",
  "description": "esm-spec \u00a79.6.11: `bilinear` with `x` over `[c]` and `y` a scalar parameter. Every element must equal the template applied to that element's argument as a scalar, bit for bit."
 },
 "index_sets": {
  "c": {
   "kind": "interval",
   "size": 5
  }
 },
