     "rhs": {
      "op": "faq",
      "args": [],
      "output_idx": [
       "i"
      ],
      "ranges": {
       "i": {
        "from": "c"
       }
      },
      "expr": {
       "op": "index",
       "args": [
        "B",
        "i"
       ]
      }
     }
