         4.0
        ]
       },
       "axis_y": {
        "op": "const",
        "args": [],
        "value": [
         10.0,
         20.0,
         30.0
        ]
       },
       "x": "px",
       "y": "py",
       "nx": 4,
       "ny": 3
      }
     }
    },
    {
     "lhs": {
      "op": "D",
      "args": [
