{
  "esm": "1.3.0",
  "metadata": {
    "name": "LiftOntoUndeclaredGrid",
    "description": "Pointwise lift (esm-spec 10.5) onto a grid that no variable declares: the operator Dep ranges over [1, 4] and declares no shaped variable, so the lift's index set comes from the size match alone. cell is the only index set of size 4 (lev has size 2), so Chem.c is lifted onto [cell] (esm-libraries-spec 4.7.5, 'Pointwise lift: index sets').",
    "authors": [
      "EarthSciAST test suite"
    ],
    "created": "2026-11-01T00:00:00Z"
  },
  "index_sets": {
    "cell": {
      "kind": "interval",
      "size": 4
    },
    "lev": {
      "kind": "interval",
      "size": 2
    }
  },
  "models": {
    "Chem": {
      "variables": {
        "c": {
          "type": "unknown",
          "units": "mol/mol",
          "default": 1.0
        },
        "k": {
          "type": "parameter",
          "units": "1/s",
          "default": 0.1
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "c"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "*",
            "args": [
              {
                "op": "-",
                "args": [
                  "k"
                ]
              },
              "c"
            ]
          }
        }
      ]
    },
    "Dep": {
      "variables": {
        "kd": {
          "type": "parameter",
          "units": "1/s",
          "default": 0.0002
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "_var"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "makearray",
            "args": [],
            "regions": [
              [
                [
                  1,
                  4
                ]
              ]
            ],
            "values": [
              {
                "op": "faq",
                "args": [],
                "output_idx": [
                  "i"
                ],
                "ranges": {
                  "i": [
                    1,
                    4
                  ]
                },
                "expr": {
                  "op": "*",
                  "args": [
                    {
                      "op": "-",
                      "args": [
                        "kd"
                      ]
                    },
                    {
                      "op": "index",
                      "args": [
                        "_var",
                        "i"
                      ]
                    }
                  ]
                }
              }
            ]
          }
        }
      ]
    }
  },
  "coupling": [
    {
      "type": "operator_compose",
      "systems": [
        "Chem",
        "Dep"
      ],
      "lifting": "pointwise"
    }
  ]
}
