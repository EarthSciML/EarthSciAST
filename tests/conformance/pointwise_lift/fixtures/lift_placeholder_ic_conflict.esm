{
  "esm": "1.3.0",
  "metadata": {
    "name": "LiftPlaceholderIcConflict",
    "description": "Chem declares its own field initial condition ic(c) ~ 3 and the operator Dep declares ic(_var) ~ Dep.c0 * 2, which operator_compose expands onto every state of Chem, Chem.c included. Chem.c would then have two initial conditions and nothing says which one holds, so flatten refuses the document with ConflictingDerivativeError (esm-libraries-spec 4.7.1 step 3, 4.7.5 step 4 field_ics).",
    "authors": [
      "EarthSciAST test suite"
    ],
    "created": "2026-11-01T00:00:00Z"
  },
