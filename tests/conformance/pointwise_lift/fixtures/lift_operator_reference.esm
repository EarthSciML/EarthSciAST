{
  "esm": "1.3.0",
  "metadata": {
    "name": "LiftOperatorReference",
    "description": "lift_same_size_index_sets.esm with Wind's operator written as the expression template adv(q, w), whose body is the operator makearray. Chem.c is lifted onto [x, y] exactly as for the inline operator: the lift decides on what the reference denotes (esm-spec 9.6.4 rule 2; esm-libraries-spec 4.7.5).",
    "authors": [
      "EarthSciAST test suite"
    ],
    "created": "2026-11-01T00:00:00Z"
  },
  "index_sets": {
    "y": {
      "kind": "interval",
      "size": 3
    },
    "x": {
      "kind": "interval",
      "size": 3
    }
  },
  "models": {
    "Chem": {
      "variables": {
        "c": {
          "type": "unknown",
          "units": "mol/mol",
          "default": 1.0
        },
        "k": {
          "type": "parameter",
          "units": "1/s",
          "default": 0.1
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "c"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "*",
            "args": [
              {
                "op": "-",
                "args": [
                  "k"
                ]
              },
              "c"
            ]
          }
        }
      ]
    },
    "Wind": {
      "variables": {
        "u": {
          "type": "parameter",
          "units": "m/s",
          "default": 2.0,
          "shape": [
            "x",
            "y"
          ]
        },
        "dx": {
          "type": "parameter",
          "units": "m",
          "default": 100.0
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "_var"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "apply_expression_template",
            "args": [],
            "name": "adv",
            "bindings": {
              "q": "_var",
              "w": "u"
            }
          }
        }
      ],
      "expression_templates": {
        "adv": {
          "params": [
            "q",
            "w"
          ],
          "body": {
            "op": "makearray",
            "args": [],
            "regions": [
              [
                [
                  1,
                  3
                ],
                [
                  1,
                  3
                ]
              ]
            ],
            "values": [
              {
                "op": "faq",
                "args": [],
                "output_idx": [
                  "i",
                  "j"
                ],
                "ranges": {
                  "i": [
                    1,
                    3
                  ],
                  "j": [
                    1,
                    3
                  ]
                },
                "expr": {
                  "op": "/",
                  "args": [
                    {
                      "op": "*",
                      "args": [
                        {
                          "op": "-",
                          "args": [
                            {
                              "op": "index",
                              "args": [
                                "w",
                                "i",
                                "j"
                              ]
                            }
                          ]
                        },
                        {
                          "op": "index",
                          "args": [
                            "q",
                            "i",
                            "j"
                          ]
                        }
                      ]
                    },
                    "dx"
                  ]
                }
              }
            ]
          }
        }
      }
    }
  },
  "coupling": [
    {
      "type": "operator_compose",
      "systems": [
        "Chem",
        "Wind"
      ],
      "lifting": "pointwise"
    }
  ]
}