{
  "esm": "2.2.0",
  "metadata": {
    "name": "LiftFixpoint",
    "description": "Lifting repeats until nothing changes (esm-libraries-spec 4.7.5). Mech is lifted through its rate; that makes Uptake.u's tendency, which reads Mech.A, an array, so Uptake is lifted; that makes Store.s's tendency, which reads Uptake.u, an array, so Store is lifted too. Each component is visited in a later pass than the one it reads.",
    "authors": [
      "EarthSciAST test suite"
    ],
    "created": "2026-11-13T00:00:00Z"
  },
  "index_sets": {
    "lev": {
      "kind": "interval",
      "size": 3
    }
  },
