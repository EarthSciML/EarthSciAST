{
  "esm": "1.3.0",
  "metadata": {
    "name": "LiftSameSizeIndexSets",
    "description": "Pointwise lift onto a 3 x 3 grid whose two index sets have the same size. The size match alone cannot tell x from y, and the registry declares y first, so neither size nor declaration order decides. The operand Wind.u is declared on [x, y] and gathered at the lift's loops (i, j), which names dimension 1 x and dimension 2 y, so Chem.c is lifted onto [x, y] (esm-libraries-spec 4.7.5, 'Pointwise lift: index sets').",
    "authors": [
      "EarthSciAST test suite"
    ],
    "created": "2026-11-01T00:00:00Z"
  },
  "index_sets": {
    "y": {
      "kind": "interval",
      "size": 3
    },
    "x": {
      "kind": "interval",
      "size": 3
    }
  },
  "models": {
    "Chem": {
      "variables": {
        "c": {
          "type": "unknown",
          "units": "mol/mol",
          "default": 1.0
        },
        "k": {
          "type": "parameter",
          "units": "1/s",
          "default": 0.1
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "c"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "*",
            "args": [
              {
                "op": "-",
                "args": [
                  "k"
                ]
              },
              "c"
            ]
          }
        }
      ]
    },
    "Wind": {
      "variables": {
        "u": {
          "type": "parameter",
          "units": "m/s",
          "default": 2.0,
          "shape": [
            "x",
            "y"
          ]
        },
        "dx": {
          "type": "parameter",
          "units": "m",
          "default": 100.0
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "_var"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "makearray",
            "args": [],
            "regions": [
              [
                [
                  1,
                  3
                ],
                [
                  1,
                  3
                ]
              ]
            ],
            "values": [
              {
                "op": "faq",
                "args": [],
                "output_idx": [
                  "i",
                  "j"
                ],
                "ranges": {
                  "i": [
                    1,
                    3
                  ],
                  "j": [
                    1,
                    3
                  ]
                },
                "expr": {
                  "op": "/",
                  "args": [
                    {
                      "op": "*",
                      "args": [
                        {
                          "op": "-",
                          "args": [
                            {
                              "op": "index",
                              "args": [
                                "u",
                                "i",
                                "j"
                              ]
                            }
                          ]
                        },
                        {
                          "op": "index",
                          "args": [
                            "_var",
                            "i",
                            "j"
                          ]
                        }
                      ]
                    },
                    "dx"
                  ]
                }
              }
            ]
          }
        }
      ]
    }
  },
  "coupling": [
    {
      "type": "operator_compose",
      "systems": [
        "Chem",
        "Wind"
      ],
      "lifting": "pointwise"
    }
  ]
}
