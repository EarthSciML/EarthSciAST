{
  "esm": "2.2.0",
  "metadata": {
    "name": "LiftUntouchedSpecies",
    "description": "The unit of lifting is the whole component (esm-libraries-spec 4.7.5). Mech.C takes part in no reaction and Box.y reads no array, yet both are lifted onto [lev] with the rest of their components: Mech because its rate reads a [lev] temperature through a variable_map, Box because Box.x reads Column.T directly.",
    "authors": [
      "EarthSciAST test suite"
    ],
    "created": "2026-11-13T00:00:00Z"
  },
  "index_sets": {
    "lev": {
      "kind": "interval",
      "size": 3
    }
  },
  "models": {
    "Column": {
      "variables": {
        "T": {
          "type": "parameter",
          "units": "K",
          "default": 300.0,
          "shape": [
            "lev"
          ]
        }
      },
      "equations": []
    },
    "Rates": {
      "variables": {
        "T": {
          "type": "parameter",
          "units": "K",
          "default": 300.0
        },
        "k1": {
          "type": "unknown",
          "units": "1/s"
        }
      },
      "equations": [
        {
          "lhs": "k1",
          "rhs": {
            "op": "*",
            "args": [
              0.001,
              {
                "op": "/",
                "args": [
                  "T",
                  300.0
                ]
              }
            ]
          }
        }
      ]
    },
    "Box": {
      "variables": {
        "x": {
          "type": "unknown",
          "units": "1",
          "default": 1.0
        },
        "y": {
          "type": "unknown",
          "units": "1",
          "default": 2.0
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "x"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "*",
            "args": [
              -1e-05,
              "Column.T",
              "x"
            ]
          }
        },
        {
          "lhs": {
            "op": "D",
            "args": [
              "y"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "*",
            "args": [
              -0.1,
              "y"
            ]
          }
        }
      ]
    }
  },
  "reaction_systems": {
    "Mech": {
      "species": {
        "A": {
          "units": "1",
          "default": 1.0
        },
        "B": {
          "units": "1",
          "default": 1.0
        },
        "C": {
          "units": "1",
          "default": 1.0
        }
      },
      "parameters": {
        "kb": {
          "units": "1/s",
          "default": 0.002
        }
      },
      "reactions": [
        {
          "id": "R1",
          "substrates": [
            {
              "species": "A",
              "stoichiometry": 1
            }
          ],
          "products": [
            {
              "species": "B",
              "stoichiometry": 1
            }
          ],
          "rate": "Rates.k1"
        },
        {
          "id": "R2",
          "substrates": [
            {
              "species": "B",
              "stoichiometry": 1
            }
          ],
          "products": null,
          "rate": "kb"
        }
      ]
    }
  },
  "coupling": [
    {
      "type": "variable_map",
      "from": "Column.T",
      "to": "Rates.T",
      "transform": "param_to_var",
      "lifting": "pointwise"
    }
  ]
}
