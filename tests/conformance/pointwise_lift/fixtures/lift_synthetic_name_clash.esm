{
  "esm": "1.3.0",
  "metadata": {
    "name": "LiftSyntheticNameClash",
    "description": "Refused at flatten. Dimension 1 of the 3 x 5 grid has two index sets of size 3 (a, b) and no shaped operand, so the lift needs the synthetic index set _liftdim1_3, but the document declares _liftdim1_3 with size 4. Flatten refuses rather than shadow the declared set or name an index set whose size is not the extent (esm-libraries-spec 4.7.5, 'Pointwise lift: index sets').",
    "authors": [
      "EarthSciAST test suite"
    ],
    "created": "2026-11-01T00:00:00Z"
  },
  "index_sets": {
    "a": {
      "kind": "interval",
      "size": 3
    },
    "b": {
      "kind": "interval",
      "size": 3
    },
    "_liftdim1_3": {
      "kind": "interval",
      "size": 4
    }
  },
  "models": {
    "Chem": {
      "variables": {
        "c": {
          "type": "unknown",
          "units": "mol/mol",
          "default": 1.0
        },
        "k": {
          "type": "parameter",
          "units": "1/s",
          "default": 0.1
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "c"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "*",
            "args": [
              {
                "op": "-",
                "args": [
                  "k"
                ]
              },
              "c"
            ]
          }
        }
      ]
    },
    "Mix": {
      "variables": {
        "kd": {
          "type": "parameter",
          "units": "1/s",
          "default": 0.0002
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "_var"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "makearray",
            "args": [],
            "regions": [
              [
                [
                  1,
                  3
                ],
                [
                  1,
                  5
                ]
              ]
            ],
            "values": [
              {
                "op": "faq",
                "args": [],
                "output_idx": [
                  "i",
                  "j"
                ],
                "ranges": {
                  "i": [
                    1,
                    3
                  ],
                  "j": [
                    1,
                    5
                  ]
                },
                "expr": {
                  "op": "*",
                  "args": [
                    {
                      "op": "-",
                      "args": [
                        "kd"
                      ]
                    },
                    {
                      "op": "index",
                      "args": [
                        "_var",
                        "i",
                        "j"
                      ]
                    }
                  ]
                }
              }
            ]
          }
        }
      ]
    }
  },
  "coupling": [
    {
      "type": "operator_compose",
      "systems": [
        "Chem",
        "Mix"
      ],
      "lifting": "pointwise"
    }
  ]
}
