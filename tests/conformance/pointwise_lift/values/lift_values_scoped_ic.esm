{
  "esm": "2.2.0",
  "metadata": {
    "name": "LiftValuesScopedIc",
    "description": "Values of a pointwise lift through an operator written elementwise, D(_var) = -km * _var with km on [lev] (esm-spec 10.5), with lifting omitted. The scoped initial condition ic(Mech.A) ~ Column.A0, A0 on [lev], sets each level of the lifted species.",
    "authors": [
      "EarthSciAST test suite"
    ],
    "created": "2026-11-13T00:00:00Z"
  },
  "index_sets": {
    "lev": {
      "kind": "interval",
      "size": 3
    }
  },
  "models": {
    "Column": {
      "variables": {
        "T": {
          "type": "parameter",
          "units": "K",
          "shape": [
            "lev"
          ],
          "default": 300.0
        },
        "A0": {
          "type": "parameter",
          "units": "1",
          "shape": [
            "lev"
          ],
          "default": 1.0
        },
        "km": {
          "type": "parameter",
          "units": "1/s",
          "shape": [
            "lev"
          ],
          "default": 0.0
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "ic",
            "args": [
              "Mech.A"
            ]
          },
          "rhs": "A0"
        }
      ],
      "tests": [
        {
          "id": "per_level",
          "parameter_overrides": {
            "Column.T": [
              300.0,
              600.0,
              150.0
            ],
            "Column.A0": [
              1.0,
              2.0,
              4.0
            ],
            "Column.km": [
              0.0,
              0.001,
              0.002
            ]
          },
          "time_span": {
            "start": 0,
            "end": 0
          },
          "assertions": [
            {
              "variable": "Mech.A[1]",
              "time": 0.0,
              "expected": 1.0,
              "tolerance": {
                "abs": 1e-15,
                "rel": 0.0
              }
            },
            {
              "variable": "Mech.A[2]",
              "time": 0.0,
              "expected": 2.0,
              "tolerance": {
                "abs": 1e-15,
                "rel": 0.0
              }
            },
            {
              "variable": "Mech.A[3]",
              "time": 0.0,
              "expected": 4.0,
              "tolerance": {
                "abs": 1e-15,
                "rel": 0.0
              }
            },
            {
              "variable": "Tend.dA_dt[1]",
              "time": 0.0,
              "expected": -0.001,
              "tolerance": {
                "abs": 1e-15,
                "rel": 0.0
              }
            },
            {
              "variable": "Tend.dA_dt[2]",
              "time": 0.0,
              "expected": -0.006,
              "tolerance": {
                "abs": 1e-15,
                "rel": 0.0
              }
            },
            {
              "variable": "Tend.dA_dt[3]",
              "time": 0.0,
              "expected": -0.01,
              "tolerance": {
                "abs": 1e-15,
                "rel": 0.0
              }
            }
          ]
        }
      ]
    },
    "Sink": {
      "variables": {
        "km": {
          "type": "parameter",
          "units": "1/s",
          "default": 0.0
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "_var"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "*",
            "args": [
              {
                "op": "-",
                "args": [
                  "km"
                ]
              },
              "_var"
            ]
          }
        }
      ]
    },
    "Rates": {
      "variables": {
        "T": {
          "type": "parameter",
          "units": "K",
          "default": 300.0
        },
        "k1": {
          "type": "unknown",
          "units": "1/s"
        }
      },
      "equations": [
        {
          "lhs": "k1",
          "rhs": {
            "op": "*",
            "args": [
              0.001,
              {
                "op": "/",
                "args": [
                  "T",
                  300.0
                ]
              }
            ]
          }
        }
      ]
    },
    "Tend": {
      "variables": {
        "dA_dt": {
          "type": "unknown",
          "units": "1/s"
        },
        "dB_dt": {
          "type": "unknown",
          "units": "1/s"
        }
      },
      "equations": [
        {
          "lhs": "dA_dt",
          "rhs": {
            "op": "D",
            "args": [
              "Mech.A"
            ],
            "wrt": "t"
          }
        },
        {
          "lhs": "dB_dt",
          "rhs": {
            "op": "D",
            "args": [
              "Mech.B"
            ],
            "wrt": "t"
          }
        }
      ]
    }
  },
  "reaction_systems": {
    "Mech": {
      "species": {
        "A": {
          "units": "1",
          "default": 1.0
        },
        "B": {
          "units": "1",
          "default": 0.5
        }
      },
      "parameters": {
        "kb": {
          "units": "1/s",
          "default": 0.002
        }
      },
      "reactions": [
        {
          "id": "R1",
          "substrates": [
            {
              "species": "A",
              "stoichiometry": 1
            }
          ],
          "products": [
            {
              "species": "B",
              "stoichiometry": 1
            }
          ],
          "rate": "Rates.k1"
        },
        {
          "id": "R2",
          "substrates": [
            {
              "species": "B",
              "stoichiometry": 1
            }
          ],
          "products": null,
          "rate": "kb"
        }
      ]
    }
  },
  "coupling": [
    {
      "type": "variable_map",
      "from": "Column.T",
      "to": "Rates.T",
      "transform": "param_to_var"
    },
    {
      "type": "variable_map",
      "from": "Column.km",
      "to": "Sink.km",
      "transform": "param_to_var"
    },
    {
      "type": "operator_compose",
      "systems": [
        "Mech",
        "Sink"
      ]
    }
  ]
}
