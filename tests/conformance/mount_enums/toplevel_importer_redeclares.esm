{
  "esm": "1.0.0",
  "metadata": {
    "name": "MountEnumsTopLevelImporterRedeclares",
    "description": "The mounting document declares probe.Symbol = 7 and reads it itself. Its declaration changes neither leaf, and its own `enum` op reads its own 7.",
    "authors": [
      "EarthSciML Authors and Contributors"
    ]
  },
  "enums": {
    "probe": {
      "Symbol": 7
    }
  },
  "models": {
    "One": {
      "ref": "./leaf_one.esm"
    },
    "Two": {
      "ref": "./leaf_two.esm"
    },
    "Probe": {
      "variables": {
        "own": {
          "type": "unknown",
          "units": "1",
          "description": "The value THIS file's `enums` block gives probe.Symbol."
        }
      },
      "equations": [
        {
          "lhs": "own",
          "rhs": {
            "op": "enum",
            "args": [
              "probe",
              "Symbol"
            ]
          }
        }
      ]
    }
  }
}
