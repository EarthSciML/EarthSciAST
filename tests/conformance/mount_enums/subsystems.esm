{
  "esm": "1.0.0",
  "metadata": {
    "name": "MountEnumsSubsystems",
    "description": "The same two leaves mounted at `subsystems.<k>` `{ref}` edges, under a model that declares probe.Symbol = 7 and reads it. Both mount forms resolve a leaf's `enum` ops the same way (esm-spec §4.7, §9.3).",
    "authors": [
      "EarthSciML Authors and Contributors"
    ]
  },
  "enums": {
    "probe": {
      "Symbol": 7
    }
  },
  "models": {
    "Probe": {
      "subsystems": {
        "One": {
          "ref": "./leaf_one.esm"
        },
        "Two": {
          "ref": "./leaf_two.esm"
        }
      },
      "variables": {
        "own": {
          "type": "unknown",
          "units": "1",
          "description": "The value THIS file's `enums` block gives probe.Symbol."
        }
      },
      "equations": [
        {
          "lhs": "own",
          "rhs": {
            "op": "enum",
            "args": [
              "probe",
              "Symbol"
            ]
          }
        }
      ]
    }
  }
}
