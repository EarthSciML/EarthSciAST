{
  "esm": "1.1.0",
  "metadata": {
    "name": "BooleanLiteralFalse",
    "description": "The `false` literal operator of esm-spec \u00a79.2's evaluable core, on its own. It is split out of `scalar_operator_semantics` because it is the one core operator the three bindings do not agree on: Julia's tree-walk evaluator carries a rule for `true` and none for `false`, so it refuses this document with `unevaluable_operator`. Keeping it here makes that refusal a NAMED EXCLUSION of ONE operator instead of an exclusion from every operator the sibling fixture pins.",
    "authors": [
      "EarthSciML Authors and Contributors"
    ],
    "tags": [
      "conformance",
      "scalar_operator_semantics",
      "inline-test",
      "boolean-literal"
    ],
    "license": "MIT"
  },
  "models": {
    "FalseOp": {
      "variables": {
        "literal_false": {
          "type": "unknown",
          "units": "1",
          "description": "The `false` literal op, which must be 0 exactly."
        },
        "probe": {
          "type": "unknown",
          "units": "1",
          "default": 0.0,
          "description": "probe(t) = t. The document's only integrated state."
        }
      },
      "equations": [
        {
          "lhs": "literal_false",
          "rhs": {
            "op": "false",
            "args": []
          }
        },
        {
          "lhs": {
            "op": "D",
            "args": [
              "probe"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "+",
            "args": [
              "literal_false",
              1
            ]
          }
        }
      ],
      "tests": [
        {
          "id": "false_literal_is_zero",
          "description": "`false` is 0, so probe integrates 0 + 1 and reaches 1 at t = 1.",
          "time_span": {
            "start": 0.0,
            "end": 1.0
          },
          "tolerance": {
            "rel": 1e-12,
            "abs": 1e-13
          },
          "assertions": [
            {
              "variable": "literal_false",
              "time": 0.0,
              "expected": 0.0
            },
            {
              "variable": "probe",
              "time": 1.0,
              "expected": 1.0,
              "tolerance": {
                "rel": 1e-09,
                "abs": 1e-11
              }
            }
          ]
        }
      ]
    }
  }
}
