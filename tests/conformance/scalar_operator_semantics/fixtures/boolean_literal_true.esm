{
  "esm": "1.1.0",
  "metadata": {
    "name": "TrueOp",
    "description": "The `true` literal operator of esm-spec \u00a79.2's evaluable core, on its own. It is split out of `scalar_operator_semantics` because Rust's strict `native` has no wholesale lowering for it and refuses the whole document with `compiler_refused_rule` \u2014 while Rust's `interpreter` runs it, and Julia and Python run it under both compilers. The split is what keeps one unlowered leaf from costing the other 84 operators their `native` coverage.",
    "authors": [
      "EarthSciML Authors and Contributors"
    ],
    "tags": [
      "conformance",
      "scalar_operator_semantics",
      "inline-test",
      "boolean-literal"
    ],
    "license": "MIT"
  },
  "models": {
    "TrueOp": {
      "variables": {
        "literal_true": {
          "type": "unknown",
          "units": "1",
          "description": "The operator under test: The `true` literal operator of esm-spec \u00a79.2's evaluable core, on its own. It is split out of `scalar_operator_semantics` because Rust's strict `native` has no wholesale lowering for it and refuses the whole document with `compiler_refused_rule` \u2014 while Rust's `interpreter` runs it, and Julia and Python run it under both compilers. The split is what keeps one unlowered leaf from costing the other 84 operators their `native` coverage."
        },
        "probe": {
          "type": "unknown",
          "units": "1",
          "default": 0.0,
          "description": "Integrates the observed, so the value is read as well as computed."
        }
      },
      "equations": [
        {
          "lhs": "literal_true",
          "rhs": {
            "op": "true",
            "args": []
          }
        },
        {
          "lhs": {
            "op": "D",
            "args": [
              "probe"
            ],
            "wrt": "t"
          },
          "rhs": "literal_true"
        }
      ],
      "tests": [
        {
          "id": "literal_true_value",
          "description": "The `true` literal operator of esm-spec \u00a79.2's evaluable core, on its own. It is split out of `scalar_operator_semantics` because Rust's strict `native` has no wholesale lowering for it and refuses the whole document with `compiler_refused_rule` \u2014 while Rust's `interpreter` runs it, and Julia and Python run it under both compilers. The split is what keeps one unlowered leaf from costing the other 84 operators their `native` coverage.",
          "time_span": {
            "start": 0.0,
            "end": 1.0
          },
          "tolerance": {
            "rel": 0.0,
            "abs": 0.0
          },
          "assertions": [
            {
              "variable": "literal_true",
              "time": 0.0,
              "expected": 1.0
            },
            {
              "variable": "probe",
              "time": 1.0,
              "expected": 1.0,
              "tolerance": {
                "rel": 1e-09,
                "abs": 1e-11
              }
            }
          ]
        }
      ]
    }
  }
}
