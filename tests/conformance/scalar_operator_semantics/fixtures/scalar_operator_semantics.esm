        },
        "arctangent_two_argument": {
          "type": "unknown",
          "units": "rad",
          "description": "atan2(1, 1) = pi/4 \u2014 argument ORDER is (y, x), so a binding that swapped them lands on the same number here ONLY because y == x; `arctangent_quadrant` below is the arm that separates them."
        },
        "arctangent_quadrant": {
          "type": "unknown",
          "units": "rad",
          "description": "atan2(1, -3) is in the SECOND quadrant; atan2(-3, 1) is in the fourth. This is the assertion a swapped argument order fails."
        },
