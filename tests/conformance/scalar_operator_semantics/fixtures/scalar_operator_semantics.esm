        },
        "power_ten": {
          "type": "unknown",
          "units": "1",
          "description": "2^10 = 1024, exactly."
        },
        "exponential_at_one": {
          "type": "unknown",
          "units": "1",
          "description": "exp(1) = e. The one elementary row whose last bits are a libm's, so it carries a looser bound than the exact rows around it."
