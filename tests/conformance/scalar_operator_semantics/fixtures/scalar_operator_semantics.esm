        },
        "negated": {
          "type": "unknown",
          "units": "1",
          "description": "`neg` is canonicalize's spelling of unary minus and must agree with it."
        },
        "product_of_three": {
          "type": "unknown",
          "units": "1",
          "description": "n-ary `*`."
        },
        "quotient": {
          "type": "unknown",
          "units": "1",
          "description": "`/` is TRUE division, never integer division."
        },
        "caret_power": {
          "type": "unknown",
          "units": "1",
          "description": "`^` with an integer-literal exponent."
        },
        "integer_literal": {
          "type": "unknown",
          "units": "1",
          "description": "A bare integer literal evaluates to the real 7, not to an integer type that would then truncate."
        },
        "integer_sum": {
          "type": "unknown",
          "units": "1",
          "description": "Two integer literals add as reals."
        },
        "integer_times_float": {
          "type": "unknown",
          "units": "1",
          "description": "An integer literal times a float literal is 4.5, NOT 4 \u2014 the arm that catches a binding that keeps integer arithmetic."
        },
        "integer_quotient": {
          "type": "unknown",
          "units": "1",
          "description": "7/2 is 3.5, NOT 3 \u2014 the sharpest statement that `/` is not integer division."
        },
        "less_than": {
          "type": "unknown",
          "units": "1",
          "description": "A true comparison is 1."
        },
        "less_equal": {
          "type": "unknown",
          "units": "1",
          "description": "`<=` is inclusive."
        },
        "greater_than": {
          "type": "unknown",
          "units": "1",
          "description": "A false comparison is 0."
        },
        "greater_equal": {
          "type": "unknown",
          "units": "1",
          "description": "`>=`."
        },
        "equal": {
          "type": "unknown",
          "units": "1",
          "description": "`==`."
        },
        "not_equal": {
          "type": "unknown",
          "units": "1",
          "description": "`!=`."
        },
        "conjunction": {
          "type": "unknown",
          "units": "1",
          "description": "`and` over two true comparisons."
        },
        "conjunction_false": {
          "type": "unknown",
          "units": "1",
          "description": "`and` is 0 as soon as one operand is false \u2014 the arm that catches a binding returning the LAST operand instead of a truth value."
        },
        "disjunction": {
          "type": "unknown",
          "units": "1",
          "description": "`or` with a false first operand."
        },
        "negation": {
          "type": "unknown",
          "units": "1",
          "description": "`not` of a false comparison."
        },
        "ifelse_taken": {
          "type": "unknown",
          "units": "1",
          "description": "`ifelse` takes the second argument when the predicate holds."
        },
        "ifelse_untaken": {
          "type": "unknown",
          "units": "1",
          "description": "`ifelse` takes the third argument when it does not."
        },
        "sign_negative": {
          "type": "unknown",
          "units": "1",
          "description": "sign(-3) = -1."
        },
        "sign_zero": {
          "type": "unknown",
          "units": "1",
          "description": "sign(0) = 0 \u2014 NOT +1, which is what a `x < 0 ? -1 : 1` spelling gives."
        },
        "sign_positive": {
          "type": "unknown",
          "units": "1",
          "description": "sign(42) = 1."
        },
