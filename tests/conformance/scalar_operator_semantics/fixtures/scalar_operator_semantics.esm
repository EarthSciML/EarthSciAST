          "units": "1",
          "description": "==(2, 2) = 1."
        },
        "not_equal_wide": {
          "type": "unknown",
          "units": "1",
          "description": "!=(2, 3) = 1."
        },
        "conjunction_numeric": {
          "type": "unknown",
          "units": "1",
          "description": "`and` over NUMERIC truthiness, not over comparison results."
        },
        "conjunction_numeric_false": {
          "type": "unknown",
          "units": "1",
          "description": "and(1, 0) = 0."
        },
        "disjunction_numeric": {
          "type": "unknown",
          "units": "1",
          "description": "or(0, 1) = 1."
        },
        "disjunction_numeric_false": {
          "type": "unknown",
          "units": "1",
          "description": "or(0, 0) = 0."
        },
        "negation_of_zero": {
          "type": "unknown",
          "units": "1",
          "description": "not(0) = 1."
        },
        "negation_of_one": {
          "type": "unknown",
          "units": "1",
          "description": "not(1) = 0."
        },
        "time_value": {
          "type": "unknown",
          "units": "1",
          "description": "The bare name `t` is the simulation time, asserted at a NON-zero time so a binding that evaluates every assertion at the span start cannot pass it."
        },
        "probe": {
          "type": "unknown",
          "units": "1",
          "default": 0.0,
          "description": "probe(t) = 6 t. The document's only integrated state."
        }
