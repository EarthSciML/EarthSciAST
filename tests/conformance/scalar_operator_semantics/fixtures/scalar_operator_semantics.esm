        },
        "tangent_at_quarter_pi": {
          "type": "unknown",
          "units": "1",
          "description": "tan(pi/4). NOT exactly 1: pi/4 is not representable, so the answer is the double nearest to tan of the double nearest to pi/4, and the expectation is that number rather than the ideal one."
        },
        "minimum_two": {
          "type": "unknown",
          "units": "1",
          "description": "min(2, 3) = 2."
        },
        "maximum_two": {
          "type": "unknown",
          "units": "1",
          "description": "max(2, 3) = 3."
        },
        "ifelse_truthy": {
          "type": "unknown",
          "units": "1",
          "description": "A NON-boolean truthy predicate selects the second argument."
        },
        "ifelse_falsy": {
