{
  "esm": "1.1.0",
  "metadata": {
    "name": "ScalarOperatorSemantics",
    "description": "One algebraic document carrying one observed per EVALUABLE-CORE scalar operator, each reading declared parameters rather than folded literals, with its value pinned in an inline `tests` block. esm-spec \u00a79.2 names the operators; this fixture is what says what each one COMPUTES.",
    "authors": [
      "EarthSciML Authors and Contributors"
    ],
    "tags": [
      "conformance",
      "scalar_operator_semantics",
      "inline-test"
    ],
    "license": "MIT"
  },
