{
  "esm": "1.1.0",
  "metadata": {
    "name": "PowAlias",
    "description": "The deprecated `pow` spelling of exponentiation, on its own. esm-spec \u00a74.2 \"Deprecated ops\": `pow` is the word spelling of `^`, and a loader rewrites it to `^` with the warning `deprecated_op`, so every binding evaluates it to the same number as `^` (Rust once classed it as a rewrite target and refused it, issue #461). The sibling fixture pins `^(2, 3) = 8` under the caret spelling, so the two documents together pin that the deprecated spelling still loads and agrees. Kept on purpose when the corpus was migrated off `pow`.",
    "authors": [
      "EarthSciML Authors and Contributors"
    ],
    "tags": [
      "conformance",
      "scalar_operator_semantics",
      "inline-test",
      "power-alias"
    ],
    "license": "MIT"
  },
  "models": {
    "PowAlias": {
      "variables": {
        "pow_power": {
          "type": "unknown",
          "units": "1",
          "description": "The operator under test: The deprecated `pow` spelling of exponentiation, on its own. esm-spec \u00a74.2 \"Deprecated ops\": `pow` is the word spelling of `^`, and a loader rewrites it to `^` with the warning `deprecated_op`, so every binding evaluates it to the same number as `^` (Rust once classed it as a rewrite target and refused it, issue #461). The sibling fixture pins `^(2, 3) = 8` under the caret spelling, so the two documents together pin that the deprecated spelling still loads and agrees. Kept on purpose when the corpus was migrated off `pow`."
        },
        "probe": {
          "type": "unknown",
          "units": "1",
          "default": 0.0,
          "description": "Integrates the observed, so the value is read as well as computed."
        },
        "two": {
          "type": "parameter",
          "units": "1",
          "default": 2.0,
          "description": "2"
        }
      },
      "equations": [
        {
          "lhs": "pow_power",
          "rhs": {
            "op": "pow",
            "args": [
              "two",
              3
            ]
          }
        },
        {
          "lhs": {
            "op": "D",
            "args": [
              "probe"
            ],
            "wrt": "t"
          },
          "rhs": "pow_power"
        }
      ],
      "tests": [
        {
          "id": "pow_power_value",
          "description": "The deprecated `pow` spelling of exponentiation, on its own. esm-spec \u00a74.2 \"Deprecated ops\": `pow` is the word spelling of `^`, and a loader rewrites it to `^` with the warning `deprecated_op`, so every binding evaluates it to the same number as `^` (Rust once classed it as a rewrite target and refused it, issue #461). The sibling fixture pins `^(2, 3) = 8` under the caret spelling, so the two documents together pin that the deprecated spelling still loads and agrees. Kept on purpose when the corpus was migrated off `pow`.",
          "time_span": {
            "start": 0.0,
            "end": 1.0
          },
          "tolerance": {
            "rel": 0.0,
            "abs": 0.0
          },
          "assertions": [
            {
              "variable": "pow_power",
              "time": 0.0,
              "expected": 8.0
            },
            {
              "variable": "probe",
              "time": 1.0,
              "expected": 8.0,
              "tolerance": {
                "rel": 1e-09,
                "abs": 1e-11
              }
            }
          ]
        }
      ]
    }
  }
}
