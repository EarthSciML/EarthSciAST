{
  "esm": "1.1.0",
  "metadata": {
    "name": "ValueInventionCompositeKeyAxis_template",
    "description": "Template rewrite of tests/conformance/value_invention_materialize/fixtures/composite_key_axis.esm (generated by tests/conformance/relational_templates/rewrites/generate.py): the skolem / rank / gated-argmin value-invention ops replaced by lib/relational.esm templates. The two-column key is pair_key(polProcessID, engTechID, 0, 0, 1000, 1000). Run by the value_invention_materialize tier.",
    "authors": [
      "EarthSciML Authors and Contributors"
    ]
  },
  "index_sets": {
    "rows": {
      "kind": "interval",
      "size": 4
    },
    "composite_keys": {
      "kind": "derived",
      "from_faq": "key_set"
    }
  },
  "models": {
    "CompositeKeyAxis": {
      "expression_template_imports": [
        {
          "ref": "esm:std/relational.esm"
        }
      ],
      "variables": {
        "polProcessID": {
          "type": "unknown",
          "shape": [
            "rows"
          ]
        },
        "engTechID": {
          "type": "unknown",
          "shape": [
            "rows"
          ]
        },
        "keyExists": {
          "type": "unknown",
          "shape": [
            "composite_keys"
          ]
        },
        "distinctKeyCount": {
          "type": "unknown"
        }
      },
      "equations": [
        {
          "lhs": "polProcessID",
          "rhs": {
            "op": "const",
            "args": [],
            "value": [
              101,
              201,
              101,
              101
            ]
          }
        },
        {
          "lhs": "engTechID",
          "rhs": {
            "op": "const",
            "args": [],
            "value": [
              121,
              121,
              122,
              121
            ]
          }
        },
        {
          "_comment": "Three distinct pairs: (101,121) twice, (201,121), (101,122).",
          "lhs": {
            "op": "index",
            "args": [
              "keyExists",
              "e"
            ]
          },
          "rhs": {
            "op": "faq",
            "id": "key_set",
            "args": [],
            "semiring": "bool_and_or",
            "distinct": true,
            "output_idx": [
              "e"
            ],
            "ranges": {
              "n": {
                "from": "rows"
              }
            },
            "key": {
              "op": "apply_expression_template",
              "args": [],
              "name": "pair_key",
              "bindings": {
                "a": {
                  "op": "index",
                  "args": [
                    "polProcessID",
                    "n"
                  ]
                },
                "b": {
                  "op": "index",
                  "args": [
                    "engTechID",
                    "n"
                  ]
                },
                "lo_a": 0,
                "lo_b": 0,
                "n_a": 1000,
                "n_b": 1000
              }
            },
            "filter": {
              "op": "true",
              "args": []
            },
            "expr": {
              "op": "true",
              "args": []
            }
          }
        },
        {
          "lhs": "distinctKeyCount",
          "rhs": {
            "op": "faq",
            "args": [],
            "output_idx": [],
            "ranges": {
              "e": {
                "from": "composite_keys"
              }
            },
            "expr": 1.0
          }
        }
      ],
      "tests": [
        {
          "id": "derived_axis_has_three_members",
          "time_span": {
            "start": 0.0,
            "end": 1.0
          },
          "assertions": [
            {
              "variable": "distinctKeyCount",
              "time": 0.0,
              "expected": 3.0
            }
          ]
        }
      ]
    }
  }
}
