{
  "esm": "1.1.0",
  "metadata": {
    "name": "ValueInventionStateKeyRefused",
    "description": "Issue #266 refusal half. The same derived axis as composite_key_axis.esm, but the skolem key also reads the ODE state `u`, so the producer classifies CONTINUOUS and cannot be materialized at build time (CONFORMANCE_SPEC \u00a75.7 guard 2). A contraction over the derived axis MUST be refused with `derived_index_set_unmaterialized`; it MUST NOT read 0.",
    "authors": [
      "EarthSciML Authors and Contributors"
    ]
  },
  "index_sets": {
    "rows": {
      "kind": "interval",
      "size": 4
    },
    "composite_keys": {
      "kind": "derived",
      "from_faq": "key_set"
    }
  },
  "models": {
    "CompositeKeyAxis": {
      "variables": {
        "polProcessID": {
          "type": "unknown",
          "shape": [
            "rows"
          ]
        },
        "engTechID": {
          "type": "unknown",
          "shape": [
            "rows"
          ]
        },
        "keyExists": {
          "type": "unknown",
          "shape": [
            "composite_keys"
          ]
        },
        "distinctKeyCount": {
          "type": "unknown"
        },
        "u": {
          "type": "unknown",
          "default": 1.0
        }
      },
      "equations": [
        {
          "lhs": "polProcessID",
          "rhs": {
            "op": "const",
            "args": [],
            "value": [
              101,
              201,
              101,
              101
            ]
          }
        },
        {
          "lhs": "engTechID",
          "rhs": {
            "op": "const",
            "args": [],
            "value": [
              121,
              121,
              122,
              121
            ]
          }
        },
        {
          "_comment": "Three distinct pairs: (101,121) twice, (201,121), (101,122).",
          "lhs": {
            "op": "index",
            "args": [
              "keyExists",
              "e"
            ]
          },
          "rhs": {
            "op": "faq",
            "id": "key_set",
            "args": [],
            "semiring": "bool_and_or",
            "distinct": true,
            "output_idx": [
              "e"
            ],
            "ranges": {
              "n": {
                "from": "rows"
              }
            },
            "key": {
              "op": "skolem",
              "label": "pol_process_eng_tech",
              "args": [
                {
                  "op": "index",
                  "args": [
                    "polProcessID",
                    "n"
                  ]
                },
                {
                  "op": "index",
                  "args": [
                    "engTechID",
                    "n"
                  ]
                },
                "u"
              ]
            },
            "filter": {
              "op": "true",
              "args": []
            },
            "expr": {
              "op": "true",
              "args": []
            }
          }
        },
        {
          "lhs": "distinctKeyCount",
          "rhs": {
            "op": "faq",
            "args": [],
            "output_idx": [],
            "ranges": {
              "e": {
                "from": "composite_keys"
              }
            },
            "expr": 1.0
          }
        },
        {
          "lhs": {
            "op": "D",
            "args": [
              "u"
            ],
            "wrt": "t"
          },
          "rhs": 0.0
        }
      ],
      "tests": [
        {
          "id": "derived_axis_has_three_members",
          "time_span": {
            "start": 0.0,
            "end": 1.0
          },
          "assertions": [
            {
              "variable": "distinctKeyCount",
              "time": 0.0,
              "expected": 3.0
            }
          ]
        }
      ]
    }
  }
}
