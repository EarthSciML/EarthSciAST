{
  "esm": "1.0.0",
  "metadata": {
    "name": "merged_rename_registry_body_reads_the_survivor",
    "description": "A `translate` match merges `Sink.O3` onto `Chem.ozone`, and `Sink`'s template `scaled_loss` reads its local `O3` free in its body. A body's free names are read at each reference's site (esm-spec §9.6.4 rules 1-2), and flatten closes every carried body: `O3` becomes a parameter of `scaled_loss` that Sink's reference binds to `Sink.O3` (esm-spec §10.7). The merge rewrites that binding like any other site, so the reference reads the survivor `Chem.ozone`, exactly as the expansion does; nothing is refused and no registry body names the merged-away state.",
    "authors": [
      "EarthSciAST"
    ],
    "tags": [
      "esm-libraries-spec-4.7.1",
      "operator-compose",
      "merged-away-rename",
      "expression-templates"
    ]
  },
  "models": {
    "Chem": {
      "reference": {
        "notes": "The SURVIVING spelling."
      },
      "variables": {
        "ozone": {
          "type": "unknown",
          "units": "ppb",
          "default": 30.0,
          "description": "Survives the merge as `Chem.ozone`."
        },
        "k": {
          "type": "parameter",
          "units": "1/s",
          "default": 0.0002,
          "description": "Chemical loss rate.",
          "shape": []
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "ozone"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "*",
            "args": [
              {
                "op": "-",
                "args": [
                  "k"
                ]
              },
              "ozone"
            ]
          }
        }
      ]
    },
    "Sink": {
      "reference": {
        "notes": "The MERGED-AWAY spelling, and the owner of the template whose body reads it."
      },
      "variables": {
        "O3": {
          "type": "unknown",
          "units": "ppb",
          "default": 40.0,
          "description": "The `translate` VALUE names it; it does not survive the merge."
        },
        "kd": {
          "type": "parameter",
          "units": "1/s",
          "default": 0.0001,
          "description": "Deposition rate.",
          "shape": []
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "O3"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "-",
            "args": [
              {
                "op": "apply_expression_template",
                "args": [],
                "name": "scaled_loss",
                "bindings": {
                  "rate": "kd"
                }
              }
            ]
          }
        }
      ],
      "expression_templates": {
        "scaled_loss": {
          "params": [
            "rate"
          ],
          "body": {
            "op": "*",
            "args": [
              "rate",
              "O3"
            ]
          }
        }
      }
    }
  },
  "coupling": [
    {
      "type": "operator_compose",
      "systems": [
        "Chem",
        "Sink"
      ],
      "translate": {
        "Chem.ozone": "Sink.O3"
      },
      "description": "Deletes `Sink.O3`. `scaled_loss`'s body reads it free; Sink's reference binds it after flatten closes the body, so the merge reaches it."
    }
  ]
}
