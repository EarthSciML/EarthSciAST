{
 "esm": "1.3.0",
 "metadata": {
  "name": "template_time_derivative_unanswered",
  "authors": [
   "EarthSciAST test suite"
  ],
  "description": "Structural time derivatives in template bodies that esm-spec §4.2's table cannot answer (esm-spec §9.6.4 rule 3, \"Time derivatives\"). `pw` holds D(p^2): `^` is outside the table, so the D stays in the body. `rate` holds D(p): bound to the state a it resolves, but bound to a^2 its p_dt has no resolution, so that reference keeps pointing at the unresolved body, registered as `rate.unresolved`. Flatten succeeds; the build gate refuses with unlowered_operator, as it refuses the expansion."
 },
 "models": {
  "M": {
   "expression_templates": {
    "rate": {
     "params": ["p"],
     "body": {"op": "D", "args": ["p"]}
    },
    "pw": {
     "params": ["p"],
     "body": {"op": "D", "args": [{"op": "^", "args": ["p", 2]}]}
    }
   },
   "variables": {
    "a": {"type": "unknown", "default": 1.5},
    "k": {"type": "parameter", "default": 0.5},
    "r1": {"type": "unknown"},
    "r2": {"type": "unknown"},
    "r3": {"type": "unknown"}
   },
   "equations": [
    {"lhs": {"op": "D", "args": ["a"], "wrt": "t"}, "rhs": {"op": "*", "args": [{"op": "-", "args": ["k"]}, "a"]}},
    {"lhs": "r1", "rhs": {"op": "apply_expression_template", "args": [], "name": "rate", "bindings": {"p": "a"}}},
    {"lhs": "r2", "rhs": {"op": "apply_expression_template", "args": [], "name": "rate", "bindings": {"p": {"op": "^", "args": ["a", 2]}}}},
    {"lhs": "r3", "rhs": {"op": "apply_expression_template", "args": [], "name": "pw", "bindings": {"p": "a"}}}
   ]
  }
 }
}
