{
  "esm": "1.0.0",
  "metadata": {
    "name": "url_substitutions_sized",
    "description": "A domain model whose axis is sized by its own metaparameter `n_rows` (default 2). It declares no data sources; the catalogue that mounts it does."
  },
  "metaparameters": {
    "n_rows": {
      "type": "integer",
      "default": 2
    }
  },
  "index_sets": {
    "rows": {
      "kind": "interval",
      "size": "n_rows"
    }
  },
  "models": {
    "Sized": {
      "variables": {
        "x": {
          "type": "parameter",
          "units": "1",
          "shape": [
            "rows"
          ],
          "default": 0.0
        }
      },
      "equations": []
    }
  }
}
