{
  "esm": "1.0.0",
  "metadata": {
    "name": "classification_indexed_lhs",
    "description": "esm-spec §6.3.1 admits TWO LHS spellings for the equation that DEFINES an unknown -- bare (`y ~ f(...)`) and indexed (`y[i] ~ f(...)`, which defines the whole array `y`) -- and neither is restricted by rank: the defining form is read through the LHS's BASE NAME, so an arrayed definition is observed exactly as its scalar counterpart is. This model writes an arrayed definition BOTH ways it is spelled in practice -- the bare `index(w, i)` of §6.3.1's own worked example, and the `aggregate{k}(index(w, k))` shell the corpus actually uses -- alongside the shapes each could be confused with: an `aggregate` over a `D` (a TENDENCY, so an ODE state), an expression LHS (an implicit constraint, so algebraic), and a scalar bare-LHS observed. Every unknown's cadence seed is pinned alongside, because §6.3.1 makes the misclassification cost concrete: `algebraic_unknowns` seeds CONTINUOUS, whereas an observed's cadence resolves through its defining RHS, so a state-free arrayed observed that is mis-credited as algebraic stops folding at bind and lands on the per-timestep hot path.",
    "authors": ["EarthSciAST conformance"]
  },
  "index_sets": {
    "lev": { "kind": "interval", "size": 4 }
  },
  "models": {
    "M": {
      "variables": {
        "u": {
          "type": "unknown",
          "units": "1",
          "shape": ["lev"],
          "description": "ODE state, differentiated through an `aggregate` shell: aggregate{k}(D(u[k])). The shell must credit an ODE STATE, not an observed -- it is the boundary the observed reader must not cross."
        },
        "v": {
          "type": "unknown",
          "units": "s",
          "shape": ["lev"],
          "description": "ODE state driven by the state-dependent arrayed observed, so `ws` is not dead."
        },
        "wf": {
          "type": "unknown",
          "units": "1/s",
          "shape": ["lev"],
          "description": "ARRAYED observed, AGGREGATE-INDEXED LHS, STATE-FREE: aggregate{k}(index(wf,k)) ~ aggregate{k}(2*k). Observed, and its cadence is CONST -- it folds at bind."
        },
        "ws": {
          "type": "unknown",
          "units": "1",
          "shape": ["lev"],
          "description": "ARRAYED observed, AGGREGATE-INDEXED LHS, STATE-DEPENDENT: aggregate{k}(index(ws,k)) ~ aggregate{k}(3*u[k]). Observed, and its cadence is CONTINUOUS -- it reads a state. The controlled twin of `wf`: a binding that folds both, or neither, fails."
        },
        "wb": {
          "type": "unknown",
          "units": "1",
          "shape": ["lev"],
          "description": "ARRAYED observed, BARE-INDEX LHS: index(wb, i) ~ ... -- the spelling esm-spec §6.3.1's worked example names verbatim (\"puts w in observed_unknowns, not algebraic_unknowns\"). Observed, CONST."
        },
        "sc": {
          "type": "unknown",
          "units": "1",
          "description": "SCALAR bare-LHS observed. The rank-0 control: §6.3.1 says an arrayed definition is observed 'exactly as its scalar counterpart is', so this must classify identically to `wb`."
        },
        "im": {
          "type": "unknown",
          "units": "1",
          "description": "ALGEBRAIC: named only by a genuine EXPRESSION LHS (im*im ~ c0), which names no single variable. The third arm of the partition, and the arm a too-eager base-name reader would steal from."
        },
        "c0": {
          "type": "parameter",
          "units": "1",
          "default": 4.0,
          "description": "CONSTANT parameter, the RHS of the implicit constraint."
        }
      },
      "equations": [
        {
          "_comment": "wf[k] ~ 2*k -- AGGREGATE-INDEXED LHS, state-free. Observed; cadence const.",
          "lhs": {
            "op": "faq",
            "args": [],
            "output_idx": ["k"],
            "ranges": { "k": { "from": "lev" } },
            "expr": { "op": "index", "args": ["wf", "k"] }
          },
          "rhs": {
            "op": "faq",
            "args": [],
            "output_idx": ["k"],
            "ranges": { "k": { "from": "lev" } },
            "expr": { "op": "*", "args": [2.0, "k"] }
          }
        },
        {
          "_comment": "ws[k] ~ 3*u[k] -- AGGREGATE-INDEXED LHS, state-dependent. Observed; cadence continuous.",
          "lhs": {
            "op": "faq",
            "args": [],
            "output_idx": ["k"],
            "ranges": { "k": { "from": "lev" } },
            "expr": { "op": "index", "args": ["ws", "k"] }
          },
          "rhs": {
            "op": "faq",
            "args": ["u"],
            "output_idx": ["k"],
            "ranges": { "k": { "from": "lev" } },
            "expr": { "op": "*", "args": [3.0, { "op": "index", "args": ["u", "k"] }] }
          }
        },
        {
          "_comment": "wb[i] ~ 5 -- BARE-INDEX LHS, the §6.3.1 worked-example spelling. Observed; cadence const.",
          "lhs": { "op": "index", "args": ["wb", "i"] },
          "rhs": 5.0
        },
        {
          "_comment": "sc ~ 7 -- the scalar control. Observed; cadence const.",
          "lhs": "sc",
          "rhs": 7.0
        },
        {
          "_comment": "im*im ~ c0 -- a genuine EXPRESSION LHS. Algebraic; cadence continuous.",
          "lhs": { "op": "*", "args": ["im", "im"] },
          "rhs": "c0"
        },
        {
          "_comment": "aggregate{k}(D(u[k])) ~ aggregate{k}(wf[k]) -- an aggregate over a D is a TENDENCY, so `u` is an ODE STATE and NOT an observed.",
          "lhs": {
            "op": "faq",
            "args": [],
            "output_idx": ["k"],
            "ranges": { "k": { "from": "lev" } },
            "expr": {
              "op": "D",
              "args": [{ "op": "index", "args": ["u", "k"] }],
              "wrt": "t"
            }
          },
          "rhs": {
            "op": "faq",
            "args": [],
            "output_idx": ["k"],
            "ranges": { "k": { "from": "lev" } },
            "expr": { "op": "index", "args": ["wf", "k"] }
          }
        },
        {
          "_comment": "aggregate{k}(D(v[k])) ~ aggregate{k}(ws[k]) -- keeps the state-dependent observed live.",
          "lhs": {
            "op": "faq",
            "args": [],
            "output_idx": ["k"],
            "ranges": { "k": { "from": "lev" } },
            "expr": {
              "op": "D",
              "args": [{ "op": "index", "args": ["v", "k"] }],
              "wrt": "t"
            }
          },
          "rhs": {
            "op": "faq",
            "args": [],
            "output_idx": ["k"],
            "ranges": { "k": { "from": "lev" } },
            "expr": { "op": "index", "args": ["ws", "k"] }
          }
        }
      ]
    }
  }
}
