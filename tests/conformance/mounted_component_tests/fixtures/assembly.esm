{
  "esm": "1.0.0",
  "metadata": {
    "name": "decay_assembly",
    "description": "A document that MOUNTS `leaf.esm` by a top-level `models` `{ref}` (esm-spec 4.7 / 9.7.10) and couples it: `Forcing.rate` replaces `Decay.k`, so the mounted leaf runs at k = 5 rather than the k = 1 its own inline test was written against. Per esm-spec 6.6 a mount does not carry the mounted component's tests; only `Forcing`'s own test - authored in THIS document, against THIS document's conditions - runs here.",
    "authors": [
      "EarthSciML Authors and Contributors"
    ]
  },
  "models": {
    "Decay": {
      "ref": "./leaf.esm"
    },
    "Forcing": {
      "variables": {
        "rate": {
          "type": "unknown",
          "units": "1/s",
          "default": 5.0,
          "description": "The coupled decay rate: five times what the leaf assumes standalone."
        }
      },
      "equations": [
        {
          "lhs": "rate",
          "rhs": 5.0
        }
      ],
      "tests": [
        {
          "id": "forcing_holds_its_rate",
          "description": "The mounting document's OWN assertion, which does run here.",
          "time_span": {
            "start": 0.0,
            "end": 1.0
          },
          "tolerance": {
            "abs": 1e-09,
            "rel": 1e-09
          },
          "assertions": [
            {
              "variable": "rate",
              "time": 1.0,
              "expected": 5.0
            }
          ]
        }
      ]
    }
  },
  "coupling": [
    {
      "type": "variable_map",
      "from": "Forcing.rate",
      "to": "Decay.k",
      "transform": "param_to_var",
      "description": "The coupling that legitimately changes the leaf's conditions: k := 5."
    }
  ]
}
