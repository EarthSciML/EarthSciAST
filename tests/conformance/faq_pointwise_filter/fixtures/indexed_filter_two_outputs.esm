{
  "esm": "1.2.0",
  "metadata": {
    "name": "indexed_filter_two_outputs",
    "description": "A `faq` filter over a node with TWO output indices, its operand read through `index` (issue #441). `a_val = [1, 2]`, `c_val = [10, 20]`, and both aggregates keep the tuples where `a_val[i] > 1.5`, so row i = 1 is 0 in every column. The two index sets have the SAME extent, so an evaluator that aligned the filter's array by position or by broadcasting rather than by the symbol `i` would gate the wrong axis; `two_outputs_swapped` puts `i` second in `output_idx` for the same reason. The bare spelling, `a_val > 1.5`, is rejected (`tests/invalid/faq/bare_array_operand_filter.esm`).",
    "authors": [
      "EarthSciML Authors and Contributors"
    ],
    "tags": [
      "faq",
      "filter",
      "conformance"
    ]
  },
  "index_sets": {
    "a_rows": {
      "kind": "interval",
      "size": 2
    },
    "c_rows": {
      "kind": "interval",
      "size": 2
    }
  },
  "models": {
    "indexed_filter_two_outputs": {
      "variables": {
        "a_val": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "a_rows"
          ],
          "description": "1, 2"
        },
        "c_val": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "c_rows"
          ],
          "description": "10, 20"
        },
        "two_outputs": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "a_rows",
            "c_rows"
          ],
          "description": "a_val[i] * c_val[g] where a_val[i] > 1.5: [0, 0 / 20, 40]"
        },
        "two_outputs_swapped": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "c_rows",
            "a_rows"
          ],
          "description": "the same, output_idx [g, i]: [0, 20 / 0, 40]"
        }
      },
      "equations": [
        {
          "lhs": "a_val",
          "rhs": {
            "op": "const",
            "args": [],
            "value": [
              1.0,
              2.0
            ]
          }
        },
        {
          "lhs": "c_val",
          "rhs": {
            "op": "const",
            "args": [],
            "value": [
              10.0,
              20.0
            ]
          }
        },
        {
          "lhs": "two_outputs",
          "rhs": {
            "op": "faq",
            "args": [],
            "semiring": "sum_product",
            "output_idx": [
              "i",
              "g"
            ],
            "ranges": {
              "i": {
                "from": "a_rows"
              },
              "g": {
                "from": "c_rows"
              }
            },
            "filter": {
              "op": "ifelse",
              "args": [
                {
                  "op": ">",
                  "args": [
                    {
                      "op": "index",
                      "args": [
                        "a_val",
                        "i"
                      ]
                    },
                    1.5
                  ]
                },
                1.0,
                0.0
              ]
            },
            "expr": {
              "op": "*",
              "args": [
                {
                  "op": "index",
                  "args": [
                    "a_val",
                    "i"
                  ]
                },
                {
                  "op": "index",
                  "args": [
                    "c_val",
                    "g"
                  ]
                }
              ]
            }
          }
        },
        {
          "lhs": "two_outputs_swapped",
          "rhs": {
            "op": "faq",
            "args": [],
            "semiring": "sum_product",
            "output_idx": [
              "g",
              "i"
            ],
            "ranges": {
              "i": {
                "from": "a_rows"
              },
              "g": {
                "from": "c_rows"
              }
            },
            "filter": {
              "op": "ifelse",
              "args": [
                {
                  "op": ">",
                  "args": [
                    {
                      "op": "index",
                      "args": [
                        "a_val",
                        "i"
                      ]
                    },
                    1.5
                  ]
                },
                1.0,
                0.0
              ]
            },
            "expr": {
              "op": "*",
              "args": [
                {
                  "op": "index",
                  "args": [
                    "a_val",
                    "i"
                  ]
                },
                {
                  "op": "index",
                  "args": [
                    "c_val",
                    "g"
                  ]
                }
              ]
            }
          }
        }
      ],
      "tolerance": {
        "rel": 1e-12,
        "abs": 0.0
      },
      "tests": [
        {
          "id": "indexed_filter_two_outputs_t1",
          "description": "Every cell of both aggregates, the filtered-out ones included.",
          "time_span": {
            "start": 0.0,
            "end": 1.0
          },
          "assertions": [
            {
              "variable": "two_outputs",
              "time": 1.0,
              "expected": 0.0,
              "coords": {
                "a_rows": 1,
                "c_rows": 1
              }
            },
            {
              "variable": "two_outputs",
              "time": 1.0,
              "expected": 0.0,
              "coords": {
                "a_rows": 1,
                "c_rows": 2
              }
            },
            {
              "variable": "two_outputs",
              "time": 1.0,
              "expected": 20.0,
              "coords": {
                "a_rows": 2,
                "c_rows": 1
              }
            },
            {
              "variable": "two_outputs",
              "time": 1.0,
              "expected": 40.0,
              "coords": {
                "a_rows": 2,
                "c_rows": 2
              }
            },
            {
              "variable": "two_outputs_swapped",
              "time": 1.0,
              "expected": 0.0,
              "coords": {
                "c_rows": 1,
                "a_rows": 1
              }
            },
            {
              "variable": "two_outputs_swapped",
              "time": 1.0,
              "expected": 20.0,
              "coords": {
                "c_rows": 1,
                "a_rows": 2
              }
            },
            {
              "variable": "two_outputs_swapped",
              "time": 1.0,
              "expected": 0.0,
              "coords": {
                "c_rows": 2,
                "a_rows": 1
              }
            },
            {
              "variable": "two_outputs_swapped",
              "time": 1.0,
              "expected": 40.0,
              "coords": {
                "c_rows": 2,
                "a_rows": 2
              }
            }
          ]
        }
      ]
    }
  }
}
