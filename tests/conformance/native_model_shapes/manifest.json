{
 "category": "native_model_shapes",
 "runner": "inline_tests",
 "version": "1.0",
 "description": "The document shapes the downstream models (EqWeFiC, eqice, moves.esm, isrm.esm) need and the native compiler refused or mis-evaluated on 2026-10-15: computed and data-dependent subscripts, reversed / offset / clamped / mod-floor subscripts into const arrays, a rank-0 faq nested in an array faq, an ifelse with a scalar condition and branches of different shapes, an out-of-range const subscript in a branch no cell takes, an initial condition gathered from a const array, a join keyed on a computed observed, an overlap-gated faq, and polygon_intersection_area in a faq. Each shape has a STATIC variant (no state: every rule is a build-time observed) and a DYNAMIC one (the same rules read by a right-hand side). Every value is checked against a hand computation in the document's own `tests` block; the goldens are the Julia interpreter's actuals.",
 "reference_binding": "julia",
 "reference_compiler": "interpreter",
 "bindings_required": [
  "julia",
  "rust"
 ],
 "scope_excluded": {
  "python": "Outside the native-models round that added this tier (its plan covers Julia and Rust). README.md records what Python answered on 2026-10-15; bringing it in is a separate decision.",
  "go": "No simulator and no inline-test runner, so a tier that DRIVES one cannot be run here (API_SPEC.md §3, capability profiles). This is an exclusion from the CATEGORY, not from the rule.",
  "typescript": "No simulator and no inline-test runner, so a tier that DRIVES one cannot be run here (API_SPEC.md §3, capability profiles). This is an exclusion from the CATEGORY, not from the rule."
 },
 "integrators": {
  "julia": {
   "algorithm": "Tsit5",
   "reltol": 1e-12,
   "abstol": 1e-14
  },
  "rust": {
   "solver": "Erk",
   "reltol": 1e-12,
   "abstol": 1e-14
  }
 },
 "tolerances": {
  "golden_rtol": 1e-10,
  "golden_atol": 1e-12,
  "detail": "Every static value is exact arithmetic on small integers and halves. The dynamic variants integrate a constant tendency from zero, a state rising at rate one, or (nested_scalar_reduction) a linear decay, so an integrator contributes nothing near this floor."
 },
