{
 "esm": "1.2.0",
 "metadata": {
  "name": "setup_reads_scalar_observed",
  "description": "An array observed C reads a build-once table (a nested parameter reduction sum over j of P[i,j], which the native build materializes at setup) times a computed scalar observed w = 1/k. None of C's own reads is a state or a scalar parameter, but w is a computed scalar observed the setup evaluator cannot resolve, so C must stay a run-time observed: built at setup, w is unbound there ('unbound name w in setup-time geometry'). The state is held fixed (D(s) = C - 4s, with C = 4), so every value is exact.",
  "authors": [
   "EarthSciML Authors and Contributors"
  ],
  "tags": [
   "native",
   "conformance"
  ]
 },
 "index_sets": {
  "x": {
   "kind": "interval",
   "size": 3
  },
  "y": {
   "kind": "interval",
   "size": 2
  }
 },
 "models": {
  "SetupReadsScalar": {
   "tolerance": {
    "rel": 1e-12,
    "abs": 1e-12
   },
   "variables": {
    "P": {
     "type": "parameter",
     "units": "1",
     "shape": [
      "x",
      "y"
     ],
     "default": 1.0
    },
    "k": {
     "type": "parameter",
     "units": "1",
     "default": 0.5
    },
    "w": {
     "type": "unknown",
     "units": "1"
    },
    "C": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "x"
     ]
    },
    "s": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "x"
     ],
     "default": 1.0
    }
   },
   "equations": [
    {
     "lhs": "w",
     "rhs": {
      "op": "/",
      "args": [
       1.0,
       "k"
      ]
     }
    },
    {
     "lhs": "C",
     "rhs": {
      "op": "faq",
      "args": [],
      "output_idx": [
       "i"
      ],
      "ranges": {
       "i": {
        "from": "x"
       }
      },
      "expr": {
       "op": "*",
       "args": [
        {
         "op": "faq",
         "args": [],
         "output_idx": [],
         "ranges": {
          "j": {
           "from": "y"
          }
         },
         "expr": {
          "op": "index",
          "args": [
           "P",
           "i",
           "j"
          ]
         },
         "reduce": "+"
        },
        "w"
       ]
      }
     }
    },
    {
     "lhs": {
      "op": "faq",
      "args": [],
      "output_idx": [
       "i"
      ],
      "ranges": {
       "i": {
        "from": "x"
       }
      },
      "expr": {
       "op": "D",
       "args": [
        {
         "op": "index",
         "args": [
          "s",
          "i"
         ]
        }
       ],
       "wrt": "t"
      }
     },
     "rhs": {
      "op": "faq",
      "args": [],
      "output_idx": [
       "i"
      ],
      "ranges": {
       "i": {
        "from": "x"
       }
      },
      "expr": {
       "op": "-",
       "args": [
        {
         "op": "index",
         "args": [
          "C",
          "i"
         ]
        },
        {
         "op": "*",
         "args": [
          4.0,
          {
           "op": "index",
           "args": [
            "s",
            "i"
           ]
          }
         ]
        }
       ]
      }
     }
    }
   ],
   "tests": [
    {
     "id": "values",
     "time_span": {
      "start": 0.0,
      "end": 1.0
     },
     "assertions": [
      {
       "variable": "C",
       "time": 1.0,
       "expected": 4.0,
       "coords": {
        "x": 1
       }
      },
      {
       "variable": "C",
       "time": 1.0,
       "expected": 4.0,
       "coords": {
        "x": 3
       }
      },
      {
       "variable": "w",
       "time": 1.0,
       "expected": 2.0
      },
      {
       "variable": "s",
       "time": 1.0,
       "expected": 1.0,
       "coords": {
        "x": 2
       }
      }
     ]
    }
   ]
  }
 }
}
