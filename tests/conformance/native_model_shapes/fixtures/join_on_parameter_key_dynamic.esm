{
 "esm": "1.2.0",
 "metadata": {
  "name": "join_on_parameter_key_dynamic",
  "description": "A value-equality `join` whose key column is computed from a SCALAR PARAMETER (`want[k] = run_year + k - 1`, moves fuel_properties / geographic_allocation / liquid_leaking_emissions). The parameter is baked (CONFORMANCE_SPEC §5.5.8): the match set is built from its value, which a test's parameter_overrides may set. Dynamic variant: a state integrates wsum at rate one over [0, 1].",
  "authors": [
   "EarthSciML Authors and Contributors"
  ],
  "tags": [
   "native",
   "conformance"
  ]
 },
 "index_sets": {
  "rows": {
   "kind": "interval",
   "size": 4
  },
  "keys": {
   "kind": "interval",
   "size": 2
  }
 },
 "models": {
  "JoinOnParameterKey": {
   "tolerance": {
    "rel": 1e-12,
    "abs": 1e-12
   },
   "variables": {
    "run_year": {
     "type": "parameter",
     "units": "1",
     "default": 2020.0,
     "description": "The run's calendar year. It feeds a join key column, so the build bakes it (CONFORMANCE_SPEC §5.5.8): a test may set it, a later substitution is refused."
    },
    "tbl_year": {
     "type": "parameter",
     "units": "1",
     "default": [
      2019.0,
      2020.0,
      2021.0,
      2020.0
     ],
     "shape": [
      "rows"
     ]
    },
    "val": {
     "type": "parameter",
     "units": "1",
     "default": [
      1.0,
      2.0,
      4.0,
      8.0
     ],
     "shape": [
      "rows"
     ]
    },
    "want": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "keys"
     ],
     "description": "run_year + k - 1: the key computed from the scalar parameter."
    },
    "total": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "keys"
     ]
    },
    "wsum": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "keys"
     ]
    },
    "acc": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "keys"
     ],
     "default": 0.0
    }
   },
   "equations": [
    {
     "lhs": "want",
     "rhs": {
      "op": "faq",
      "args": [],
      "output_idx": [
       "k"
      ],
      "ranges": {
       "k": {
        "from": "keys"
       }
      },
      "expr": {
       "op": "+",
       "args": [
        "run_year",
        {
         "op": "-",
         "args": [
          "k",
          1
         ]
        }
       ]
      }
     }
    },
    {
     "lhs": "total",
     "rhs": {
      "op": "faq",
      "args": [],
      "output_idx": [
       "k"
      ],
      "ranges": {
       "k": {
        "from": "keys"
       },
       "r": {
        "from": "rows"
       }
      },
      "semiring": "sum_product",
      "join": [
       {
        "on": [
         [
          "want",
          "tbl_year"
         ]
        ]
       }
      ],
      "expr": 1.0
     }
    },
    {
     "lhs": "wsum",
     "rhs": {
      "op": "faq",
      "args": [],
      "output_idx": [
       "k"
      ],
      "ranges": {
       "k": {
        "from": "keys"
       },
       "r": {
        "from": "rows"
       }
      },
      "semiring": "sum_product",
      "join": [
       {
        "on": [
         [
          "want",
          "tbl_year"
         ]
        ]
       }
      ],
      "expr": {
       "op": "index",
       "args": [
        "val",
        "r"
       ]
      }
     }
    },
    {
     "lhs": {
      "op": "faq",
      "args": [],
      "output_idx": [
       "k"
      ],
      "ranges": {
       "k": {
        "from": "keys"
       }
      },
      "expr": {
       "op": "D",
       "args": [
        {
         "op": "index",
         "args": [
          "acc",
          "k"
         ]
        }
       ],
       "wrt": "t"
      }
     },
     "rhs": {
      "op": "faq",
      "args": [],
      "output_idx": [
       "k"
      ],
      "ranges": {
       "k": {
        "from": "keys"
       }
      },
      "expr": {
       "op": "index",
       "args": [
        "wsum",
        "k"
       ]
      }
     }
    }
   ],
   "tests": [
    {
     "id": "default_year",
     "time_span": {
      "start": 0.0,
      "end": 1.0
     },
     "assertions": [
      {
       "variable": "total",
       "time": 1.0,
       "expected": 2.0,
       "coords": {
        "keys": 1
       }
      },
      {
       "variable": "total",
       "time": 1.0,
       "expected": 1.0,
       "coords": {
        "keys": 2
       }
      },
      {
       "variable": "wsum",
       "time": 1.0,
       "expected": 10.0,
       "coords": {
        "keys": 1
       }
      },
      {
       "variable": "wsum",
       "time": 1.0,
       "expected": 4.0,
       "coords": {
        "keys": 2
       }
      },
      {
       "variable": "acc",
       "time": 1.0,
       "expected": 10.0,
       "coords": {
        "keys": 1
       }
      },
      {
       "variable": "acc",
       "time": 1.0,
       "expected": 4.0,
       "coords": {
        "keys": 2
       }
      }
     ]
    },
    {
     "id": "overridden_year",
     "time_span": {
      "start": 0.0,
      "end": 1.0
     },
     "parameter_overrides": {
      "run_year": 2019.0
     },
     "assertions": [
      {
       "variable": "total",
       "time": 1.0,
       "expected": 1.0,
       "coords": {
        "keys": 1
       }
      },
      {
       "variable": "total",
       "time": 1.0,
       "expected": 2.0,
       "coords": {
        "keys": 2
       }
      },
      {
       "variable": "wsum",
       "time": 1.0,
       "expected": 1.0,
       "coords": {
        "keys": 1
       }
      },
      {
       "variable": "wsum",
       "time": 1.0,
       "expected": 10.0,
       "coords": {
        "keys": 2
       }
      },
      {
       "variable": "acc",
       "time": 1.0,
       "expected": 1.0,
       "coords": {
        "keys": 1
       }
      },
      {
       "variable": "acc",
       "time": 1.0,
       "expected": 10.0,
       "coords": {
        "keys": 2
       }
      }
     ]
    }
   ]
  }
 }
}
