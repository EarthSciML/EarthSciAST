{
 "esm": "1.2.0",
 "metadata": {
  "name": "guarded_out_of_range_dynamic",
  "description": "An out-of-range subscript into a const array (inline, named, and a parameter with inline data) inside an `ifelse` branch the guard switches off at exactly the cells where it would be out of range, and one excluded by a `faq` filter: the chem_vertical_mixing `rho_w` shape. No cell takes the out-of-range branch, so nothing may fault; the cases where the branch IS taken are in tests/conformance/const_array_gather_bounds/. Dynamic variant: the same rules beside a state whose right-hand side reads them, so they are lowered on the run-time path.",
  "authors": [
   "EarthSciML Authors and Contributors"
  ],
  "tags": [
   "native",
   "conformance"
  ]
 },
 "index_sets": {
  "rows": {
   "kind": "interval",
   "size": 4
  },
  "nodes": {
   "kind": "interval",
   "size": 5
  }
 },
