{
 "esm": "1.2.0",
 "metadata": {
  "name": "data_dependent_gather_dynamic",
  "description": "Gathers whose subscript is itself data: `c[j[i]]` into an inline `const` array (the rrtm_setcoef `jt` shape), `b[ix[k]]` through a parameter index array and `tbl[idx[i]]` through a `const` one (the isrm member-index gather), `fld[layer[r]*4 + c]` (the isrm per-record layer offset), and an inline `const` selector `const([1,0])[d]` (the isrm ring vertex selector). Dynamic variant: the same rules beside a state whose right-hand side reads them, so they are lowered on the run-time path.",
  "authors": [
   "EarthSciML Authors and Contributors"
  ],
  "tags": [
   "native",
   "conformance"
  ]
 },
 "index_sets": {
  "rows": {
   "kind": "interval",
   "size": 4
  },
  "n5": {
   "kind": "interval",
   "size": 5
  },
  "k3": {
   "kind": "interval",
   "size": 3
  },
  "recs": {
   "kind": "interval",
   "size": 3
  },
  "cells": {
   "kind": "interval",
   "size": 4
  },
  "all": {
   "kind": "interval",
   "size": 12
  },
  "xy": {
   "kind": "interval",
   "size": 2
  }
 },
