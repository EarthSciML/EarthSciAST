{
 "esm": "1.2.0",
 "metadata": {
  "name": "nested_scalar_reduction_static",
  "description": "A rank-0 `faq` nested inside an array `faq` body: a whole-array sum times each element, a column sum reading the outer column index (the rrtm `o3_clim[L]` shape), a filtered nested prefix sum, and (dynamic variant) a column sum of the STATE, so the nested reduction runs on every call. Static variant: no state, so every value is a build-time observed.",
  "authors": [
   "EarthSciML Authors and Contributors"
  ],
  "tags": [
   "native",
   "conformance"
  ]
 },
 "index_sets": {
  "rows": {
   "kind": "interval",
   "size": 4
  },
  "cols": {
   "kind": "interval",
   "size": 3
  },
  "lev": {
   "kind": "interval",
   "size": 4
  }
 },
 "models": {
  "NestedScalarReduction": {
   "tolerance": {
    "rel": 1e-12,
    "abs": 1e-12
   },
   "variables": {
    "p": {
     "type": "parameter",
     "units": "1",
     "default": [
      10.0,
      20.0,
      30.0,
      40.0
     ],
     "shape": [
      "rows"
     ]
    },
    "x": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "rows"
     ]
    },
    "y": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "rows"
     ]
    },
    "q2": {
     "type": "parameter",
     "units": "1",
     "default": [
      [
       1.0,
       2.0,
       3.0,
       4.0
      ],
      [
       2.0,
       2.0,
       2.0,
       2.0
      ],
      [
       0.5,
       1.5,
       2.5,
       3.5
      ]
     ],
     "shape": [
      "cols",
      "lev"
     ]
    },
    "frac": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "cols",
      "lev"
     ]
    },
    "below": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "cols",
      "lev"
     ]
    }
   },
   "equations": [
    {
     "lhs": "x",
     "rhs": {
      "op": "faq",
      "args": [],
      "output_idx": [
       "r"
      ],
      "ranges": {
       "r": {
        "from": "rows"
       }
      },
      "expr": {
       "op": "*",
       "args": [
        2.0,
        {
         "op": "index",
         "args": [
          "p",
          "r"
         ]
        }
       ]
      }
     }
    },
    {
     "lhs": "y",
     "rhs": {
      "op": "faq",
      "args": [],
      "output_idx": [
       "i"
      ],
      "ranges": {
       "i": {
        "from": "rows"
       }
      },
      "expr": {
       "op": "*",
       "args": [
        {
         "op": "faq",
         "args": [],
         "output_idx": [],
         "ranges": {
          "j": {
           "from": "rows"
          }
         },
         "expr": {
          "op": "index",
          "args": [
           "x",
           "j"
          ]
         }
        },
        {
         "op": "index",
         "args": [
          "x",
          "i"
         ]
        }
       ]
      }
     }
    },
    {
     "lhs": "frac",
     "rhs": {
      "op": "faq",
      "args": [],
      "output_idx": [
       "c",
       "l"
      ],
      "ranges": {
       "c": {
        "from": "cols"
       },
       "l": {
        "from": "lev"
       }
      },
      "expr": {
       "op": "/",
       "args": [
        {
         "op": "index",
         "args": [
          "q2",
          "c",
          "l"
         ]
        },
        {
         "op": "faq",
         "args": [],
         "output_idx": [],
         "ranges": {
          "m": {
           "from": "lev"
          }
         },
         "expr": {
          "op": "index",
          "args": [
           "q2",
           "c",
           "m"
          ]
         }
        }
       ]
      }
     }
    },
    {
     "lhs": "below",
     "rhs": {
      "op": "faq",
      "args": [],
      "output_idx": [
       "c",
       "l"
      ],
      "ranges": {
       "c": {
        "from": "cols"
       },
       "l": {
        "from": "lev"
       }
      },
      "expr": {
       "op": "faq",
       "args": [],
       "output_idx": [],
       "ranges": {
        "m": {
         "from": "lev"
        }
       },
       "filter": {
        "op": "<",
        "args": [
         "m",
         "l"
        ]
       },
       "expr": {
        "op": "index",
        "args": [
         "q2",
         "c",
         "m"
        ]
       }
      }
     }
    }
   ],
   "tests": [
