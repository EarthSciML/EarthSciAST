{
 "esm": "1.2.0",
 "metadata": {
  "name": "setup_reads_dynamic_observed",
  "description": "An array observed A reads a build-once table C (a nested parameter reduction the native build materializes at setup) and an observed W that reads the state s. None of A's own reads is a state, but W moves with s, so A must stay a run-time observed: built at setup, W would be unbound there ('unbound name W in setup-time geometry'). The state is held fixed (D(s) = 8s - A, with A = 8s), so every value is exact.",
  "authors": [
   "EarthSciML Authors and Contributors"
  ],
  "tags": [
   "native",
   "conformance"
  ]
 },
 "index_sets": {
  "x": {
   "kind": "interval",
   "size": 3
  },
  "y": {
   "kind": "interval",
   "size": 2
  }
 },
 "models": {
  "SetupReadsDynamic": {
   "tolerance": {
    "rel": 1e-12,
    "abs": 1e-12
   },
   "variables": {
    "P": {
     "type": "parameter",
     "units": "1",
     "shape": [
      "x",
      "y"
     ],
     "default": 1.0
    },
    "s": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "x"
     ],
     "default": 0.5
    },
    "C": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "x"
     ]
    },
    "W": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "x"
     ]
    },
    "A": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "x"
     ]
    }
   },
   "equations": [
    {
     "lhs": "C",
     "rhs": {
      "op": "faq",
      "args": [],
      "output_idx": [
       "i"
      ],
      "ranges": {
       "i": {
        "from": "x"
       }
      },
      "expr": {
       "op": "*",
       "args": [
        2.0,
        {
         "op": "faq",
         "args": [],
         "output_idx": [],
         "ranges": {
          "j": {
           "from": "y"
          }
         },
         "expr": {
          "op": "index",
          "args": [
           "P",
           "i",
           "j"
          ]
         },
         "reduce": "+"
        }
       ]
      }
     }
    },
    {
     "lhs": "W",
     "rhs": {
      "op": "faq",
      "args": [],
      "output_idx": [
       "i"
      ],
      "ranges": {
       "i": {
        "from": "x"
       }
      },
      "expr": {
       "op": "*",
       "args": [
        2.0,
        {
         "op": "index",
         "args": [
          "s",
          "i"
         ]
        }
       ]
      }
     }
    },
    {
     "lhs": "A",
     "rhs": {
      "op": "faq",
      "args": [],
      "output_idx": [
       "i"
      ],
      "ranges": {
       "i": {
        "from": "x"
       }
      },
      "expr": {
       "op": "*",
       "args": [
        {
         "op": "index",
         "args": [
          "C",
          "i"
         ]
        },
        {
         "op": "index",
         "args": [
          "W",
          "i"
         ]
        }
       ]
      }
     }
    },
    {
     "lhs": {
      "op": "faq",
      "args": [],
      "output_idx": [
       "i"
      ],
      "ranges": {
       "i": {
        "from": "x"
       }
      },
      "expr": {
       "op": "D",
       "args": [
        {
         "op": "index",
         "args": [
          "s",
          "i"
         ]
        }
       ],
       "wrt": "t"
      }
     },
     "rhs": {
      "op": "faq",
      "args": [],
      "output_idx": [
       "i"
      ],
      "ranges": {
       "i": {
        "from": "x"
       }
      },
      "expr": {
       "op": "-",
       "args": [
        {
         "op": "*",
         "args": [
          8.0,
          {
           "op": "index",
           "args": [
            "s",
            "i"
           ]
          }
         ]
        },
        {
         "op": "index",
         "args": [
          "A",
          "i"
         ]
        }
       ]
      }
     }
    }
   ],
   "tests": [
    {
     "id": "values",
     "time_span": {
      "start": 0.0,
      "end": 1.0
     },
     "assertions": [
      {
       "variable": "C",
       "time": 1.0,
       "expected": 4.0,
       "coords": {
        "x": 1
       }
      },
      {
       "variable": "C",
       "time": 1.0,
       "expected": 4.0,
       "coords": {
        "x": 3
       }
      },
      {
       "variable": "A",
       "time": 1.0,
       "expected": 4.0,
       "coords": {
        "x": 1
       }
      },
      {
       "variable": "A",
       "time": 1.0,
       "expected": 4.0,
       "coords": {
        "x": 2
       }
      },
      {
       "variable": "A",
       "time": 1.0,
       "expected": 4.0,
       "coords": {
        "x": 3
       }
      },
      {
       "variable": "s",
       "time": 1.0,
       "expected": 0.5,
       "coords": {
        "x": 2
       }
      }
     ]
    }
   ]
  }
 }
}
