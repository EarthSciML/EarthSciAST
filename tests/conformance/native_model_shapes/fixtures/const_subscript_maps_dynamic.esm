{
 "esm": "1.2.0",
 "metadata": {
  "name": "const_subscript_maps_dynamic",
  "description": "Subscripts into a const array other than a plain shift: reversed (`c[6 - i]`, the madronich `ze[(NLEV+2) - i]` shape), offset by a scalar parameter (`p[o + i]`), and clamped by min/max (the cloud_grid `ze[min(NN, max(1, i+1))]` shape), on an inline `const` base, a named `const` observed, and a shaped parameter carrying inline data. Dynamic variant: the same rules beside a state whose right-hand side reads them, so they are lowered on the run-time path.",
  "authors": [
   "EarthSciML Authors and Contributors"
  ],
  "tags": [
   "native",
   "conformance"
  ]
 },
 "index_sets": {
  "n5": {
   "kind": "interval",
   "size": 5
  },
  "n4": {
   "kind": "interval",
   "size": 4
  },
  "n3": {
   "kind": "interval",
   "size": 3
  }
 },
