{
 "esm": "1.2.0",
 "metadata": {
  "name": "makearray_prefix_scan_dynamic",
  "description": "Issue #533: a two-region `makearray` whose first region value is a prefix-scan `faq` (`filter j < k` / `j >= k`, `reduce \"+\"`) and whose second is the rank-0 column total (EarthSciDiscretizations column_nonuniform_1d integral_lev_nodes_cumulative_from_bottom / _to_top after template expansion). On a non-uniform column (dz = 0.5, 1, 1.5, 2) with integrand 1, 2, 3, 4 the terms are 0.5, 2, 4.5, 8: from the surface the interfaces hold 0, 0.5, 2.5, 7 and the total 15 at the top; to the top they hold 15, 14.5, 12.5, 8 and 0. G_top pins the to-top fold ORDER (esm-spec §4.3.1: a reverse scan folds from the top): over 1, -1e16, 1, 1e16 it is exactly 1, 0, 1e16, 1e16, 0, where a bottom-up fold gives 0 at interface 1. Dynamic variant: the integrand is a state, so the scans are lowered on the right-hand side, and two accumulator states integrate the interface fields from zero over one unit of time.",
  "authors": [
   "EarthSciML Authors and Contributors"
  ],
  "tags": [
   "native",
   "conformance",
   "makearray",
   "prefix-scan"
  ]
 },
 "index_sets": {
  "lev": {
   "kind": "interval",
   "size": 4
  },
  "lev_nodes": {
   "kind": "interval",
   "size": 5
  }
 },
 "models": {
  "MakearrayPrefixScan": {
   "tolerance": {
    "rel": 1e-12,
    "abs": 1e-12
   },
   "variables": {
    "ze": {
     "type": "unknown",
     "units": "m",
     "shape": [
      "lev_nodes"
     ],
     "description": "Interface heights of a non-uniform column."
    },
    "dz": {
     "type": "unknown",
     "units": "m",
     "shape": [
      "lev"
     ],
     "description": "Layer thickness ze[k+1] - ze[k]: 0.5, 1, 1.5, 2."
    },
    "F_bottom": {
     "type": "unknown",
     "units": "m",
     "shape": [
      "lev_nodes"
     ],
     "description": "Integral from the surface to each interface: the exclusive prefix scan on interfaces 1..4 and the rank-0 column total at interface 5."
    },
    "F_top": {
     "type": "unknown",
     "units": "m",
     "shape": [
      "lev_nodes"
     ],
     "description": "Integral from each interface to the top: the inclusive suffix scan on interfaces 1..4 and 0 at interface 5."
    },
    "G_top": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "lev_nodes"
     ],
     "description": "Inclusive to-top scan of 1, -1e16, 1, 1e16 (no measure) on interfaces 1..4 and 0 at interface 5, asserted EXACTLY: folded from the top it is 1, 0, 1e16, 1e16; a bottom-up fold of cell 1 gives 0."
    },
    "u": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "lev"
     ],
     "description": "The integrand as a state held constant (D(u) = 0) at 1, 2, 3, 4, so the scans read a state on the right-hand side."
    },
    "w_bottom": {
     "type": "unknown",
     "units": "m",
     "shape": [
      "lev_nodes"
     ],
     "default": 0.0,
     "description": "Accumulates F_bottom from zero at a constant rate."
    },
    "w_top": {
     "type": "unknown",
     "units": "m",
     "shape": [
      "lev_nodes"
     ],
     "default": 0.0,
     "description": "Accumulates F_top from zero at a constant rate."
    },
    "v": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "lev"
     ],
     "description": "The cancellation-sensitive integrand 1, -1e16, 1, 1e16 as a state held constant (D(v) = 0)."
    }
   },
   "equations": [
    {
     "lhs": "ze",
     "rhs": {
      "op": "const",
      "args": [],
      "value": [
       0.0,
       0.5,
