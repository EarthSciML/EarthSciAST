         2.0
        ]
       },
       {
        "op": "*",
        "args": [
         "F",
         "H"
        ]
       },
       0.0
      ]
     }
    },
    {
     "lhs": "R_off",
     "rhs": {
      "op": "faq",
      "args": [],
      "output_idx": [
       "i"
      ],
      "ranges": {
       "i": {
        "from": "cell"
       }
      },
      "expr": {
       "op": "index",
