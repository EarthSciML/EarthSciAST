{
 "esm": "1.3.0",
 "metadata": {
  "name": "setup_shapeless_param_observed",
  "description": "An array observed c declared without a shape (esm-spec 4.3.4: it takes its operands' index sets), defined by a faq over an array parameter, c = faq_i a[i], and read by a state equation. The run path promotes it to the lifted form c = faq_p index(faq_i a[i], p), whose inner faq the native build took for a nested reduction and pulled into setup, where the setup compiler refused the faq operand ('operand must be a build-time array ... in setup-time geometry'). It must stay a run-time observed. D(x) = sum_r c[r]*y[r] with y held at 1, so x(t) = 10.25 t exactly. Reported from EarthSciIntegrator's adjoint (a frozen residual's vjp document, _dp_zcap_1 = faq_i zmax[i]) and EarthSciASTDiff's derived documents (faq_operand_list: _du_colsum_1 = faq_k const[k]).",
  "authors": [
   "EarthSciML Authors and Contributors"
  ],
  "tags": [
   "native",
   "conformance"
  ]
 },
 "index_sets": {
  "k": {
   "kind": "interval",
   "size": 2
  }
 },
 "models": {
  "M": {
   "variables": {
    "x": {
     "type": "unknown",
     "default": 0.0
    },
    "y": {
     "type": "unknown",
     "default": 1.0,
     "shape": [
      "k"
     ]
    },
    "a": {
     "type": "parameter",
     "shape": [
      "k"
     ],
     "default": [
      0.25,
      10.0
     ]
    },
    "c": {
     "type": "unknown"
    }
   },
   "equations": [
    {
     "lhs": "M.c",
     "rhs": {
      "op": "faq",
      "args": [],
      "output_idx": [
       "i"
      ],
      "ranges": {
       "i": [
        1,
        2
       ]
      },
      "expr": {
       "op": "index",
       "args": [
        "M.a",
        "i"
       ]
      }
     }
    },
    {
     "lhs": {
      "op": "D",
      "args": [
       "M.x"
      ],
      "wrt": "t"
     },
     "rhs": {
      "op": "faq",
      "args": [],
      "output_idx": [],
      "ranges": {
       "r": [
        1,
        2
       ]
      },
      "expr": {
       "op": "*",
       "args": [
        {
         "op": "index",
         "args": [
          "M.c",
          "r"
         ]
        },
        {
         "op": "index",
         "args": [
          "M.y",
          "r"
         ]
        }
       ]
      }
     }
    },
    {
     "lhs": {
      "op": "D",
      "args": [
       "M.y"
      ],
      "wrt": "t"
     },
     "rhs": {
      "op": "makearray",
      "args": [],
      "regions": [
       [
        [
         1,
         2
        ]
       ]
      ],
      "values": [
       0.0
      ]
     }
    }
   ],
   "tolerance": {
    "rel": 1e-12,
    "abs": 1e-12
   },
   "tests": [
    {
     "id": "values",
     "time_span": {
      "start": 0.0,
      "end": 1.0
     },
     "assertions": [
      {
       "variable": "x",
       "time": 0.5,
       "expected": 5.125
      },
      {
       "variable": "x",
       "time": 1.0,
       "expected": 10.25
      },
      {
       "variable": "y",
       "time": 1.0,
       "expected": 1.0,
       "coords": {
        "k": 2
       }
      }
     ]
    }
   ]
  }
 }
}
