{
 "esm": "1.2.0",
 "metadata": {
  "name": "assert_ingested_parameter",
  "description": "An inline assertion may name a DATA-FED parameter (`update: {kind: \"data\"}`) and is judged against the ingested cells, exactly as it is for a computed variable (moves finding F43). `m_val` is the `val` column of rows.parquet, [1, 2, 4, 8]; `v_total` is the same column summed (15) as the control, and the state `x` integrates it from 0 (`x(1) = 15`), so the value the assertion reads is also the one the right-hand side reads.",
  "authors": [
   "EarthSciML Authors and Contributors"
  ],
  "tags": [
   "native",
   "conformance"
  ]
 },
 "data_sources": {
  "rows_table": {
   "kind": "static",
   "source": {
    "url_template": "./data/rows.parquet"
   },
   "extent": {
    "metaparameter": "n_rows"
   },
   "metadata": {
    "esio_format": "parquet",
    "note": "Committed beside this document; a test may override the URL."
   }
  }
 },
 "metaparameters": {
  "n_rows": {
   "type": "integer",
   "default": 0,
   "description": "Rows in rows.parquet, discovered by the source's own extent (4)."
  }
 },
 "index_sets": {
  "rows": {
   "kind": "interval",
   "size": "n_rows"
  }
 },
 "models": {
  "AssertIngestedParameter": {
   "tolerance": {
    "rel": 1e-12,
    "abs": 1e-12
   },
   "variables": {
    "m_val": {
     "type": "parameter",
     "units": "1",
     "default": 0.0,
     "shape": [
      "rows"
     ],
     "description": "rows.parquet `val`: [1, 2, 4, 8]. The variable the assertions name.",
     "update": {
      "kind": "data",
      "source": "rows_table",
      "from": {
       "file_variable": "val"
      }
     }
    },
    "v_total": {
     "type": "unknown",
     "units": "1",
     "description": "The same column summed: 15. The control."
    },
    "x": {
     "type": "unknown",
     "units": "1",
     "default": 0.0,
     "description": "Integrates v_total from 0: 15 t."
    }
   },
   "equations": [
    {
     "lhs": "v_total",
     "rhs": {
      "op": "faq",
      "args": [],
      "output_idx": [],
      "ranges": {
       "r": {
        "from": "rows"
       }
      },
      "expr": {
       "op": "index",
       "args": [
        "m_val",
        "r"
       ]
      }
     }
    },
    {
     "lhs": {
      "op": "D",
      "args": [
       "x"
      ],
      "wrt": "t"
     },
     "rhs": "v_total"
    }
   ],
   "tests": [
    {
     "id": "the_ingested_column_is_asserted_where_it_arrives",
     "description": "The control first, then the data-fed parameter itself: two cells by `coords`, its `mean` (15/4), and the state that integrated it.",
     "time_span": {
      "start": 0.0,
      "end": 1.0
     },
     "assertions": [
      {
       "variable": "v_total",
       "time": 0.0,
       "expected": 15.0
      },
      {
       "variable": "m_val",
       "time": 0.0,
       "coords": {
        "rows": 1
       },
       "expected": 1.0
      },
      {
       "variable": "m_val",
       "time": 1.0,
       "coords": {
        "rows": 4
       },
       "expected": 8.0
      },
      {
       "variable": "m_val",
       "time": 0.0,
       "reduce": "mean",
       "expected": 3.75
      },
      {
       "variable": "x",
       "time": 1.0,
       "expected": 15.0,
       "tolerance": {
        "rel": 1e-9
       }
      }
     ]
    }
   ]
  }
 }
}
