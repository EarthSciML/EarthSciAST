{
  "esm": "1.0.0",
  "metadata": {
    "name": "function_tables_nearest_conformance",
    "description": "esm-spec §9.5.3 `interpolation: \"nearest\"` exercised through each binding's inline-test runner. A lookup returns the table value at the knot NEAREST the query, a tie between two knots going to the LOWER knot, and with the default `out_of_bounds: \"clamp\"` a query outside the axis returns the end value. The axis [1, 2, 4, 8] is non-uniform, so the midpoints differ per cell, and every midpoint used is exactly representable, so the tie is a true tie in binary64. `n_tie_2_4_hand` spells the §9.5.3 lowering of the `q_tie_2_4` query out by hand (searchsorted, min, max, index, -, <, ==, ifelse), so a binding whose `table_lookup` lowering differs from the spec's composition disagrees with it.",
    "authors": [
      "EarthSciML"
    ]
  },
  "function_tables": {
    "steps": {
      "description": "A step table read by nearest knot (synthetic).",
      "axes": [
        {
          "name": "p",
          "values": [
            1.0,
            2.0,
            4.0,
            8.0
          ]
        }
      ],
      "interpolation": "nearest",
      "data": [
        10.0,
        20.0,
        40.0,
        80.0
      ]
    }
  },
