      "tests": [
        {
          "id": "nearest_knot_ties_low_and_clamps",
          "description": "q_below = 0.0 -> 10.0 (below the first knot: clamps to D[1]); q_first = 1.0 -> 10.0 (on the first knot); q_tie_1_2 = 1.5 -> 10.0 (midpoint of knots 1 and 2: a tie goes to the LOWER knot); q_near_lo = 2.9 -> 20.0 (nearer knot 2 (0.9) than knot 4 (1.1)); q_tie_2_4 = 3.0 -> 20.0 (midpoint of knots 2 and 4: tie, lower knot); q_near_hi = 3.1 -> 40.0 (nearer knot 4 (0.9) than knot 2 (1.1): first knot >= x, and here also the nearest); q_knot = 4.0 -> 40.0 (on an interior knot); q_tie_4_8 = 6.0 -> 40.0 (midpoint of knots 4 and 8: tie, lower knot); q_just_above_tie = 6.5 -> 80.0 (just past the 4-8 midpoint: upper knot); q_last = 8.0 -> 80.0 (on the last knot); q_above = 100.0 -> 80.0 (above the last knot: clamps to D[N] (the old index(D, searchsorted) lowering read D[N+1] here))",
          "time_span": {
            "start": 0.0,
            "end": 1.0
          },
          "assertions": [
            {
              "variable": "n_below",
              "time": 0.0,
              "expected": 10.0
            },
            {
              "variable": "n_first",
              "time": 0.0,
              "expected": 10.0
            },
            {
              "variable": "n_tie_1_2",
              "time": 0.0,
              "expected": 10.0
            },
