{
  "esm": "1.1.0",
  "metadata": {
    "name": "ArrayControl",
    "description": "CONTROL: the array refusal document with the algebraic equation removed. It takes the array evaluator and MUST still build and run, so the array refusal is attributable to the second definition and not to the shaped unknown.",
    "authors": [
      "EarthSciML Authors and Contributors"
    ],
    "tags": [
      "conformance",
      "doubly_defined_state",
      "control"
    ]
  },
  "index_sets": {
    "rows": {
      "kind": "interval",
      "size": 2
    }
  },
  "models": {
    "ArrayControl": {
      "variables": {
        "x": {
          "type": "unknown",
          "units": "1",
          "description": "Defined once, by its derivative equation."
        },
        "x_seen": {
          "type": "unknown",
          "shape": [
            "rows"
          ],
          "units": "1",
          "description": "`x` broadcast over an axis, so the document takes the array evaluator."
        },
        "k": {
          "type": "parameter",
          "units": "1",
          "default": 2.0,
          "description": "The rate the derivative equation uses."
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "x"
            ],
            "wrt": "t"
          },
          "rhs": "k"
        },
        {
          "lhs": {
            "op": "ic",
            "args": [
              "x"
            ]
          },
          "rhs": 1.0
        },
        {
          "lhs": "x_seen",
          "rhs": {
            "op": "faq",
            "args": [],
            "output_idx": [
              "r"
            ],
            "ranges": {
              "r": {
                "from": "rows"
              }
            },
            "expr": "x"
          }
        }
      ],
      "tests": [
        {
          "id": "the_array_path_still_runs",
          "description": "x(0) = 1, dx/dt = 2, so x(1) = 3 and x_seen reads it.",
          "time_span": {
            "start": 0.0,
            "end": 1.0
          },
          "assertions": [
            {
              "variable": "x_seen",
              "time": 1.0,
              "expected": 3.0,
              "tolerance": {
                "rel": 1e-06
              },
              "coords": {
                "rows": 1
              }
            },
            {
              "variable": "x",
              "time": 1.0,
              "expected": 3.0,
              "tolerance": {
                "rel": 1e-06
              }
            }
          ]
        }
      ]
    }
  }
}
