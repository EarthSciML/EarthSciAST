{
  "esm": "1.1.0",
  "metadata": {
    "name": "inject_agnostic_faq",
    "description": "esm-spec §9.7.10 / §6.6.6 (issue #185): a discretization-agnostic PDE leaf that deliberately declares NO `index_sets` of its own — its registry arrives from a discretization library injected into this component's scope by a composing document (form A/B) or by an inline test (form C), so the sets exist only in that per-run build. Both the variable `shape` and the `faq` `ranges` { \"from\": \"cells\" } therefore name a set the document itself does not declare, and the LOAD-TIME contract is that BOTH are accepted: `undefined_index_set` is deferred past the point where the component's effective template scope closes, exactly as §9.6.1 defers `template_constraint_unknown_index_set` for a library file validated standalone. Like every §6.6.6 leaf this document is un-runnable in isolation — the evaluating bindings' resolvers still reject `cells` until a grid is injected, which is where the typo-catching value lives. Negative control: tests/invalid/faq/undeclared_from_name.esm DOES declare a registry (`cells`) and ranges over a name absent from it, and is still rejected at validate().",
    "authors": [
      "EarthSciAST"
    ],
    "tags": [
      "faq",
      "index-set",
      "expression-templates",
      "injection",
      "conformance",
      "validation"
    ]
  },
  "models": {
    "AgnosticLeaf": {
      "variables": {
        "u": {
          "type": "unknown",
          "shape": [
            "cells"
          ],
          "description": "tracer over an index set supplied by the injected grid"
        },
        "total": {
          "type": "unknown",
          "description": "domain total, contracted over the injected index set"
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "faq",
            "args": [],
            "output_idx": [
              "i"
            ],
            "expr": {
              "op": "D",
              "args": [
                {
                  "op": "index",
                  "args": [
                    "u",
                    "i"
                  ]
                }
              ],
              "wrt": "t"
            },
            "ranges": {
              "i": {
                "from": "cells"
              }
            }
          },
          "rhs": {
            "op": "faq",
            "args": [],
            "output_idx": [
              "i"
            ],
            "semiring": "sum_product",
            "expr": {
              "op": "-",
              "args": [
                {
                  "op": "index",
                  "args": [
                    "u",
                    "i"
                  ]
                }
              ]
            },
            "ranges": {
              "i": {
                "from": "cells"
              }
            }
          }
        },
        {
          "lhs": {
            "op": "D",
            "args": [
              "total"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "faq",
            "args": [],
            "output_idx": [],
            "semiring": "sum_product",
            "expr": {
              "op": "index",
              "args": [
                "u",
                "i"
              ]
            },
            "ranges": {
              "i": {
                "from": "cells"
              }
            }
          }
        }
      ]
    }
  }
}
