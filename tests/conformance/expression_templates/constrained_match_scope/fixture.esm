{
  "esm": "1.0.0",
  "metadata": {
    "name": "constrained_match_scope",
    "description": "Static match-scoping constraints (esm-spec §9.6.1 `where`; docs/content/rfcs/match-pattern-scoping-constraints.md): ONE shape-constrained spatial-D rule in a document with TWO shaped variables. The rule's pattern {op: D, args: [F], wrt: x} structurally matches both D nodes, but `where: {F: {shape: [edges]}}` makes it eligible only where F binds to a bare variable declared over exactly [edges]. So D(F_edge, wrt: x) is rewritten and D(F_cell, wrt: x) is NOT — it survives lowering intact (loading is permissive, §9.6.3 constraint 6; it would be rejected by `unlowered_operator` only if evaluated). Positive and negative case in one expanded golden; constraint evaluation is fully static (declared shapes only), so all five bindings agree byte-for-byte.",
    "authors": [
      "match-pattern-scoping-constraints conformance"
    ]
  },
  "index_sets": {
    "cells": {
      "kind": "interval",
      "size": 7
    },
    "edges": {
      "kind": "interval",
      "size": 12
    }
  },
  "models": {
    "m": {
      "variables": {
        "F_edge": {
          "type": "unknown",
          "units": "1",
          "default": 1.5,
          "shape": [
            "edges"
          ],
          "description": "Edge-normal flux (over the constrained index set)"
        },
        "F_cell": {
          "type": "unknown",
          "units": "1",
          "default": 2.5,
          "shape": [
            "cells"
          ],
          "description": "Cell-centered field (fails the shape constraint)"
        },
        "inv_area": {
          "type": "parameter",
          "units": "1",
          "default": 0.5,
          "description": "Stand-in 1/A_i stencil coefficient"
        },
        "div_edge": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "cells"
          ],
          "description": "x-derivative of an edge field: the constrained rule fires"
        },
        "div_cell": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "cells"
          ],
          "description": "x-derivative of a cell field: constraint-excluded, stays unlowered"
        }
      },
      "equations": [
        {
          "lhs": "div_edge",
          "rhs": {
            "op": "D",
            "args": [
              "F_edge"
            ],
            "wrt": "x"
          }
        },
        {
          "lhs": "div_cell",
          "rhs": {
            "op": "D",
            "args": [
              "F_cell"
            ],
            "wrt": "x"
          }
        }
      ],
      "expression_templates": {
        "fv_div_edges": {
          "params": [
            "F"
          ],
          "match": {
            "op": "D",
            "args": [
              "F"
            ],
            "wrt": "x"
          },
          "where": {
            "F": {
              "shape": [
                "edges"
              ]
            }
          },
          "body": {
            "op": "*",
            "args": [
              "inv_area",
              "F"
            ]
          }
        }
      }
    }
  }
}
