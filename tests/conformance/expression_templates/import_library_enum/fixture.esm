{
  "esm": "1.0.0",
  "metadata": {
    "name": "library_enum_importer",
    "description": "Imports a template whose body names an enum member declared only in the library (lib.esm). The importer declares no `enums` block and must still load: the library's `enum` op resolves against the library's own block (esm-spec §9.3)."
  },
  "models": {
    "Consumer": {
      "expression_template_imports": [{ "ref": "./lib.esm" }],
      "variables": {
        "isPerHorsepowerHour": { "type": "unknown", "units": "1" }
      },
      "equations": [
        {
          "lhs": "isPerHorsepowerHour",
          "rhs": {
            "op": "apply_expression_template",
            "args": [],
            "name": "is_rate_per_horsepower_hour",
            "bindings": { "unit_code": 1 }
          }
        }
      ]
    }
  }
}
