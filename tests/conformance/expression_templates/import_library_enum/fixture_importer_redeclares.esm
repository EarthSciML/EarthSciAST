{
  "esm": "1.0.0",
  "metadata": {
    "name": "library_enum_importer_redeclares",
    "description": "The importer declares an enum of the same name as the library's (lib.esm) with DIFFERENT values (`g_per_hp_hr` 7 and `g_per_gallon` 9, where the library says 1 and 2). Enums are file-local (esm-spec §9.3): the library's own `enum` op keeps 1 and the library's own call `gallon_code` keeps 2, while every symbol the IMPORTER spells resolves against the importer's block: its own `enum` ops, one it binds into a template parameter, a symbol it binds into `activity_code`, and one it binds through `code_via`'s forwarded parameter."
  },
  "enums": {
    "activity_unit": {
      "g_per_hp_hr": 7,
      "g_per_gallon": 9
    }
  },
  "models": {
    "Consumer": {
      "expression_template_imports": [
        {
          "ref": "./lib.esm"
        }
      ],
      "variables": {
        "isPerHorsepowerHour": {
          "type": "unknown",
          "units": "1"
        },
        "importerCode": {
          "type": "unknown",
          "units": "1"
        },
        "callerBoundCode": {
          "type": "unknown",
          "units": "1"
        },
        "gallonCode": {
          "type": "unknown",
          "units": "1"
        },
        "importerBoundCode": {
          "type": "unknown",
          "units": "1"
        },
        "forwardedCode": {
          "type": "unknown",
          "units": "1"
        }
      },
      "equations": [
        {
          "lhs": "isPerHorsepowerHour",
          "rhs": {
            "op": "apply_expression_template",
            "args": [],
            "name": "is_rate_per_horsepower_hour",
            "bindings": {
              "unit_code": 1
            }
          }
        },
        {
          "lhs": "importerCode",
          "rhs": {
            "op": "enum",
            "args": [
              "activity_unit",
              "g_per_hp_hr"
            ]
          }
        },
        {
          "lhs": "callerBoundCode",
          "rhs": {
            "op": "apply_expression_template",
            "args": [],
            "name": "is_rate_per_horsepower_hour",
            "bindings": {
              "unit_code": {
                "op": "enum",
                "args": [
                  "activity_unit",
                  "g_per_hp_hr"
                ]
              }
            }
          }
        },
        {
          "lhs": "gallonCode",
          "rhs": {
            "op": "apply_expression_template",
            "args": [],
            "name": "gallon_code",
            "bindings": {}
          }
        },
        {
          "lhs": "importerBoundCode",
          "rhs": {
            "op": "apply_expression_template",
            "args": [],
            "name": "activity_code",
            "bindings": {
              "sym": "g_per_gallon"
            }
          }
        },
        {
          "lhs": "forwardedCode",
          "rhs": {
            "op": "apply_expression_template",
            "args": [],
            "name": "code_via",
            "bindings": {
              "which": "g_per_gallon"
            }
          }
        }
      ]
    }
  }
}
