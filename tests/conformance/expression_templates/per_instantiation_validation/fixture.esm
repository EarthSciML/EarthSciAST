{
  "esm": "2.0.0",
  "metadata": {
    "name": "per_instantiation_validation",
    "description": "esm-spec §9.6.9 (RFC out-of-line-expression-templates §8, §9.2): an `fn`-param template (the scalar `fn` field of a `broadcast` node) referenced at TWO call sites. `invalid_broadcast_fn` is discharged per-instantiation on the reference-preserving form: the first call site (fn = max) is admissible, the second (fn = bogus) is not. The offending call site is named in the diagnostic. INVALID fixture — load MUST reject. Until esm 2.0.0 the site was the `manifold` field of the removed geometry leaf.",
    "authors": [
      "out-of-line-expression-templates conformance"
    ]
  },
  "models": {
    "m": {
      "expression_templates": {
        "combine": {
          "params": [
            "a",
            "b",
            "f"
          ],
          "body": {
            "op": "broadcast",
            "fn": "f",
            "args": [
              "a",
              "b"
            ]
          }
        }
      },
      "variables": {
        "pa": {
          "type": "parameter",
          "units": "1",
          "default": 1.0
        },
        "pb": {
          "type": "parameter",
          "units": "1",
          "default": 2.0
        },
        "r_ok": {
          "type": "unknown",
          "units": "1"
        },
        "r_bad": {
          "type": "unknown",
          "units": "1"
        }
      },
      "equations": [
        {
          "lhs": "r_ok",
          "rhs": {
            "op": "apply_expression_template",
            "args": [],
            "name": "combine",
            "bindings": {
              "a": "pa",
              "b": "pb",
              "f": "max"
            }
          }
        },
        {
          "lhs": "r_bad",
          "rhs": {
            "op": "apply_expression_template",
            "args": [],
            "name": "combine",
            "bindings": {
              "a": "pa",
              "b": "pb",
              "f": "bogus"
            }
          }
        }
      ]
    }
  }
}
