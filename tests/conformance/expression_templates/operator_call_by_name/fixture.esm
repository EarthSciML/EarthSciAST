          "description": "twice"
        },
        "t2": {
          "type": "unknown",
          "units": "1",
          "description": "thrice"
        },
        "p": {
          "type": "unknown",
          "units": "1",
          "description": "placeholder"
        },
        "r": {
          "type": "unknown",
          "units": "1",
          "description": "explicit reference"
        }
      },
      "equations": [
        {
