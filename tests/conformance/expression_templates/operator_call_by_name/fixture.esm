{
  "esm": "2.4.0",
  "metadata": {
    "name": "operator_call_by_name",
    "description": "esm 2.4.0 (esm-spec §9.6.3 constraint 2, §9.6.12): calls of defined operators resolve to definitions without a match. div(F) on an edge field picks fv_div_edges (a where before none, at equal priority, though declared after div_default); div(u) on a cell field picks div_default (the where fails); twice(w) picks twice_fast (priority 1 over the key-named twice); thrice(w) picks thrice_a (declaration order); mystery(w) has no definition and stays a placeholder. Every resolved call becomes a reference; nothing is inlined.",
    "authors": [
      "one-operator-type conformance"
    ]
  },
  "index_sets": {
    "cells": {
      "kind": "interval",
      "size": 3
    },
    "edges": {
      "kind": "interval",
      "size": 4
    }
  },
  "models": {
    "m": {
      "variables": {
        "F": {
          "type": "parameter",
          "units": "1",
          "default": 1.0,
          "shape": [
            "edges"
          ],
          "description": "Edge field"
        },
        "u": {
          "type": "parameter",
          "units": "1",
          "default": 2.0,
          "shape": [
            "cells"
          ],
          "description": "Cell field"
        },
        "w": {
          "type": "parameter",
          "units": "1",
          "default": 0.5,
          "description": "Scalar"
        },
        "d1": {
          "type": "unknown",
