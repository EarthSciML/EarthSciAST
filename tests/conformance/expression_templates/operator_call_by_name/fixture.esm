            ]
          }
        },
        {
          "lhs": "r",
          "rhs": {
            "op": "apply_operator",
            "args": [],
            "name": "twice",
            "bindings": {
              "a": "w"
            }
          }
        }
      ],
      "operators": {
        "div_default": {
          "params": [
            "X"
          ],
          "defines": "div",
