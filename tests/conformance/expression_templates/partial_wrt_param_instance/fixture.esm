          "type": "parameter",
          "units": "1",
          "default": 0.1,
          "description": "Rate"
        },
        "gx": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "x"
          ],
          "description": "Spatial derivative of u"
        },
        "gt": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "x"
          ],
          "description": "Time derivative of u"
        }
      },
      "equations": [
