          ],
          "description": "variable"
        },
        "y": {
          "type": "unknown",
          "units": "1",
          "description": "variable"
        }
      },
      "equations": [
        {
          "lhs": "d1",
          "rhs": {
            "op": "div",
            "args": [
              "F"
            ]
          }
        },
        {
          "lhs": "d2",
