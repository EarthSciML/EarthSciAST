          "type": "parameter",
          "units": "1",
          "default": 1.0,
          "shape": [
            "edges"
          ],
          "description": "variable"
        },
        "G": {
          "type": "parameter",
          "units": "1",
          "default": 2.0,
          "shape": [
            "cells"
          ],
          "description": "variable"
        },
        "x": {
          "type": "parameter",
          "units": "1",
          "default": 0.5,
