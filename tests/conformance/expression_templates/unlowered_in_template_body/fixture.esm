{
  "esm": "1.1.0",
  "metadata": {
    "name": "unlowered_in_template_body",
    "description": "esm-spec §9.6.3 constraint 6, §9.6.4 rule 3: the template `ddy` holds `D(f, wrt y)` and no rule matches a `D` along `y`. The document loads (loading is permissive) and the reference to `ddy` survives with its body unrewritten; the build gate walks the reachable body and rejects it with `unlowered_operator`, naming the op, the template and the first call site.",
    "authors": [
      "rules-as-references conformance (esm-spec §9.6.3 constraint 7, §9.6.4 rule 3)"
    ]
  },
  "index_sets": {
    "x": {
      "kind": "interval",
      "size": 4
    },
    "y": {
      "kind": "interval",
      "size": 3
    }
  },
  "models": {
