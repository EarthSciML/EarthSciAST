      "expression_templates": {
        "central": {
          "params": [
            "f"
          ],
          "match": {
            "op": "D",
            "args": [
              "f"
            ],
            "wrt": "x"
          },
          "body": {
            "op": "faq",
            "args": [
              "f"
            ],
            "output_idx": [
              "i"
            ],
            "ranges": {
              "i": {
                "from": "x"
              }
            },
            "expr": {
              "op": "-",
              "args": [
                {
                  "op": "index",
                  "args": [
                    "f",
                    {
                      "op": "+",
                      "args": [
                        "i",
                        1
                      ]
                    }
                  ]
                },
                {
                  "op": "index",
                  "args": [
                    "f",
                    {
                      "op": "-",
                      "args": [
                        "i",
                        1
                      ]
                    }
                  ]
                }
              ]
            }
          }
        },
        "ddy": {
          "params": [
            "f"
          ],
          "body": {
