{
 "esm": "2.0.0",
 "metadata": {
  "name": "expression_templates_scalar_field_param",
  "description": "Scalar-field template-parameter substitution (esm-spec \u00a79.6.1 / \u00a79.6.3 constraint 5): one `total` template whose `body` carries a parameter name (`K_semiring`) as the string VALUE of the scalar `semiring` field of a `faq` node \u2014 a substitution site, the exact mirror of the match-side scalar-field binding rule \u2014 instantiated twice with different semiring literals (sum_product, max_sum). All five bindings MUST expand both observeds to the same post-substitution nodes (expanded.esm); the bound value must be a literal admissible for the field, enforced on the EXPANDED form (\u00a79.6.9; tests/conformance/expression_templates/per_instantiation_validation). Re-pointed from the `manifold` field of the geometry leaf removed at esm 2.0.0.",
  "authors": [
   "esm conformance"
  ],
  "tags": [
   "expression_templates",
   "scalar-field-substitution",
   "semiring",
   "conformance"
  ]
 },
 "index_sets": {
  "k": {
   "kind": "interval",
   "size": 3
  }
 },
 "models": {
  "Total": {
   "variables": {
    "w": {
     "type": "parameter",
     "units": "1",
     "shape": [
      "k"
     ],
     "default": [
      1.0,
      3.0,
      2.0
     ]
    },
    "u": {
     "type": "unknown",
     "units": "1",
     "default": 0.5
    },
    "total_sum": {
     "type": "unknown",
     "units": "1",
     "description": "First instantiation: the semiring parameter bound to the literal 'sum_product'."
    },
    "total_max": {
     "type": "unknown",
     "units": "1",
     "description": "Second instantiation: the SAME template bound to 'max_sum'."
    }
   },
   "equations": [
    {
     "lhs": {
      "op": "D",
      "args": [
       "u"
      ],
      "wrt": "t"
     },
     "rhs": {
      "op": "-",
      "args": [
       "u"
      ]
     }
    },
    {
     "lhs": "total_sum",
     "rhs": {
      "op": "apply_expression_template",
      "args": [],
      "name": "total",
      "bindings": {
       "K_semiring": "sum_product",
       "a": "w"
      }
     }
    },
    {
     "lhs": "total_max",
     "rhs": {
      "op": "apply_expression_template",
      "args": [],
      "name": "total",
      "bindings": {
       "K_semiring": "max_sum",
       "a": "w"
      }
     }
    }
   ],
   "expression_templates": {
    "total": {
     "params": [
      "K_semiring",
      "a"
     ],
     "body": {
      "op": "faq",
      "args": [
       "a"
      ],
      "semiring": "K_semiring",
      "output_idx": [],
      "ranges": {
