{
  "esm": "1.0.0",
  "metadata": {
    "name": "decay_problem",
    "description": "Problem file sized by metaparameter N (default 2): N appears in an expression position (npts), in an aggregate dense range bound (ramp, folded at load), and in an AST division that must NOT fold (half)"
  },
