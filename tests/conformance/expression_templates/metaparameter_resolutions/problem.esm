          "type": "unknown",
          "units": "1",
          "default": 1.0
        },
        "npts": {
          "type": "unknown",
          "units": "1"
        },
        "half": {
          "type": "unknown",
          "units": "1"
        },
        "ramp": {
          "type": "unknown",
          "units": "1"
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "u"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "*",
            "args": [
              -0.5,
              "u"
            ]
          }
        },
        {
          "lhs": "npts",
          "rhs": "N"
        },
        {
          "lhs": "half",
          "rhs": {
