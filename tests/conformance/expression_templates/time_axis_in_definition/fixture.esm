{
  "esm": "2.4.0",
  "metadata": {"name": "TimeAxisInDefinition"},
  "domain": {"independent_variable": "clock"},
  "models": {
    "Probe": {
      "variables": {
        "u": {"type": "unknown", "default": 0},
        "temporal": {"type": "unknown"},
        "spatial": {"type": "unknown"}
      },
      "operators": {
        "derivative": {
          "params": ["f", "axis"],
          "body": {"op": "D", "args": ["f"], "wrt": "axis"}
        },
        "replace_spatial": {
          "params": ["p"],
          "match": {"op": "partial", "args": ["p"]},
          "body": 17
        }
      },
      "equations": [
        {"lhs": {"op": "D", "args": ["u"], "wrt": "clock"}, "rhs": 1},
        {
          "lhs": "temporal",
          "rhs": {"op": "apply_operator", "args": [], "name": "derivative",
                  "bindings": {"f": "u", "axis": "t"}}
        },
        {
          "lhs": "spatial",
          "rhs": {"op": "apply_operator", "args": [], "name": "derivative",
                  "bindings": {"f": "u", "axis": "x"}}
        }
      ]
    }
  }
}
