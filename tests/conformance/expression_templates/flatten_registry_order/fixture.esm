            "f"
          ],
          "body": {
            "op": "+",
            "args": [
              "f",
              1
            ]
          }
        },
        "aa": {
          "params": [
            "f"
          ],
          "body": {
            "op": "*",
            "args": [
              2,
              "f"
            ]
