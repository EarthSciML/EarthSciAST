{
  "esm": "1.1.0",
  "metadata": {
    "name": "expression_templates_ranges_from_param",
    "description": "esm-spec §9.6.1: a template parameter written as the `from` of a `faq` `ranges` entry is a substitution site, so a template can range over an index set the caller names. `total(v, S)` sums `v` over `{\"from\": S}` and `count_below(x, v, S)` counts the entries of `v` below `x` over the same range. The call sites bind `S` to `cells` (3 members) and `sites` (2 members); each expanded `ranges` entry names the bound set (expanded.esm). This is how lib/relational.esm's `rank_of_set` ranges over a derived set whose size is known only after value invention.",
    "authors": [
      "EarthSciML"
    ],
    "tags": [
      "expression_templates",
      "faq",
      "ranges",
      "index-set",
      "esm-spec-9.6.1"
    ]
  },
  "index_sets": {
    "cells": {
      "kind": "interval",
      "size": 3
    },
    "sites": {
      "kind": "interval",
      "size": 2
    }
  },
  "models": {
    "M": {
      "expression_templates": {
        "total": {
          "params": [
            "v",
            "S"
          ],
          "body": {
            "op": "faq",
            "args": [
              "v"
            ],
            "output_idx": [],
            "reduce": "+",
            "ranges": {
              "k_t": {
                "from": "S"
              }
            },
            "expr": {
              "op": "index",
              "args": [
                "v",
                "k_t"
              ]
            }
          }
        },
        "count_below": {
          "params": [
            "x",
            "v",
            "S"
          ],
          "body": {
            "op": "faq",
            "args": [
              "v"
            ],
            "output_idx": [],
            "reduce": "+",
            "ranges": {
              "k_b": {
                "from": "S"
              }
            },
            "expr": {
              "op": "ifelse",
              "args": [
                {
                  "op": "<",
                  "args": [
                    {
                      "op": "index",
                      "args": [
                        "v",
                        "k_b"
                      ]
                    },
                    "x"
                  ]
                },
                1,
                0
              ]
            }
          }
        }
      },
      "variables": {
        "a": {
          "type": "parameter",
          "shape": [
            "cells"
          ],
          "default": [
            1.0,
            2.0,
            4.0
          ],
          "units": "1"
        },
        "b": {
          "type": "parameter",
          "shape": [
            "sites"
          ],
          "default": [
            8.0,
            16.0
          ],
          "units": "1"
        },
        "q": {
          "type": "parameter",
          "default": 3.0,
          "units": "1"
        },
        "y_cells": {
          "type": "unknown",
          "default": 0.0,
          "units": "1"
        },
        "y_sites": {
          "type": "unknown",
          "default": 0.0,
          "units": "1"
        },
        "n_below": {
          "type": "unknown",
          "default": 0.0,
          "units": "1"
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "y_cells"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "apply_expression_template",
            "args": [],
            "name": "total",
            "bindings": {
              "v": "a",
              "S": "cells"
            }
          }
        },
        {
          "lhs": {
            "op": "D",
            "args": [
              "y_sites"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "apply_expression_template",
            "args": [],
            "name": "total",
            "bindings": {
              "v": "b",
              "S": "sites"
            }
          }
        },
        {
          "lhs": {
            "op": "D",
            "args": [
              "n_below"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "apply_expression_template",
            "args": [],
            "name": "count_below",
            "bindings": {
              "x": "q",
              "v": "a",
              "S": "cells"
            }
          }
        }
      ],
      "tests": [
        {
          "id": "ranges_from_param",
          "time_span": {
            "start": 0.0,
            "end": 1.0
          },
          "tolerance": {
            "rel": 1e-09,
            "abs": 1e-12
          },
          "assertions": [
            {
              "variable": "y_cells",
              "time": 1.0,
              "expected": 7.0
            },
            {
              "variable": "y_sites",
              "time": 1.0,
              "expected": 24.0
            },
            {
              "variable": "n_below",
              "time": 1.0,
              "expected": 2.0
            }
          ]
        }
      ]
    }
  }
}
