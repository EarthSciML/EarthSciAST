{
  "esm": "1.0.0",
  "metadata": {
    "name": "TranslateFactorProvenance",
    "description": "Per-term provenance under an operator_compose `translate` factor. Chem.Z has one contribution, so it is appended as 3 * expr with Chem's origin. Chem.X already holds two (Chem's and Sink's, from entry 0), so they COLLAPSE into one contribution 2 * (x1 + x2) whose origins are the union, Chem then Sink: distributing the factor would change the arithmetic.",
    "authors": [
      "EarthSciAST test suite"
    ],
    "created": "2026-10-24T00:00:00Z"
  },
