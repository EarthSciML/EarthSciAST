{"esm":"1.2.0","metadata":{"name":"suffix_scan","description":"two-region makearray of a column to-top scan and a zero lid, 50 columns x 20 layers","authors":["EarthSciAST scaling conformance tier"]},"index_sets":{"col":{"kind":"interval","size":50},"lev":{"kind":"interval","size":20},"lev_nodes":{"kind":"interval","size":21}},"models":{"Column":{"variables":{"u":{"type":"unknown","units":"kg/m^3","shape":["col","lev"],"default":1.0},"dz":{"type":"unknown","units":"m","shape":["lev"]},"B":{"type":"unknown","units":"kg/m^2","shape":["col","lev_nodes"]}},"equations":[{"lhs":"dz","rhs":{"op":"faq","args":[],"output_idx":["l"],"ranges":{"l":{"from":"lev"}},"expr":{"op":"*","args":[{"op":"const","args":[],"value":100.0,"units":"m"},{"op":"+","args":[1,{"op":"*","args":[0.5,{"op":"sin","args":["l"]}]}]}]}}},{"lhs":"B","rhs":{"op":"makearray","args":[],"regions":[[[1,50],[1,20]],[[1,50],[21,21]]],"values":[{"op":"faq","args":[],"output_idx":["c","k"],"ranges":{"c":{"from":"col"},"k":{"from":"lev"},"j":{"from":"lev"}},"reduce":"+","filter":{"op":">=","args":["j","k"]},"expr":{"op":"*","args":[{"op":"index","args":["u","c","j"]},{"op":"index","args":["dz","j"]}]}},0.0]}},{"lhs":{"op":"faq","args":[],"output_idx":["c","l"],"expr":{"op":"D","args":[{"op":"index","args":["u","c","l"]}],"wrt":"t"},"ranges":{"c":{"from":"col"},"l":{"from":"lev"}}},"rhs":{"op":"faq","args":[],"output_idx":["c","l"],"ranges":{"c":{"from":"col"},"l":{"from":"lev"}},"expr":{"op":"/","args":[{"op":"*","args":[-0.001,{"op":"-","args":[{"op":"index","args":["B","c","l"]},{"op":"index","args":["B","c",{"op":"+","args":["l",1]}]}]}]},{"op":"index","args":["dz","l"]}]}}}]}}}
