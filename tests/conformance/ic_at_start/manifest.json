    10.0,
    11.0
   ],
   "providers": [],
   "expected": {
    "S.a": 21.0,
    "S.b": 60.0
   },
   "note": "the same on a document with no array state: a = 2*10 + 1, b = g = 3*2*10",
   "p": {}
  },
