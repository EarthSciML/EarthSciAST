{
 "category": "ic_at_start",
 "version": "1.0",
 "description": "An `ic` right-hand side is evaluated once, at t0 = tspan[0], the start of the run, in the start-of-run scope (esm-spec 11.4.2): it may read the independent variable t (bound to t0), every parameter (scalar or shaped), every data-fed parameter at the value its provider gives at t0, and every observed over those, scalar or array-valued; it may not read a state, and a build refuses one that does at construction with ic_reads_state. Each case builds its fixture with the case's tspan, p, providers and sample_time and checks the state a solve starts from at tspan[0], element by element, keyed by flattened name; a refusal case checks that construction raises the error code. Every provider value is a dyadic rational and every formula exact in binary64, so the expected values are exact.",
 "spec": [
  "esm-spec.md 11.4.2",
  "esm-spec.md 6.6.5 (build-time evaluation scope)",
  "esm-libraries-spec.md 2.5.2"
 ],
 "compiler": "native",
 "bindings_required": [
  "julia",
  "python",
  "rust"
 ],
 "scope_excluded": {
  "typescript": "No simulator (API_SPEC 3, capability profiles).",
  "go": "No simulator (API_SPEC 3, capability profiles)."
 },
 "provider": "As tests/conformance/provider_forcing: a provider entry is passed under `key` in the construction option `providers`. It delivers one field whose value at time t is base + slope * t elementwise; `base` is nested row-major (outer list = first index) over `shape`, and a 0-d field is one number. `refresh_times` empty makes it a const provider (slope 0); otherwise it is discrete with those refresh times.",
 "checks": {
  "expected": "the state a solve of the Problem starts from at tspan[0] equals `expected` for every state element (rtol, atol below); Rust also checks initial_state(prob) against it bit for bit",
  "error_code": "building the Problem (or, at the latest, building its initial state) raises an error carrying `error_code`"
 },
 "tolerances": {
  "rtol": 1e-14,
  "atol": 1e-14
 },
 "cases": [
  {
   "id": "t_at_nonzero_start",
   "fixture": "fixtures/ic_reads_t.esm",
   "tspan": [
    10.0,
    11.0
   ],
   "providers": [],
   "expected": {
    "T.a": 21.0,
    "T.u[1]": 6.0,
    "T.u[2]": 7.0,
    "T.u[3]": 8.0
   },
   "note": "t is bound to t0 = 10: a = 2*10 + 1, u[i] = rate[i] = i + 0.5*10. A binding that binds t to 0 gives a = 1, u = [1, 2, 3].",
   "p": {}
  },
  {
   "id": "t_at_zero_start",
   "fixture": "fixtures/ic_reads_t.esm",
   "tspan": [
    0.0,
    1.0
   ],
   "providers": [],
   "expected": {
    "T.a": 1.0,
    "T.u[1]": 1.0,
    "T.u[2]": 2.0,
    "T.u[3]": 3.0
   },
   "note": "the control at t0 = 0",
   "p": {}
  },
  {
