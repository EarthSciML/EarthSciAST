{
  "esm": "2.4.0",
  "metadata": {
    "name": "computed_array_argument",
    "description": "A definition's array parameter bound to a COMPUTED array: a makearray whose interior region is itself an array-valued definition application (the face fluxes of a finite-volume divergence, zero at both walls), and an array-valued application read at other subscripts. Each is evaluated once, in the caller, and passed to the definition as its argument, exactly as a named array would be; nothing is expanded. With a = [1, 2, 4, 8] held constant: F = [0, 1.5, 3, 6, 0] and v' = F[i+1] - F[i] = [1.5, 1.5, 3, -6]; w' = 3 * (2 a)[5-i] = [48, 24, 12, 6]. Each probe integrates its constant tendency for one unit of time from zero, so its value at t = 1 is that tendency, computed outside every binding.",
    "authors": [
      "EarthSciAST Test Suite"
    ],
    "tags": [
      "operators",
      "array-parameter",
      "makearray",
      "conformance",
      "esm-spec-9.6.11"
    ]
  },
  "index_sets": {
    "cells": {
      "kind": "interval",
      "size": 4
    }
  },
  "models": {
    "computed_array_argument": {
      "tolerance": {
        "rel": 1e-09,
        "abs": 1e-12
      },
      "variables": {
        "a": {
          "type": "unknown",
          "shape": [
            "cells"
          ],
          "units": "1",
          "description": "Held constant (zero tendency); the source of both computed arrays."
        },
        "v": {
          "type": "unknown",
          "shape": [
            "cells"
          ],
          "units": "1"
        },
        "w": {
          "type": "unknown",
          "shape": [
            "cells"
          ],
          "units": "1"
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "a"
            ],
            "wrt": "t"
          },
          "rhs": 0.0
        },
        {
          "lhs": {
            "op": "D",
            "args": [
              "v"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "apply_operator",
            "args": [],
            "name": "face_difference",
            "bindings": {
              "F": {
                "op": "makearray",
                "args": [],
                "regions": [
                  [
                    [
                      2,
                      4
                    ]
                  ],
                  [
                    [
                      1,
                      1
                    ]
                  ],
                  [
                    [
                      5,
                      5
                    ]
                  ]
                ],
                "values": [
                  {
                    "op": "apply_operator",
                    "args": [],
                    "name": "faces_interior",
                    "bindings": {
                      "q": "a"
                    }
                  },
                  0.0,
                  0.0
                ]
              }
            }
          }
        },
        {
          "lhs": {
            "op": "D",
            "args": [
              "w"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "apply_operator",
            "args": [],
            "name": "reversed_scaled",
            "bindings": {
              "G": {
                "op": "apply_operator",
                "args": [],
                "name": "twice",
                "bindings": {
                  "q": "a"
                }
              }
            }
          }
        }
      ],
      "operators": {
        "faces_interior": {
          "params": [
            "q"
          ],
          "description": "The mean of the two cells on each interior face f = 2..4 (face f lies between cells f-1 and f).",
          "body": {
            "op": "faq",
            "args": [
              "q"
            ],
            "output_idx": [
              "f"
            ],
            "ranges": {
              "f": [
                2,
                4
              ]
            },
            "expr": {
              "op": "*",
              "args": [
                0.5,
                {
                  "op": "+",
                  "args": [
                    {
                      "op": "index",
                      "args": [
                        "q",
                        {
                          "op": "-",
                          "args": [
                            "f",
                            1
                          ]
                        }
                      ]
                    },
                    {
                      "op": "index",
                      "args": [
                        "q",
                        "f"
                      ]
                    }
                  ]
                }
              ]
            }
          }
        },
        "face_difference": {
          "params": [
            "F"
          ],
          "description": "F[i+1] - F[i] over the cells: the parameter F is read only through index, so it is an array parameter.",
          "body": {
            "op": "faq",
            "args": [
              "F"
            ],
            "output_idx": [
              "i"
            ],
            "ranges": {
              "i": {
                "from": "cells"
              }
            },
            "expr": {
              "op": "-",
              "args": [
                {
                  "op": "index",
                  "args": [
                    "F",
                    {
                      "op": "+",
                      "args": [
                        "i",
                        1
                      ]
                    }
                  ]
                },
                {
                  "op": "index",
                  "args": [
                    "F",
                    "i"
                  ]
                }
              ]
            }
          }
        },
        "twice": {
          "params": [
            "q"
          ],
          "description": "2 q, an array-valued definition over the cells.",
          "body": {
            "op": "faq",
            "args": [
              "q"
            ],
            "output_idx": [
              "i"
            ],
            "ranges": {
              "i": {
                "from": "cells"
              }
            },
            "expr": {
              "op": "*",
              "args": [
                2.0,
                {
                  "op": "index",
                  "args": [
                    "q",
                    "i"
                  ]
                }
              ]
            }
          }
        },
        "reversed_scaled": {
          "params": [
            "G"
          ],
          "description": "3 G[5-i]: G read at another subscript, so it is read as a whole array, not element by element.",
          "body": {
            "op": "faq",
            "args": [
              "G"
            ],
            "output_idx": [
              "i"
            ],
            "ranges": {
              "i": {
                "from": "cells"
              }
            },
            "expr": {
              "op": "*",
              "args": [
                3.0,
                {
                  "op": "index",
                  "args": [
                    "G",
                    {
                      "op": "-",
                      "args": [
                        5,
                        "i"
                      ]
                    }
                  ]
                }
              ]
            }
          }
        }
      },
      "tests": [
        {
          "id": "computed_array_arguments",
          "description": "Each probe integrates a constant element of a definition applied to a computed array for one unit of time.",
          "initial_conditions": {
            "a[1]": 1.0,
            "a[2]": 2.0,
            "a[3]": 4.0,
            "a[4]": 8.0,
            "v[1]": 0.0,
            "v[2]": 0.0,
            "v[3]": 0.0,
            "v[4]": 0.0,
            "w[1]": 0.0,
            "w[2]": 0.0,
            "w[3]": 0.0,
            "w[4]": 0.0
          },
          "time_span": {
            "start": 0.0,
            "end": 1.0
          },
          "assertions": [
            {
              "variable": "v[1]",
              "time": 1.0,
              "expected": 1.5
            },
            {
              "variable": "v[2]",
              "time": 1.0,
              "expected": 1.5
            },
            {
              "variable": "v[3]",
              "time": 1.0,
              "expected": 3.0
            },
            {
              "variable": "v[4]",
              "time": 1.0,
              "expected": -6.0
            },
            {
              "variable": "w[1]",
              "time": 1.0,
              "expected": 48.0
            },
            {
              "variable": "w[2]",
              "time": 1.0,
              "expected": 24.0
            },
            {
              "variable": "w[3]",
              "time": 1.0,
              "expected": 12.0
            },
            {
              "variable": "w[4]",
              "time": 1.0,
              "expected": 6.0
            }
          ]
        }
      ]
    }
  }
}
