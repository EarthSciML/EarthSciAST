{
  "esm": "1.1.0",
  "metadata": {
    "name": "geometry_spherical_fan_template",
    "description": "The `overlap_area_spherical` and `lonlat_to_unit` templates of lib/geometry.esm on a meridian fan on the unit sphere. Apex E = (0E, 0N) is a pole of the meridian lon = 90E, so every fan arc meets that meridian at a right angle and each triangle (E, (90E, a), (90E, b)) has area b - a in radians by Girard's theorem. Four source triangles of 15 degrees tile two target triangles of 30 degrees along shared great-circle arcs: a nested pair overlaps by pi/12 sr (it shares two edges with its target, run the same way), a pair touching along a fan arc run in opposite directions or only at the apex overlaps by exactly 0, and each target's row sum is pi/6. Every ring is a triangle padded to four slots. The unit-vector stacks are built once per cell by a faq over `lonlat_to_unit`. Run by the `geometry_templates` inline-test conformance tier.",
    "authors": [
      "EarthSciML"
    ],
    "tags": [
      "geometry",
      "polygon_intersection_area",
      "expression_templates",
      "faq",
      "spherical",
      "padded-ring",
      "conformance"
    ]
  },
  "index_sets": {
    "src_cells": {
      "kind": "interval",
      "size": 4
    },
    "tgt_cells": {
      "kind": "interval",
      "size": 2
    },
    "verts": {
      "kind": "interval",
      "size": 4
    },
    "lonlat": {
      "kind": "interval",
      "size": 2
    },
    "xyz": {
      "kind": "interval",
      "size": 3
    }
  },
  "models": {
    "GeometrySphericalFanTemplate": {
      "expression_template_imports": [
        {
          "ref": "../../../../lib/geometry.esm",
          "only": [
            "overlap_area_spherical",
            "lonlat_to_unit"
          ]
        }
      ],
      "variables": {
        "src_poly": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "src_cells",
            "verts",
            "lonlat"
          ],
          "description": "Source fan triangles S_k = (E, (90E, 15(k-1)N), (90E, 15kN)), E = (0E, 0N), each padded to four slots by repeating its last vertex."
        },
        "tgt_poly": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "tgt_cells",
            "verts",
            "lonlat"
          ],
          "description": "Target fan triangles T_1 = (E, (90E, 0N), (90E, 30N)) and T_2 = (E, (90E, 30N), (90E, 60N)), padded the same way."
        },
        "src_xyz": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "src_cells",
            "verts",
            "xyz"
          ],
          "description": "Unit vectors of the source vertices, by the `lonlat_to_unit` template."
        },
        "tgt_xyz": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "tgt_cells",
            "verts",
            "xyz"
          ],
          "description": "Unit vectors of the target vertices, by the `lonlat_to_unit` template."
        },
        "A_template": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "src_cells",
            "tgt_cells"
          ],
          "description": "Overlap areas in steradians by the `overlap_area_spherical` template of lib/geometry.esm."
        },
        "A_j": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "tgt_cells"
          ],
          "description": "Row sums of the computed overlaps: each target's area, pi/6."
        },
        "s": {
          "type": "unknown",
          "units": "1",
          "default": 0.0,
          "description": "Trivial state, so the document has something to integrate."
        }
      },
      "equations": [
        {
          "lhs": "src_poly",
          "rhs": {
            "op": "const",
            "args": [],
            "value": [
              [
                [
                  0.0,
                  0.0
                ],
                [
                  90.0,
                  0.0
                ],
                [
                  90.0,
                  15.0
                ],
                [
                  90.0,
                  15.0
                ]
              ],
