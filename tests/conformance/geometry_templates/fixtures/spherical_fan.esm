                  90.0,
                  15.0
                ],
                [
                  90.0,
                  30.0
                ],
                [
                  90.0,
                  30.0
                ]
              ],
              [
                [
                  0.0,
                  0.0
                ],
                [
                  90.0,
                  30.0
                ],
                [
                  90.0,
                  45.0
                ],
                [
                  90.0,
                  45.0
                ]
              ],
              [
                [
                  0.0,
                  0.0
                ],
                [
                  90.0,
                  45.0
                ],
                [
                  90.0,
                  60.0
                ],
                [
                  90.0,
                  60.0
                ]
              ]
            ]
          }
        },
        {
          "lhs": "tgt_poly",
          "rhs": {
            "op": "const",
            "args": [],
            "value": [
              [
                [
                  0.0,
                  0.0
                ],
                [
                  90.0,
                  0.0
                ],
                [
                  90.0,
                  30.0
                ],
                [
                  90.0,
                  30.0
                ]
              ],
              [
                [
                  0.0,
                  0.0
                ],
                [
                  90.0,
                  30.0
                ],
                [
                  90.0,
                  60.0
                ],
                [
                  90.0,
                  60.0
                ]
              ]
            ]
          }
        },
        {
          "lhs": "src_xyz",
          "rhs": {
            "op": "faq",
            "args": [],
            "output_idx": [
              "c",
              "v",
              "d"
            ],
            "ranges": {
              "c": {
                "from": "src_cells"
              },
              "v": {
                "from": "verts"
              },
              "d": {
                "from": "xyz"
              }
            },
            "expr": {
              "op": "apply_expression_template",
              "args": [],
              "name": "lonlat_to_unit",
              "bindings": {
                "ring": "src_poly",
                "cell": "c",
                "vert": "v",
                "comp": "d"
              }
            }
          }
        },
        {
          "lhs": "tgt_xyz",
          "rhs": {
            "op": "faq",
            "args": [],
            "output_idx": [
              "c",
              "v",
              "d"
            ],
            "ranges": {
              "c": {
                "from": "tgt_cells"
              },
              "v": {
                "from": "verts"
              },
              "d": {
                "from": "xyz"
              }
            },
            "expr": {
              "op": "apply_expression_template",
              "args": [],
              "name": "lonlat_to_unit",
              "bindings": {
                "ring": "tgt_poly",
                "cell": "c",
                "vert": "v",
                "comp": "d"
              }
            }
          }
        },
        {
          "lhs": "A_template",
          "rhs": {
            "op": "faq",
            "args": [],
            "output_idx": [
              "i",
              "j"
            ],
            "ranges": {
              "i": {
                "from": "src_cells"
              },
              "j": {
                "from": "tgt_cells"
              }
            },
            "expr": {
              "op": "apply_expression_template",
              "args": [],
              "name": "overlap_area_spherical",
              "bindings": {
                "ring_a": "src_xyz",
                "cell_a": "i",
                "nv_a": 4,
                "ring_b": "tgt_xyz",
                "cell_b": "j",
                "nv_b": 4
              }
            }
          }
        },
        {
          "lhs": "A_j",
          "rhs": {
            "op": "faq",
            "args": [],
            "output_idx": [
              "j"
            ],
            "ranges": {
              "i": {
                "from": "src_cells"
              },
              "j": {
                "from": "tgt_cells"
              }
            },
            "expr": {
              "op": "index",
              "args": [
                "A_template",
                "i",
                "j"
              ]
            }
          }
        },
        {
          "lhs": {
            "op": "D",
            "args": [
              "s"
            ],
            "wrt": "t"
          },
          "rhs": 0.0
        }
      ],
      "tolerance": {
        "abs": 1e-15,
        "rel": 1e-09
      },
      "tests": [
        {
          "id": "spherical_fan_t0",
          "description": "Every pair against Girard's theorem (pi/12 for a nested pair) at the CONFORMANCE_SPEC 5.8.2 band; the touching pairs exactly 0.",
          "time_span": {
            "start": 0.0,
            "end": 0.0
