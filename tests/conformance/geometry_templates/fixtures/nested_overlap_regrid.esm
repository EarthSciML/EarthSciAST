  "NestedOverlapRegrid": {
   "operator_imports": [
    {
     "ref": "esm:std/geometry.esm",
     "only": [
      "overlap_area_planar"
     ]
    }
   ],
   "operators": {
    "pairs_gated": {
     "params": [
      "src_ring",
      "tgt_ring",
      "area",
      "src_poly",
      "tgt_poly"
     ],
     "description": "The broad-phase-gated pairwise skeleton (EarthSciDiscretizations regridding/conservative_overlap.esm conservative_overlap_pairs_gated): the [src_cells, tgt_cells] matrix whose (i, j) entry is the expression bound to `area`, evaluated with the loop symbols i and j in scope, over the candidate pairs of the overlap join gate only. The gate's envelopes `src_poly` and `tgt_poly` are parameters, as a flatten closes the library's body (they sit in a structural position: a reference names its instance).",
     "body": {
      "op": "faq",
      "semiring": "sum_product",
      "output_idx": [
       "i",
       "j"
      ],
      "ranges": {
       "i": {
        "from": "src_cells"
       },
       "j": {
        "from": "tgt_cells"
       }
      },
      "join": [
       {
        "overlap": {
         "src_env": [
          "src_poly"
         ],
         "tgt_env": [
          "tgt_poly"
         ],
         "eps": 1e-09
        }
       }
      ],
      "args": [
       "src_ring",
       "tgt_ring"
      ],
      "expr": "area"
     }
    },
    "pairs_dense": {
     "params": [
      "src_ring",
      "tgt_ring",
      "area"
     ],
     "description": "The dense pairwise skeleton (conservative_overlap_pairs): every pair visited.",
     "body": {
      "op": "faq",
      "output_idx": [
       "i",
       "j"
      ],
      "ranges": {
       "i": {
        "from": "src_cells"
       },
       "j": {
        "from": "tgt_cells"
       }
      },
      "args": [
       "src_ring",
       "tgt_ring"
      ],
      "expr": "area"
     }
    },
    "area_planar_ij": {
     "params": [
      "src_poly",
      "tgt_poly",
      "src_nv",
      "tgt_nv"
     ],
     "description": "The narrow-phase element (conservative_overlap_area_planar_ij): overlap_area_planar of source cell i and target cell j. It reads the loop symbols i and j of the skeleton it is bound into (the expansion substitutes it inside the skeleton's loops).",
     "body": {
      "op": "apply_operator",
      "args": [],
      "name": "overlap_area_planar",
      "bindings": {
       "ring_a": "src_poly",
       "cell_a": "i",
       "nv_a": "src_nv",
       "ring_b": "tgt_poly",
       "cell_b": "j",
       "nv_b": "tgt_nv"
      }
     }
    },
    "A_ij_gated_planar": {
     "params": [
      "src_poly",
      "tgt_poly",
      "src_nv",
      "tgt_nv"
     ],
     "description": "The gated narrow phase (conservative_overlap_A_ij_gated_planar): a definition whose body applies another definition, the skeleton, with its `area` bound to a third application that reads the skeleton's loop symbols.",
     "body": {
      "op": "apply_operator",
      "args": [],
      "name": "pairs_gated",
      "bindings": {
       "src_ring": "src_poly",
       "tgt_ring": "tgt_poly",
       "src_poly": "src_poly",
       "tgt_poly": "tgt_poly",
       "area": {
        "op": "apply_operator",
        "args": [],
        "name": "area_planar_ij",
        "bindings": {
         "src_poly": "src_poly",
         "tgt_poly": "tgt_poly",
         "src_nv": "src_nv",
         "tgt_nv": "tgt_nv"
        }
       }
      }
     }
    },
    "A_ij_dense_planar": {
     "params": [
      "src_poly",
      "tgt_poly",
      "src_nv",
      "tgt_nv"
     ],
     "description": "The dense narrow phase (conservative_overlap_A_ij_planar): the same nesting around the dense skeleton.",
     "body": {
      "op": "apply_operator",
      "args": [],
      "name": "pairs_dense",
      "bindings": {
       "src_ring": "src_poly",
       "tgt_ring": "tgt_poly",
       "area": {
        "op": "apply_operator",
        "args": [],
        "name": "area_planar_ij",
        "bindings": {
         "src_poly": "src_poly",
         "tgt_poly": "tgt_poly",
         "src_nv": "src_nv",
         "tgt_nv": "tgt_nv"
        }
       }
      }
     }
    },
    "A_j_gated": {
     "params": [
      "A_ij",
      "src_poly",
      "tgt_poly",
      "atol"
     ],
     "description": "The gated row normalization (conservative_overlap_A_j_gated).",
     "body": {
      "op": "faq",
      "semiring": "sum_product",
      "output_idx": [
       "j"
      ],
      "ranges": {
       "i": {
        "from": "src_cells"
       },
       "j": {
        "from": "tgt_cells"
       }
      },
      "join": [
       {
        "overlap": {
         "src_env": [
          "src_poly"
         ],
         "tgt_env": [
          "tgt_poly"
         ],
         "eps": 1e-09
        }
       }
      ],
      "filter": {
       "op": ">",
       "args": [
        {
         "op": "index",
         "args": [
          "A_ij",
          "i",
          "j"
         ]
        },
        "atol"
       ]
      },
      "args": [
       "A_ij",
       "src_poly",
       "tgt_poly"
      ],
      "expr": {
       "op": "index",
       "args": [
        "A_ij",
        "i",
        "j"
       ]
      }
     }
    },
    "apply_gated": {
     "params": [
      "A_ij",
      "A_j",
      "F_src",
      "src_poly",
      "tgt_poly",
      "atol"
     ],
     "description": "The gated apply and normalize (conservative_overlap_apply_gated).",
     "body": {
      "op": "faq",
      "semiring": "sum_product",
      "output_idx": [
       "j"
      ],
      "ranges": {
       "i": {
        "from": "src_cells"
       },
       "j": {
        "from": "tgt_cells"
       }
      },
      "join": [
       {
        "overlap": {
         "src_env": [
          "src_poly"
         ],
         "tgt_env": [
          "tgt_poly"
         ],
         "eps": 1e-09
        }
       }
      ],
      "filter": {
       "op": ">",
       "args": [
        {
         "op": "index",
         "args": [
          "A_ij",
          "i",
          "j"
         ]
        },
        "atol"
       ]
      },
      "args": [
       "A_ij",
       "A_j",
       "F_src",
       "src_poly",
       "tgt_poly"
      ],
      "expr": {
       "op": "/",
       "args": [
        {
         "op": "*",
         "args": [
          {
           "op": "index",
           "args": [
            "A_ij",
            "i",
            "j"
           ]
          },
          {
           "op": "index",
           "args": [
            "F_src",
            "i"
           ]
          }
         ]
        },
        {
         "op": "index",
         "args": [
          "A_j",
          "j"
         ]
        }
       ]
      }
     }
    }
   },
   "tolerance": {
    "abs": 1e-12,
    "rel": 1e-12
   },
   "variables": {
    "atol": {
     "type": "parameter",
     "units": "1",
     "default": 1e-12
    },
    "A_ij": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "src_cells",
      "tgt_cells"
     ],
     "description": "Overlap areas by the gated narrow phase: a definition whose body applies the skeleton definition."
    },
    "A_dense": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "src_cells",
      "tgt_cells"
     ],
     "description": "The same areas by the dense narrow phase."
    },
    "A_j": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "tgt_cells"
     ],
     "description": "Covered area of each target cell (the gated row sum)."
    },
    "E": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "tgt_cells"
     ],
     "default": 0.0,
     "description": "Integrates the regridded field for one unit of time."
    }
   },
   "equations": [
    {
     "lhs": "A_ij",
     "rhs": {
      "op": "apply_operator",
      "args": [],
      "name": "A_ij_gated_planar",
      "bindings": {
       "src_poly": "Rings.src_poly",
       "tgt_poly": "Rings.tgt_poly",
       "src_nv": 4,
       "tgt_nv": 4
      }
     }
    },
    {
     "lhs": "A_dense",
     "rhs": {
      "op": "apply_operator",
      "args": [],
      "name": "A_ij_dense_planar",
      "bindings": {
       "src_poly": "Rings.src_poly",
       "tgt_poly": "Rings.tgt_poly",
       "src_nv": 4,
       "tgt_nv": 4
      }
     }
    },
    {
     "lhs": "A_j",
     "rhs": {
      "op": "apply_operator",
      "args": [],
      "name": "A_j_gated",
      "bindings": {
       "A_ij": "A_ij",
       "src_poly": "Rings.src_poly",
       "tgt_poly": "Rings.tgt_poly",
       "atol": "atol"
      }
     }
    },
    {
     "lhs": {
      "op": "D",
      "args": [
       "E"
      ],
      "wrt": "t"
     },
     "rhs": {
      "op": "apply_operator",
      "args": [],
      "name": "apply_gated",
      "bindings": {
       "A_ij": "A_ij",
       "A_j": "A_j",
       "F_src": "Rings.F_src",
       "src_poly": "Rings.src_poly",
       "tgt_poly": "Rings.tgt_poly",
       "atol": "atol"
      }
     }
    }
   ],
   "tests": [
    {
     "id": "nested_overlap_regrid",
