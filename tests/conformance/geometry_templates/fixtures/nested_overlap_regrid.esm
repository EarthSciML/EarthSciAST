{
 "esm": "2.4.0",
 "metadata": {
  "name": "geometry_nested_overlap_regrid",
  "description": "The conservative overlap regrid of the EarthSciDiscretizations library (regridding/conservative_overlap.esm) as reseact's NEI emissions apply it: the rings live in another component (`Rings`), so each application binds component-qualified names, and the gated skeleton takes its overlap envelopes as parameters, which sit in a structural position (each application reads an instance of it). The narrow phase is a definition whose BODY applies another definition, the pairwise skeleton, with the skeleton's `area` bound to a third application that reads the skeleton's loop symbols i and j (the expansion substitutes it inside the skeleton's loops, which bind them). Gated and dense narrow phases, the gated row sum and the gated apply. A binding compiles each definition as its own function, called from the one that applies it; none is expanded. 3 x 3 unit source cells onto 2 x 2 target cells of side 1.5; every area is dyadic. Run by the `geometry_templates` inline-test conformance tier.",
  "authors": [
   "EarthSciML"
  ],
  "tags": [
   "geometry",
   "operators",
   "nested-references",
   "faq",
   "planar",
   "join-gate",
   "conformance"
  ]
 },
 "index_sets": {
  "src_cells": {
   "kind": "interval",
   "size": 9
  },
  "tgt_cells": {
   "kind": "interval",
   "size": 4
  },
  "verts": {
   "kind": "interval",
   "size": 4
  },
  "xy": {
   "kind": "interval",
   "size": 2
  }
 },
