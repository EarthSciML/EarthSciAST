              "bindings": {
                "ring_a": "src_poly",
                "cell_a": "i",
                "nv_a": 6,
                "ring_b": "tgt_poly",
                "cell_b": "j",
                "nv_b": 6
              }
            },
            "join": [
              {
                "overlap": {
                  "src_env": [
                    "src_poly"
                  ],
                  "tgt_env": [
                    "tgt_poly"
                  ],
                  "eps": 0.0
                }
              }
            ]
          }
        },
        {
          "lhs": "A_leaf",
          "rhs": {
            "op": "faq",
            "args": [],
            "output_idx": [
              "i",
              "j"
            ],
            "ranges": {
              "i": {
                "from": "src_cells"
              },
              "j": {
                "from": "tgt_cells"
              }
            },
            "expr": {
              "op": "polygon_intersection_area",
              "manifold": "planar",
              "args": [
                {
                  "op": "index",
                  "args": [
                    "src_poly",
                    "i"
                  ]
                },
                {
                  "op": "index",
                  "args": [
                    "tgt_poly",
                    "j"
                  ]
                }
              ]
            }
          }
        },
        {
          "lhs": {
            "op": "D",
            "args": [
