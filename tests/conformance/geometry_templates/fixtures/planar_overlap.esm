{
  "esm": "1.1.0",
  "metadata": {
    "name": "geometry_planar_overlap_template",
    "description": "The `overlap_area_planar` template of lib/geometry.esm against the `polygon_intersection_area` leaf (esm-spec \u00a78.6.1) on cells that exercise every special case: identical cells, an adjacent pair (shared edge, opposite directions), corner and edge touches, nested and partial overlaps, a clockwise ring, a pentagon, and rings padded by a closing duplicate, trailing repeats and a leading repeat. Every coordinate and area is dyadic, so the template, the template behind the overlap join gate, and the leaf are each asserted exactly (tolerance 0). Run by the `geometry_templates` inline-test conformance tier.",
    "authors": [
      "EarthSciML"
    ],
    "tags": [
      "geometry",
      "polygon_intersection_area",
      "expression_templates",
      "faq",
      "planar",
      "padded-ring",
      "conformance"
    ]
  },
  "index_sets": {
    "src_cells": {
      "kind": "interval",
      "size": 4
    },
    "tgt_cells": {
      "kind": "interval",
      "size": 3
    },
    "verts": {
      "kind": "interval",
      "size": 6
    },
    "xy": {
      "kind": "interval",
      "size": 2
    }
  },
  "models": {
    "GeometryPlanarOverlapTemplate": {
      "expression_template_imports": [
        {
          "ref": "../../../../lib/geometry.esm",
          "only": [
            "overlap_area_planar"
          ]
        }
      ],
      "variables": {
        "src_poly": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "src_cells",
            "verts",
            "xy"
          ],
          "description": "Four source cells, each padded to six vertex slots: a square with its last vertex repeated, a square with a closing duplicate, a clockwise square, and a pentagon."
        },
        "tgt_poly": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "tgt_cells",
            "verts",
            "xy"
          ],
          "description": "Three target cells: source cell 1 again (padded with a leading repeat), a strip over the bottom row, and a diamond centred on the corner (1, 1)."
        },
        "A_template": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "src_cells",
            "tgt_cells"
          ],
          "description": "Overlap areas by the `overlap_area_planar` template of lib/geometry.esm, a dense faq over every pair."
        },
        "A_gated": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "src_cells",
            "tgt_cells"
          ],
          "description": "The same template behind the bounding-box overlap join gate, as a conservative-regrid narrow phase writes it over candidate pairs; a pair the gate drops reads 0."
        },
        "A_leaf": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "src_cells",
            "tgt_cells"
          ],
          "description": "The same areas by the `polygon_intersection_area` leaf (planar)."
        },
        "s": {
          "type": "unknown",
          "units": "1",
          "default": 0.0,
          "description": "Trivial state, so the document has something to integrate."
        }
      },
