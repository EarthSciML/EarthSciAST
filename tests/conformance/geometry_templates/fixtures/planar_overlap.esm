            "expr": {
              "op": "apply_expression_template",
              "args": [],
              "name": "overlap_area_planar",
              "bindings": {
                "ring_a": "src_poly",
                "cell_a": "i",
                "nv_a": 6,
                "ring_b": "tgt_poly",
