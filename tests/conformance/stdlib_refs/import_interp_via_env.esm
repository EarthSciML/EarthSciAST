{
  "esm": "1.1.0",
  "metadata": {
    "name": "import_interp_via_env",
    "description": "A ref that is a `${VAR}` token whose value (set by the harness from the manifest `env`) is `esm:std/interp.esm`. The expansion begins with `esm:`, so it is a standard-library ref (esm-spec §4.7 rule 3), never a relative path.",
    "authors": [
      "EarthSciML"
    ]
  },
  "models": {
    "M": {
      "expression_template_imports": [
        {
          "ref": "${ESM_STDLIB_TEST_REF}",
          "only": [
            "linear"
          ]
        }
      ],
      "variables": {
        "s": {
          "type": "unknown",
          "units": "1",
          "default": 0.0
        },
        "x": {
          "type": "parameter",
          "units": "1",
          "default": 1.5
        },
        "r": {
          "type": "unknown",
          "units": "1"
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "s"
            ],
            "wrt": "t"
          },
          "rhs": 0.0
        },
        {
          "lhs": "r",
          "rhs": {
            "op": "apply_expression_template",
            "args": [],
            "name": "linear",
            "bindings": {
              "table": {
                "op": "const",
                "args": [],
                "value": [
                  10.0,
                  20.0,
                  40.0
                ]
              },
              "axis": {
                "op": "const",
                "args": [],
                "value": [
                  0.0,
                  1.0,
                  2.0
                ]
              },
              "x": "x",
              "n": 3
            }
          }
        }
      ]
    }
  }
}
