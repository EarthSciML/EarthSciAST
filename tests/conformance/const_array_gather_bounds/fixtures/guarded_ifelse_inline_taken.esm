{
  "esm": "1.2.0",
  "metadata": {
    "name": "guarded_ifelse_inline_taken",
    "description": "y[i] = ifelse(i <= 1, 0, 0.5 (c[i] + c[i-1])) over 5 nodes, c a inline 4-entry const array. The guard lets node 5 through, so c[5] is read and the run must fail with E_TREEWALK_CONSTARRAY_OOB, whichever cell is asserted.",
    "authors": [
      "EarthSciML Authors and Contributors"
    ]
  },
  "index_sets": {
    "rows": {
      "kind": "interval",
      "size": 4
    },
    "nodes": {
      "kind": "interval",
      "size": 5
    }
  },
  "models": {
    "M": {
      "variables": {
        "y": {
          "type": "unknown",
          "shape": [
            "nodes"
          ]
        },
        "flux": {
          "type": "unknown",
          "default": 0.0
        }
      },
      "equations": [
        {
          "lhs": "y",
          "rhs": {
            "op": "faq",
            "args": [],
            "output_idx": [
              "i"
            ],
            "ranges": {
              "i": {
                "from": "nodes"
              }
            },
            "expr": {
              "op": "ifelse",
              "args": [
                {
                  "op": "<=",
                  "args": [
                    "i",
                    1
                  ]
                },
                0.0,
                {
                  "op": "*",
                  "args": [
                    0.5,
                    {
                      "op": "+",
                      "args": [
                        {
                          "op": "index",
                          "args": [
                            {
                              "op": "const",
                              "args": [],
                              "value": [
                                10.0,
                                20.0,
                                30.0,
                                40.0
                              ]
                            },
                            "i"
                          ]
                        },
                        {
                          "op": "index",
                          "args": [
                            {
                              "op": "const",
                              "args": [],
                              "value": [
                                10.0,
                                20.0,
                                30.0,
                                40.0
                              ]
                            },
                            {
                              "op": "-",
                              "args": [
                                "i",
                                1
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          }
        },
        {
          "lhs": {
            "op": "D",
            "args": [
              "flux"
            ],
            "wrt": "t"
          },
          "rhs": 0.0
        }
      ],
      "tests": [
        {
          "id": "gather",
          "time_span": {
            "start": 0.0,
            "end": 1.0
          },
          "assertions": [
            {
              "variable": "y",
              "time": 0.0,
              "expected": -1.0,
              "coords": {
                "nodes": 2
              }
            }
          ]
        }
      ]
    }
  }
}
