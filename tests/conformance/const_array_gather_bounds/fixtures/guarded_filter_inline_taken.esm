{
  "esm": "1.2.0",
  "metadata": {
    "name": "guarded_filter_inline_taken",
    "description": "y = sum_j c[j] over 5 nodes with filter j <= 5, c a inline 4-entry const array. The filter admits j = 5, so c[5] is read and the run must fail with E_TREEWALK_CONSTARRAY_OOB.",
    "authors": [
      "EarthSciML Authors and Contributors"
    ]
  },
  "index_sets": {
    "rows": {
      "kind": "interval",
      "size": 4
    },
    "nodes": {
      "kind": "interval",
      "size": 5
    }
  },
  "models": {
    "M": {
      "variables": {
        "y": {
          "type": "unknown"
        },
        "flux": {
          "type": "unknown",
          "default": 0.0
        }
      },
      "equations": [
        {
          "lhs": "y",
          "rhs": {
            "op": "faq",
            "args": [],
            "output_idx": [],
            "ranges": {
              "j": {
                "from": "nodes"
              }
            },
            "filter": {
              "op": "<=",
              "args": [
                "j",
                5
              ]
            },
            "expr": {
              "op": "index",
              "args": [
                {
                  "op": "const",
                  "args": [],
                  "value": [
                    10.0,
                    20.0,
                    30.0,
                    40.0
                  ]
                },
                "j"
              ]
            }
          }
        },
        {
          "lhs": {
            "op": "D",
            "args": [
              "flux"
            ],
            "wrt": "t"
          },
          "rhs": 0.0
        }
      ],
      "tests": [
        {
          "id": "gather",
          "time_span": {
            "start": 0.0,
            "end": 1.0
          },
          "assertions": [
            {
              "variable": "y",
              "time": 0.0,
              "expected": -1.0
            }
          ]
        }
      ]
    }
  }
}
