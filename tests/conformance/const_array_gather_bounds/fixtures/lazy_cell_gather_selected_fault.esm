{
  "esm": "2.4.0",
  "metadata": {
    "name": "lazy_cell_gather_selected_fault",
    "description": "The second output cell selects an out-of-range constant array read. The first cell is the successful differential replay."
  },
  "models": {
    "Probe": {
      "variables": {"selected": {"type": "unknown", "units": "1"}},
      "equations": [
        {
          "lhs": "selected",
          "rhs": {
            "op": "index",
            "args": [
              {
                "op": "broadcast",
                "fn": "ifelse",
                "args": [
                  {"op": "const", "args": [], "value": [1, 0]},
                  {"op": "const", "args": [], "value": [7, 8]},
                  {"op": "index", "args": [{"op": "const", "args": [], "value": [9]}, 0]}
                ]
              },
              2
            ]
          }
        }
      ],
      "tolerance": {"rel": 0, "abs": 0},
      "tests": [
        {
          "id": "probe",
          "time_span": {"start": 0, "end": 1},
          "assertions": [{"variable": "selected", "time": 0, "expected": -1}]
        }
      ]
    }
  }
}
