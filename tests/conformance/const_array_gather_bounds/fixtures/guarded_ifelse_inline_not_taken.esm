      "variables": {
        "y": {
          "type": "unknown",
          "shape": [
            "nodes"
          ]
        },
        "flux": {
          "type": "unknown",
          "default": 0.0
        }
      },
      "equations": [
        {
          "lhs": "y",
          "rhs": {
            "op": "faq",
            "args": [],
