{
  "esm": "1.1.0",
  "metadata": {
    "name": "WienerNoiseOnTheArrayPath",
    "description": "The same process, with `x_seen` broadcasting `x` over an index set so the document takes the ARRAY evaluator. A parameter whose `update.kind` is `wiener` makes the document an SDE (esm-spec §5.4, §6.3.1 `system_kind` \"sde\"). None of the executing bindings integrates an SDE, and before issue #475 Julia's tree-walk evaluator and Python's pathways built the document anyway, as an ODE with the noise read as a constant. Every evaluator MUST refuse it with `unsupported_construct` naming the construct and the evaluator. Julia's `compiler = :mtk` has no SDE lowering either and refuses it by name with `compiler_refused_rule`.",
    "authors": [
      "EarthSciML Authors and Contributors"
    ],
    "tags": [
      "conformance",
      "unsupported_construct",
      "sde",
      "wiener"
    ]
  },
  "index_sets": {
    "step_rows": {
      "kind": "interval",
      "size": 2
    }
  },
  "models": {
    "WienerNoiseOnTheArrayPath": {
      "tolerance": {
        "rel": 1e-06
      },
      "variables": {
        "x": {
          "type": "unknown",
          "units": "1",
          "description": "An Ornstein-Uhlenbeck state: relaxes towards 0 at rate `theta` and is driven by `sigma * Bw`."
        },
        "theta": {
          "type": "parameter",
          "units": "1/s",
          "default": 1.0,
          "description": "Mean-reversion rate."
        },
        "sigma": {
          "type": "parameter",
          "units": "1/s^0.5",
          "default": 0.5,
          "description": "Noise amplitude."
        },
        "Bw": {
          "type": "parameter",
          "units": "1/s^0.5",
          "description": "The Wiener noise source: resampled every step with sqrt(dt) scaling (esm-spec §5.4). This is the construct under test.",
          "distribution": {
            "kind": "normal",
            "mean": 0.0,
            "std": 1.0
          },
          "update": {
            "kind": "wiener"
          }
        },
        "x_seen": {
          "type": "unknown",
          "shape": [
            "step_rows"
          ],
          "units": "1",
          "description": "`x` broadcast over an axis, so the document takes the array evaluator."
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "x"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "+",
            "args": [
              {
                "op": "*",
                "args": [
                  {
                    "op": "-",
                    "args": [
                      "theta"
                    ]
                  },
                  "x"
                ]
              },
              {
                "op": "*",
                "args": [
                  "sigma",
                  "Bw"
                ]
              }
            ]
          }
        },
        {
          "lhs": {
            "op": "ic",
            "args": [
              "x"
            ]
          },
          "rhs": 1.0
        },
        {
          "lhs": "x_seen",
          "rhs": {
            "op": "faq",
            "args": [],
            "output_idx": [
              "k"
            ],
            "ranges": {
              "k": {
                "from": "step_rows"
              }
            },
            "expr": "x"
          }
        }
      ],
      "tests": [
        {
          "id": "the_noise_is_not_read_as_a_constant",
          "description": "Stated as the drift-only expectation E[x(1)] = exp(-1). No evaluator in this category integrates an SDE, so the case pins the REFUSAL, not this number.",
          "time_span": {
            "start": 0.0,
            "end": 1.0
          },
          "assertions": [
            {
              "variable": "x",
              "time": 1.0,
              "expected": 0.36787944117144233
            }
          ]
        }
      ]
    }
  }
}
