{
 "esm": "1.1.0",
 "metadata": {
  "name": "DiscreteEventInASubsystemOnTheScalarPath",
  "description": "The scalar discrete-event document with its model, event included, mounted as the inline subsystem `Inner` of a trivial parent. An event owned by a subsystem is the one that can vanish before any build-time check sees it: Python's and Rust's flatten do not lift a subsystem's events into the flattened system, so an evaluator that checks only the flattened event list runs the model without it. Every evaluator MUST refuse it with `unsupported_construct` exactly as it refuses a top-level event.",
  "authors": [
   "EarthSciML Authors and Contributors"
  ],
  "tags": [
   "conformance",
   "unsupported_construct",
   "events"
  ]
 },
 "models": {
  "DiscreteEventInASubsystemOnTheScalarPath": {
   "tolerance": {
    "rel": 1e-12
   },
   "variables": {
    "z": {
     "type": "unknown",
     "units": "1",
     "description": "A trivial parent state, so the parent is a model in its own right."
    }
   },
   "equations": [
    {
     "lhs": {
      "op": "D",
      "args": [
       "z"
      ],
      "wrt": "t"
     },
     "rhs": 0.0
    },
    {
     "lhs": {
      "op": "ic",
      "args": [
       "z"
      ]
     },
     "rhs": 0.0
    }
   ],
   "subsystems": {
    "Inner": {
     "variables": {
      "s": {
       "type": "unknown",
       "units": "1",
       "description": "Doubles at each event; 1 at t = 0."
      }
     },
     "equations": [
      {
       "lhs": {
        "op": "D",
        "args": [
         "s"
        ],
        "wrt": "t"
       },
       "rhs": 0.0
      },
      {
       "lhs": {
        "op": "ic",
        "args": [
         "s"
        ]
       },
       "rhs": 1.0
      }
     ],
     "discrete_events": [
      {
       "name": "double",
       "trigger": {
        "type": "periodic",
        "interval": 1.0
       },
       "affects": [
        {
         "lhs": "s",
         "rhs": {
          "op": "*",
          "args": [
           {
            "op": "Pre",
            "args": [
             "s"
            ]
           },
           2.0
          ]
         }
        }
       ],
       "description": "s := 2*Pre(s), once per unit of time."
      }
     ]
    }
   },
   "tests": [
    {
     "id": "a_periodic_event_folds_an_unknown",
     "description": "Intended behaviour: s(3.5) = 8.",
     "time_span": {
      "start": 0.0,
      "end": 3.5
     },
     "assertions": [
      {
       "variable": "Inner.s",
       "time": 3.5,
       "expected": 8.0
      }
     ]
    }
   ]
  }
 }
}
