{
 "esm": "1.1.0",
 "metadata": {
  "name": "ImplicitEquationAsTheDerivativeOfAnExpression",
  "description": "An implicit equation spelled as a TIME DERIVATIVE OF AN EXPRESSION: `D(a + b) ~ 3` beside `D(a) ~ 1`. Its LHS is a time derivative, but of an expression rather than of an unknown, so it defines no state and only constrains `b` implicitly (esm-spec §9.6.6: an implicit equation is one whose LHS is not an unknown, a time derivative of one, or `ic` of one). Solved, it gives D(b) = 2 and b(1) = 2. An evaluator that treats every `D` LHS as a derivative and finds no state to credit drops the equation and reports b(1) = 0; each evaluator MUST refuse it with `unsupported_construct` instead.",
  "authors": [
   "EarthSciML Authors and Contributors"
  ],
  "tags": [
   "conformance",
   "unsupported_construct",
   "equations"
  ]
 },
 "models": {
  "ImplicitEquationAsTheDerivativeOfAnExpression": {
   "tolerance": {
    "rel": 1e-12
   },
   "variables": {
    "a": {
     "type": "unknown",
     "units": "1",
     "description": "Grows at unit rate from 0."
    },
    "b": {
     "type": "unknown",
     "units": "1",
     "description": "Defined only through D(a + b) = 3."
    }
   },
   "equations": [
    {
     "lhs": {
      "op": "D",
      "args": [
       "a"
      ],
      "wrt": "t"
     },
     "rhs": 1.0
    },
    {
     "lhs": {
      "op": "D",
      "args": [
       {
        "op": "+",
        "args": [
         "a",
         "b"
        ]
       }
      ],
      "wrt": "t"
     },
     "rhs": 3.0
    },
    {
     "lhs": {
      "op": "ic",
      "args": [
       "a"
      ]
     },
     "rhs": 0.0
    },
    {
     "lhs": {
      "op": "ic",
      "args": [
       "b"
      ]
     },
     "rhs": 0.0
    }
   ],
   "tests": [
    {
     "id": "b_grows_at_rate_two",
     "description": "Intended behaviour: b(1) = 2.",
     "time_span": {
      "start": 0.0,
      "end": 1.0
     },
     "assertions": [
      {
       "variable": "b",
       "time": 1.0,
       "expected": 2.0
      }
     ]
    }
   ]
  }
 }
}
