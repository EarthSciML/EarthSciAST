{
  "esm": "1.1.0",
  "metadata": {
    "name": "ImplicitEquationOnTheArrayPath",
    "description": "An array unknown `s` is defined only by a residual, `s - faq(k -> ifelse(k <= 1, 1, 2*s[k-1])) = 0`, whose unique solution is [1, 2, 4, 8]. No binding's array evaluator solves an implicit (algebraic) equation: they used to return the initial condition [1, 1, 1, 1]. Every such evaluator MUST refuse the document with `unsupported_construct` naming the construct and the evaluator (issue #264).",
    "authors": [
      "EarthSciML Authors and Contributors"
    ],
    "tags": [
      "conformance",
      "unsupported_construct",
      "equations"
    ]
  },
  "index_sets": {
    "step_rows": {
      "kind": "interval",
      "size": 4
    }
  },
  "models": {
    "ImplicitEquationOnTheArrayPath": {
      "tolerance": {
        "rel": 1e-12
      },
      "variables": {
        "s": {
          "type": "unknown",
          "shape": [
            "step_rows"
          ],
          "units": "1",
          "description": "Defined by a residual, not an assignment."
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "ic",
            "args": [
              "s"
            ]
          },
          "rhs": {
            "op": "faq",
            "args": [],
            "output_idx": [
              "k"
            ],
            "ranges": {
              "k": {
                "from": "step_rows"
              }
            },
            "expr": 1.0
          }
        },
        {
          "lhs": {
            "op": "-",
            "args": [
              "s",
              {
                "op": "faq",
                "args": [],
                "output_idx": [
                  "k"
                ],
                "ranges": {
                  "k": {
                    "from": "step_rows"
                  }
                },
                "expr": {
                  "op": "ifelse",
                  "args": [
                    {
                      "op": "<=",
                      "args": [
                        "k",
                        1
                      ]
                    },
                    1.0,
                    {
                      "op": "*",
                      "args": [
                        {
                          "op": "index",
                          "args": [
                            "s",
                            {
                              "op": "-",
                              "args": [
                                "k",
                                1
                              ]
                            }
                          ]
                        },
                        2.0
                      ]
                    }
                  ]
                }
              }
            ]
          },
          "rhs": 0.0
        }
      ],
      "tests": [
        {
          "id": "an_implicit_recurrence_is_solved",
          "description": "Intended behaviour: [1, 2, 4, 8]. An evaluator that cannot solve the residual must refuse rather than report the initial condition.",
          "time_span": {
            "start": 0.0,
            "end": 1.0
          },
          "assertions": [
            {
              "variable": "s",
              "time": 1.0,
              "expected": 2.0,
              "coords": {
                "step_rows": 2
              }
            },
            {
              "variable": "s",
              "time": 1.0,
              "expected": 8.0,
              "coords": {
                "step_rows": 4
              }
            }
          ]
        }
      ]
    }
  }
}
