{
  "esm": "1.1.0",
  "metadata": {
    "name": "ValueInventionNearestGeneratorODE",
    "authors": [
      "EarthSciML Authors and Contributors"
    ],
    "description": "An `argmin` arg-witness assignment feeding a right-hand side through a gather. Points at x = 0, 1, 1.5, 2 (y = 0, 0.5, 0, 0) are assigned the index of their nearest generator among x = 0, 1, 2 (y = 0). Point 3 is exactly 0.25 (squared) from generators 2 and 3; the smallest id wins (CONFORMANCE_SPEC §5.5.1 rule 6), so assign = [1, 2, 2, 3]. The coordinates are unknowns defined by `const` nodes (constant factors, esm-spec §4.2). d(w[i])/dt = gx[assign[i]], so from zero at t = 1: w = [0, 1, 1, 2]."
  },
  "index_sets": {
    "points": {
      "kind": "interval",
      "size": 4
    },
    "generators": {
      "kind": "interval",
      "size": 3
    }
  },
  "models": {
