     "units": "1",
     "default": 0.5,
     "description": "Target grid origin y."
    },
    "tgt_dx": {
     "type": "parameter",
     "units": "1",
     "default": 4.0,
     "description": "Target cell width."
    },
    "tgt_dy": {
     "type": "parameter",
     "units": "1",
     "default": 4.0,
     "description": "Target cell height."
    },
    "src_poly": {
     "type": "unknown",
     "shape": [
