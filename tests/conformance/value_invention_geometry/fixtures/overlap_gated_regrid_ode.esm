{
 "esm": "1.2.0",
 "metadata": {
  "name": "overlap_gated_regrid_ode",
  "description": "Issue #535: a construction-time observed whose `faq` carries a spatial `overlap` join gate (CONFORMANCE_SPEC §5.5.6), the candidate-gated conservative regrid of EarthSciDiscretizations' regridding/conservative_overlap.esm (A_ij, A_j, W/F_tgt through the _gated templates) at three source and two target cells. The gate is built from each ring's envelope; the third source square lies far from the first target and the first two far from the second, so four of the six pairs are pruned and never clipped. A_ij = 1, 1, 0.5 on the surviving pairs and 0 elsewhere; A_j = 2, 0.5; F_tgt = 1.5, 3. Two states integrate A_j and F_tgt from zero over one unit of time.",
  "authors": [
   "EarthSciML Authors and Contributors"
  ],
  "tags": [
   "conformance",
   "join",
   "overlap",
   "geometry",
   "polygon_intersection_area",
   "construction"
  ]
 },
 "index_sets": {
  "src_cells": {
   "kind": "interval",
   "size": 3
  },
  "tgt_cells": {
   "kind": "interval",
   "size": 2
  },
  "verts": {
   "kind": "interval",
   "size": 4
  },
  "coord": {
   "kind": "interval",
   "size": 2
  }
 },
 "models": {
  "OverlapGatedRegrid": {
   "tolerance": {
    "rel": 1e-12,
    "abs": 1e-12
   },
   "variables": {
    "atol": {
     "type": "parameter",
     "units": "1",
     "default": 1e-12,
     "description": "Sliver floor of the surviving set (CONFORMANCE_SPEC 5.8.2)."
    },
    "src_poly": {
     "type": "unknown",
     "shape": [
      "src_cells",
      "verts",
      "coord"
     ],
     "description": "Three CCW unit squares: [0,1]x[0,1], [1,2]x[0,1], [5,6]x[0,1]."
    },
    "tgt_poly": {
     "type": "unknown",
     "shape": [
      "tgt_cells",
      "verts",
      "coord"
     ],
     "description": "Two CCW rectangles: [0,2]x[0,1] and [5,5.5]x[0,1]."
    },
    "F_src": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "src_cells"
     ],
     "description": "Source field 1, 2, 3."
    },
    "A_ij": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "src_cells",
      "tgt_cells"
     ],
     "description": "Overlap-gated narrow phase: polygon_intersection_area over the candidate pairs the envelope gate admits."
    },
    "A_j": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "tgt_cells"
     ],
     "description": "Gated, sliver-filtered row sum of A_ij: 2 and 0.5."
    },
    "F_tgt": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "tgt_cells"
     ],
     "description": "Gated conservative regrid sum_i A_ij F_src[i] / A_j: 1.5 and 3."
    },
    "area_state": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "tgt_cells"
     ],
     "default": 0.0,
     "description": "d/dt = A_j from zero."
    },
    "regrid_state": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "tgt_cells"
     ],
     "default": 0.0,
     "description": "d/dt = F_tgt from zero."
    }
   },
   "equations": [
    {
     "lhs": "src_poly",
     "rhs": {
      "op": "const",
      "args": [],
      "value": [
       [
        [
         0,
         0
        ],
        [
         1,
         0
        ],
        [
         1,
         1
        ],
        [
         0,
         1
        ]
       ],
       [
        [
         1,
         0
        ],
        [
         2,
         0
        ],
        [
         2,
         1
        ],
        [
         1,
         1
        ]
       ],
       [
        [
         5,
         0
        ],
        [
         6,
         0
        ],
        [
         6,
         1
        ],
        [
         5,
         1
        ]
       ]
      ]
     }
    },
    {
     "lhs": "tgt_poly",
     "rhs": {
      "op": "const",
      "args": [],
      "value": [
       [
        [
         0,
         0
        ],
        [
         2,
         0
        ],
        [
         2,
         1
        ],
        [
         0,
         1
        ]
       ],
       [
        [
         5,
         0
        ],
        [
         5.5,
         0
        ],
        [
         5.5,
         1
        ],
        [
         5,
         1
        ]
       ]
      ]
     }
    },
    {
     "lhs": "F_src",
     "rhs": {
      "op": "const",
      "args": [],
      "value": [
       1.0,
       2.0,
       3.0
      ]
     }
    },
    {
     "lhs": "A_ij",
     "rhs": {
      "op": "faq",
      "args": [],
      "semiring": "sum_product",
      "output_idx": [
       "i",
       "j"
      ],
      "ranges": {
       "i": {
        "from": "src_cells"
       },
       "j": {
        "from": "tgt_cells"
       }
      },
      "join": [
       {
        "overlap": {
         "src_env": [
          "src_poly"
         ],
         "tgt_env": [
          "tgt_poly"
         ],
         "eps": 1e-09
        }
       }
      ],
      "expr": {
       "op": "polygon_intersection_area",
       "manifold": "planar",
       "args": [
        {
         "op": "index",
         "args": [
          "src_poly",
          "i"
         ]
        },
        {
         "op": "index",
         "args": [
          "tgt_poly",
          "j"
         ]
        }
       ]
      }
     }
    },
    {
     "lhs": "A_j",
     "rhs": {
      "op": "faq",
      "args": [],
      "semiring": "sum_product",
      "output_idx": [
       "j"
      ],
      "ranges": {
       "i": {
        "from": "src_cells"
       },
       "j": {
        "from": "tgt_cells"
       }
      },
      "join": [
       {
        "overlap": {
         "src_env": [
          "src_poly"
         ],
         "tgt_env": [
          "tgt_poly"
         ],
         "eps": 1e-09
        }
       }
      ],
      "filter": {
       "op": ">",
       "args": [
        {
         "op": "index",
         "args": [
          "A_ij",
          "i",
          "j"
         ]
        },
        "atol"
       ]
      },
      "expr": {
       "op": "index",
       "args": [
        "A_ij",
        "i",
        "j"
       ]
      }
     }
    },
    {
     "lhs": "F_tgt",
     "rhs": {
      "op": "faq",
      "args": [],
      "semiring": "sum_product",
      "output_idx": [
       "j"
      ],
      "ranges": {
       "i": {
        "from": "src_cells"
       },
       "j": {
        "from": "tgt_cells"
       }
      },
      "join": [
       {
        "overlap": {
         "src_env": [
          "src_poly"
         ],
         "tgt_env": [
          "tgt_poly"
         ],
         "eps": 1e-09
        }
       }
      ],
      "filter": {
       "op": ">",
       "args": [
        {
         "op": "index",
         "args": [
          "A_ij",
          "i",
          "j"
         ]
        },
        "atol"
       ]
      },
      "expr": {
       "op": "/",
       "args": [
        {
         "op": "*",
         "args": [
          {
           "op": "index",
           "args": [
            "A_ij",
            "i",
            "j"
           ]
          },
          {
           "op": "index",
           "args": [
            "F_src",
            "i"
           ]
          }
         ]
        },
        {
         "op": "index",
         "args": [
          "A_j",
          "j"
         ]
        }
       ]
      }
     }
    },
    {
     "lhs": {
      "op": "D",
      "args": [
       "area_state"
      ],
      "wrt": "t"
     },
     "rhs": "A_j"
    },
    {
     "lhs": {
      "op": "D",
      "args": [
       "regrid_state"
      ],
      "wrt": "t"
     },
     "rhs": "F_tgt"
    }
   ],
   "tests": [
    {
     "id": "values",
     "time_span": {
      "start": 0.0,
      "end": 1.0
     },
     "assertions": [
      {
       "variable": "A_ij",
       "time": 1.0,
       "expected": 1.0,
       "coords": {
        "src_cells": 1,
        "tgt_cells": 1
       }
      },
      {
       "variable": "A_ij",
       "time": 1.0,
       "expected": 0.0,
       "coords": {
        "src_cells": 1,
        "tgt_cells": 2
       }
      },
      {
       "variable": "A_ij",
       "time": 1.0,
       "expected": 1.0,
       "coords": {
        "src_cells": 2,
        "tgt_cells": 1
       }
      },
      {
       "variable": "A_ij",
       "time": 1.0,
       "expected": 0.0,
       "coords": {
        "src_cells": 2,
        "tgt_cells": 2
       }
      },
      {
       "variable": "A_ij",
       "time": 1.0,
       "expected": 0.0,
       "coords": {
        "src_cells": 3,
        "tgt_cells": 1
       }
      },
      {
       "variable": "A_ij",
       "time": 1.0,
       "expected": 0.5,
       "coords": {
        "src_cells": 3,
        "tgt_cells": 2
       }
      },
      {
       "variable": "area_state",
       "time": 1.0,
       "expected": 2.0,
       "coords": {
        "tgt_cells": 1
       }
      },
      {
       "variable": "regrid_state",
       "time": 1.0,
       "expected": 1.5,
       "coords": {
        "tgt_cells": 1
       }
      },
      {
       "variable": "area_state",
       "time": 1.0,
       "expected": 0.5,
       "coords": {
        "tgt_cells": 2
       }
      },
      {
       "variable": "regrid_state",
