{
  "description": "Scenarios for the `argmin` / `argmax` templates of lib/relational.esm. `values` are the candidate values in index order (\"NaN\", \"Inf\" and \"-Inf\" stand for the non-finite values JSON cannot write); `expected` is the 1-based index the template returns: the smallest index on a tie, the first NaN index when any candidate is NaN. `op_expected`, where present, is what the `argmin` / `argmax` op returns today on the same candidates: the op ignores a NaN candidate unless it is the first one, so it differs from the template only when a NaN is present after the first candidate.",
  "scenarios": [
    {
      "name": "distinct_minimum",
      "op": "argmin",
      "values": [
        3.0,
        1.0,
        2.0
      ],
      "expected": 2,
      "description": "one smallest candidate"
    },
    {
      "name": "first_is_extreme",
      "op": "argmin",
      "values": [
        0.5,
        2.0,
        3.0
      ],
      "expected": 1,
      "description": "the first candidate"
    },
    {
      "name": "last_is_extreme",
      "op": "argmin",
      "values": [
        4.0,
        3.0,
        2.0,
        1.0
      ],
      "expected": 4,
      "description": "the last candidate"
    },
    {
      "name": "negative_values",
      "op": "argmin",
      "values": [
        -1.0,
        -3.0,
        -2.0
      ],
      "expected": 2,
      "description": "negative candidates"
    },
    {
      "name": "tie_two",
      "op": "argmin",
      "values": [
        2.0,
        1.0,
        1.0
      ],
      "expected": 2,
      "description": "a tie goes to the smaller index"
    },
    {
      "name": "tie_first_last",
      "op": "argmin",
      "values": [
        1.0,
        2.0,
        1.0
      ],
      "expected": 1,
      "description": "a tie between the first and last candidates"
    },
    {
      "name": "all_equal",
      "op": "argmin",
      "values": [
        5.0,
        5.0,
        5.0
      ],
      "expected": 1,
      "description": "every candidate equal"
    },
    {
      "name": "single_candidate",
      "op": "argmin",
      "values": [
        7.0
      ],
      "expected": 1,
      "description": "one candidate"
    },
    {
      "name": "signed_zero_tie",
      "op": "argmin",
      "values": [
        0.0,
        -0.0
      ],
      "expected": 1,
      "description": "-0.0 == 0.0, so a tie"
    },
    {
      "name": "signed_zero_tie_reversed",
      "op": "argmin",
      "values": [
        -0.0,
        0.0
      ],
      "expected": 1,
      "description": "-0.0 == 0.0, so a tie"
    },
    {
      "name": "subnormal_tie",
      "op": "argmin",
      "values": [
        5e-324,
        1.0,
        5e-324
      ],
      "expected": 1,
      "description": "equal subnormal candidates"
    },
    {
      "name": "equidistant_generators",
      "op": "argmin",
      "values": [
        2.25,
        0.25,
        0.25
      ],
      "expected": 2,
      "description": "the nearest_generator tie: point 1.5 to generators 0, 1, 2"
    },
    {
      "name": "pos_inf_candidate",
      "op": "argmin",
      "values": [
        "Inf",
        1.0
      ],
      "expected": 2,
      "description": "+Inf is never the minimum of finite candidates"
    },
    {
      "name": "all_pos_inf",
      "op": "argmin",
      "values": [
        "Inf",
        "Inf"
      ],
      "expected": 1,
      "description": "every candidate +Inf: a tie"
    },
    {
      "name": "neg_inf_tie",
      "op": "argmin",
      "values": [
        1.0,
        "-Inf",
        "-Inf"
      ],
      "expected": 2,
      "description": "-Inf tie"
    },
    {
      "name": "nan_first",
      "op": "argmin",
      "values": [
        "NaN",
        0.0,
        1.0
      ],
      "expected": 1,
      "description": "a NaN candidate wins at its first occurrence"
    },
    {
      "name": "nan_middle",
      "op": "argmin",
      "values": [
        3.0,
        "NaN",
        1.0,
        "NaN"
      ],
      "expected": 2,
      "op_expected": 3,
      "description": "first NaN, not the smallest number"
    },
    {
      "name": "nan_last",
      "op": "argmin",
      "values": [
        1.0,
        2.0,
        "NaN"
      ],
      "expected": 3,
      "op_expected": 1,
      "description": "a NaN after the minimum"
    },
    {
      "name": "nan_and_neg_inf",
      "op": "argmin",
      "values": [
        "-Inf",
        "NaN"
      ],
      "expected": 2,
      "op_expected": 1,
      "description": "NaN beats -Inf"
    },
    {
      "name": "all_nan",
      "op": "argmin",
      "values": [
        "NaN",
        "NaN"
      ],
      "expected": 1,
      "description": "every candidate NaN"
    },
    {
      "name": "max_distinct",
      "op": "argmax",
      "values": [
        3.0,
        1.0,
        2.0
      ],
      "expected": 1,
      "description": "one largest candidate"
    },
    {
      "name": "max_last",
      "op": "argmax",
      "values": [
        1.0,
        2.0,
        3.0,
        4.0
      ],
      "expected": 4,
      "description": "the last candidate"
    },
    {
      "name": "max_tie",
      "op": "argmax",
      "values": [
        1.0,
        4.0,
        4.0
      ],
      "expected": 2,
      "description": "a tie goes to the smaller index"
    },
    {
      "name": "max_farthest_tie",
      "op": "argmax",
      "values": [
        1.0,
        0.0,
        1.0
      ],
      "expected": 1,
      "description": "the farthest-generator tie (point 1.0 to generators 0, 1, 2)"
    },
    {
      "name": "max_all_equal",
      "op": "argmax",
      "values": [
        -2.0,
        -2.0
      ],
      "expected": 1,
      "description": "every candidate equal"
    },
    {
      "name": "max_single_candidate",
      "op": "argmax",
      "values": [
        -7.0
      ],
      "expected": 1,
      "description": "one candidate"
    },
    {
      "name": "max_signed_zero_tie",
      "op": "argmax",
      "values": [
        -0.0,
        0.0
      ],
      "expected": 1,
      "description": "-0.0 == 0.0, so a tie"
    },
    {
      "name": "max_pos_inf_tie",
      "op": "argmax",
      "values": [
        1.0,
        "Inf",
        "Inf"
      ],
      "expected": 2,
      "description": "+Inf tie"
    },
    {
      "name": "max_all_neg_inf",
      "op": "argmax",
      "values": [
        "-Inf",
        "-Inf",
        "-Inf"
      ],
      "expected": 1,
      "description": "every candidate -Inf: a tie"
    },
    {
      "name": "max_nan_first",
      "op": "argmax",
      "values": [
        "NaN",
        5.0
      ],
      "expected": 1,
      "description": "a NaN candidate wins at its first occurrence"
    },
    {
      "name": "max_nan_middle",
      "op": "argmax",
      "values": [
        1.0,
        9.0,
        "NaN",
        2.0,
        "NaN"
      ],
      "expected": 3,
      "op_expected": 2,
      "description": "first NaN, not the largest number"
    },
    {
      "name": "max_nan_and_pos_inf",
      "op": "argmax",
      "values": [
        "Inf",
        "NaN"
      ],
      "expected": 2,
      "op_expected": 1,
      "description": "NaN beats +Inf"
    }
  ]
}
