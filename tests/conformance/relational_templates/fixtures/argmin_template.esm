        },
        "r_max_signed_zero_tie": {
          "type": "unknown",
          "units": "1",
          "description": "`argmax` template on scenario `max_signed_zero_tie` of scenarios.json: -0.0 == 0.0, so a tie."
        },
        "r_max_pos_inf_tie": {
          "type": "unknown",
          "units": "1",
          "description": "`argmax` template on scenario `max_pos_inf_tie` of scenarios.json: +Inf tie."
        },
        "r_max_all_neg_inf": {
          "type": "unknown",
          "units": "1",
