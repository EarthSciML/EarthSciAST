      ],
      "tests": [
        {
          "id": "nearest_generator_template_ode",
          "time_span": {
            "start": 0.0,
            "end": 1.0
          },
          "tolerance": {
            "rel": 1e-09,
            "abs": 1e-12
          },
          "assertions": [
