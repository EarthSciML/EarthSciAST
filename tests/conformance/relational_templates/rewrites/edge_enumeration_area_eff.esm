{
  "esm": "1.1.0",
  "metadata": {
    "name": "edge_enumeration_area_eff_template",
    "description": "Template rewrite of tests/valid/faq/edge_enumeration_area_eff.esm (generated by tests/conformance/relational_templates/rewrites/generate.py): the skolem / rank / gated-argmin value-invention ops replaced by lib/relational.esm templates. The edge key is edge_key(a, b, 1, 4) over the ragged face members; rank(edges) is the loop index.",
    "authors": [
      "EarthSciAST/polecats/gastown.nux"
    ],
    "tags": [
      "faq",
      "skolem",
      "distinct",
      "rank",
      "ragged",
      "edges-of-cell",
      "value-invention",
      "geometric-faq",
      "end-to-end",
      "conformance",
      "schema",
      "ess-my4.3.10"
    ]
  },
  "index_sets": {
    "faces": {
      "kind": "interval",
      "size": 2
    },
    "cells": {
      "kind": "interval",
      "size": 2
    },
    "face_vertices": {
      "kind": "ragged",
      "of": [
        "faces"
      ],
      "offsets": "n_verts_on_face",
      "values": "verts_on_face"
    },
    "edges": {
      "kind": "derived",
      "from_faq": "edge_set"
    },
    "edges_of_cell": {
      "kind": "ragged",
      "of": [
        "cells"
      ],
      "offsets": "n_edges_on_cell",
      "values": "edges_on_cell"
    }
  },
  "models": {
    "EdgeEnumerationAreaEff": {
      "expression_template_imports": [
        {
          "ref": "esm:std/relational.esm"
        }
      ],
      "variables": {
        "n_verts_on_face": {
          "type": "parameter",
          "shape": [
            "faces"
          ],
          "description": "Valence of each face (vertices per face) — the ragged `face_vertices` offsets factor. Document-literal connectivity (CONST)."
        },
        "verts_on_face": {
          "type": "parameter",
          "shape": [
            "faces",
            "local_verts"
          ],
          "description": "Vertex ids of each face — the ragged `face_vertices` values factor (CSR member gather). Document-literal connectivity (CONST)."
        },
        "n_edges_on_cell": {
          "type": "parameter",
          "shape": [
            "cells"
          ],
          "description": "Valence of each cell (edges per cell) — the ragged `edges_of_cell` offsets factor."
        },
        "edges_on_cell": {
          "type": "parameter",
          "shape": [
            "cells",
            "local_edges"
          ],
          "description": "Dense edge ids incident on each cell — the ragged `edges_of_cell` values factor; the INVERSION of the face->edge relation (§5.2)."
        },
        "dc": {
          "type": "parameter",
          "shape": [
            "edges"
          ],
          "description": "Distance between the cell centers sharing each edge (the DUO primal length), keyed by dense edge id."
        },
        "dv": {
          "type": "parameter",
          "shape": [
            "edges"
          ],
          "description": "Length of each edge (the DUO dual length), keyed by dense edge id."
        },
        "edge_exists": {
          "type": "unknown",
          "shape": [
            "edges"
          ],
          "description": "Materialized edge-membership over the derived `edges` set, assigned algebraically from the CONST connectivity (the index-set-producing faq output)."
        },
        "edge_dense_id": {
          "type": "unknown",
          "shape": [
            "edges"
          ],
          "description": "Dense integer ids over the derived `edges` set (the array-backend index), assigned from the rank."
        },
        "area_eff": {
          "type": "unknown",
          "shape": [
            "cells"
          ],
          "description": "Effective cell area, the downstream geometric sum_product FAQ over edges_of_cell — replaces the imperative per-edge Julia loop."
        }
      },
      "equations": [
        {
          "_comment": "(1)+(2) edge_set: the index-set-producing node referenced by index_sets.edges.from_faq. semiring bool_and_or + distinct:true dedups the unique undirected edges discovered from the face->vertex connectivity; ranges iterate each face f and the vertex pairs (a,b) of that face ({from face_vertices, of [f]}); filter a<b keeps each undirected edge once; key mints the canonical Skolem term skolem(edge,a,b); the `true` body marks existence. Output order is the §5.7 sorted order. This is the literal RFC §7.3 form. (Template rewrite: see tests/conformance/relational_templates/rewrites/.)",
          "lhs": {
            "op": "index",
            "args": [
              "edge_exists",
              "edge"
            ]
          },
          "rhs": {
            "op": "faq",
            "id": "edge_set",
            "args": [
              "faces"
            ],
            "semiring": "bool_and_or",
            "distinct": true,
            "output_idx": [
              "edge"
            ],
            "ranges": {
              "f": {
                "from": "faces"
              },
              "a": {
                "from": "face_vertices",
                "of": [
                  "f"
                ]
              },
              "b": {
                "from": "face_vertices",
                "of": [
                  "f"
                ]
              }
            },
            "filter": {
              "op": "<",
              "args": [
                "a",
                "b"
              ]
            },
            "key": {
              "op": "apply_expression_template",
              "args": [],
              "name": "edge_key",
              "bindings": {
                "u": "a",
                "v": "b",
                "lo": 1,
                "n": 4
              }
            },
            "expr": {
              "op": "true",
              "args": []
            }
          }
        },
        {
          "_comment": "(3) rank: dense integer ids over the derived `edges` set, by position in the sorted distinct sequence (§5.5 / §5.7.3) — what the array backend indexes by.",
          "lhs": {
            "op": "index",
            "args": [
              "edge_dense_id",
              "e"
            ]
          },
          "rhs": {
            "op": "faq",
            "args": [],
            "semiring": "sum_product",
            "output_idx": [
              "e"
            ],
            "ranges": {
              "e": {
                "from": "edges"
              }
            },
            "expr": "e"
          }
        },
        {
          "_comment": "(4)+(5) downstream geometric FAQ: area_eff[i] = 1/4 * Sum_{k in edges_of_cell(i)} dc[e]*dv[e], e = edges_on_cell(i,k). edges_of_cell is the ragged inversion join (§5.2): output index i over cells (dense), contraction k over the per-cell ragged edge set; dc/dv are gathered by the dense edge id. An ordinary sum_product FAQ that consumes the derived `edges` set as a PRIMITIVE index set — the DUO effective area, replacing imperative Julia.",
          "lhs": {
            "op": "faq",
            "args": [],
            "output_idx": [
              "i"
            ],
            "expr": {
              "op": "D",
              "args": [
                {
                  "op": "index",
                  "args": [
                    "area_eff",
                    "i"
                  ]
                }
              ],
              "wrt": "t"
            },
            "ranges": {
              "i": {
                "from": "cells"
              }
            }
          },
          "rhs": {
            "op": "faq",
            "args": [
              "dc",
              "dv",
              "edges_on_cell"
            ],
            "semiring": "sum_product",
            "output_idx": [
              "i"
            ],
            "ranges": {
              "i": {
                "from": "cells"
              },
              "k": {
                "from": "edges_of_cell",
                "of": [
                  "i"
                ]
              }
            },
            "expr": {
              "op": "*",
              "args": [
                0.25,
                {
                  "op": "index",
                  "args": [
                    "dc",
                    {
                      "op": "index",
                      "args": [
                        "edges_on_cell",
                        "i",
                        "k"
                      ]
                    }
                  ]
                },
                {
                  "op": "index",
                  "args": [
                    "dv",
                    {
                      "op": "index",
                      "args": [
                        "edges_on_cell",
                        "i",
                        "k"
                      ]
                    }
                  ]
                }
              ]
            }
          }
        }
      ]
    }
  }
}
