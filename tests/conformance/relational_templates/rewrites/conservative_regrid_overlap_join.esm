{
  "esm": "1.1.0",
  "metadata": {
    "name": "conservative_regrid_overlap_join_template",
    "description": "Template rewrite of tests/valid/geometry/conservative_regrid_overlap_join.esm (generated by tests/conformance/relational_templates/rewrites/generate.py): the skolem / rank / gated-argmin value-invention ops replaced by lib/relational.esm templates. Bin keys split into per-component join columns; the pair key is pair_key(i, j, 1, 1, 3, 3).",
    "authors": [
      "EarthSciAST/polecats/gastown.slit"
    ],
    "tags": [
      "geometry",
      "conservative-regridding",
      "overlap-join",
      "bin-skolem",
      "spatial-join",
      "floor",
      "skolem",
      "join",
      "intersect_polygon",
      "polygon-area",
      "value-invention",
      "partition-of-unity",
      "conservation",
      "end-to-end",
      "conformance",
      "schema",
      "ess-my4.4.5"
    ]
  },
  "index_sets": {
    "coord": {
      "kind": "interval",
      "size": 2
    },
    "cell_verts": {
      "kind": "interval",
      "size": 4
    },
    "src_cells": {
      "kind": "interval",
      "size": 3
    },
    "tgt_cells": {
      "kind": "interval",
      "size": 3
    },
    "candidate_pairs": {
      "kind": "derived",
      "from_faq": "candidate_set"
    },
    "clip_ring": {
      "kind": "derived",
      "from_faq": "overlap_clip"
    }
  },
  "models": {
    "ConservativeRegridOverlapJoin": {
      "expression_template_imports": [
        {
          "ref": "esm:std/relational.esm"
        }
      ],
      "variables": {
        "src_lon": {
          "type": "parameter",
          "shape": [
            "src_cells"
          ],
          "description": "Source-cell representative longitude (e.g. the bbox-min corner). A float coordinate that enters ONLY the integer binning via `floor`, never a raw join comparison (§5.8.5)."
        },
        "src_lat": {
          "type": "parameter",
          "shape": [
            "src_cells"
          ],
          "description": "Source-cell representative latitude — the other binning coordinate."
        },
        "tgt_lon": {
          "type": "parameter",
          "shape": [
            "tgt_cells"
          ],
          "description": "Target-cell representative longitude."
        },
        "tgt_lat": {
          "type": "parameter",
          "shape": [
            "tgt_cells"
          ],
          "description": "Target-cell representative latitude."
        },
        "dx": {
          "type": "parameter",
          "shape": [],
          "description": "Bin width in degrees — the exactly-defined integer quantization step of the broad phase (§5.8.5). Shared by source and target so a common bin key means the bboxes fall in the same bucket."
        },
        "dy": {
          "type": "parameter",
          "shape": [],
          "description": "Bin height in degrees."
        },
        "atol": {
          "type": "parameter",
          "shape": [],
          "description": "Sliver floor (§5.8.2): an overlap area at or below `atol` (≈ 1e-15·R²) is treated as equal-to-zero — 'present-but-tiny' and 'absent' both collapse to no contribution. It is the threshold of the zero-area `filter` that turns the byte-identical CANDIDATE set into the tolerance-dependent SURVIVING-overlap set (§5.8.5)."
        },
        "src_poly_rep": {
          "type": "parameter",
          "shape": [
            "cell_verts",
            "coord"
          ],
          "description": "A representative source cell as a closed lon-lat vertex ring (src_poly_rep[v,1]=lon, src_poly_rep[v,2]=lat) — the `poly_a` operand of the narrow-phase clip demo below. An ordinary [verts, coord] coordinate array (no bespoke polygon type, §8.1). In the full mesh there is one such ring per source cell; the clip runs once per candidate pair to fill each `A_ij` entry."
        },
        "tgt_poly_rep": {
          "type": "parameter",
          "shape": [
            "cell_verts",
            "coord"
          ],
          "description": "A representative target cell ring — the `poly_b` operand of the clip demo."
        },
        "A_ij": {
          "type": "parameter",
          "shape": [
            "src_cells",
            "tgt_cells"
          ],
          "description": "The build-once sparse overlap-area matrix A_ij = polygon_area(intersect_polygon(src_i, tgt_j)) — ConservativeRegridding.jl's `intersections` matrix of RAW areas, the static-partition (§6.1) NARROW-phase output that the assembly consumes as a factor (analogous to `dc`/`dv` over the derived edge set in edge_enumeration_area_eff.esm). Entries for non-candidate (different-bin) pairs are 0 — those (i,j) never enter the bin-Skolem join — and sub-`atol` sliver entries are 0 by the §5.8.2 snapping; both are excluded by the join + zero-area `filter` of the assembly faq nodes. Its per-pair provenance is the `clip`/`A_ij_rep` demo and intersect_polygon_clip_area.esm; cross-binding A_ij agreement is tolerance-based (§5.8.2), gated by ess-my4.4.8."
        },
        "F_src": {
          "type": "parameter",
          "shape": [
            "src_cells"
          ],
          "description": "The source field being remapped. A `parameter` here (static field, build-once apply); in the time-varying case it is `state`/`discrete` and the apply FAQ (eq. 5) becomes CONTINUOUS-cadence per §6.1 — the build-once weights / apply-many split is exactly the static/dynamic partition."
        },
        "pair_exists": {
          "type": "unknown",
          "shape": [
            "candidate_pairs"
          ],
          "description": "Membership over the candidate overlap-pair set produced by the bin-Skolem equi-join (the broad phase) — the byte-identical integer candidate set of §5.8.5, materialized as the derived `candidate_pairs` index set via from_faq:\"candidate_set\"."
        },
        "clip": {
          "type": "unknown",
          "shape": [
            "clip_ring",
            "coord"
          ],
          "description": "NARROW-PHASE DEMO: the clipped overlap ring A ∩ B for a representative candidate pair — the `intersect_polygon` leaf output, a vertex ring of DATA-DEPENDENT length whose vertex set is the derived `clip_ring` index set (from_faq:\"overlap_clip\", riding the M3 value-invention machinery, §8.1). One such clip is computed per candidate pair to fill the `A_ij` factor."
        },
        "A_ij_rep": {
          "type": "unknown",
          "shape": [],
          "description": "NARROW-PHASE DEMO: the representative overlap area A_ij = polygon_area(clip) on the SPHERE — a sum_product FAQ over the clipped ring whose body is the great-circle fan triangulation Σ_v E(v_1,v_v,v_{v+1}) of Van Oosterom-Strackee spherical excesses E(a,b,c)=2·atan2(a·(b×c),1+a·b+b·c+c·a) (unit sphere). This is how each entry of the build-once A_ij factor is produced; the test asserts it equals polygon_area(clip,\"spherical\") and the matching A_ij[i,j]."
        },
        "A_j": {
          "type": "unknown",
          "shape": [
            "tgt_cells"
          ],
          "description": "Target-cell area denominator A_j = Σ_i A_ij — the group-by-`j` row-sum over the bin-Skolem CANDIDATE pairs (join.on [[src_bin,tgt_bin]] on the MATERIALISED bin buffers) with the sub-atol sliver filter. d(A_j[j])/dt from a zero IC ⇒ du = A_j[j]; the test asserts it reproduces the supplied `dst_areas` (PoU by construction, §5.8.3)."
        },
        "F_tgt": {
          "type": "unknown",
          "shape": [
            "tgt_cells"
          ],
          "description": "Regridded field F_tgt[j] = (1/dst_areas[j])·Σ_i A_ij[i,j]·F_src[i] = Σ_i W_ij·F_src[i], W_ij = A_ij/A_j — the apply sum_product FAQ over the bin-Skolem candidate set with the normalize `/ dst_areas[j]` folded in. d(F_tgt[j])/dt from a zero IC ⇒ du = F_tgt[j]."
        },
        "dst_areas": {
          "type": "parameter",
          "shape": [
            "tgt_cells"
          ],
          "description": "Build-once target-cell area denominator A_j = Σ_i A_ij stored at regridder-build time (ConservativeRegridding.jl's `dst_areas`). The NORMALIZE factor the apply body divides by; supplied as a const_array. The `A_j` FAQ recomputes the same row-sum to prove the group-by reproduces it (partition-of-unity by construction, §5.8.3)."
        },
        "narrow_phase_area": {
          "type": "unknown",
          "shape": [],
          "description": "Tracer consuming the representative narrow-phase area so the spherical clip + polygon_area FAQ evaluate in a well-formed ODE: d(narrow_phase_area)/dt = A_ij_rep from a zero IC ⇒ du = A_ij_rep. The conformance test checks it equals polygon_area(clip,\"spherical\") (the kept Van Oosterom-Strackee oracle) and the matching A_ij entry."
        },
        "src_bin_c1": {
          "type": "unknown",
          "shape": [
            "src_cells"
          ],
          "description": "Component 1 of the bin key formerly `src_bin` (an integer join column)."
        },
        "src_bin_c2": {
          "type": "unknown",
          "shape": [
            "src_cells"
          ],
          "description": "Component 2 of the bin key formerly `src_bin` (an integer join column)."
        },
        "tgt_bin_c1": {
          "type": "unknown",
          "shape": [
            "tgt_cells"
          ],
          "description": "Component 1 of the bin key formerly `tgt_bin` (an integer join column)."
        },
        "tgt_bin_c2": {
          "type": "unknown",
          "shape": [
            "tgt_cells"
          ],
          "description": "Component 2 of the bin key formerly `tgt_bin` (an integer join column)."
        }
      },
      "equations": [
        {
          "_comment": "Component 1 of the former `src_bin` bin key: an integer join column.",
          "lhs": {
            "op": "index",
            "args": [
              "src_bin_c1",
              "i"
            ]
          },
          "rhs": {
            "op": "faq",
            "semiring": "sum_product",
            "output_idx": [
              "i"
            ],
            "ranges": {
              "i": {
                "from": "src_cells"
              }
            },
            "args": [],
            "expr": {
              "op": "floor",
              "args": [
                {
                  "op": "/",
                  "args": [
                    {
                      "op": "index",
                      "args": [
                        "src_lon",
                        "i"
                      ]
                    },
                    "dx"
                  ]
                }
              ]
            }
          }
        },
        {
          "_comment": "Component 2 of the former `src_bin` bin key: an integer join column.",
          "lhs": {
            "op": "index",
            "args": [
              "src_bin_c2",
              "i"
            ]
          },
          "rhs": {
            "op": "faq",
            "semiring": "sum_product",
            "output_idx": [
              "i"
            ],
            "ranges": {
              "i": {
                "from": "src_cells"
              }
            },
            "args": [],
            "expr": {
              "op": "floor",
              "args": [
                {
                  "op": "/",
                  "args": [
                    {
                      "op": "index",
                      "args": [
                        "src_lat",
                        "i"
                      ]
                    },
                    "dy"
                  ]
                }
              ]
            }
          }
        },
        {
          "_comment": "Component 1 of the former `tgt_bin` bin key: an integer join column.",
          "lhs": {
            "op": "index",
            "args": [
              "tgt_bin_c1",
              "j"
            ]
          },
          "rhs": {
            "op": "faq",
            "semiring": "sum_product",
            "output_idx": [
              "j"
            ],
            "ranges": {
              "j": {
                "from": "tgt_cells"
              }
            },
            "args": [],
            "expr": {
              "op": "floor",
              "args": [
                {
                  "op": "/",
                  "args": [
                    {
                      "op": "index",
                      "args": [
                        "tgt_lon",
                        "j"
                      ]
                    },
                    "dx"
                  ]
                }
              ]
            }
          }
        },
        {
          "_comment": "Component 2 of the former `tgt_bin` bin key: an integer join column.",
          "lhs": {
            "op": "index",
            "args": [
              "tgt_bin_c2",
              "j"
            ]
          },
          "rhs": {
            "op": "faq",
            "semiring": "sum_product",
            "output_idx": [
              "j"
            ],
            "ranges": {
              "j": {
                "from": "tgt_cells"
              }
            },
            "args": [],
            "expr": {
              "op": "floor",
              "args": [
                {
                  "op": "/",
                  "args": [
                    {
                      "op": "index",
                      "args": [
                        "tgt_lat",
                        "j"
                      ]
                    },
                    "dy"
                  ]
                }
              ]
            }
          }
        },
        {
          "_comment": "(1c) OVERLAP PAIRS — the candidate overlap-pair set = the bin-Skolem EQUI-join. The index-set-producing faq (bool_and_or, distinct:true, id `candidate_set` referenced by candidate_pairs.from_faq) ranges source i and target j, the M2 `join.on` keeps only (i,j) whose bin keys are EQUAL, and skolem(\"pair\", i, j) names each surviving candidate; the `true` body marks membership. Integer bin keys ⇒ the candidate set is byte-identical across bindings in the §5.7 sorted order (§5.8.5). No spatial-index op in the IR — the index is a physical-operator concern (STR-tree acceleration is the perf follow-on, out of scope). (Template rewrite: see tests/conformance/relational_templates/rewrites/.)",
          "lhs": {
            "op": "index",
            "args": [
              "pair_exists",
              "p"
            ]
          },
          "rhs": {
            "op": "faq",
            "id": "candidate_set",
            "semiring": "bool_and_or",
            "distinct": true,
            "output_idx": [
              "p"
            ],
            "ranges": {
              "i": {
                "from": "src_cells"
              },
              "j": {
                "from": "tgt_cells"
              }
            },
            "join": [
              {
                "on": [
                  [
                    "src_bin_c1",
                    "tgt_bin_c1"
                  ],
                  [
                    "src_bin_c2",
                    "tgt_bin_c2"
                  ]
                ]
              }
            ],
            "args": [
              "src_bin_c1",
              "src_bin_c2",
              "tgt_bin_c1",
              "tgt_bin_c2"
            ],
            "key": {
              "op": "apply_expression_template",
              "args": [],
              "name": "pair_key",
              "bindings": {
                "a": "i",
                "b": "j",
                "lo_a": 1,
                "lo_b": 1,
                "n_a": 3,
                "n_b": 3
              }
            },
            "expr": {
              "op": "true",
              "args": []
            }
          }
        },
        {
          "_comment": "NARROW-PHASE DEMO consumer: d(narrow_phase_area)/dt = A_ij_rep, the representative spherical polygon_area(intersect_polygon(...)) overlap area. A_ij_rep is a scalar observed substituted inline; from a zero IC du = A_ij_rep.",
          "lhs": {
            "op": "D",
            "args": [
              "narrow_phase_area"
            ],
            "wrt": "t"
          },
          "rhs": "A_ij_rep"
        },
        {
          "_comment": "(3) A_j[j] = Σ_i A_ij[i,j] — the group-by-`j` sum_product FAQ. The OVERLAP JOIN restricts the contraction to bin-Skolem CANDIDATE pairs by gating on the MATERIALISED bin buffers: join.on [[src_bin,tgt_bin]] admits (i,j) iff src_bin[i] == tgt_bin[j] (the F3 buffer-gated join, §5.3). filter A_ij>atol drops sub-atol slivers → the SURVIVING set. Zero IC ⇒ du[A_j[j]] = A_j[j].",
          "lhs": {
            "op": "faq",
            "args": [],
            "output_idx": [
              "j"
            ],
            "expr": {
              "op": "D",
              "args": [
                {
                  "op": "index",
                  "args": [
                    "A_j",
                    "j"
                  ]
                }
              ],
              "wrt": "t"
            },
            "ranges": {
              "j": [
                1,
                3
              ]
            }
          },
          "rhs": {
            "op": "faq",
            "semiring": "sum_product",
            "output_idx": [
              "j"
            ],
            "ranges": {
              "i": {
                "from": "src_cells"
              },
              "j": {
                "from": "tgt_cells"
              }
            },
            "join": [
              {
                "on": [
                  [
                    "src_bin_c1",
                    "tgt_bin_c1"
                  ],
                  [
                    "src_bin_c2",
                    "tgt_bin_c2"
                  ]
                ]
              }
            ],
            "filter": {
              "op": ">",
              "args": [
                {
                  "op": "index",
                  "args": [
                    "A_ij",
                    "i",
                    "j"
                  ]
                },
                "atol"
              ]
            },
            "args": [
              "A_ij",
              "src_bin_c1",
              "src_bin_c2",
              "tgt_bin_c1",
              "tgt_bin_c2"
            ],
            "expr": {
              "op": "index",
              "args": [
                "A_ij",
                "i",
                "j"
              ]
            }
          }
        },
        {
          "_comment": "(4)+(5) APPLY + NORMALIZE — F_tgt[j] = Σ_i A_ij[i,j]·F_src[i] / dst_areas[j]. Same bin-Skolem buffer-gated join + zero-area filter as A_j; the elementwise `/ dst_areas[j]` folds in the normalize (dst_areas is the build-once denominator A_j). F_tgt = Σ_i W_ij·F_src[i], Σ_i W_ij = 1 by construction. Zero IC ⇒ du[F_tgt[j]] = F_tgt[j].",
          "lhs": {
            "op": "faq",
            "args": [],
            "output_idx": [
              "j"
            ],
            "expr": {
              "op": "D",
              "args": [
                {
                  "op": "index",
                  "args": [
                    "F_tgt",
                    "j"
                  ]
                }
              ],
              "wrt": "t"
            },
            "ranges": {
              "j": [
                1,
                3
              ]
            }
          },
          "rhs": {
            "op": "faq",
            "semiring": "sum_product",
            "output_idx": [
              "j"
            ],
            "ranges": {
              "i": {
                "from": "src_cells"
              },
              "j": {
                "from": "tgt_cells"
              }
            },
            "join": [
              {
                "on": [
                  [
                    "src_bin_c1",
                    "tgt_bin_c1"
                  ],
                  [
                    "src_bin_c2",
                    "tgt_bin_c2"
                  ]
                ]
              }
            ],
            "filter": {
              "op": ">",
              "args": [
                {
                  "op": "index",
                  "args": [
                    "A_ij",
                    "i",
                    "j"
                  ]
                },
                "atol"
              ]
            },
            "args": [
              "A_ij",
              "F_src",
              "dst_areas",
              "src_bin_c1",
              "src_bin_c2",
              "tgt_bin_c1",
              "tgt_bin_c2"
            ],
            "expr": {
              "op": "/",
              "args": [
                {
                  "op": "*",
                  "args": [
                    {
                      "op": "index",
                      "args": [
                        "A_ij",
                        "i",
                        "j"
                      ]
                    },
                    {
                      "op": "index",
                      "args": [
                        "F_src",
                        "i"
                      ]
                    }
                  ]
                },
                {
                  "op": "index",
                  "args": [
                    "dst_areas",
                    "j"
                  ]
                }
              ]
            }
          }
        },
        {
          "lhs": "clip",
          "rhs": {
            "op": "intersect_polygon",
            "id": "overlap_clip",
            "manifold": "spherical",
            "args": [
              "src_poly_rep",
              "tgt_poly_rep"
            ]
          }
        },
        {
          "lhs": "A_ij_rep",
          "rhs": {
            "op": "faq",
            "semiring": "sum_product",
            "output_idx": [],
            "ranges": {
              "v": {
                "from": "clip_ring"
              }
            },
            "args": [
              "clip"
            ],
            "expr": {
              "op": "*",
              "args": [
                2.0,
                {
                  "op": "atan2",
                  "args": [
                    {
                      "op": "+",
                      "args": [
                        {
                          "op": "*",
                          "args": [
                            {
                              "op": "*",
                              "args": [
                                {
                                  "op": "cos",
                                  "args": [
                                    {
                                      "op": "*",
                                      "args": [
                                        {
                                          "op": "index",
                                          "args": [
                                            "clip",
                                            1,
                                            2
                                          ]
                                        },
                                        0.017453292519943295
                                      ]
                                    }
                                  ]
                                },
                                {
                                  "op": "cos",
                                  "args": [
                                    {
                                      "op": "*",
                                      "args": [
                                        {
                                          "op": "index",
                                          "args": [
                                            "clip",
                                            1,
                                            1
                                          ]
                                        },
                                        0.017453292519943295
                                      ]
                                    }
                                  ]
                                }
                              ]
                            },
                            {
                              "op": "-",
                              "args": [
                                {
                                  "op": "*",
                                  "args": [
                                    {
                                      "op": "*",
                                      "args": [
                                        {
                                          "op": "cos",
                                          "args": [
                                            {
                                              "op": "*",
                                              "args": [
                                                {
                                                  "op": "index",
                                                  "args": [
                                                    "clip",
                                                    "v",
                                                    2
                                                  ]
                                                },
                                                0.017453292519943295
                                              ]
                                            }
                                          ]
                                        },
                                        {
                                          "op": "sin",
                                          "args": [
                                            {
                                              "op": "*",
                                              "args": [
                                                {
                                                  "op": "index",
                                                  "args": [
                                                    "clip",
                                                    "v",
                                                    1
                                                  ]
                                                },
                                                0.017453292519943295
                                              ]
                                            }
                                          ]
                                        }
                                      ]
                                    },
                                    {
                                      "op": "sin",
                                      "args": [
                                        {
                                          "op": "*",
                                          "args": [
                                            {
                                              "op": "index",
                                              "args": [
                                                "clip",
                                                {
                                                  "op": "+",
                                                  "args": [
                                                    "v",
                                                    1
                                                  ]
                                                },
                                                2
                                              ]
                                            },
                                            0.017453292519943295
                                          ]
                                        }
                                      ]
                                    }
                                  ]
                                },
                                {
                                  "op": "*",
                                  "args": [
                                    {
                                      "op": "sin",
                                      "args": [
                                        {
                                          "op": "*",
                                          "args": [
                                            {
                                              "op": "index",
                                              "args": [
                                                "clip",
                                                "v",
                                                2
                                              ]
                                            },
                                            0.017453292519943295
                                          ]
                                        }
                                      ]
                                    },
                                    {
                                      "op": "*",
                                      "args": [
                                        {
                                          "op": "cos",
                                          "args": [
                                            {
                                              "op": "*",
                                              "args": [
                                                {
                                                  "op": "index",
                                                  "args": [
                                                    "clip",
