              "args": [
                {
                  "op": "index",
                  "args": [
                    "F_tgt",
                    "j"
                  ]
                }
              ],
              "wrt": "t"
            }
          },
          "rhs": {
            "op": "faq",
            "semiring": "sum_product",
            "output_idx": [
              "j"
            ],
            "ranges": {
              "i": {
                "from": "src_cells"
              },
              "j": {
                "from": "tgt_cells"
              }
            },
            "join": [
              {
                "on": [
                  [
                    "src_bin_c1",
                    "tgt_bin_c1"
                  ],
                  [
                    "src_bin_c2",
                    "tgt_bin_c2"
                  ]
                ]
              }
            ],
            "filter": {
              "op": ">",
              "args": [
