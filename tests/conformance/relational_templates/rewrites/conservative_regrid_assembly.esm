{
  "esm": "2.0.0",
  "metadata": {
    "name": "conservative_regrid_assembly_template",
    "description": "Template rewrite of tests/valid/geometry/conservative_regrid_assembly.esm (generated by tests/conformance/relational_templates/rewrites/generate.py): the skolem / rank / gated-argmin value-invention ops replaced by lib/relational.esm templates. Bin keys split into per-component join columns in the producer and every gathered contraction; the pair key is pair_key(i, j, 1, 1, 4, 4).",
    "authors": [
      "EarthSciAST/polecats/gastown.nux"
    ],
    "tags": [
      "geometry",
      "conservative-regridding",
      "assembly",
      "overlap-join",
      "bin-skolem",
      "polygon_intersection_area",
      "fused-leaf",
      "sum_product",
      "join",
      "filter",
      "inline-weights",
      "partition-of-unity",
      "conservation",
      "end-to-end",
      "ess-my4.4.6"
    ]
  },
  "index_sets": {
    "coord": {
      "kind": "interval",
      "size": 2
    },
    "cell_verts": {
      "kind": "interval",
      "size": 4
    },
    "src_cells": {
      "kind": "interval",
      "size": 4
    },
    "tgt_cells": {
      "kind": "interval",
      "size": 4
    },
    "candidate_pairs": {
      "kind": "derived",
      "from_faq": "candidate_set"
    }
  },
  "models": {
    "ConservativeRegridAssembly": {
      "expression_template_imports": [
        {
          "ref": "esm:std/relational.esm"
        },
        {
          "ref": "esm:std/geometry.esm",
          "only": [
            "overlap_area_planar"
          ]
        }
      ],
      "variables": {
        "src_poly": {
          "type": "unknown",
          "shape": [
            "src_cells",
            "cell_verts",
            "coord"
          ],
          "description": "In-file SOURCE-cell geometry: one closed lon-lat vertex ring per source cell (src_poly[i,v,1]=lon, src_poly[i,v,2]=lat), declared as a `const` array. The `poly_a` operand of the ranged narrow-phase clip. This is the cell geometry the overlap weights are computed FROM — nothing about the weights is supplied opaquely."
        },
        "tgt_poly": {
          "type": "unknown",
          "shape": [
            "tgt_cells",
            "cell_verts",
            "coord"
          ],
          "description": "In-file TARGET-cell geometry: one closed lon-lat vertex ring per target cell — the `poly_b` operand of the ranged clip. The source and target grids tile the same domain [0,4]x[0,1] with DIFFERENT cell boundaries so the overlaps are fractional (the interesting regridding case)."
        },
        "src_lon": {
          "type": "unknown",
          "shape": [
            "src_cells"
          ],
          "description": "Source-cell representative longitude (bbox-min corner) — the float coord that enters ONLY the integer binning via `floor`, never a raw join comparison (§5.8.5)."
        },
        "src_lat": {
          "type": "unknown",
          "shape": [
            "src_cells"
          ],
          "description": "Source-cell representative latitude for binning."
        },
        "tgt_lon": {
          "type": "unknown",
          "shape": [
            "tgt_cells"
          ],
          "description": "Target-cell representative longitude for binning."
        },
        "tgt_lat": {
          "type": "unknown",
          "shape": [
            "tgt_cells"
          ],
          "description": "Target-cell representative latitude for binning."
        },
        "F_src": {
          "type": "unknown",
          "shape": [
            "src_cells"
          ],
          "description": "The SPATIALLY-VARYING source field being remapped (F_src=[10,20,30,40]). Non-uniform on purpose: a uniform field broadcast through the weights would be a no-op, so conservation and partition-of-unity are non-trivial."
        },
        "dx": {
          "type": "parameter",
          "shape": [],
          "description": "Bin width in degrees — the integer quantization step of the broad phase (§5.8.5).",
          "default": 2.0
        },
        "dy": {
          "type": "parameter",
          "shape": [],
          "description": "Bin height in degrees.",
          "default": 2.0
        },
        "atol": {
          "type": "parameter",
          "shape": [],
          "description": "Sliver floor (§5.8.2): an overlap area at or below atol is treated as zero and dropped by the surviving-overlap filter.",
          "default": 1e-12
        },
        "pair_exists": {
          "type": "unknown",
          "shape": [
            "candidate_pairs"
          ],
          "description": "Membership over the bin-skolem candidate overlap-pair set (the broad phase), materialized as the derived candidate_pairs index set via from_faq:\"candidate_set\"."
        },
        "A_ij": {
          "type": "unknown",
          "shape": [
            "src_cells",
            "tgt_cells"
          ],
          "description": "NARROW PHASE (densely evaluable): the overlap-area matrix A_ij[i,j] = polygon_intersection_area(src_poly[i], tgt_poly[j]) computed INLINE from the in-file geometry via the FUSED planar clip+area leaf (esm-spec.md §8.6.1). Ranged over the SAME bin-skolem candidate pairs (join.on [[src_bin,tgt_bin]]) as the row-sum / apply, so it is dense over the broad-phase candidate set with NO ragged intermediate: the fused leaf returns the SCALAR overlap area (defined to equal the standalone intersect_polygon clip composed with the shoelace area) and hides the intersection ring inside the kernel. This replaces the earlier ragged-ring narrow phase (which surfaced a data-dependent per-clip vertex set and was only structurally valid). The weights are DECLARED from cell geometry in-file, not hand-supplied; the row-sum / apply halves below consume A_ij as the per-pair overlap-area factor."
        },
        "A_j": {
          "type": "unknown",
          "shape": [
            "tgt_cells"
          ],
          "description": "Target-cell area denominator A_j[j] = Σ_i A_ij[i,j] — the group-by-`j` row-sum over the bin-skolem CANDIDATE pairs (join.on [[src_bin,tgt_bin]]) with the sub-atol sliver filter. The normalize denominator; = ConservativeRegridding.jl's `dst_areas`, here computed from geometry, not supplied."
        },
        "W_ij": {
          "type": "unknown",
          "shape": [
            "src_cells",
            "tgt_cells"
          ],
          "description": "The conservative regrid weights W_ij = A_ij[i,j] / A_j[j] over the candidate pairs. Partition-of-unity Σ_i W_ij = 1 holds BY CONSTRUCTION because the denominator A_j is the row-sum of the SAME areas (§5.8.3)."
        },
        "A_j_check": {
          "type": "unknown",
          "shape": [
            "tgt_cells"
          ],
          "description": "Tracer that recomputes A_j from the SAME A_ij feeding the apply (zero IC ⇒ du = A_j), the partition-of-unity-by-construction proof."
        },
        "F_tgt": {
          "type": "unknown",
          "shape": [
            "tgt_cells"
          ],
          "description": "The regridded field F_tgt[j] = Σ_i W_ij[i,j]·F_src[i] = (1/A_j[j])·Σ_i A_ij[i,j]·F_src[i] — the apply sum_product FAQ over the candidate set. Zero IC ⇒ du = F_tgt. Conservation Σ_j A_j·F_tgt[j] = Σ_i A_i·F_src[i] and PoU Σ_i W_ij = 1 hold."
        },
        "src_bin_c1": {
          "type": "unknown",
          "shape": [
            "src_cells"
          ],
          "description": "Component 1 of the bin key formerly `src_bin` (an integer join column)."
        },
        "src_bin_c2": {
          "type": "unknown",
          "shape": [
            "src_cells"
          ],
          "description": "Component 2 of the bin key formerly `src_bin` (an integer join column)."
        },
        "tgt_bin_c1": {
          "type": "unknown",
          "shape": [
            "tgt_cells"
          ],
          "description": "Component 1 of the bin key formerly `tgt_bin` (an integer join column)."
        },
        "tgt_bin_c2": {
          "type": "unknown",
          "shape": [
            "tgt_cells"
          ],
          "description": "Component 2 of the bin key formerly `tgt_bin` (an integer join column)."
        }
      },
      "equations": [
        {
          "_comment": "Component 1 of the former `src_bin` bin key: an integer join column.",
          "lhs": {
            "op": "index",
            "args": [
              "src_bin_c1",
              "i"
            ]
          },
          "rhs": {
            "op": "faq",
            "semiring": "sum_product",
            "output_idx": [
              "i"
            ],
            "ranges": {
              "i": {
                "from": "src_cells"
              }
            },
            "args": [],
            "expr": {
              "op": "floor",
              "args": [
                {
                  "op": "/",
                  "args": [
                    {
                      "op": "index",
                      "args": [
                        "src_lon",
                        "i"
                      ]
                    },
                    "dx"
                  ]
                }
              ]
            }
          }
        },
        {
          "_comment": "Component 2 of the former `src_bin` bin key: an integer join column.",
          "lhs": {
            "op": "index",
            "args": [
              "src_bin_c2",
              "i"
            ]
          },
          "rhs": {
            "op": "faq",
            "semiring": "sum_product",
            "output_idx": [
              "i"
            ],
            "ranges": {
              "i": {
                "from": "src_cells"
              }
            },
            "args": [],
            "expr": {
              "op": "floor",
              "args": [
                {
                  "op": "/",
                  "args": [
                    {
                      "op": "index",
                      "args": [
                        "src_lat",
                        "i"
                      ]
                    },
                    "dy"
                  ]
                }
              ]
            }
          }
        },
        {
          "_comment": "Component 1 of the former `tgt_bin` bin key: an integer join column.",
          "lhs": {
            "op": "index",
            "args": [
              "tgt_bin_c1",
              "j"
            ]
          },
          "rhs": {
            "op": "faq",
            "semiring": "sum_product",
            "output_idx": [
              "j"
            ],
            "ranges": {
              "j": {
                "from": "tgt_cells"
              }
            },
            "args": [],
            "expr": {
              "op": "floor",
              "args": [
                {
                  "op": "/",
                  "args": [
                    {
                      "op": "index",
                      "args": [
                        "tgt_lon",
                        "j"
                      ]
                    },
                    "dx"
                  ]
                }
              ]
            }
          }
        },
        {
          "_comment": "Component 2 of the former `tgt_bin` bin key: an integer join column.",
          "lhs": {
            "op": "index",
            "args": [
              "tgt_bin_c2",
              "j"
            ]
          },
          "rhs": {
            "op": "faq",
            "semiring": "sum_product",
            "output_idx": [
              "j"
            ],
            "ranges": {
              "j": {
                "from": "tgt_cells"
              }
            },
            "args": [],
            "expr": {
              "op": "floor",
              "args": [
                {
                  "op": "/",
                  "args": [
                    {
                      "op": "index",
                      "args": [
                        "tgt_lat",
                        "j"
                      ]
                    },
                    "dy"
                  ]
                }
              ]
            }
          }
        },
        {
          "_comment": "(1c) BROAD PHASE — candidate overlap-pair set = the bin-skolem equi-join (distinct bool_and_or, id candidate_set): keep (i,j) whose bin keys are EQUAL; skolem(\"pair\",i,j) names each surviving candidate. (Template rewrite: see tests/conformance/relational_templates/rewrites/.)",
          "lhs": {
            "op": "index",
            "args": [
              "pair_exists",
              "p"
            ]
          },
          "rhs": {
            "op": "faq",
            "semiring": "bool_and_or",
            "output_idx": [
              "p"
            ],
            "ranges": {
              "i": {
                "from": "src_cells"
              },
              "j": {
                "from": "tgt_cells"
              }
            },
            "id": "candidate_set",
            "distinct": true,
            "join": [
              {
                "on": [
                  [
                    "src_bin_c1",
                    "tgt_bin_c1"
                  ],
                  [
                    "src_bin_c2",
                    "tgt_bin_c2"
                  ]
                ]
              }
            ],
            "key": {
              "op": "apply_expression_template",
              "args": [],
              "name": "pair_key",
              "bindings": {
                "a": "i",
                "b": "j",
                "lo_a": 1,
                "lo_b": 1,
                "n_a": 4,
                "n_b": 4
              }
            },
            "args": [],
            "expr": {
              "op": "true",
              "args": []
            }
          }
        },
        {
          "_comment": "(3) A_j[j] = Σ_i A_ij[i,j] over the bin-skolem candidate pairs (join on the materialized bin buffers) with the sliver filter. A_ij is computed inline from geometry above. Zero IC ⇒ du[A_j_check] = A_j. (Template rewrite: see tests/conformance/relational_templates/rewrites/.)",
          "lhs": {
            "op": "faq",
            "semiring": "sum_product",
            "output_idx": [
              "j"
            ],
            "ranges": {
              "j": [
                1,
                4
              ]
            },
            "args": [],
            "expr": {
              "op": "D",
              "args": [
                {
                  "op": "index",
                  "args": [
                    "A_j_check",
                    "j"
                  ]
                }
              ],
              "wrt": "t"
            }
          },
          "rhs": {
            "op": "faq",
            "semiring": "sum_product",
            "output_idx": [
              "j"
            ],
            "ranges": {
              "i": {
                "from": "src_cells"
              },
              "j": {
                "from": "tgt_cells"
              }
            },
            "join": [
              {
                "on": [
                  [
                    "src_bin_c1",
                    "tgt_bin_c1"
                  ],
                  [
                    "src_bin_c2",
                    "tgt_bin_c2"
                  ]
                ]
              }
            ],
            "filter": {
              "op": ">",
              "args": [
                {
                  "op": "index",
                  "args": [
                    "A_ij",
                    "i",
                    "j"
                  ]
                },
                "atol"
              ]
            },
            "args": [],
            "expr": {
              "op": "index",
              "args": [
                "A_ij",
                "i",
                "j"
              ]
            }
          }
        },
        {
          "_comment": "(4)+(5) APPLY + NORMALIZE — D(F_tgt[j]) = Σ_i W_ij[i,j]·F_src[i], W_ij = A_ij/A_j (normalize folded into the inline weights). Same bin-skolem candidate join + zero-area filter. Zero IC ⇒ du[F_tgt] = F_tgt. (Template rewrite: see tests/conformance/relational_templates/rewrites/.)",
          "lhs": {
            "op": "faq",
            "semiring": "sum_product",
            "output_idx": [
              "j"
            ],
            "ranges": {
              "j": [
                1,
