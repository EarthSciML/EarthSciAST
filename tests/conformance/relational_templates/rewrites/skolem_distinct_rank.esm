{
  "esm": "1.1.0",
  "metadata": {
    "name": "skolem_distinct_rank_template",
    "description": "Template rewrite of tests/valid/faq/skolem_distinct_rank.esm (generated by tests/conformance/relational_templates/rewrites/generate.py): the skolem / rank / gated-argmin value-invention ops replaced by lib/relational.esm templates. The edge key is edge_key(edge_lo, edge_hi, 1, 6); rank(edges) is the loop index.",
    "authors": [
      "EarthSciAST/polecats/gastown.capable"
    ],
    "tags": [
      "faq",
      "skolem",
      "distinct",
      "rank",
      "value-invention",
      "conformance",
      "schema"
    ]
  },
  "index_sets": {
    "faces": {
      "kind": "interval",
      "size": 12
    },
    "local_edges": {
      "kind": "interval",
      "size": 3
    },
    "edges": {
      "kind": "derived",
      "from_faq": "edge_set"
    }
  },
  "models": {
    "EdgeEnumeration": {
      "expression_template_imports": [
        {
          "ref": "../../../../lib/relational.esm"
        }
      ],
      "variables": {
        "u": {
          "type": "unknown"
        },
        "edge_lo": {
          "type": "parameter",
          "shape": [
            "faces",
            "local_edges"
          ]
        },
        "edge_hi": {
          "type": "parameter",
          "shape": [
            "faces",
            "local_edges"
          ]
        },
        "edge_exists": {
          "type": "unknown"
        },
        "edge_dense_id": {
          "type": "unknown",
          "shape": [
            "edges"
          ]
        }
      },
      "equations": [
        {
          "_comment": "edge_set: the index-set-producing node referenced by index_sets.edges.from_faq. distinct:true under bool_and_or dedups the unique undirected edges; `key` mints a canonical Skolem term over the sorted endpoint vertices; the `true` body marks set membership (existence). Output order is the §5.7 sorted order, never insertion order.",
          "lhs": {
            "op": "index",
            "args": [
              "edge_exists",
              "e"
            ]
          },
          "rhs": {
            "op": "faq",
            "id": "edge_set",
            "args": [
              "edge_lo",
              "edge_hi"
            ],
            "semiring": "bool_and_or",
            "distinct": true,
            "output_idx": [
              "e"
            ],
            "ranges": {
              "f": {
                "from": "faces"
              },
              "le": {
                "from": "local_edges"
              }
            },
            "key": {
              "op": "apply_expression_template",
              "args": [],
              "name": "edge_key",
              "bindings": {
                "u": {
                  "op": "index",
                  "args": [
                    "edge_lo",
                    "f",
                    "le"
                  ]
                },
                "v": {
                  "op": "index",
                  "args": [
                    "edge_hi",
                    "f",
                    "le"
                  ]
                },
                "lo": 1,
                "n": 6
              }
            },
            "filter": {
              "op": "true",
              "args": []
            },
            "expr": {
              "op": "true",
              "args": []
            }
          }
        },
        {
          "_comment": "rank: dense integer ids over the derived `edges` set, assigned by position in the sorted distinct sequence (§5.5 / §5.7.3) — what the array backend indexes by.",
          "lhs": {
            "op": "index",
            "args": [
              "edge_dense_id",
              "e"
            ]
          },
          "rhs": {
            "op": "faq",
            "args": [],
            "semiring": "sum_product",
            "output_idx": [
              "e"
            ],
            "ranges": {
              "e": {
                "from": "edges"
              }
            },
            "expr": "e"
          }
        },
        {
          "_comment": "An ordinary continuous decay, so the model is a well-formed ODE alongside the value-invention (topology) nodes above.",
          "lhs": {
            "op": "D",
            "args": [
              "u"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "-",
            "args": [
              "u"
            ]
          }
        }
      ]
    }
  }
}
