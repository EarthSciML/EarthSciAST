{
  "esm": "1.1.0",
  "metadata": {
    "name": "nearest_generator_argmin_template",
    "description": "Template rewrite of tests/valid/faq/nearest_generator_argmin.esm (generated by tests/conformance/relational_templates/rewrites/generate.py): the skolem / rank / gated-argmin value-invention ops replaced by lib/relational.esm templates. Bin keys split into per-component columns; the gated argmin becomes argmin_where with the predicate point_bin == gen_bin per component.",
    "authors": [
      "EarthSciAST/polecats/gastown.slit"
    ],
    "tags": [
      "faq",
      "argmin",
      "arg-witness",
      "value-invention",
      "nearest-generator",
      "tie-break",
      "bin-skolem",
      "spatial-join",
      "mpas-scvt",
      "determinism",
      "conformance",
      "schema",
      "ess-os1"
    ]
  },
  "index_sets": {
    "points": {
      "kind": "interval",
      "size": 4
    },
    "generators": {
      "kind": "interval",
      "size": 3
    }
  },
  "models": {
    "NearestGeneratorBinned": {
      "expression_template_imports": [
        {
          "ref": "esm:std/relational.esm"
        }
      ],
      "variables": {
        "px": {
          "type": "parameter",
          "shape": [
            "points"
          ],
          "description": "Point longitudes."
        },
        "py": {
          "type": "parameter",
          "shape": [
            "points"
          ],
          "description": "Point latitudes."
        },
        "gx": {
          "type": "parameter",
          "shape": [
            "generators"
          ],
          "description": "Generator longitudes."
        },
        "gy": {
          "type": "parameter",
          "shape": [
            "generators"
          ],
          "description": "Generator latitudes."
        },
        "binw": {
          "type": "parameter",
          "shape": [],
          "description": "Bin width in degrees — the integer lat-lon quantization step of the broad phase (§A.8). Shared by points and generators so a common bin key means they fall in the same bucket."
        },
        "assign_binned": {
          "type": "unknown",
          "shape": [
            "points"
          ],
          "description": "Nearest-generator INDEX restricted to same-bin candidates: assign_binned[i] = argmin_{g : point_bin[i] = gen_bin[g]} dist(point_i, gen_g). The argmin's `join` (bin-Skolem equi-join, §5.3) prunes the candidate generators to the point's bin before the distance reduction — the SCVT broad phase. CONST-cadence integer buffer, byte-identical across bindings (§5.7 rule 6)."
        },
        "point_bin_c1": {
          "type": "unknown",
          "shape": [
            "points"
          ],
          "description": "Component 1 of the bin key formerly `point_bin` (an integer join column)."
        },
        "point_bin_c2": {
          "type": "unknown",
          "shape": [
            "points"
          ],
          "description": "Component 2 of the bin key formerly `point_bin` (an integer join column)."
        },
        "gen_bin_c1": {
          "type": "unknown",
          "shape": [
            "generators"
          ],
          "description": "Component 1 of the bin key formerly `gen_bin` (an integer join column)."
        },
        "gen_bin_c2": {
          "type": "unknown",
          "shape": [
            "generators"
          ],
          "description": "Component 2 of the bin key formerly `gen_bin` (an integer join column)."
        }
      },
      "equations": [
        {
          "_comment": "Component 1 of the former `point_bin` bin key: an integer join column.",
          "lhs": {
            "op": "index",
            "args": [
              "point_bin_c1",
              "i"
            ]
          },
          "rhs": {
            "op": "faq",
            "output_idx": [
              "i"
            ],
            "ranges": {
              "i": {
                "from": "points"
              }
            },
            "args": [],
            "expr": {
              "op": "floor",
              "args": [
                {
                  "op": "/",
                  "args": [
                    {
                      "op": "index",
                      "args": [
                        "px",
                        "i"
                      ]
                    },
                    "binw"
                  ]
                }
              ]
            }
          }
        },
        {
          "_comment": "Component 2 of the former `point_bin` bin key: an integer join column.",
          "lhs": {
            "op": "index",
            "args": [
              "point_bin_c2",
              "i"
            ]
          },
          "rhs": {
            "op": "faq",
            "output_idx": [
              "i"
            ],
            "ranges": {
              "i": {
                "from": "points"
              }
            },
            "args": [],
            "expr": {
              "op": "floor",
              "args": [
                {
                  "op": "/",
                  "args": [
                    {
                      "op": "index",
                      "args": [
                        "py",
                        "i"
                      ]
                    },
                    "binw"
                  ]
                }
              ]
            }
          }
        },
        {
          "_comment": "Component 1 of the former `gen_bin` bin key: an integer join column.",
          "lhs": {
            "op": "index",
            "args": [
              "gen_bin_c1",
              "g"
            ]
          },
          "rhs": {
            "op": "faq",
            "output_idx": [
              "g"
            ],
            "ranges": {
              "g": {
                "from": "generators"
              }
            },
            "args": [],
            "expr": {
              "op": "floor",
              "args": [
                {
                  "op": "/",
                  "args": [
                    {
                      "op": "index",
                      "args": [
                        "gx",
                        "g"
                      ]
                    },
                    "binw"
                  ]
                }
              ]
            }
          }
        },
        {
          "_comment": "Component 2 of the former `gen_bin` bin key: an integer join column.",
          "lhs": {
            "op": "index",
            "args": [
              "gen_bin_c2",
              "g"
            ]
          },
          "rhs": {
            "op": "faq",
            "output_idx": [
              "g"
            ],
            "ranges": {
              "g": {
                "from": "generators"
              }
            },
            "args": [],
            "expr": {
              "op": "floor",
              "args": [
                {
                  "op": "/",
                  "args": [
                    {
                      "op": "index",
                      "args": [
                        "gy",
                        "g"
                      ]
                    },
                    "binw"
                  ]
                }
              ]
            }
          }
        },
        {
          "_comment": "NARROW PHASE — assign_binned[i] = argmin_g dist over ONLY the same-bin candidate generators. The argmin's `join` is the bin-Skolem value-equality equi-join (§5.3): point_bin[i] = gen_bin[g] gates which (i,g) pairs enter the distance reduction (the broad phase), then the squared-Euclidean FAQ + smallest-id tie-break pick the winner (the narrow phase). Builds directly on the landed bin-Skolem join + front-door.",
          "lhs": {
            "op": "index",
            "args": [
              "assign_binned",
              "i"
            ]
          },
          "rhs": {
            "op": "faq",
            "output_idx": [
              "i"
            ],
            "ranges": {
              "i": {
                "from": "points"
              }
            },
            "args": [
              "px",
              "py",
              "gx",
              "gy",
              "point_bin_c1",
              "point_bin_c2",
              "gen_bin_c1",
              "gen_bin_c2"
            ],
            "expr": {
              "op": "apply_expression_template",
              "args": [],
              "name": "argmin_where",
              "bindings": {
                "f": {
                  "op": "+",
                  "args": [
                    {
                      "op": "*",
                      "args": [
                        {
                          "op": "-",
                          "args": [
                            {
                              "op": "index",
                              "args": [
                                "px",
                                "i"
                              ]
                            },
                            {
                              "op": "index",
                              "args": [
                                "gx",
                                "k_argmin_where_1"
                              ]
                            }
                          ]
                        },
                        {
                          "op": "-",
                          "args": [
                            {
                              "op": "index",
                              "args": [
                                "px",
                                "i"
                              ]
                            },
                            {
                              "op": "index",
                              "args": [
                                "gx",
                                "k_argmin_where_1"
                              ]
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "op": "*",
                      "args": [
                        {
                          "op": "-",
                          "args": [
                            {
                              "op": "index",
                              "args": [
                                "py",
                                "i"
                              ]
                            },
                            {
                              "op": "index",
                              "args": [
                                "gy",
                                "k_argmin_where_1"
                              ]
                            }
                          ]
                        },
                        {
                          "op": "-",
                          "args": [
                            {
                              "op": "index",
                              "args": [
                                "py",
                                "i"
                              ]
                            },
                            {
                              "op": "index",
                              "args": [
                                "gy",
                                "k_argmin_where_1"
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                "p": {
                  "op": "and",
                  "args": [
                    {
                      "op": "==",
                      "args": [
                        {
                          "op": "index",
                          "args": [
                            "point_bin_c1",
                            "i"
                          ]
                        },
                        {
                          "op": "index",
                          "args": [
                            "gen_bin_c1",
                            "k_argmin_where_1"
                          ]
                        }
                      ]
                    },
                    {
                      "op": "==",
                      "args": [
                        {
                          "op": "index",
                          "args": [
                            "point_bin_c2",
                            "i"
                          ]
                        },
                        {
                          "op": "index",
                          "args": [
                            "gen_bin_c2",
                            "k_argmin_where_1"
                          ]
                        }
                      ]
                    }
                  ]
                },
                "n": 3
              }
            }
          }
        }
      ]
    }
  }
}
