{
  "esm": "1.1.0",
  "metadata": {
    "name": "bin_skolem_spatial_join_template",
    "description": "Template rewrite of tests/valid/geometry/bin_skolem_spatial_join.esm (generated by tests/conformance/relational_templates/rewrites/generate.py): the skolem / rank / gated-argmin value-invention ops replaced by lib/relational.esm templates. Bin keys split into per-component join columns; the pair key is pair_key(i, j, 1, 1, 4, 4).",
    "authors": [
      "EarthSciAST/polecats/gastown.furiosa"
    ],
    "tags": [
      "geometry",
      "spatial-join",
      "bin-skolem",
      "floor",
      "skolem",
      "join",
      "value-invention",
      "conformance",
      "schema",
      "ess-my4.4.2"
    ]
  },
  "index_sets": {
    "src_cells": {
      "kind": "interval",
      "size": 4
    },
    "tgt_cells": {
      "kind": "interval",
      "size": 4
    },
    "candidate_pairs": {
      "kind": "derived",
      "from_faq": "candidate_set"
    }
  },
  "models": {
    "BinSkolemSpatialJoin": {
      "expression_template_imports": [
        {
          "ref": "esm:std/relational.esm"
        }
      ],
      "variables": {
        "src_lon": {
          "type": "parameter",
          "shape": [
            "src_cells"
          ],
          "description": "Source-cell representative longitude (e.g. bbox-min corner). Float coordinate — enters ONLY the integer binning via floor, never a raw join comparison."
        },
        "src_lat": {
          "type": "parameter",
          "shape": [
            "src_cells"
          ]
        },
        "tgt_lon": {
          "type": "parameter",
          "shape": [
            "tgt_cells"
          ]
        },
        "tgt_lat": {
          "type": "parameter",
          "shape": [
            "tgt_cells"
          ]
        },
        "dx": {
          "type": "parameter",
          "shape": [],
          "description": "Bin width in degrees — the exactly-defined integer quantization step (§5.8.5)."
        },
        "dy": {
          "type": "parameter",
          "shape": []
        },
        "pair_exists": {
          "type": "unknown",
          "shape": [
            "candidate_pairs"
          ],
          "description": "Membership over the candidate overlap-pair set produced by the bin-Skolem equi-join (the broad phase). The byte-identical integer candidate set of §5.8.5."
        },
        "src_bin_c1": {
          "type": "unknown",
          "shape": [
            "src_cells"
          ],
          "description": "Component 1 of the bin key formerly `src_bin` (an integer join column)."
        },
        "src_bin_c2": {
          "type": "unknown",
          "shape": [
            "src_cells"
          ],
          "description": "Component 2 of the bin key formerly `src_bin` (an integer join column)."
        },
        "tgt_bin_c1": {
          "type": "unknown",
          "shape": [
            "tgt_cells"
          ],
          "description": "Component 1 of the bin key formerly `tgt_bin` (an integer join column)."
        },
        "tgt_bin_c2": {
          "type": "unknown",
          "shape": [
            "tgt_cells"
          ],
          "description": "Component 2 of the bin key formerly `tgt_bin` (an integer join column)."
        }
      },
      "equations": [
        {
          "_comment": "Component 1 of the former `src_bin` bin key: an integer join column.",
          "lhs": {
            "op": "index",
            "args": [
              "src_bin_c1",
              "i"
            ]
          },
          "rhs": {
            "op": "faq",
            "semiring": "sum_product",
            "output_idx": [
              "i"
            ],
            "ranges": {
              "i": {
                "from": "src_cells"
              }
            },
            "args": [],
            "expr": {
              "op": "floor",
              "args": [
                {
                  "op": "/",
                  "args": [
                    {
                      "op": "index",
                      "args": [
                        "src_lon",
                        "i"
                      ]
                    },
                    "dx"
                  ]
                }
              ]
            }
          }
        },
        {
          "_comment": "Component 2 of the former `src_bin` bin key: an integer join column.",
          "lhs": {
            "op": "index",
            "args": [
              "src_bin_c2",
              "i"
            ]
          },
          "rhs": {
            "op": "faq",
            "semiring": "sum_product",
            "output_idx": [
              "i"
            ],
            "ranges": {
              "i": {
                "from": "src_cells"
              }
            },
            "args": [],
            "expr": {
              "op": "floor",
              "args": [
                {
                  "op": "/",
                  "args": [
                    {
                      "op": "index",
                      "args": [
                        "src_lat",
                        "i"
                      ]
                    },
                    "dy"
                  ]
                }
              ]
            }
          }
        },
        {
          "_comment": "Component 1 of the former `tgt_bin` bin key: an integer join column.",
          "lhs": {
            "op": "index",
            "args": [
              "tgt_bin_c1",
              "j"
            ]
          },
          "rhs": {
            "op": "faq",
            "semiring": "sum_product",
            "output_idx": [
              "j"
            ],
            "ranges": {
              "j": {
                "from": "tgt_cells"
              }
            },
            "args": [],
            "expr": {
              "op": "floor",
              "args": [
                {
                  "op": "/",
                  "args": [
                    {
                      "op": "index",
                      "args": [
                        "tgt_lon",
                        "j"
                      ]
                    },
                    "dx"
                  ]
                }
              ]
            }
          }
        },
        {
          "_comment": "Component 2 of the former `tgt_bin` bin key: an integer join column.",
          "lhs": {
            "op": "index",
            "args": [
              "tgt_bin_c2",
              "j"
            ]
          },
          "rhs": {
            "op": "faq",
            "semiring": "sum_product",
            "output_idx": [
              "j"
            ],
            "ranges": {
              "j": {
                "from": "tgt_cells"
              }
            },
            "args": [],
            "expr": {
              "op": "floor",
              "args": [
                {
                  "op": "/",
                  "args": [
                    {
                      "op": "index",
                      "args": [
                        "tgt_lat",
                        "j"
                      ]
                    },
                    "dy"
                  ]
                }
              ]
            }
          }
        },
        {
          "_comment": "Candidate overlap-pair set = the bin-Skolem EQUI-join: the index-set-producing faq (bool_and_or, distinct:true) ranges source i and target j, the M2 `join.on` keeps only (i,j) whose bin keys are EQUAL (join on [src_bin, tgt_bin]), and skolem(\"pair\", i, j) names each surviving candidate. The `true` body marks membership. This is the landed M2 equi-join reused on integer bin keys (§5.8.5) — no spatial-index op in the IR; the index is a physical-operator/planner concern (a non-goal here). (Template rewrite: see tests/conformance/relational_templates/rewrites/.)",
          "lhs": {
            "op": "index",
            "args": [
              "pair_exists",
              "p"
            ]
          },
          "rhs": {
            "op": "faq",
            "id": "candidate_set",
            "semiring": "bool_and_or",
            "distinct": true,
            "output_idx": [
              "p"
            ],
            "ranges": {
              "i": {
                "from": "src_cells"
              },
              "j": {
                "from": "tgt_cells"
              }
            },
            "join": [
              {
                "on": [
                  [
                    "src_bin_c1",
                    "tgt_bin_c1"
                  ],
                  [
                    "src_bin_c2",
                    "tgt_bin_c2"
                  ]
                ]
              }
            ],
            "args": [
              "src_bin_c1",
              "src_bin_c2",
              "tgt_bin_c1",
              "tgt_bin_c2"
            ],
            "key": {
              "op": "apply_expression_template",
              "args": [],
              "name": "pair_key",
              "bindings": {
                "a": "i",
                "b": "j",
                "lo_a": 1,
                "lo_b": 1,
                "n_a": 4,
                "n_b": 4
              }
            },
            "expr": {
              "op": "true",
              "args": []
            }
          }
        }
      ]
    }
  }
}
