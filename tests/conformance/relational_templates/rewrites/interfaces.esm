          "lhs": {
            "op": "index",
            "args": [
              "rg_tgt_bin_c1",
              "l"
            ]
          },
          "rhs": {
            "op": "faq",
            "semiring": "sum_product",
            "output_idx": [
              "l"
            ],
            "ranges": {
              "l": {
                "from": "lower_cells"
              }
            },
            "args": [],
            "expr": {
              "op": "floor",
              "args": [
                {
                  "op": "/",
                  "args": [
                    {
                      "op": "index",
                      "args": [
                        "rg_tgt_lon",
                        "l"
                      ]
                    },
