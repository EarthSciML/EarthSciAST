                  ]
                }
              ]
            }
          }
        },
        {
          "_comment": "Component 2 of the former `rg_tgt_bin` bin key: an integer join column.",
          "lhs": {
            "op": "index",
            "args": [
              "rg_tgt_bin_c2",
              "l"
            ]
          },
          "rhs": {
            "op": "faq",
            "semiring": "sum_product",
            "output_idx": [
