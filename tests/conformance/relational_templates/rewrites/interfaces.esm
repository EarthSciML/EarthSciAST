  "coupling": [
    {
      "type": "variable_map",
      "from": "UpperAtmosphere.O3_field",
      "to": "LowerAtmosphere.O3_strat",
      "transform": "param_to_var",
      "lifting": "pointwise",
      "description": "Spatially-varying stratospheric ozone field supplied to the lower atmosphere on the 3-cell upper grid; LowerAtmosphere regrids it onto the 4-cell troposphere (O3_boundary) via the inline conservative overlap weights across the tropopause."
    },
    {
      "type": "variable_map",
      "from": "LowerAtmosphere.q",
      "to": "LandSurface.atm_precip",
      "transform": "conversion_factor",
      "factor": 0.001,
      "lifting": "mean",
      "description": "Tropospheric humidity reduced (mean) from the spatial grid to the 0-D land surface as precipitation"
    }
  ]
