{
  "esm": "2.0.0",
  "metadata": {
    "name": "InterfaceDefinitions_template",
    "description": "Template rewrite of tests/coupling/interfaces.esm, with its value invention written with lib/relational.esm templates. LowerAtmosphere only: bin keys split into per-component join columns; the pair key is pair_key(u, l, 1, 1, 3, 4).",
    "authors": [
      "EarthSciML"
    ],
    "created": "2026-04-09T00:00:00Z",
    "tags": [
      "interfaces",
      "regridding",
      "cross-grid",
      "lifting",
      "migrated_to_v08"
    ]
  },
  "index_sets": {
    "upper_cells": {
      "kind": "interval",
      "size": 3
    },
    "lower_cells": {
      "kind": "interval",
      "size": 4
    },
    "rg_coord": {
      "kind": "interval",
      "size": 2
    },
    "rg_cell_verts": {
      "kind": "interval",
      "size": 4
    },
    "rg_candidate_pairs": {
      "kind": "derived",
      "from_faq": "rg_candidate_set"
    }
  },
  "models": {
    "UpperAtmosphere": {
      "variables": {
        "O3": {
          "type": "unknown",
          "units": "mol/mol",
          "default": 1e-07,
          "shape": [
            "upper_cells"
          ],
          "description": "Ozone mixing ratio on the stratospheric grid"
        },
        "T": {
          "type": "unknown",
          "units": "K",
          "default": 220.0,
          "shape": [
            "upper_cells"
          ],
          "description": "Temperature on the stratospheric grid"
        },
        "O3_field": {
          "type": "unknown",
          "shape": [
            "upper_cells"
          ],
          "description": "SPATIALLY-VARYING stratospheric ozone field on the 3-cell stratospheric grid (non-uniform on purpose). Coupled onto LowerAtmosphere.O3_strat and regridded onto the troposphere across the tropopause."
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "ic",
            "args": [
              "O3"
            ]
          },
          "rhs": 1e-07
        },
        {
          "lhs": {
            "op": "ic",
            "args": [
              "T"
            ]
          },
          "rhs": {
            "op": "const",
            "args": [],
            "value": 220.0,
            "units": "K"
          }
        },
        {
          "lhs": {
            "op": "D",
            "args": [
              "O3"
            ],
            "wrt": "t"
          },
          "rhs": 0.0
        },
        {
          "lhs": {
            "op": "D",
            "args": [
              "T"
            ],
            "wrt": "t"
          },
          "rhs": 0.0
        },
        {
          "lhs": "O3_field",
          "rhs": {
            "op": "const",
            "value": [
              5e-08,
              6e-08,
              7e-08
            ],
            "args": []
          }
        }
      ]
    },
    "LowerAtmosphere": {
      "expression_template_imports": [
        {
          "ref": "esm:std/relational.esm"
        },
        {
          "ref": "esm:std/geometry.esm",
          "only": [
            "overlap_area_planar"
          ]
        }
      ],
      "variables": {
        "T": {
          "type": "unknown",
          "units": "K",
          "default": 288.0,
          "shape": [
            "lower_cells"
          ],
          "description": "Temperature on the tropospheric grid"
        },
        "q": {
          "type": "unknown",
          "units": "kg/kg",
          "default": 0.01,
          "shape": [
            "lower_cells"
          ],
          "description": "Specific humidity on the tropospheric grid"
        },
        "O3": {
          "type": "unknown",
          "units": "mol/mol",
          "default": 4e-08,
          "shape": [
            "lower_cells"
          ],
          "description": "Tropospheric ozone on the lower-atmosphere grid; relaxed toward the regridded stratospheric boundary O3_boundary (stratosphere-troposphere exchange across the tropopause)"
        },
        "tropopause_relax": {
          "type": "parameter",
          "units": "1/s",
          "default": 1e-06,
          "description": "Relaxation rate of tropospheric ozone toward the regridded stratospheric ozone boundary"
        },
        "O3_strat": {
          "type": "parameter",
          "units": "mol/mol",
          "default": 5e-08,
          "shape": [
            "upper_cells"
          ],
          "description": "Stratospheric ozone sampled on the 3-cell upper-atmosphere grid (a SPATIALLY-VARYING field from UpperAtmosphere), regridded onto the 4-cell troposphere by the inline conservative weights below."
        },
        "rg_src_poly": {
          "type": "unknown",
          "shape": [
            "upper_cells",
            "rg_cell_verts",
            "rg_coord"
          ],
          "description": "In-file SOURCE-grid geometry: one closed lon-lat vertex ring per source cell (the 3-cell stratospheric grid). The `poly_a` operand of the ranged clip — the weights are computed FROM this geometry, not supplied."
        },
        "rg_tgt_poly": {
          "type": "unknown",
          "shape": [
            "lower_cells",
            "rg_cell_verts",
            "rg_coord"
          ],
          "description": "In-file TARGET-grid geometry: one closed lon-lat vertex ring per target cell (the 4-cell tropospheric grid). A GENUINELY DIFFERENT grid (distinct cell count and vertex rings) tiling the same domain, so the overlaps are fractional."
        },
        "rg_src_lon": {
          "type": "unknown",
          "shape": [
            "upper_cells"
          ],
          "description": "Source-cell representative longitude (bbox-min) — enters only the integer binning via floor, never a raw join comparison."
        },
        "rg_src_lat": {
          "type": "unknown",
          "shape": [
            "upper_cells"
          ],
          "description": "Source-cell representative latitude for binning."
        },
        "rg_tgt_lon": {
          "type": "unknown",
          "shape": [
            "lower_cells"
          ],
          "description": "Target-cell representative longitude for binning."
        },
        "rg_tgt_lat": {
          "type": "unknown",
          "shape": [
            "lower_cells"
          ],
          "description": "Target-cell representative latitude for binning."
        },
        "rg_dx": {
          "type": "parameter",
          "shape": [],
          "description": "Broad-phase bin width (integer quantization step).",
          "default": 2.0
        },
        "rg_dy": {
          "type": "parameter",
          "shape": [],
          "description": "Broad-phase bin height.",
          "default": 2.0
        },
        "rg_atol": {
          "type": "parameter",
          "shape": [],
          "description": "Sliver floor: an overlap area at or below atol is dropped.",
          "default": 1e-12
        },
        "rg_pairs": {
          "type": "unknown",
          "shape": [
            "rg_candidate_pairs"
          ],
          "description": "Membership over the bin-key candidate overlap-pair set (broad phase), materialized as the derived rg_candidate_pairs index set via from_faq:\"rg_candidate_set\"."
        },
        "rg_A": {
          "type": "unknown",
          "shape": [
            "upper_cells",
            "lower_cells"
          ],
          "description": "NARROW PHASE (densely evaluable): overlap-area matrix A[u,l] = the `overlap_area_planar` template of esm:std/geometry.esm applied to rg_src_poly[u] and rg_tgt_poly[l], computed INLINE from the in-file geometry, ranged over the SAME bin-key candidate pairs (join.on [[rg_src_bin,rg_tgt_bin]]) as the row-sum / apply. the template returns the SCALAR overlap area (its body clips one convex ring against the other and takes the shoelace area) with no intersection ring in the document, so this is a DENSE faq over the candidate set with NO ragged intermediate. The weights are computed from cell geometry, not supplied."
        },
        "rg_At": {
          "type": "unknown",
          "shape": [
            "lower_cells"
          ],
          "description": "Target-cell area denominator A_j = Σ_i A_ij over the bin-key candidate pairs (join.on [[rg_src_bin,rg_tgt_bin]]) with the sliver filter — the row-sum normalization, computed from geometry, not supplied."
        },
        "rg_W": {
          "type": "unknown",
          "shape": [
            "upper_cells",
            "lower_cells"
          ],
          "description": "The conservative regrid weights W_ij = A_ij/A_j over the candidate pairs. Partition-of-unity Σ_i W_ij = 1 by construction (denominator is the row-sum of the same areas)."
        },
        "O3_boundary": {
          "type": "unknown",
          "shape": [
            "lower_cells"
          ],
          "description": "Ozone boundary value on the tropospheric grid, regridded from the stratosphere via the INLINE conservative weights: O3_boundary[l] = Σ_u W[u,l]·O3_strat[u], W = A/A_l from cell geometry (the old tropopause interface as a real overlap-weighted regrid)."
        },
        "rg_src_bin_c1": {
          "type": "unknown",
          "shape": [
            "upper_cells"
          ],
          "description": "Component 1 of the bin key formerly `rg_src_bin` (an integer join column)."
        },
        "rg_src_bin_c2": {
          "type": "unknown",
          "shape": [
            "upper_cells"
          ],
          "description": "Component 2 of the bin key formerly `rg_src_bin` (an integer join column)."
        },
        "rg_tgt_bin_c1": {
          "type": "unknown",
          "shape": [
            "lower_cells"
          ],
          "description": "Component 1 of the bin key formerly `rg_tgt_bin` (an integer join column)."
        },
        "rg_tgt_bin_c2": {
          "type": "unknown",
          "shape": [
            "lower_cells"
          ],
          "description": "Component 2 of the bin key formerly `rg_tgt_bin` (an integer join column)."
        }
      },
      "equations": [
        {
          "_comment": "Component 1 of the former `rg_src_bin` bin key: an integer join column.",
          "lhs": {
            "op": "index",
            "args": [
              "rg_src_bin_c1",
              "u"
            ]
          },
          "rhs": {
            "op": "faq",
            "semiring": "sum_product",
            "output_idx": [
