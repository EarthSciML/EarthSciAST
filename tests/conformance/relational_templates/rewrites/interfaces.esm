                "from": "lower_cells"
              }
            },
            "args": [],
            "expr": {
              "op": "floor",
              "args": [
                {
                  "op": "/",
                  "args": [
                    {
                      "op": "index",
                      "args": [
                        "rg_tgt_lat",
                        "l"
                      ]
                    },
                    "rg_dy"
                  ]
                }
              ]
            }
          }
        },
        {
          "_comment": "BROAD PHASE (1c): candidate overlap-pair set = the bin-key equi-join (distinct bool_and_or): keep (i,j) whose bin keys are EQUAL. (Template rewrite: see tests/conformance/relational_templates/rewrites/.)",
          "lhs": {
            "op": "index",
            "args": [
              "rg_pairs",
              "p"
            ]
          },
          "rhs": {
            "op": "faq",
            "semiring": "bool_and_or",
            "output_idx": [
              "p"
            ],
            "ranges": {
              "u": {
                "from": "upper_cells"
              },
              "l": {
                "from": "lower_cells"
              }
            },
            "id": "rg_candidate_set",
            "distinct": true,
            "join": [
