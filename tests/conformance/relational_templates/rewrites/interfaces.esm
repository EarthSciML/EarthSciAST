            ],
            "key": {
              "op": "apply_expression_template",
              "args": [],
              "name": "pair_key",
              "bindings": {
                "a": "u",
                "b": "l",
                "lo_a": 1,
                "lo_b": 1,
                "n_a": 3,
                "n_b": 4
              }
            },
            "args": [],
            "expr": {
              "op": "true",
              "args": []
            }
          }
        },
