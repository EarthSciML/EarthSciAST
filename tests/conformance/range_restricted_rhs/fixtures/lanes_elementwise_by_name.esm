          "description": "Shape-less: 2 B + C, on [lat, lon] by inference."
        },
        "E": {
          "type": "unknown",
          "units": "1",
          "description": "Shape-less: on [lon, lat] by inference, the union of its operands' sets in order of first appearance."
        },
        "k": {
