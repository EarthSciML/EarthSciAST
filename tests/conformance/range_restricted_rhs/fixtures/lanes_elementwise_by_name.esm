{
  "esm": "2.0.0",
  "metadata": {
    "name": "lanes_elementwise_by_name",
    "description": "Observeds declared with no shape, defined by bare elementwise expressions over arrays whose axes come in different orders (esm-spec \u00a74.3.4: an undeclared result spans the union of its operands' index sets and every operand aligns by index-set name). B is on [lat, lon], transposed against the state A on [lon, lat]; C on [lat] is a subset on the result's trailing axis; F = cos(t) B is shape-less over a transposed operand; H = 2 B + C is shape-less with C on its leading axis; E = cos(t) A + F + k A A + C + H reads the shape-less F and H and the state. The state equation reads E at each cell. The whole-domain program and a lane program (at one time and at a time per lane) give the same values.",
    "authors": [
      "EarthSciAST test suite"
    ],
    "created": "2026-11-27T00:00:00Z",
    "tags": [
      "conformance",
      "range_restricted_rhs"
    ]
  },
  "index_sets": {
    "lon": {
      "kind": "interval",
      "size": 4
    },
    "lat": {
      "kind": "interval",
      "size": 3
    }
  },
  "models": {
