      "variables": {
        "A": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "lon",
            "lat"
          ],
          "default": 1.0,
          "description": "The state."
        },
        "B": {
          "type": "unknown",
          "units": "1",
          "description": "A state-free observed on [lat, lon], transposed against A.",
          "shape": [
