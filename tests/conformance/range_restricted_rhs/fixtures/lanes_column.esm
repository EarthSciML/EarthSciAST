{
  "esm": "1.2.0",
  "metadata": {
    "name": "lanes_column",
    "description": "A column operator on a 5 x 4 x 6 grid: vertical mixing and settling of c along lev with a surface region (k = 1) carrying a source scaled by the cosine of an index-derived latitude, and a top region (k = 6); d is fed pointwise by c. Every read stays in its own column, so the operator's locality is column.",
    "authors": [
      "EarthSciAST test suite"
    ],
    "created": "2026-10-24T00:00:00Z",
    "tags": [
      "conformance",
      "range_restricted_rhs"
    ]
  },
