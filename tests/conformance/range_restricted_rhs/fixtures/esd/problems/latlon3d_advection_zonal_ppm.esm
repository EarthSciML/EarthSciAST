                      "k"
                    ],
                    "args": [],
                    "ranges": {
                      "i": {
                        "from": "lon"
                      },
                      "j": {
                        "from": "lat"
                      },
                      "k": {
                        "from": "lev"
                      }
                    },
                    "expr": {
                      "op": "cos",
                      "args": [
                        {
                          "op": "*",
                          "args": [
                            {
                              "op": "/",
                              "args": [
                                3.141592653589793,
                                180
                              ]
                            },
                            {
                              "op": "+",
                              "args": [
                                -90,
                                {
                                  "op": "*",
