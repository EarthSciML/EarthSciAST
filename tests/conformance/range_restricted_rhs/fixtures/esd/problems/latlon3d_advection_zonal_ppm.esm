            {
              "variable": "u",
              "time": 0.5,
              "expected": 0.0,
              "tolerance": {
                "abs": 0.05
              },
              "reduce": "L2_error",
              "reference": {
                "op": "*",
                "args": [
                  {
                    "op": "faq",
                    "output_idx": [
                      "i",
                      "j",
                      "k"
                    ],
                    "args": [],
                    "ranges": {
                      "i": {
