                      "op": "*",
                      "args": [
                        "dlon_deg",
                        {
                          "op": "/",
                          "args": [
                            3.141592653589793,
                            180
                          ]
                        }
                      ]
                    },
                    {
                      "op": "index",
                      "args": [
                        "dS_lat",
                        "j"
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "op": "-",
              "args": [
                {
                  "op": "apply_expression_template",
                  "args": [],
                  "name": "ppmflux_lev_face_flux",
                  "bindings": {
                    "aL2": {
                      "op": "index",
                      "args": [
                        "q",
                        {
                          "op": "-",
                          "args": [
                            "NLON",
                            2
                          ]
                        },
                        "j",
                        "k"
                      ]
                    },
                    "aL1": {
                      "op": "index",
                      "args": [
                        "q",
                        {
                          "op": "-",
                          "args": [
                            "NLON",
                            1
                          ]
                        },
                        "j",
                        "k"
                      ]
                    },
                    "aC": {
                      "op": "index",
                      "args": [
                        "q",
                        "NLON",
                        "j",
                        "k"
                      ]
                    },
                    "aRc": {
                      "op": "index",
                      "args": [
                        "qbc_e",
                        "j",
                        "k"
                      ]
                    },
                    "aR1": {
                      "op": "index",
                      "args": [
                        "qbc_e",
                        "j",
                        "k"
                      ]
                    },
                    "aR2": {
                      "op": "index",
                      "args": [
                        "qbc_e",
                        "j",
                        "k"
                      ]
                    },
                    "dL2": "dlon_deg",
                    "dL1": "dlon_deg",
                    "dC": "dlon_deg",
                    "dRc": "dlon_deg",
                    "dR1": "dlon_deg",
                    "dR2": "dlon_deg",
                    "w": {
                      "op": "index",
                      "args": [
                        "U",
                        {
                          "op": "+",
                          "args": [
                            "NLON",
                            1
                          ]
                        },
                        "j",
                        "k"
                      ]
                    }
                  }
                },
                {
                  "op": "apply_expression_template",
                  "args": [],
                  "name": "ppmflux_lev_face_flux",
                  "bindings": {
                    "aL2": {
                      "op": "index",
                      "args": [
                        "q",
                        {
                          "op": "-",
                          "args": [
                            "NLON",
                            3
                          ]
                        },
                        "j",
                        "k"
                      ]
                    },
                    "aL1": {
                      "op": "index",
                      "args": [
                        "q",
                        {
                          "op": "-",
                          "args": [
                            "NLON",
                            2
                          ]
                        },
                        "j",
                        "k"
                      ]
                    },
                    "aC": {
                      "op": "index",
                      "args": [
                        "q",
                        {
                          "op": "-",
                          "args": [
                            "NLON",
                            1
                          ]
                        },
                        "j",
                        "k"
                      ]
                    },
                    "aRc": {
                      "op": "index",
                      "args": [
                        "q",
                        "NLON",
                        "j",
                        "k"
                      ]
                    },
                    "aR1": {
                      "op": "index",
                      "args": [
                        "qbc_e",
                        "j",
                        "k"
                      ]
                    },
                    "aR2": {
                      "op": "index",
                      "args": [
                        "qbc_e",
                        "j",
                        "k"
                      ]
                    },
                    "dL2": "dlon_deg",
                    "dL1": "dlon_deg",
                    "dC": "dlon_deg",
                    "dRc": "dlon_deg",
                    "dR1": "dlon_deg",
                    "dR2": "dlon_deg",
                    "w": {
                      "op": "index",
                      "args": [
