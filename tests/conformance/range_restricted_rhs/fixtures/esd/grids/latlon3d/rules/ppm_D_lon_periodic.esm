            "lat",
            "lev"
          ]
        }
      },
      "body": {
        "op": "makearray",
        "args": [],
        "regions": [
          [
            [
              4,
              {
                "op": "-",
                "args": [
                  "NLON",
                  2
                ]
              }
            ],
            [
              1,
              "NLAT"
            ],
            [
              1,
              "NLEV"
            ]
          ],
          [
