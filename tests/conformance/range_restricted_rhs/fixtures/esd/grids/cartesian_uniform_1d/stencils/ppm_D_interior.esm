{
  "esm": "1.2.0",
  "metadata": {
    "name": "ppm_D_interior",
    "description": "Interior conservative finite-volume PPM flux-difference for u_x on cartesian_uniform_1d: D u[i] = (F_{i+1/2} - F_{i-1/2})/dx over i in [4, N-2], with F the semi-discrete PPM upwind face flux (stencils/ppm_flux.esm). F_{i+1/2}=ppm_flux(u[i-2..i+2]) and F_{i-1/2}=ppm_flux(u[i-3..i+1]) share the interface cell reconstruction, so the same float face flux is added in cell i and subtracted in cell i+1 -> the divergence telescopes and mass is conserved to the bit. The interior touches u[i-3..i+2] (6 cells); the three left faces i=1,2,3 and two right faces i=N-1,N (which reach outside [1,N]) are supplied by the periodic wrap in rules/ppm_D_periodic.esm. Nominal 3rd-order (parabolic) reconstruction; the unlimited flux-difference reduces algebraically to the standard 4th-order central first derivative, and the Colella-Woodward limiter clips only near extrema. `dx` is the grid's consumer-supplied free name (grids/cartesian_uniform_1d/grid.esm). Match-less; wrapped into the complete rule by rules/ppm_D_periodic.esm.",
    "license": "MIT",
    "tags": [
      "esd:stencil",
      "family:finite_volume",
      "grid:cartesian_uniform_1d",
      "op:D",
      "order:3",
      "stencil_width:6"
    ],
    "references": [
      {
        "citation": "Colella, P., & Woodward, P. R. (1984). The Piecewise Parabolic Method (PPM) for gas-dynamical simulations. Journal of Computational Physics, 54(1), 174-201.",
        "doi": "10.1016/0021-9991(84)90143-8"
      }
    ]
  },
  "expression_template_imports": [
    {
      "ref": "../grid.esm"
    },
    {
      "ref": "./ppm_flux.esm"
    }
  ],
  "expression_templates": {
    "ppm_D_interior": {
      "params": [
        "f"
      ],
      "description": "interior (F_{i+1/2}-F_{i-1/2})/dx over [4,N-2]",
      "body": {
        "op": "faq",
        "output_idx": [
          "i"
        ],
        "args": [
          "f"
        ],
        "ranges": {
          "i": [
            4,
            {
              "op": "-",
              "args": [
                "N",
                2
              ]
            }
          ]
        },
        "expr": {
          "op": "/",
          "args": [
            {
              "op": "-",
              "args": [
                {
                  "op": "apply_expression_template",
                  "args": [],
                  "name": "ppm_flux",
                  "bindings": {
                    "um2": {
                      "op": "index",
                      "args": [
                        "f",
                        {
                          "op": "-",
                          "args": [
                            "i",
                            2
                          ]
                        }
                      ]
                    },
                    "um1": {
                      "op": "index",
                      "args": [
                        "f",
                        {
                          "op": "-",
                          "args": [
                            "i",
                            1
                          ]
                        }
                      ]
                    },
                    "u0": {
                      "op": "index",
                      "args": [
                        "f",
                        "i"
                      ]
                    },
                    "up1": {
                      "op": "index",
                      "args": [
                        "f",
                        {
                          "op": "+",
                          "args": [
                            "i",
                            1
                          ]
                        }
                      ]
                    },
                    "up2": {
                      "op": "index",
                      "args": [
                        "f",
                        {
                          "op": "+",
                          "args": [
                            "i",
                            2
                          ]
                        }
                      ]
                    }
                  }
                },
                {
                  "op": "apply_expression_template",
                  "args": [],
                  "name": "ppm_flux",
                  "bindings": {
                    "um2": {
                      "op": "index",
                      "args": [
                        "f",
                        {
                          "op": "-",
                          "args": [
                            "i",
                            3
                          ]
                        }
                      ]
                    },
                    "um1": {
                      "op": "index",
                      "args": [
                        "f",
                        {
                          "op": "-",
                          "args": [
                            "i",
                            2
                          ]
                        }
                      ]
                    },
                    "u0": {
                      "op": "index",
                      "args": [
                        "f",
                        {
                          "op": "-",
                          "args": [
                            "i",
                            1
                          ]
                        }
                      ]
                    },
                    "up1": {
                      "op": "index",
                      "args": [
                        "f",
                        "i"
                      ]
                    },
                    "up2": {
                      "op": "index",
                      "args": [
                        "f",
                        {
                          "op": "+",
                          "args": [
                            "i",
                            1
                          ]
                        }
                      ]
                    }
                  }
                }
              ]
            },
            "dx"
          ]
        }
      }
    }
  }
}
