{
  "esm": "1.2.0",
  "metadata": {
    "name": "selection_two_operator",
    "description": "Two operators and a coupling entry on 10 cells. Chem is 0-D O3/NO2 chemistry; coupling entry 0 (a `couple` additive connector) adds Emis.e * Chem.O3 to D(Chem.NO2), origin {\"coupling\": 0}; entry 1 composes Chem with the upwind advection operator Adv and lifts it pointwise onto x. D(Chem.O3) carries contributions from Chem and Adv; D(Chem.NO2) from Chem, coupling 0 and Adv. Selecting the coupling term alone writes only NO2 and reads O3 as aux.",
    "authors": [
      "EarthSciAST test suite"
    ],
    "created": "2026-10-24T00:00:00Z",
    "tags": [
      "conformance",
      "range_restricted_rhs"
    ]
  },
