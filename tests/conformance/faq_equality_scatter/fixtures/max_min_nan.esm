{
 "esm": "1.2.0",
 "metadata": {
  "name": "faq_equality_scatter_max_min_nan",
  "description": "`max` and `min` with a NaN after a number in one cell, a NaN first in another, one at a point no cell admits, and an all-empty `max`. The reductions are observeds read by the right-hand side, which reports NaN as -1 and -Inf as -2 so every derivative is finite. A NaN term propagates wherever it is in the window (esm-spec §4.2). Generated by generate.py beside this file; esm-spec §4.3.1, one-pass scatter for an equality filter.",
  "authors": [
   "EarthSciML Authors and Contributors"
  ],
  "tags": [
   "native",
   "conformance",
   "faq",
   "equality-scatter"
  ]
 },
 "index_sets": {
  "n2": {
   "kind": "interval",
   "size": 2
  },
  "n3": {
   "kind": "interval",
   "size": 3
  },
  "ns": {
   "kind": "interval",
   "size": 24
  }
 },
