  "Scatter": {
   "variables": {
    "s": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "ns"
     ],
     "default": 1.0,
     "description": "A source state held constant (D(s) = 0) at 1, so every body reads a state and the scatter runs on the right-hand side."
    },
    "MX": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "n3"
     ],
     "description": "max_{i : j == floor((i-1)/4)+1} num[i]/den[i] s[i] over i = 1..16, j = 1..3: cell 1 holds numbers only, cell 2 a NaN after a number (i = 6), cell 3 a NaN first (i = 9); the NaN at i = 14 maps to j = 4, outside j's range, and must reach no cell."
    },
    "dmx": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "n3"
     ],
     "default": 0.0,
     "description": "D(dmx[j]) = MX[j], with NaN reported as -1 and -Inf as -2."
    },
    "MN": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "n3"
     ],
     "description": "min_{i : j == floor((i-1)/4)+1} num[i]/den[i] s[i] over i = 1..16, j = 1..3: cell 1 holds numbers only, cell 2 a NaN after a number (i = 6), cell 3 a NaN first (i = 9); the NaN at i = 14 maps to j = 4, outside j's range, and must reach no cell."
    },
    "dmn": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "n3"
     ],
     "default": 0.0,
     "description": "D(dmn[j]) = MN[j], with NaN reported as -1 and -Inf as -2."
    },
    "ME": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "n2"
     ],
     "description": "max over a filter that admits nothing (j == i + 5, i = 1..3, j = 1..2): every cell is the max identity, -Inf."
    },
    "dme": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "n2"
     ],
     "default": 0.0,
     "description": "D(dme[j]) = ME[j], with NaN reported as -1 and -Inf as -2."
    }
   },
