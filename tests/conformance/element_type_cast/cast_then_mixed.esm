{
  "esm": "1.2.0",
  "metadata": {
    "name": "element_type_cast_then_mixed",
    "description": "A cast's result carries the cast's precision, so adding it to a binary64 operand is still a mix: mixed_element_type."
  },
  "models": {
    "Mix": {
      "variables": {
        "x": {
          "type": "parameter",
          "units": "1",
          "default": 0.1,
          "description": "A binary64 value."
        },
        "z": {
          "type": "parameter",
          "units": "1",
          "default": 1.0,
          "description": "Another binary64 value."
        },
        "y": {
          "type": "unknown",
          "units": "1",
          "description": "cast(x, Float32) + z: refused."
        }
      },
      "equations": [
        {
          "lhs": "y",
          "rhs": {
            "op": "+",
            "args": [
              {
                "op": "cast",
                "element_type": "Float32",
                "args": [
                  "x"
                ]
              },
              "z"
            ]
          }
        }
      ]
    }
  }
}
