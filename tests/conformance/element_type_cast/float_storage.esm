{
  "esm": "1.2.0",
  "metadata": {
    "name": "element_type_cast_float_storage",
    "description": "A binary64 document that rounds one value through binary32 storage and continues in binary64: cast(cast(x, Float32), Float64), the value a FLOAT column holds when it is read back (esm-spec §11.3.1). No variable declares an element_type; the casts are the declaration."
  },
  "models": {
    "Store": {
      "variables": {
        "x": {
          "type": "parameter",
          "units": "1",
          "default": 0.1,
          "description": "A binary64 share."
        },
        "stored": {
          "type": "unknown",
          "units": "1",
          "description": "cast(cast(x, Float32), Float64): 0.10000000149011612, binary32's nearest to 0.1, widened exactly."
        },
        "residual": {
          "type": "unknown",
          "units": "1",
          "description": "1 - stored, in binary64: 0.8999999985098839."
        },
        "n": {
          "type": "parameter",
          "units": "1",
          "default": 16777217.0,
          "description": "2^24 + 1: exact in binary64, not representable in binary32."
        },
        "excess": {
          "type": "unknown",
          "units": "1",
          "description": "cast(cast(n - 2^24, Float32), Float64): the subtraction runs in binary64, the operand's own precision, so 1. Evaluated in the cast's binary32 it would be 0, because n would narrow to 2^24 first."
        }
      },
      "equations": [
        {
          "lhs": "stored",
          "rhs": {
            "op": "cast",
            "element_type": "Float64",
            "args": [
              {
                "op": "cast",
                "element_type": "Float32",
                "args": [
                  "x"
                ]
              }
            ]
          }
        },
        {
          "lhs": "residual",
          "rhs": {
            "op": "-",
            "args": [
              1,
              "stored"
            ]
          }
        },
        {
          "lhs": "excess",
          "rhs": {
            "op": "cast",
            "element_type": "Float64",
            "args": [
              {
                "op": "cast",
                "element_type": "Float32",
                "args": [
                  {
                    "op": "-",
                    "args": [
                      "n",
                      16777216.0
                    ]
                  }
                ]
              }
            ]
          }
        }
      ],
      "tests": [
        {
          "id": "float_storage_round_trip",
          "time_span": {
            "start": 0.0,
            "end": 0.0
          },
          "assertions": [
            {
              "variable": "stored",
              "time": 0.0,
              "expected": 0.10000000149011612,
              "tolerance": {
                "rel": 0.0,
                "abs": 0.0
              }
            },
            {
              "variable": "residual",
              "time": 0.0,
              "expected": 0.8999999985098839,
              "tolerance": {
                "rel": 0.0,
                "abs": 0.0
              }
            },
            {
              "variable": "excess",
              "time": 0.0,
              "expected": 1.0,
              "tolerance": {
                "rel": 0.0,
                "abs": 0.0
              }
            }
          ]
        }
      ]
    }
  }
}
