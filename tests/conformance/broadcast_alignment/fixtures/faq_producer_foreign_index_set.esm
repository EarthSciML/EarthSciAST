{
  "esm": "2.3.0",
  "metadata": {
    "name": "FaqProducerForeignIndexSet",
    "description": "A `faq` over `{from: lon}` read under an elementwise operator in a result declared over [lat] only. A `faq` whose output indices range over index sets aligns by those names like a declared variable (esm-spec §4.3.4 rule 2), and `lon` is not among the result's index sets, so there is no axis to place it on: the build refuses with array_shape_mismatch. The assertions pin the LAUNDERED positional read (`z[i] = k * q[i]` over the first two `lon` cells), which a conforming binding never produces.",
    "authors": [
      "EarthSciML Authors and Contributors"
    ]
  },
  "index_sets": {
    "lat": {
      "kind": "interval",
      "size": 2
    },
    "lon": {
      "kind": "interval",
      "size": 3
    }
  },
  "models": {
    "FaqProducerForeignIndexSet": {
      "variables": {
        "q": {
          "type": "parameter",
          "units": "1",
          "shape": [
            "lon"
          ],
          "default": [
            1,
            2,
            3
          ]
        },
        "k": {
          "type": "parameter",
          "units": "1",
          "default": 2
        },
        "z": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "lat"
          ],
          "description": "Declared [lat]; k times a faq over lon, which has no axis here."
        }
      },
      "equations": [
        {
          "lhs": "z",
          "rhs": {
            "op": "*",
            "args": [
              "k",
              {
                "op": "faq",
                "args": [],
                "output_idx": [
                  "i"
                ],
                "ranges": {
                  "i": {
                    "from": "lon"
                  }
                },
                "expr": {
                  "op": "index",
                  "args": [
                    "q",
                    "i"
                  ]
                }
              }
            ]
          }
        }
      ],
      "tolerance": {
        "rel": 0,
        "abs": 1e-12
      },
      "tests": [
        {
          "id": "t",
          "time_span": {
            "start": 0,
            "end": 1
          },
          "assertions": [
            {
              "variable": "z[1]",
              "time": 0,
              "expected": 2
            },
            {
              "variable": "z[2]",
              "time": 0,
              "expected": 4
            }
          ]
        }
      ]
    }
  }
}
