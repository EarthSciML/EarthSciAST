{
  "esm": "1.1.0",
  "metadata": {
    "name": "observed_expression_aligned",
    "description": "esm-spec \u00a74.3.4 alignment reaches THROUGH an observed. `q` is a rank-3 OBSERVED whose body is the mixed-rank product w2 * z1 \u2014 w2 over [lon,lat], z1 over [lev] \u2014 and the state's equation reads the bare name `q`. The answer must be the same cell for cell as writing that product directly in the state's own equation: q[i,j,k] = (i + 10 j) * 100 k. A binding that aligns only the operands it finds in a STATE equation, and materializes an observed's body in its own declared layout without aligning it, disagrees everywhere off the leading lon column.",
    "authors": [
      "EarthSciAST Test Suite"
    ],
    "tags": [
      "array-level",
      "broadcast",
      "observed",
      "conformance",
      "esm-spec-4.3.4",
      "issue-100"
    ]
  },
  "index_sets": {
    "lon": {
      "kind": "interval",
      "size": 3
    },
    "lat": {
      "kind": "interval",
      "size": 2
    },
    "lev": {
      "kind": "interval",
      "size": 2
    }
  },
  "models": {
    "observed_expression_aligned": {
      "tolerance": {
        "rel": 1e-08,
        "abs": 1e-10
      },
      "variables": {
        "dp": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "lon",
            "lat",
            "lev"
          ],
          "default": 0.0,
          "description": "Reads the observed by bare name."
        },
        "q": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "lon",
            "lat",
            "lev"
          ],
          "description": "The mixed-rank product, as an OBSERVED."
        },
        "w2": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "lon",
            "lat"
          ],
          "description": "w2[i,j] = i + 10 j."
        },
        "z1": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "lev"
          ],
          "description": "z1[k] = 100 k, i.e. [100, 200]."
        }
      },
      "equations": [
        {
          "_comment": "D(dp)/dt = q, where q is the rank-3 observed below.",
          "lhs": {
            "op": "D",
            "args": [
              "dp"
            ],
            "wrt": "t"
          },
          "rhs": "q"
        },
        {
          "lhs": "q",
          "rhs": {
            "op": "*",
            "args": [
              "w2",
              "z1"
            ]
          }
        },
        {
          "lhs": "w2",
          "rhs": {
            "op": "faq",
            "args": [],
            "output_idx": [
              "i",
              "j"
            ],
            "ranges": {
              "i": {
                "from": "lon"
              },
              "j": {
                "from": "lat"
              }
            },
            "expr": {
              "op": "+",
              "args": [
                "i",
                {
                  "op": "*",
                  "args": [
                    10,
                    "j"
                  ]
                }
              ]
            }
          }
        },
        {
          "lhs": "z1",
          "rhs": {
            "op": "faq",
            "args": [],
            "output_idx": [
              "k"
            ],
            "ranges": {
              "k": {
                "from": "lev"
              }
            },
            "expr": {
              "op": "*",
              "args": [
                100,
                "k"
              ]
            }
          }
        }
      ],
      "tests": [
        {
          "id": "observed_expression_aligned_t1",
          "description": "The same eight probes `bare_mixed_rank_product` pins, read through an observed.",
          "time_span": {
            "start": 0.0,
            "end": 1.0
          },
          "assertions": [
            {
              "variable": "dp",
              "time": 1.0,
              "expected": 1100.0,
              "coords": {
                "lon": 1,
                "lat": 1,
                "lev": 1
              }
            },
            {
              "variable": "dp",
              "time": 1.0,
              "expected": 1300.0,
              "coords": {
                "lon": 3,
                "lat": 1,
                "lev": 1
              }
            },
            {
              "variable": "dp",
              "time": 1.0,
              "expected": 2100.0,
              "coords": {
                "lon": 1,
                "lat": 2,
                "lev": 1
              }
            },
            {
              "variable": "dp",
              "time": 1.0,
              "expected": 2300.0,
              "coords": {
                "lon": 3,
                "lat": 2,
                "lev": 1
              }
            },
            {
              "variable": "dp",
              "time": 1.0,
              "expected": 2200.0,
              "coords": {
                "lon": 1,
                "lat": 1,
                "lev": 2
              }
            },
            {
              "variable": "dp",
              "time": 1.0,
              "expected": 2600.0,
              "coords": {
                "lon": 3,
                "lat": 1,
                "lev": 2
              }
            },
            {
              "variable": "dp",
              "time": 1.0,
              "expected": 4400.0,
              "coords": {
                "lon": 2,
                "lat": 2,
                "lev": 2
              }
            },
            {
              "variable": "dp",
              "time": 1.0,
              "expected": 4600.0,
              "coords": {
                "lon": 3,
                "lat": 2,
                "lev": 2
              }
            }
          ]
        }
      ]
    }
  }
}
