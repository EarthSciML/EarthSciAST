{
  "esm": "2.3.0",
  "metadata": {
    "name": "FaqWholeRhsForeignIndexSet",
    "description": "The whole right-hand side is a `faq` over `{from: lon}`, and the result is declared over [lat] only. As for a nested producer (`faq_producer_foreign_index_set`), the faq aligns by the index sets it names (esm-spec §4.3.4 rule 2) and `lon` is not among the result's, so the build refuses with array_shape_mismatch. The assertions pin the LAUNDERED positional read (`z[i] = q[i]` over the first two `lon` cells), which a conforming binding never produces.",
    "authors": [
      "EarthSciML Authors and Contributors"
    ]
  },
  "index_sets": {
    "lat": {
      "kind": "interval",
      "size": 2
    },
    "lon": {
      "kind": "interval",
      "size": 3
    }
  },
  "models": {
    "FaqWholeRhsForeignIndexSet": {
      "variables": {
        "q": {
          "type": "parameter",
          "units": "1",
          "shape": [
            "lon"
          ],
          "default": [
            1,
            2,
            3
          ]
        },
        "z": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "lat"
          ],
          "description": "Declared [lat]; defined by a faq over lon, which has no axis here."
        }
      },
      "equations": [
        {
          "lhs": "z",
          "rhs": {
            "op": "faq",
            "args": [],
            "output_idx": [
              "i"
            ],
            "ranges": {
              "i": {
                "from": "lon"
              }
            },
            "expr": {
              "op": "index",
              "args": [
                "q",
                "i"
              ]
            }
          }
        }
      ],
      "tolerance": {
        "rel": 0,
        "abs": 1e-12
      },
      "tests": [
        {
          "id": "t",
          "time_span": {
            "start": 0,
            "end": 1
          },
          "assertions": [
            {
              "variable": "z[1]",
              "time": 0,
              "expected": 1
            },
            {
              "variable": "z[2]",
              "time": 0,
              "expected": 2
            }
          ]
        }
      ]
    }
  }
}
