{
  "esm": "2.3.0",
  "metadata": {
    "name": "StaticNamedBroadcast",
    "description": "Two shaped parameters have disjoint axis names and unequal extents. The bare elementwise expressions align them by name according to their declared result axes.",
    "authors": [
      "EarthSciML Authors and Contributors"
    ]
  },
  "index_sets": {
    "rows": {
      "kind": "interval",
      "size": 2
    },
    "cols": {
      "kind": "interval",
      "size": 3
    }
  },
  "models": {
    "StaticNamedBroadcast": {
      "variables": {
        "q": {
          "type": "parameter",
          "units": "1",
          "shape": [
            "rows"
          ],
          "default": [
            5,
            8
          ]
        },
        "c": {
          "type": "parameter",
          "units": "1",
          "shape": [
            "cols"
          ],
          "default": [
            3,
            10,
            20
          ]
        },
        "named": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "cols",
            "rows"
          ]
        },
        "product": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rows",
            "cols"
          ]
        }
      },
      "equations": [
        {
          "lhs": "named",
          "rhs": {
            "op": "+",
            "args": [
              "q",
              "c"
            ]
          }
        },
        {
          "lhs": "product",
          "rhs": {
            "op": "*",
            "args": [
              "q",
              "c"
            ]
          }
        }
      ],
      "tolerance": {
        "rel": 0,
        "abs": 1e-12
      },
      "tests": [
        {
          "id": "named_axes",
          "time_span": {
            "start": 0,
            "end": 1
          },
          "assertions": [
            {
              "variable": "named",
              "time": 0,
              "expected": 28,
              "coords": {
                "cols": 3,
                "rows": 2
              }
            },
            {
              "variable": "named",
              "time": 0,
              "expected": 8,
              "coords": {
                "cols": 1,
                "rows": 1
              }
            },
            {
              "variable": "product",
              "time": 0,
              "expected": 80,
              "coords": {
                "rows": 2,
                "cols": 2
              }
            }
          ]
        }
      ]
    }
  }
}
