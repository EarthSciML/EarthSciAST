{
  "category": "solver_time_span",
  "spec": "esm-spec §2.2.7",
  "design_note": "GitHub issue #550 (RFC U16, `solver.time_span`)",
  "bindings_required": [
    "julia",
    "typescript",
    "python",
    "rust",
    "go"
  ],
  "notes": "The SHARED pin for `solver.time_span` (CONFORMANCE_SPEC §5.48). Every binding's own test suite reads THIS file and asserts against it; there is no adapter and no golden. Each fixture is loaded by its path. For `expect: accepted` a binding asserts that `resolve_time_span(file)` with no call-site interval returns `seconds` EXACTLY (binary64 equality; every pinned value is exact), and that the root's `solver` block as `emit` writes it equals `solver` once both are parsed as JSON, numbers compared by value. For `expect: refused` the load MUST fail with `error_code`, and the message MUST contain every `message_contains` substring.",
  "fields": {
    "path": "The fixture, relative to this directory.",
    "expect": "`accepted` or `refused`.",
    "solver": "The root's `solver` block exactly as `emit` writes it, numbers compared by value (null: the emitted document has no `solver` key). A timestamp stays the authored string; a mounted leaf's block never reaches the root.",
    "seconds": "What the accessor returns with no call-site interval: `[start, end]` in binary64 seconds, or null for no interval.",
    "error_code": "For `expect: refused`: the diagnostic code the load MUST fail with.",
    "message_contains": "For `expect: refused`: substrings the diagnostic message MUST contain."
  },
  "fixtures": [
