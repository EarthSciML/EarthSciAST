{
  "esm": "1.3.0",
  "metadata": {
    "name": "SolverTimeSpan_leaf",
    "description": "A leaf whose `solver` block carries `time_span`. Its block does not cross a mount edge (esm-spec §2.2.7 'Mounting', §4.7).",
    "authors": [
      "EarthSciML Test Suite"
    ],
    "license": "MIT",
    "tags": [
      "solver",
      "time_span",
      "mount",
      "leaf"
    ]
  },
  "solver": {
    "stiffness": "low",
    "time_span": {
      "start": 0,
      "end": 99
    }
  },
  "models": {
    "LeafDecay": {
      "variables": {
        "A": {
          "type": "unknown",
          "units": "mol/m^3",
          "default": 2.0
        },
        "k": {
          "type": "parameter",
          "units": "1/s",
          "default": 0.5
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "A"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "neg",
            "args": [
              {
                "op": "*",
                "args": [
                  "k",
                  "A"
                ]
              }
            ]
          }
        }
      ]
    }
  }
}
