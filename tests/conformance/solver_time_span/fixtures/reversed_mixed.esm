{
  "esm": "1.3.0",
  "metadata": {
    "name": "SolverTimeSpan_reversed_mixed",
    "description": "A timestamp start one minute after the epoch and a number end of 30 s: only the conversion can see the interval is reversed, which is why this is a load-time check and not a schema rule.",
    "authors": [
      "EarthSciML Test Suite"
    ],
    "license": "MIT",
    "tags": [
      "solver",
      "time_span"
    ]
  },
  "solver": {
    "time_span": {
      "start": "1970-01-01T00:01:00Z",
      "end": 30
    }
  },
  "models": {
    "Decay": {
      "variables": {
        "A": {
          "type": "unknown",
          "units": "mol/m^3",
          "default": 2.0
        },
        "k": {
          "type": "parameter",
          "units": "1/s",
          "default": 0.5
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "A"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "neg",
            "args": [
              {
                "op": "*",
                "args": [
                  "k",
                  "A"
                ]
              }
            ]
          }
        }
      ]
    }
  }
}
