{
  "esm": "1.0.0",
  "metadata": {
    "name": "ClassificationSystemKindPde",
    "description": "Spatial derivatives do NOT determine system_kind (esm 2.4.0 dropped the `pde` kind; esm-spec §6.3.1): the derived kinds are `sde`, `nonlinear` and `ode`, in that order. `Transient` has a time derivative and a spatial `D` on its right-hand side and is `ode`. `SugarOps` (named for the `laplacian` sugar it once used) writes nested spatial `D` on two axes and is equally `ode`. `SteadyState` has NO time-derivative equation (`0 ~ D(D(phi, x), x) - f`) and is `nonlinear`. `StochasticSpatial` carries a wiener parameter and is `sde`. `DeclaredPde` declares the deprecated `system_kind: \"pde\"`: the document still loads, with one `deprecated_system_kind` warning naming /models/DeclaredPde/system_kind; the declared value is ignored (the declared-kind accessor reports none), the model is its derived kind `ode`, and no `system_kind_mismatch` is reported.",
    "authors": [
      "EarthSciAST"
    ],
    "created": "2026-08-19T00:00:00Z",
    "tags": [
      "classification",
      "system_kind",
      "pde",
      "esm-1.0.0"
    ]
  },
  "domain": {
    "independent_variable": "t",
    "temporal": {
      "start": "2024-01-01T00:00:00Z",
      "end": "2024-01-02T00:00:00Z"
    }
  },
  "models": {
    "Transient": {
      "variables": {
        "u": {
          "type": "unknown",
          "units": "1",
          "default": 1.0,
          "description": "Advected scalar."
        },
        "c": {
          "type": "parameter",
          "units": "m/s",
          "default": 1.0,
          "description": "Advection speed."
        }
      },
      "equations": [
        {
          "_comment": "D(u)/dt = -c * D(u)/dx -- a spatial D on the RHS does not change the system kind.",
          "lhs": {
            "op": "D",
            "args": [
              "u"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "*",
            "args": [
              {
                "op": "-",
                "args": [
                  "c"
                ]
              },
              {
                "op": "D",
                "args": [
                  "u"
                ],
                "wrt": "x"
              }
            ]
          }
        }
      ]
    },
    "SugarOps": {
      "variables": {
        "T": {
          "type": "unknown",
          "units": "K",
          "default": 300.0,
          "description": "Temperature."
        },
        "kappa": {
          "type": "parameter",
          "units": "m^2/s",
          "default": 1.0,
          "description": "Diffusivity."
        }
      },
      "equations": [
        {
          "_comment": "D(T)/dt = kappa * (D(D(T, x), x) + D(D(T, y), y)). The Laplacian as nested spatial D: the outer spatial D's argument is itself a spatial D, not a bare variable.",
          "lhs": {
            "op": "D",
            "args": [
              "T"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "*",
            "args": [
              "kappa",
              {
                "op": "+",
                "args": [
                  {
                    "op": "D",
                    "args": [
                      {
                        "op": "D",
                        "args": [
                          "T"
                        ],
                        "wrt": "x"
                      }
                    ],
                    "wrt": "x"
                  },
                  {
                    "op": "D",
                    "args": [
                      {
                        "op": "D",
                        "args": [
                          "T"
                        ],
                        "wrt": "y"
                      }
                    ],
                    "wrt": "y"
                  }
                ]
              }
            ]
          }
        }
      ]
    },
    "SteadyState": {
      "variables": {
        "phi": {
          "type": "unknown",
          "units": "1",
          "default": 0.0,
          "description": "Potential."
        },
        "f": {
          "type": "parameter",
          "units": "1/m^2",
          "default": 0.0,
          "description": "Source term."
        }
      },
      "equations": [
        {
          "_comment": "0 ~ D(D(phi, x), x) - f. No time derivative at all, so ORDER decides: pde is tested before nonlinear. The spatial D sits on the right-hand side; phi is named on no left-hand side, so it is an algebraic unknown.",
          "lhs": 0,
          "rhs": {
            "op": "-",
            "args": [
              {
                "op": "D",
                "args": [
                  {
                    "op": "D",
                    "args": [
                      "phi"
                    ],
                    "wrt": "x"
                  }
                ],
                "wrt": "x"
              },
              "f"
            ]
          }
        }
      ]
    },
    "StochasticSpatial": {
      "variables": {
        "v": {
          "type": "unknown",
          "units": "1",
          "default": 1.0,
          "description": "Spatially diffusing quantity, stochastically forced."
        },
        "kappa": {
          "type": "parameter",
          "units": "m^2/s",
          "default": 1.0,
          "description": "Diffusivity."
        },
        "xi": {
          "type": "parameter",
          "units": "1/s^0.5",
          "distribution": {
            "kind": "normal",
            "mean": 0.0,
            "std": 1.0
          },
          "update": {
            "kind": "wiener"
          },
          "description": "Driving noise. Its presence makes this sde DESPITE the spatial derivative."
        }
      },
      "equations": [
        {
          "_comment": "D(v)/dt = kappa * D(v, wrt=x) + xi * v. Both signals present; sde wins.",
          "lhs": {
            "op": "D",
            "args": [
              "v"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "+",
            "args": [
              {
                "op": "*",
                "args": [
                  "kappa",
                  {
                    "op": "D",
                    "args": [
                      "v"
                    ],
                    "wrt": "x"
                  }
                ]
              },
              {
                "op": "*",
                "args": [
                  "xi",
                  "v"
                ]
              }
            ]
          }
        }
      ]
    },
    "DeclaredPde": {
      "variables": {
        "u": {
          "type": "unknown",
          "units": "1",
          "default": 1.0,
          "description": "Advected scalar."
        },
        "c": {
          "type": "parameter",
          "units": "m/s",
          "default": 1.0,
          "description": "Advection speed."
        }
      },
      "equations": [
        {
          "_comment": "D(u)/dt = -c * D(u)/dx -- a spatial D on the RHS does not change the system kind.",
          "lhs": {
            "op": "D",
            "args": [
              "u"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "*",
            "args": [
              {
                "op": "-",
                "args": [
                  "c"
                ]
              },
              {
                "op": "D",
                "args": [
                  "u"
                ],
                "wrt": "x"
              }
            ]
          }
        }
      ],
      "system_kind": "pde"
    }
  }
}
