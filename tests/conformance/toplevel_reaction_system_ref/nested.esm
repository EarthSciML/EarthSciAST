{
 "esm": "1.0.0",
 "metadata": {
  "name": "nested",
  "description": "Mounts nested/mid.esm, which mounts ../leaf.esm: the inner {ref} resolves against nested/. Loads to the same document as basic_inline.esm.",
  "license": "MIT"
 },
 "models": {
  "Host": {
   "variables": {
    "y": {
     "type": "unknown",
     "units": "1",
     "default": 1.0,
     "description": "an inline model beside the mount"
    }
   },
   "equations": [
    {
     "lhs": {
      "op": "D",
      "args": [
       "y"
      ],
      "wrt": "t"
     },
     "rhs": {
      "op": "-",
      "args": [
       "y"
      ]
     }
    }
   ]
  }
 },
 "reaction_systems": {
  "Chem": {
   "ref": "./nested/mid.esm"
  }
 }
}
