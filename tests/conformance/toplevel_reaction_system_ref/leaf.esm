{
 "esm": "1.0.0",
 "metadata": {
  "name": "leaf",
  "description": "A single-reaction-system leaf (A -> B at rate k), mounted by reference.",
  "license": "MIT"
 },
 "reaction_systems": {
  "Chem": {
   "species": {
    "A": {
     "units": "mol/m^3",
     "default": 1.0,
     "description": "reactant"
    },
    "B": {
     "units": "mol/m^3",
     "default": 0.0,
     "description": "product"
    }
   },
   "parameters": {
    "k": {
     "units": "1/s",
     "default": 0.3,
     "description": "rate constant"
    }
   },
   "reactions": [
    {
     "id": "R1",
     "substrates": [
      {
       "species": "A",
       "stoichiometry": 1
      }
     ],
     "products": [
      {
       "species": "B",
       "stoichiometry": 1
      }
     ],
     "rate": "k"
    }
   ]
  }
 }
}
