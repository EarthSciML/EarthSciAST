{
 "esm": "1.0.0",
 "metadata": {
  "name": "basic",
  "description": "A top-level reaction_systems.<k> {ref} mount beside an inline model. Loads to the same document as basic_inline.esm.",
  "license": "MIT"
 },
 "models": {
  "Host": {
   "variables": {
    "y": {
     "type": "unknown",
     "units": "1",
     "default": 1.0,
     "description": "an inline model beside the mount"
    }
   },
   "equations": [
    {
     "lhs": {
      "op": "D",
      "args": [
       "y"
      ],
      "wrt": "t"
     },
     "rhs": {
      "op": "-",
      "args": [
       "y"
      ]
     }
    }
   ]
  }
 },
 "reaction_systems": {
  "Chem": {
   "ref": "./leaf.esm"
  }
 }
}
