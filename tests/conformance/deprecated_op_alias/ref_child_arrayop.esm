{
  "esm": "1.1.0",
  "metadata": {
    "name": "ref_child_arrayop",
    "description": "A REFERENCED child carrying the REMOVED `\"op\": \"arrayop\"` spelling. Loading the parent that mounts it MUST be rejected with `removed_op`. `arrayop` is a well-formed identifier, so without a by-name rejection at the child's wire boundary esm-spec \u00a74.2 admits it as an OPEN rewrite-target op: the document loads silently and fails much later as `unlowered_operator`, or never (docs/content/rfcs/faq-node-rename.md \u00a75.4).",
    "authors": [
      "EarthSciAST"
    ],
    "tags": [
      "faq",
      "deprecated_op_alias",
      "ref",
      "conformance"
    ]
  },
