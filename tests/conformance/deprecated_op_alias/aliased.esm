{
  "esm": "1.1.0",
  "metadata": {
    "name": "deprecated_op_alias",
    "description": "The `aggregate` -> `faq` deprecated-op-alias contract (esm 1.1.0, docs/content/rfcs/faq-node-rename.md). This document exists in two spellings that differ ONLY in the expression-node `op` tag: `aliased.esm` uses the DEPRECATED `aggregate`, `canonical.esm` the canonical `faq`. Everything else, metadata included, is identical, so `emit(load(aliased.esm))` must be byte-identical to `emit(load(canonical.esm))` \u2014 normalization happens once, at the wire boundary, and nothing downstream of the loader (`emit` included) ever sees the alias. Loading `aliased.esm` must also warn `deprecated_op_alias` exactly ONCE for the document, naming the node count (2), not once per node. The alias is REMOVED at esm 2.0.0.",
    "authors": [
      "EarthSciAST"
    ],
    "tags": [
      "faq",
      "deprecated_op_alias",
      "conformance"
    ]
  },
  "index_sets": {
    "faces": {
      "kind": "interval",
      "size": 8
    },
    "edges": {
      "kind": "derived",
      "from_faq": "edge_enum"
    }
  },
  "models": {
    "NodeAddressingDemo": {
      "variables": {
        "u": {
          "type": "unknown"
        },
        "flux": {
          "type": "unknown"
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "u"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "aggregate",
            "id": "edge_enum",
            "args": [],
            "semiring": "bool_and_or",
            "output_idx": [
              "edge"
            ],
            "expr": {
              "op": "index",
              "args": [
                "u",
                "f"
              ]
            },
            "ranges": {
              "f": {
                "from": "faces"
              }
            }
          }
        },
        {
          "lhs": {
            "op": "D",
            "args": [
              "flux"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "aggregate",
            "args": [],
            "semiring": "sum_product",
            "output_idx": [],
            "expr": {
              "op": "index",
              "args": [
                "u",
                "e"
              ]
            },
            "ranges": {
              "e": {
                "from": "edges"
              }
            }
          }
        }
      ]
    }
  }
}