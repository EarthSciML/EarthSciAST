    {
      "id": "unprovable_offset_on_two_axes",
      "expected_code": "recurrence_not_wellfounded",
      "expected_path": "/models/R2/equations/0/rhs",
      "why": "THE BOUNDARY CASE. An unprovable lag is admitted (see fixture 08) -- but admitting it identifies the recurrence axis without stopping the axis COUNT. index(m, i-n, j-n) with `n` a parameter is still two axes. This is the one place an unprovable lag rejects, and it is one `if` away from being lost in a refactor, which is why it is pinned across bindings rather than in one binding's unit tests.",
      "document": {
        "esm": "1.1.0",
        "metadata": {
          "name": "R2",
          "description": "rejection case",
          "authors": [
            "EarthSciML Authors and Contributors"
          ]
        },
        "index_sets": {
          "rows": {
            "kind": "interval",
            "size": 3
          },
          "cols": {
            "kind": "interval",
            "size": 3
          }
        },
        "models": {
          "R2": {
            "tolerance": {
              "rel": 1e-12
            },
            "variables": {
              "m": {
                "type": "unknown",
                "shape": [
                  "rows",
                  "cols"
                ],
                "units": "1"
              },
              "n": {
                "type": "parameter",
                "units": "1",
                "default": 1
              }
            },
            "equations": [
              {
                "lhs": "m",
                "rhs": {
                  "op": "faq",
                  "args": [],
                  "output_idx": [
                    "i",
                    "j"
                  ],
                  "ranges": {
                    "i": {
                      "from": "rows"
                    },
                    "j": {
                      "from": "cols"
                    }
                  },
                  "expr": {
                    "op": "index",
                    "args": [
                      "m",
                      {
                        "op": "-",
                        "args": [
                          "i",
                          "n"
                        ]
                      },
                      {
                        "op": "-",
                        "args": [
                          "j",
                          "n"
                        ]
                      }
                    ]
                  }
                }
              }
            ]
          }
        }
      }
    },
