    {
      "id": "group_same_cell_cycle",
      "expected_code": "recurrence_not_wellfounded",
      "expected_path": "/models/R/equations/0/rhs",
      "why": "a reads its peer b at the cell being written and b reads a there too: index(b, k) in a, index(a, k) in b. A same-position read of a peer is an ordering WITHIN the cell (esm-spec 4.3.1.2 rule 1), so the group is still a candidate (a also reads a[k-1]), but two of them in a cycle admit no order. Reported at the first member, in equation order, on the cycle.",
      "document": {
        "esm": "1.2.0",
        "metadata": {
          "name": "R",
          "description": "recurrence group case",
          "authors": [
            "EarthSciML Authors and Contributors"
          ]
        },
        "index_sets": {
          "lev": {
            "kind": "interval",
            "size": 4
          }
        },
        "models": {
          "R": {
            "variables": {
              "a": {
                "type": "unknown",
                "units": "1",
                "shape": [
                  "lev"
                ]
              },
              "b": {
                "type": "unknown",
                "units": "1",
                "shape": [
                  "lev"
                ]
              }
            },
            "equations": [
              {
                "lhs": "a",
                "rhs": {
                  "op": "faq",
                  "args": [],
                  "output_idx": [
                    "k"
                  ],
                  "ranges": {
                    "k": {
                      "from": "lev"
                    }
                  },
                  "expr": {
                    "op": "ifelse",
                    "args": [
                      {
                        "op": "<=",
                        "args": [
                          "k",
                          1
                        ]
                      },
                      1.0,
                      {
                        "op": "+",
                        "args": [
                          {
                            "op": "index",
                            "args": [
                              "a",
                              {
                                "op": "-",
                                "args": [
                                  "k",
                                  1
                                ]
                              }
                            ]
                          },
                          {
                            "op": "index",
                            "args": [
                              "b",
                              "k"
                            ]
                          }
                        ]
                      }
                    ]
                  }
                }
              },
              {
                "lhs": "b",
                "rhs": {
                  "op": "faq",
                  "args": [],
                  "output_idx": [
                    "k"
                  ],
                  "ranges": {
                    "k": {
                      "from": "lev"
                    }
                  },
                  "expr": {
                    "op": "*",
                    "args": [
                      {
                        "op": "index",
                        "args": [
                          "a",
                          "k"
                        ]
                      },
                      2.0
                    ]
                  }
                }
              }
            ]
          }
        }
      }
