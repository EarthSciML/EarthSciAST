{
  "category": "recurrence/rejections",
  "version": "1.0",
  "description": "Malformed causal self-references (esm-spec 4.3.1.1 `Rejections`) that EVERY binding must refuse, executing or not (CONFORMANCE_SPEC 5.19.5). Each case pins the (code, path) pair and NOTHING ELSE -- see `pinned` below. These live here rather than in tests/invalid/ because they are a property of one construct and belong beside the fixtures that exercise it; the two families would otherwise drift apart, which is exactly what happened to the boundary case `unprovable_offset_on_two_axes`, found by one binding's author and held by one binding's unit test until it was moved here.",
  "pinned": {
    "code": true,
    "path": true,
    "message": false,
    "note": "The format guarantees the CODE and the JSON-pointer PATH. It does NOT guarantee the diagnostic PROSE, and a binding MUST NOT be tested against another binding's wording. This is a deliberate line: the same defect legitimately reads differently depending on which check reached it first -- an unbound parameter used as a whole index is reported by the coefficient test in some bindings and by the affinity test in others, and both are correct. Pinning prose would make the first reworded error message a cross-binding conformance failure."
  },
  "cases": [
    {
      "id": "forward_self_read",
      "expected_code": "recurrence_not_wellfounded",
      "expected_path": "/models/R/equations/0/rhs",
      "why": "index(s, k+1) names a cell the sweep has not reached. Provably later on its axis, so no sweep order satisfies it.",
      "document": {
        "esm": "1.0.0",
        "metadata": {
          "name": "R",
          "description": "rejection case",
          "authors": [
            "EarthSciML Authors and Contributors"
          ]
        },
        "index_sets": {
          "steps": {
            "kind": "interval",
            "size": 4
          }
        },
        "models": {
          "R": {
            "tolerance": {
              "rel": 1e-12
            },
            "variables": {
              "s": {
                "type": "unknown",
                "shape": [
                  "steps"
                ],
                "units": "1"
              }
            },
            "equations": [
              {
                "lhs": "s",
                "rhs": {
                  "op": "aggregate",
                  "args": [],
                  "output_idx": [
                    "k"
                  ],
                  "ranges": {
                    "k": {
                      "from": "steps"
                    }
                  },
                  "expr": {
                    "op": "index",
                    "args": [
                      "s",
                      {
                        "op": "+",
                        "args": [
                          "k",
                          1
                        ]
                      }
                    ]
                  }
                }
              }
            ]
          }
        }
      }
    },
