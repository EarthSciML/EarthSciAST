{
  "esm": "1.0.0",
  "metadata": {
    "name": "operator_compose_owner_rename_mechanism_declared_first",
    "description": "esm-libraries-spec 4.7.1 step 3, the bare-name fallback's OWNERSHIP rule. `Sink` and `Chem` each declare a state named `O3` with a DIFFERENT default, and only the bare-name fallback binds them -- there is no `translate` map and neither writes the other's scoped name. The tendency is arithmetically the same whichever way the entry is written, so the ONLY observable difference used to be the surviving state's NAME and its INITIAL CONDITION, and before this rule flipping `systems` silently swapped both. The surviving spelling now follows the state's owner -- the component the DOCUMENT declares first -- so all three fixtures in this trio are decided by the `models` order and not by the coupling entry's argument order. The DECLARATION order is what decides, not the argument order: here the mechanism is declared first while the operator is still listed first in `systems`, and `Chem.O3` (default 30.0) survives. This is the reseact.esm shape -- an operator-first coupling entry over a mechanism declared above it -- and under the old rule the mechanism's states moved out from under every downstream reference to them.",
    "authors": [
      "EarthSciAST"
    ],
    "tags": [
      "esm-libraries-spec-4.7.1",
      "operator-compose",
      "bare-name-fallback",
      "merge-intent",
      "owner-rename"
    ]
  },
  "models": {
    "Chem": {
      "variables": {
        "O3": {
          "type": "unknown",
          "units": "ppb",
          "default": 30.0,
          "description": "The MECHANISM's own spelling and its own initial condition."
        },
        "k": {
          "type": "parameter",
          "units": "1/s",
          "default": 0.0002
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "O3"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "*",
            "args": [
              {
                "op": "-",
                "args": [
                  "k"
                ]
              },
              "O3"
            ]
          }
        }
      ]
    },
    "Sink": {
      "variables": {
        "O3": {
          "type": "unknown",
          "units": "ppb",
          "default": 40.0,
          "description": "The OPERATOR's own spelling and its own initial condition."
        },
        "kd": {
          "type": "parameter",
          "units": "1/s",
          "default": 0.0001
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "O3"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "*",
            "args": [
              {
                "op": "-",
                "args": [
                  "kd"
                ]
              },
              "O3"
            ]
          }
        }
      ]
    }
  },
  "coupling": [
    {
      "type": "operator_compose",
      "systems": [
        "Sink",
        "Chem"
      ]
    }
  ]
}
