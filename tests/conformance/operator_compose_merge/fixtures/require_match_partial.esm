{
  "esm": "1.0.0",
  "metadata": {
    "name": "operator_compose_require_match_partial",
    "description": "esm-libraries-spec 4.7.1 step 5: a PARTIAL match fails under `require_match` exactly as a zero match does. There is no 'some is enough' reading an author could rely on -- an operator that reaches seven of twelve species and silently misses five is the defect the flag exists to catch. Same document as `partial_merge.esm`, with the flag set; flatten REFUSES.",
    "authors": [
      "EarthSciAST"
    ],
    "tags": [
      "esm-libraries-spec-4.7.1",
      "operator-compose",
      "operator-compose-require-match",
      "merge-intent"
    ]
  },
