          "description": "The species the mechanism does NOT carry. Nothing matches it."
        },
        "kd": {
          "type": "parameter",
          "units": "1/s",
          "default": 0.0001
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "O3S"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "*",
            "args": [
              {
                "op": "-",
                "args": [
                  "kd"
                ]
              },
              "O3S"
            ]
          }
        }
      ]
    }
  },
  "coupling": [
