{
  "esm": "1.0.0",
  "metadata": {
    "name": "operator_compose_require_match_unmatched",
    "description": "esm-libraries-spec 4.7.1 step 5, `require_match`. The same zero-merge document as `no_merge.esm`, with the entry declaring `require_match: true` -- the author saying that Sink's equations are CONTRIBUTIONS and must land on an existing state of Chem. They do not, so flatten REFUSES with operator_compose_require_match_unmatched instead of quietly integrating a decoupled Sink. This document is schema-valid and structurally valid; it is refused at FLATTEN, which is why it lives here and not in tests/invalid/.",
    "authors": [
      "EarthSciAST"
    ],
    "tags": [
      "esm-libraries-spec-4.7.1",
      "operator-compose",
      "operator-compose-require-match",
      "merge-intent"
    ]
  },
