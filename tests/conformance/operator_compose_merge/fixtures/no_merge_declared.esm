{
  "esm": "1.0.0",
  "metadata": {
    "name": "operator_compose_no_merge_declared",
    "description": "esm-libraries-spec 4.7.1 step 5, the `require_match: false` OPT-OUT and the non-vacuity anchor for the zero-merge refusal. The same document as `no_merge.esm`, with the author DECLARING a standalone-contributing operator. A zero merge is then exactly what was asked for: the equations are preserved per step 5, `Sink.O3S` integrates on its own, and nothing is reported. This is how the nine corpus documents that legitimately compose an operator for its VARIABLES rather than its tendencies stay valid under the stricter default -- and without this case a binding that refused every zero merge unconditionally would pass `no_merge.esm`.",
    "authors": [
      "EarthSciAST"
    ],
    "tags": [
      "esm-libraries-spec-4.7.1",
      "operator-compose",
      "require-match-false",
      "merge-intent",
      "non-vacuity"
    ]
  },
  "models": {
    "Chem": {
      "variables": {
        "O3": {
          "type": "unknown",
          "units": "ppb",
          "default": 30.0
        },
        "k": {
          "type": "parameter",
          "units": "1/s",
          "default": 0.0002
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "O3"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "*",
            "args": [
              {
                "op": "-",
                "args": [
                  "k"
                ]
              },
              "O3"
            ]
          }
        }
      ]
    },
    "Sink": {
      "variables": {
        "O3S": {
          "type": "unknown",
          "units": "ppb",
          "default": 40.0,
          "description": "The species the mechanism does NOT carry. Nothing matches it."
        },
        "kd": {
          "type": "parameter",
          "units": "1/s",
          "default": 0.0001
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "O3S"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "*",
            "args": [
              {
                "op": "-",
                "args": [
                  "kd"
                ]
              },
              "O3S"
            ]
          }
        }
      ]
    }
  },
  "coupling": [
    {
      "type": "operator_compose",
      "systems": [
        "Chem",
        "Sink"
      ],
      "require_match": false
    }
  ]
}
