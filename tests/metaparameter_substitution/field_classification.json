  "reasons": {
    "substituted": {
      "expression": "An Expression position: a bare string here is a variable reference, and a bound metaparameter name closes to its integer.",
      "metaparameter_site": "A metaparameter expression or a string naming a metaparameter (index-set size, faq dense ranges, makearray regions, edge bindings values, data-source select range bounds).",
      "dimension": "An integer length or a symbolic dimension (reshape shape); a metaparameter name here closes to the length it names.",
      "declared_name": "Names a variable, parameter, species or index set. metaparameter_name_conflict guarantees no metaparameter spells such a name, so substitution is a no-op here; the key is still skipped when it is structural elsewhere."
    },
    "structural": {
      "node_header": "Describes the Expression node itself (op, id, expect_cadence).",
      "axis": "Names a spatial axis or integration variable (wrt, dim, var).",
      "registry": "A closed-registry id or literal enum parameterizing the node's op.",
      "loop_symbol": "A loop symbol or bound index name of a faq node. metaparameter_name_conflict refuses a metaparameter spelled like a loop symbol, so a metaparameter reaches these fields only as an on data-column name; they are names wherever they appear, so they are structural rather than left to that check.",
      "identifier": "An id or name of a declaration, event, test, plot or handler.",
      "reference": "Names a file, component, data source, template-import vocabulary or data column rather than a value.",
      "enum": "A closed enumeration value.",
      "unit": "A unit string; unit symbols such as m, s and K are valid metaparameter identifiers.",
      "free_text": "Documentation or citation text.",
      "datetime": "A date/time literal."
    }
  },
