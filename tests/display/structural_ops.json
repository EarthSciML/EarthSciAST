        "unicode": "⋁[m] (true) where {c∈cells, r∈records} join(overlap(src=[px, py], tgt=[W, S, E, N])) if (W[c] ≤ px[r])·(px[r] < E[c]) distinct key=skolem(c, label=cell) [semiring=bool_and_or]",
        "latex": "\\bigvee_{m} (true) \\text{ where } \\{c \\in cells, r \\in records\\} join(overlap(src=[px, py], tgt=[W, S, E, N])) if (W[c] \\leq \\mathrm{px}[r]) \\cdot (\\mathrm{px}[r] < E[c]) distinct key=\\mathrm{skolem}(c, label=cell) [semiring=bool_and_or]",
        "ascii": "any[m] (true) where {c in cells, r in records} join(overlap(src=[px, py], tgt=[W, S, E, N])) if (W[c] <= px[r]) * (px[r] < E[c]) distinct key=skolem(c, label=cell) [semiring=bool_and_or]"
