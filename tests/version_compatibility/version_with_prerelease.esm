{
  "esm": "1.0.0-alpha.1",
  "metadata": {
    "name": "Version_With_Prerelease",
    "description": "A prerelease identifier on an otherwise SUPPORTED version — the semver pattern admits major.minor.patch only, so this fails schema validation before the version gate ever sees it.",
    "authors": [
      "ESM Format Team"
    ],
    "created": "2024-01-01T00:00:00Z"
  },
  "models": {
    "SimpleModel": {
      "variables": {
        "x": {
          "type": "unknown",
          "units": "mol/mol",
          "default": 1e-06
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "x"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "*",
            "args": [
              -0.01,
              "x"
            ]
          }
        }
      ]
    }
  }
}
