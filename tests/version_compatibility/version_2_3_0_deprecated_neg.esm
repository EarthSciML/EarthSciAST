          "type": "unknown",
          "units": "mol",
          "default": 1.0
        },
        "k": {
          "type": "parameter",
          "units": "1/s",
          "default": 0.1
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "N"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "*",
            "args": [
              {
                "op": "neg",
